#!/usr/bin/env python3

"""Generate MODELS.md's ranking tables by RUNNING the dashboard.

The dashboard is canonical. It and this document used to compute the same
ranking twice -- `research/build-tables` in python against the captures,
`docs/index.html` in javascript against `docs/data.json` -- and two
implementations of one composite is exactly the drift this repo exists to
remove. So the document is generated from the page: boot the shipped
`docs/index.html` under node with nothing set, which is the view a reader gets
by opening it, and print what the table says.

    ./dashboard-table --table ranking     # the default view, ranked
    ./dashboard-table --table components  # the same rows, per-source columns on
    ./dashboard-table --table weights     # the same rows under each named preset
    ./dashboard-table --table arena       # lmarena elo beside that rank
    ./dashboard-table --table effective   # the index discounted by the fitted quant
    ./dashboard-table --json              # the rows themselves

`--table ranking` is the page's default: text models, a quant that fits a 128gb
box after a 2gib reserve and a 128k context, quality as the weighted mean of
percentiles under the composite weights, quant-adjusted. Everything the page
lets a reader change is left where the page leaves it, so a number here is a
number they will see.

The per-source columns are hidden by default on the page because most readers
want a stance rather than sixty decisions; switching them on is one click and
does not change the ranking, so `--table components` shows the same rows with
the working out.
"""

import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
PROBE = os.path.join(HERE, ".dashboard.js")
# the board the composite weighs: style-controlled, so preference is not
# rewarding length. the same one build-viewer reads the rating out of
TEXT_BOARD = "text-overall-style_control"

sys.path.insert(0, os.path.join(ROOT, "scripts"))
import pageboot  # noqa: E402

# the page computes every one of these; nothing here recomputes any of them
EMIT = """
setTimeout(() => {
  if (!D) { console.error('the page never booted'); process.exit(1); }
  // the ROSTER THIS DOCUMENT RANKS, pinned rather than inherited. it used to be
  // whatever the page opened on, which made a change to a ui default a rewrite
  // of MODELS.md: the two questions -- what a reader should see first, and
  // which models this document is about -- are not the same question and had
  // one answer between them.
  //
  // the FLAGS are pinned for the same reason and were not, which is half a fix:
  // filtering the page on the licence took the document's roster from 69 models
  // to 62, qwen3.8 flash next among the seven, and it surfaced as a prose block
  // referencing a subject the ranking no longer had. a licence is a reason a
  // READER might not want a model; it is not a reason this document is not
  // about it, and the comparison is worth less if the models it declines to
  // compare are the ones somebody could not ship.
  //
  // an EMPTY licence set is every tier, and it has to be said rather than left
  // out: the page opens on `permissive` alone, so inheriting that default is
  // the same seven models going missing by a different route.
  filters.mods = new Set(['text']);
  filters.flags = new Set(['fits']);
  filters.licenses = new Set();
  drawTable();
  const rows = sorted(visible()).map(m => ({
    rank: m._rank, short: m.short, publisher: m.publisher,
    quant: (activeQuant(m) || {}).quant || null,
    gib: (activeQuant(m) || {}).gib || null,
    bpw: (activeQuant(m) || {}).bpw || null,
    retention: modelRetention(m),
    score: scored(m).value, have: scored(m).have, want: scored(m).want,
    cover: scored(m).cover,
    ctx: fitContext(m),
    ids: m.ids || {},
    total_b: m.facts.params_total_b ?? null, active_b: activeB(m) ?? null,
    // the raw intelligence index, unscaled by the quant discount, because the
    // effective-II table prints both halves and the arithmetic between them
    ii: m.facts && m.facets['aa.intelligence']
      ? m.facets['aa.intelligence'].value : null,
    facets: Object.fromEntries(Object.keys(SCALED_COLUMNS).map(k =>
      [k, m.facets[SCALED_COLUMNS[k]]
          ? {value: facetValue(m, SCALED_COLUMNS[k]),
             pct: facetPctRaw(m, SCALED_COLUMNS[k])} : null])),
    community: m.facets['community.reddit-localllama']
      ? facetValue(m, 'community.reddit-localllama') : null,
    // `card.*` is a wildcard weight on the page: one knob for "how much do i
    // trust what the vendor says", averaged over every claim it published
    card: (ks => ks.length
      ? ks.reduce((a, k) => a + facetPctRaw(m, k), 0) / ks.length : null)(
      Object.keys(m.facets).filter(k => k.startsWith('card.'))),
  }));
  // the same ranking under each of the page's named weightings. this table was
  // a SECOND composite in python for a long time, and it answered differently:
  // it put glm-5.3-flash first where the page puts qwen3.8 flash next, in a
  // document every other block of which is generated from the page. the
  // weightings are the page's own presets rather than a set invented here, so
  // "what if you weight coding" means on screen what it means in the document.
  const presets = {};
  Object.keys(PRESETS).forEach(name => {
    if (name === 'clear') return;
    W = PRESETS[name].w();
    // the score is memoized per model and the memo is only valid for the
    // weights it was computed under, so every preset has to drop it -- without
    // this the five rows came out identical, which is what a second composite
    // in python was invented to avoid saying
    clearScores();
    drawTable();
    presets[name] = {
      title: PRESETS[name].t,
      top: sorted(visible()).slice(0, 4).map(m => ({short: m.short,
                                                    score: scored(m).value})),
    };
  });
  W = {...D.weights};
  clearScores();
  drawTable();

  // exit only once the payload has actually left: node's stdout to a PIPE is
  // async, so `console.log` followed by `process.exit` truncates at the pipe
  // buffer. this payload passed 8192 bytes when a quant note grew, and the
  // reader got `Unterminated string ... column 8191` rather than a short read
  process.stdout.write(JSON.stringify({
    weights: D.weights, hardware: {budget, reserve, minCtx, cap, floor},
    effective, rows, presets,
  }), () => process.exit(0));
}, 0);
"""


def num(v, digits=1):
    return "-" if v is None else ("%.*f" % (digits, v))


def cover(r):
    """The share of the asked weight that was measured, as the page prints it.

    A count of factors and a share of weight disagree in both directions -- four
    of the 0.05 factors and one of the 0.3 ones are the same 29% -- and the
    weight is what the composite spends and what the floor below `quality`
    reads. The document said `4/7` while the page said `29%` for one visit.
    """
    return "%d%%" % round((r.get("cover") or 0) * 100)


def table_ranking(d):
    """What the page shows on open: what it is, whether it fits, how good it is."""
    print("| # | model | quant | size (gib) | fits ctx | evidence | quality |")
    print("|--:|---|---|--:|--:|--:|--:|")
    for r in d["rows"]:
        print("| %d | %s | %s | %s | %s | %s | **%s** |" % (
            r["rank"], r["short"], r["quant"] or "-", num(r["gib"]),
            "%dk" % (r["ctx"] / 1024) if r["ctx"] else "-",
            cover(r), num(r["score"], 1)))


def table_components(d):
    """The same rows with the per-source columns the page keeps under the gear."""
    print("| model | quality | eff scicode | eff tbench | gbench | arena | swe-reb "
          "| sentiment | card | evidence |")
    print("|---|--:|--:|--:|--:|--:|--:|--:|--:|--:|")
    for r in d["rows"]:
        f = r["facets"]
        cell = lambda k, n=1: num((f.get(k) or {}).get("value"), n)
        # the two artificial analysis columns are pass rates rather than the
        # 0-100 indices they were, so one decimal of a fraction would show the
        # whole roster as 0.4 and 0.5
        def share(k):
            v = (f.get(k) or {}).get("value")
            return "-" if v is None else "%.1f" % (v * 100)
        print("| %s | **%s** | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            r["short"], num(r["score"], 1), share("scicode"), share("tbench"),
            cell("gbench", 3), num((f.get("arena") or {}).get("value"), 0),
            cell("swe"), num(r["community"], 1),
            num(r["card"], 0), cover(r)))


def table_weights(d):
    """How far the ranking moves when the reader picks a different question.

    The page's own presets, run through the page. Each is a whole answer to
    "what is quality" rather than a nudge, which is why the rows can disagree
    about first place and that is the point of printing them.
    """
    print("| weighting | top four |")
    print("|---|---|")
    for name, got in d["presets"].items():
        top = ["%s %s" % (m["short"], num(m["score"], 1)) for m in got["top"]]
        lead = "**%s**" % top[0] if top else "-"
        print("| %s | %s |" % (got["title"], " > ".join([lead] + top[1:])))


def table_arena(d):
    """Human preference, beside the rank the rest of the document uses.

    The rank column was a second composite's answer for a while, which is the
    worst version of a stale table: the elo and the votes beside it were the
    page's and the rank was not.
    """
    lm = json.load(open(os.path.join(HERE, "data", "lmarena.json")))["boards"]
    text, web = lm.get(TEXT_BOARD) or {}, lm.get("webdev-overall-raw") or {}

    def find(board, mid):
        return next((e for e in board.get("entries") or []
                     if e.get("modelDisplayName") == mid), {})

    print("| model | composite rank | text elo | votes | webdev elo |")
    print("|---|--:|--:|--:|--:|")
    for r in d["rows"]:
        mid = (r["ids"] or {}).get("lmarena")
        t, w = (find(text, mid), find(web, mid)) if mid else ({}, {})
        print("| %s | %d | %s | %s | %s |" % (
            r["short"], r["rank"], num(t.get("rating"), 0),
            "{:,}".format(t["votes"]) if t.get("votes") else "-",
            num(w.get("rating"), 0)))


def table_effective(d):
    """What each model is worth at the quant that fits, from the page's fit.

    Sorting by raw intelligence index instead would imply quantization is free,
    which is the thing this document exists to disprove. The quant, the bits per
    weight and the retention are the page's, so the rung named here is the rung
    it names everywhere else -- this table used to answer with a second one,
    fitted against a flat budget rather than each model's own kv cache.
    """
    print("| model | total / active | quant | size (gib) | bpw | AA II | retention "
          "| effective II |")
    print("|---|---|---|--:|--:|--:|--:|--:|")
    rows = sorted(d["rows"], key=lambda r: (r["ii"] is not None,
                                            (r["ii"] or 0) * (r["retention"] or 1)),
                  reverse=True)
    for r in rows:
        shape = "%gb / %s" % (r["total_b"] or 0,
                              "%gb" % r["active_b"] if r["active_b"] else "?")
        eff = None if r["ii"] is None else r["ii"] * (r["retention"] or 1)
        print("| %s | %s | %s | %s | %s | %s | %.3f | **%s** |" % (
            r["short"], shape, r["quant"] or "-", num(r["gib"]), num(r["bpw"], 2),
            num(r["ii"]), r["retention"] or 1.0, num(eff)))


TABLES = {"ranking": table_ranking, "components": table_components,
          "weights": table_weights, "arena": table_arena,
          "effective": table_effective}


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--table", default="ranking",
                    choices=["ranking", "components", "weights",
                             "arena", "effective"])
    ap.add_argument("--json", action="store_true", help="the rows, unformatted")
    ap.add_argument("--keep", action="store_true", help="leave the probe on disk")
    args = ap.parse_args()

    r = pageboot.run(EMIT, PROBE, keep=args.keep, capture=True)
    if r.returncode:
        sys.exit("!!! the page failed to boot")
    d = json.loads(r.stdout.strip().split("\n")[-1])
    if args.json:
        print(json.dumps(d, indent=1))
        return
    TABLES[args.table](d)


if __name__ == "__main__":
    main()
