def load_build_tables():
    """Reuse build-tables' joins rather than restating them."""
    spec = importlib.util.spec_from_loader(
        "build_tables",
        importlib.machinery.SourceFileLoader("build_tables",
                                             os.path.join(HERE, "build-tables")))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def load(name):
    path = os.path.join("data", name + ".json")
    try:
        with open(path) as f:
            return json.load(f)
    except (IOError, ValueError):
        return {}


def ref(source, model_id=None, note=None):
    """Where a number came from: the source, its file, and a url to read it at."""
    s = SOURCES[source]
    out = {"source": s["label"], "file": s["file"]}
    if s.get("model_url") and model_id:
        out["url"] = s["model_url"] % model_id
    elif s.get("url"):
        out["url"] = s["url"]
    if model_id:
        out["id"] = model_id
    if note:
        out["note"] = note
    return out


def percentile(value, population):
    """Where in the cohort this value sits, 0-100, by plotting position.

    The cohort is the registry models carrying the SAME facet, not every model
    the source scored: "top third of what this box can run" is the question,
    and ranking a 27b local model against a frontier api model answers a
    different one.

    `(below + half the ties) / n` rather than `below / n`, which is the Hazen
    position. The difference is worst on a small cohort and it showed badly:
    three models carry artificial analysis' TTS elo, so the lowest of them --
    kokoro, at a perfectly real 1060 -- scored a flat ZERO, which reads as
    unmeasured rather than as third of three. The same formula never returned
    100 either, since nothing is strictly below the top. Three models now read
    17, 50 and 83.

    It is not a relabelling: the shift is +50/n, so a model measured on a rare
    facet gains more than one measured on a common one, and the composite --
    which averages percentiles across facets with different cohort sizes --
    moves. Six adjacent pairs swapped in the text ranking when this landed, all
    of them within 3 points. That is the point rather than a side effect: the
    old rule pushed every small cohort toward zero, this one centres each
    cohort on 50 whatever its size, and only then are two percentiles from
    different-sized cohorts a fair thing to average.
    """
    others = [v for v in population if v is not None]
    if len(others) < 2:
        return None
    below = sum(1 for x in others if x < value)
    ties = sum(1 for x in others if x == value)
    return round(100.0 * (below + 0.5 * ties) / len(others))


def aa_facets(entry, aa_id):
    out = {}
    for key, label, field, unit in AA_FACETS:
        v = entry.get(field)
        if v is None:
            continue
        out[key] = {"value": v, "label": label, "unit": unit,
                    "group": "artificial analysis", "ref": ref("aa", aa_id)}
    return out


def gbench_facets(row, gid, bt):
    """gscore overall and per mode, plus the per-language breakdown."""
    out, langs = {}, []
    if not row:
        return out, langs
    thin = (row.get("total_matches") or 0) < bt.GBENCH_MIN_MATCHES
    for key, label, mode in GBENCH_MODES:
        sub = row if mode is None else (row.get(mode) or {})
        if sub.get("gscore") is None:
            continue
        note = "only %d matches played" % (row.get("total_matches") or 0) if thin else None
        out[key] = {"value": sub["gscore"], "label": label, "unit": "gscore",
                    "group": "gbench", "games": sub.get("games_played"),
                    "low_confidence": bool(thin), "ref": ref("gbench", gid, note)}
    for lang, c in (row.get("by_language") or {}).items():
        if (c.get("total") or 0) < LANG_MIN_GAMES or c.get("success_rate") is None:
            continue
        langs.append({"lang": lang, "rate": c["success_rate"], "games": c["total"],
                      "matches": c.get("matches"), "ref": ref("gbench", gid)})
    langs.sort(key=lambda x: -x["rate"])
    # the per-language rates are facets too, so a reader who writes rust can
    # weight rust. they are kept out of `USE_FOR` -- being good at kotlin is
    # not a use case, it is a language somebody either uses or does not
    for l in langs:
        out["lang." + l["lang"]] = {
            "value": l["rate"], "label": "%s (%d games)" % (l["lang"], l["games"]),
            "unit": "share", "group": "gbench languages", "games": l["games"],
            "ref": l["ref"]}
    return out, langs


def epoch_losses(epoch):
    """Epoch benchmarks dropped rather than faceted, because they score a loss.

    A capture that stops being a facet has to say so: a silently smaller facet
    set is the failure mode this repo keeps a punch list for.
    """
    return sorted(name for name, b in (epoch.get("benchmarks") or {}).items()
                  if (b.get("metric") or "") in EPOCH_LOSSES)


def epoch_facets(epoch, epoch_id):
    """Third-party runs on epoch's own harness, one facet per benchmark."""
    out = {}
    if not epoch_id:
        return out
    for name, b in (epoch.get("benchmarks") or {}).items():
        metric = b.get("metric") or "Score"
        if metric in EPOCH_LOSSES:
            continue
        for row in b.get("results") or []:
            mv = (row.get("Model version") or "").split("/")[-1].rsplit("_", 1)[0]
            if mv != epoch_id or metric not in row:
                continue
            try:
                v = float(row[metric])
            except (TypeError, ValueError):
                continue
            out["epoch." + name] = {
                "value": v, "label": "%s (%s)" % (name.replace("_", " "), metric.lower()),
                "unit": "share" if v <= 1 else "score", "group": "epoch",
                "ref": ref("epoch", epoch_id, row.get("Source"))}
            break
    return out


def card_facets(card, repo, bias):
    """What the model says about itself, marked as such and bias-corrected.

    analyze-self-report measures the median claim at +0.9 over third-party
    measurement of the same model on the same benchmark, so the constant is
    subtracted here rather than left for the reader to remember.
    """
    out = {}
    for bench, v in ((card or {}).get("claimed") or {}).items():
        out["card." + bench] = {
            "value": round(v - bias, 1), "raw": v, "label": bench.replace("_", " "),
            "unit": "share" if v <= 1 else "score", "group": "card claims",
            "vendor_reported": True,
            "ref": ref("card", repo, "claimed %s, corrected by -%.1f" % (v, bias))}
    return out


def community_facet(sent):
    """One number per forum: how much it is discussed x how well received.

    Same shape as build-tables' sentiment score -- log-damped volume times
    reception -- but computed per forum rather than pooled, because a forum
    that publishes no post bodies cannot vote on quality.
    """
    import math
    out = {}
    for source, s in (sent.get("by_source") or {}).items():
        if not s.get("mentions"):
            continue
        rel = (s["median_rel"] if s.get("median_rel") is not None else 50) / 50.0
        out["community." + source] = {
            "value": round(math.log1p(s["mentions"]) * rel, 2),
            "label": "discussion on %s" % source, "unit": "score",
            "group": "community", "mentions": s["mentions"],
            "approval": s.get("approval"), "refs": s.get("refs") or [],
            "ref": {"source": source, "file": SOURCES["community"]["file"]}}
    return out


def derive(facets, langs):
    """A cheap answer for a consumer with no weighting ui: what stands out."""
    best, weak = [], []
    for key, f in facets.items():
        use = USE_FOR.get(key)
        pct = f.get("pct")
        if not use or pct is None or f.get("vendor_reported"):
            continue
        if pct >= TOP_PCT and use not in best:
            best.append(use)
        elif pct <= BOTTOM_PCT and use not in weak:
            weak.append(use)
    return {"best_for": best, "weak_for": [w for w in weak if w not in best],
            "best_languages": [l["lang"] for l in langs[:3]]}


def provenance(files):
    """Which capture every number in this file came from."""
    out = {}
    for f in files:
        path = os.path.join("data", f + ".json")
        if not os.path.exists(path):
            continue
        with open(path, "rb") as fh:
            digest = hashlib.sha256(fh.read()).hexdigest()[:16]
        out["data/%s.json" % f] = {
            "sha256": digest,
            "modified": time.strftime("%Y-%m-%d",
                                      time.gmtime(os.path.getmtime(path)))}
    return out


# the speech boards, and how to read each one. two of the five publish an ERROR
# RATE, and every facet on this page is higher-is-better -- the percentile pass
# has no notion of direction -- so a WER is stored as the accuracy it implies
# rather than as itself. that is also how it reads: "94.6% of words right"
# answers the question somebody opening a transcription model is asking, and the
# label says which number it came from so nothing is hidden by the arithmetic.
#
# an elo needs no such treatment and gets none.
def accuracy(wer):
    """A word error rate as the percentage it leaves standing."""
    return None if wer is None else round((1 - wer) * 100, 2)


def speech_facets(speech, arena, voicearena, ids, open_asr=None):
    """Facets for a model one of the speech boards scores.

    Nothing here is scored against a text model: no text model carries these
    keys, so each one's percentile cohort is the speech roster that shares it.
    """
    out = {}
    # the open ASR leaderboard, which already stores an accuracy: its collector
    # inverts the word error rate on the way in, so unlike the boards below
    # there is nothing to flip here. eight datasets behind one mean, against
    # artificial analysis' single index
    oasr = (open_asr or {}).get(ids.get("open-asr")) or {}
    if oasr.get("accuracy") is not None:
        out["open-asr.accuracy"] = {
            "value": oasr["accuracy"], "label": "transcription accuracy",
            "unit": "share", "group": "open asr leaderboard",
            "ref": ref("open-asr", ids.get("open-asr"),
                       "100 - %.2f mean WER over %d datasets"
                       % (oasr.get("wer") or 0, len(oasr.get("datasets") or {})))}

    stt = (speech.get("speech-to-text") or {}).get(ids.get("aa-stt")) or {}
    v = accuracy(stt.get("aaWerIndex"))
    if v is not None:
        out["aa-stt.accuracy"] = {
            "value": v, "label": "transcription accuracy", "unit": "share",
            "group": "artificial analysis speech",
            "ref": ref("aa-stt", ids.get("aa-stt"),
                                          "100 - aaWerIndex, a word error rate")}

    live = ((speech.get("speech-to-text-streaming") or {})
            .get(ids.get("aa-stt-streaming")) or {})
    v = accuracy(live.get("aaWerStreamingIndex"))
    if v is not None:
        out["aa-stt-streaming.accuracy"] = {
            "value": v, "label": "streaming transcription accuracy", "unit": "share",
            "group": "artificial analysis speech",
            "ref": ref("aa-stt-streaming",
                                          ids.get("aa-stt-streaming"),
                                          "100 - aaWerStreamingIndex")}

    tts = (speech.get("text-to-speech") or {}).get(ids.get("aa-tts")) or {}
    if tts.get("qualityElo") is not None:
        out["aa-tts.elo"] = {
            "value": tts["qualityElo"], "label": "synthesis quality", "unit": "elo",
            "group": "artificial analysis speech",
            "ref": ref("aa-tts", ids.get("aa-tts"))}

    ta = arena.get(ids.get("tts-arena")) or {}
    if ta.get("elo") is not None:
        # the vote count is what separates a rating worth reading from one that
        # is three people, and this board is the only one that publishes it
        out["tts-arena.elo"] = {
            "value": ta["elo"], "label": "synthesis preference", "unit": "elo",
            "group": "tts arena", "votes": ta.get("totalVotes"),
            "ref": ref("tts-arena", ids.get("tts-arena"),
                       "%s votes, +-%s" % (ta.get("totalVotes"), ta.get("uncertainty")))}

    # one facet per language, the way gbench already gets one per language: the
    # whole reason to carry voice arena is that the slices disagree, and an
    # average over them would throw away the finding
    va = voicearena.get(ids.get("voicearena")) or {}
    for lang, sets in sorted((va.get("languages") or {}).items()):
        # the noise slices are a breakdown of "All", not siblings of it
        whole = sets.get("All") or {}
        if whole.get("corpusErrorPct") is None:
            continue
        out["voicearena." + lang.lower().replace(" ", "-")] = {
            "value": round(100 - whole["corpusErrorPct"], 2),
            "label": "accuracy, %s" % lang.lower(), "unit": "share",
            "group": "voice arena languages", "samples": whole.get("samples"),
            "ref": ref("voicearena", ids.get("voicearena"),
                       "100 - corpusErrorPct over %s samples" % whole.get("samples"))}
    return out


# the showdown's two competitions, as (facet key, capture board, what it asks).
# the four axes JevBench publishes, as (facet suffix, where to read it, label,
# unit). the composite is carried alongside its own components rather than
# instead of them, because it is a harmonic mean over speed and cost as well --
# and for a model whose whole output is a probability, calibration is not one
# axis among four, it is the product.
JEV_AXES = [("score", ("jevbench_score",), "jevbench score (25:25:25:25)", "score"),
            ("intelligence", ("axes", "intelligence"), "intelligence", "score"),
            ("calibration", ("axes", "calibration"), "calibration", "score"),
            ("hard", ("tiers", "hard"), "hard tier accuracy", "share"),
            ("sealed", ("sealed_accuracy",), "sealed tier accuracy", "share")]


def jev_facets(board, ids):
    """JevBench, for the models that answer in probabilities rather than tokens.

    Five numbers over two questions. The first is how good the answers are
    (score, intelligence, hard tier) and the second is whether the model knows:
    `calibration` is a score no other source here has any notion of, and
    `sealed` is the swe-rebench move on this board -- 308 items frozen after
    every system shipped, so a model 49 points better on the public items than on
    the sealed ones is telling on itself. Both halves are carried per row rather
    than averaged, because the gap between them IS the finding.
    """
    row = (board.get(ids.get("jev")) or {})
    if not row:
        return {}
    total = sum(1 for r in board.values() if r.get("ranked"))
    note = ("rank %s of %d ranked systems, revision %s"
            % (row.get("rank") or "-", total, row.get("new_in") or "the pinned run"))
    # the public-minus-sealed gap is a LOSS, and every facet here ranks higher as
    # better, so it is not a facet of its own. it rides on the sealed one's ref
    # line, where a reader sees the accuracy and how much of it the frozen items
    # did not survive
    gap = row.get("public_minus_sealed_gap_pp")
    if gap is not None:
        note += "; the public items read %.1f points higher than the sealed ones" % gap
    out = {}
    for suffix, path, label, unit in JEV_AXES:
        v = row
        for key in path:
            v = (v or {}).get(key)
        if v is None:
            continue
        out["jev.%s" % suffix] = {
            "value": v, "label": label, "unit": unit, "group": "jevbench",
            "ref": ref("jev", ids.get("jev"), note)}
    return out


# one shape, two questions, so they are generated from a table rather than
# written twice
SHOWDOWN_BOARDS = [
    ("showdown-t2i", "text-to-image", "prompt adherence"),
    ("showdown-edit", "image-editing", "edit adherence"),
]


def image_facets(board, lm, ids, lm_edit=None, showdown=None):
    """Five numbers over two questions: three sites rating generated pictures,
    and two rating EDITED ones.

    The generation boards are kept apart for the reason the two transcription
    boards are: they disagree. Artificial analysis has z-image above krea 2 and
    lmarena has it below, over six million votes. An average of the two would
    hide that and answer neither question.

    The showdown disagrees with both by construction, because it is not asking
    what anybody preferred. It is fifteen prompts with the passing criteria
    written down and a pass-or-fail against each, which makes a low number mean
    something the elos cannot say: flux.2 dev sits mid-table on both arenas and
    passes 5 of 15 here.

    Editing is a third thing again and not a third opinion on the same one. It
    is here because two collectors were already capturing it and nothing read
    them.
    """
    lm_edit = lm_edit or {}
    out = {}
    row = board.get(ids.get("aa-t2i")) or {}
    if row.get("elo") is not None:
        out["aa-t2i.elo"] = {
            "value": row["elo"], "label": "image arena rating", "unit": "elo",
            "group": "artificial analysis image", "votes": row.get("appearances"),
            "ref": ref("aa-t2i", ids.get("aa-t2i"),
                       "%s appearances, %s to %s" % (row.get("appearances"),
                                                     row.get("ciLower"),
                                                     row.get("ciUpper")))}

    edit = lm_edit.get(ids.get("lmarena-edit")) or {}
    if edit.get("rating") is not None:
        # a separate facet from the generation board on purpose: qwen-image-edit
        # leads this one and appears on no text-to-image board at all, and the
        # flux 2 entries sit within 40 points of each other here while their
        # generation ratings spread wider. one number is not evidence for the
        # other question
        out["lmarena-edit.rating"] = {
            "value": edit["rating"], "label": "image edit rating (raw)",
            "unit": "elo", "group": "lmarena images", "votes": edit.get("votes"),
            "ref": ref("lmarena-edit", ids.get("lmarena-edit"),
                       "rank %s of the editing board, %s votes"
                       % (edit.get("rank"), edit.get("votes")))}

    entry = lm.get(ids.get("lmarena-t2i")) or {}
    if entry.get("rating") is not None:
        # the board is `-raw`: lmarena style-controls its text boards and not
        # this one, so the rating carries whatever presentation effects a
        # picture has and the label says raw rather than pretending otherwise
        out["lmarena-t2i.rating"] = {
            "value": entry["rating"], "label": "image arena rating (raw)",
            "unit": "elo", "group": "lmarena images", "votes": entry.get("votes"),
            "ref": ref("lmarena-t2i", ids.get("lmarena-t2i"),
                       "rank %s of the board, %s votes"
                       % (entry.get("rank"), entry.get("votes")))}

    # a share rather than the raw count, because the two competitions run
    # different numbers of prompts and three generators were retired part way
    # through the generation series -- imagen 3 has thirteen of the fifteen. the
    # ref note carries both halves of the fraction so a reader never has to
    # trust the division
    boards = (showdown or {}).get("boards") or {}
    for source, name, label in SHOWDOWN_BOARDS:
        got = ((boards.get(name) or {}).get("models") or {}).get(ids.get(source)) or {}
        if got.get("passRate") is None:
            continue
        out["%s.adherence" % source] = {
            "value": got["passRate"], "label": label, "unit": "share",
            "group": "genai showdown", "prompts": got.get("scored"),
            "ref": ref(source, ids.get(source),
                       "%s of %s prompts passed over %s generations"
                       % (got.get("passed"), got.get("scored"), got.get("attempts")))}
    return out


def build(bt, registry):
    """One record per registry model, plus the cohort percentiles across them."""
    aa, epoch = load("artificial-analysis"), load("epoch")
    gb = {m["model_id"]: m for m in (load("gbench").get("rankings") or [])}
    sent, cards = load("sentiment"), load("model-cards")
    speech = load("artificial-analysis-speech")
    open_asr = (load("open-asr") or {}).get("models") or {}
    arena, voicearena = load("tts-arena"), load("voicearena")
    pictures, showdown = load("artificial-analysis-image"), load("genai-showdown")
    jev = load("jevbench").get("systems") or {}

    def lm_board(name):
        """One lmarena board's entries, keyed by the name its ids use."""
        return {e["modelDisplayName"]: e for e in
                ((load("lmarena").get("boards") or {}).get(name) or {}).get("entries") or []
                if e.get("modelDisplayName")}

    lm_images = lm_board("text_to_image-overall-raw")
    lm_edits = lm_board("image_edit-overall-raw")
    models = {}
    for repo, m in registry.items():
        ids = m.get("ids") or {}
        short = (m.get("name") or {}).get("short") or repo
        facets = {}
        facets.update(aa_facets(aa.get(ids.get("aa")) or {}, ids.get("aa")))
        gfacets, langs = gbench_facets(gb.get(ids.get("gbench")), ids.get("gbench"), bt)
        facets.update(gfacets)
        facets.update(epoch_facets(epoch, ids.get("epoch")))
        facets.update(card_facets(cards.get(repo), repo, bt.CARD_BIAS))
        facets.update(community_facet(sent.get(short) or {}))
        facets.update(speech_facets(speech, arena, voicearena, ids, open_asr))
        facets.update(image_facets(pictures, lm_images, ids, lm_edits, showdown))
        facets.update(jev_facets(jev, ids))
        rating = bt.lmarena_score(ids)
        if rating is not None:
            facets["lmarena.rating"] = {
                "value": rating, "label": "arena rating (style controlled)",
                "unit": "elo", "group": "lmarena", "ref": ref("lmarena", ids.get("lmarena"))}
        resolved = bt.swerebench_score(ids)
        if resolved is not None:
            facets["swerebench.resolved"] = {
                "value": resolved, "label": "resolved rate", "unit": "share",
                "group": "swe-rebench", "ref": ref("swerebench", ids.get("swerebench"))}
        # artificial analysis publishes the ADVERTISED parameter counts. the
        # derived total in model-facts.json counts the tensors that actually
        # ship, so the two disagree -- deepseek v4 flash counts 304b of weights
        # against an advertised 284b -- and both are worth carrying: one is
        # what you download, the other is what the vendor calls it. active
        # parameters have no derived counterpart at all, because config.json
        # says how many EXPERTS route per token and not how big they are.
        entry = aa.get(ids.get("aa")) or {}
        params = {k: v for k, v in
                  (("advertised_total_b", entry.get("totalParameters")),
                   ("advertised_active_b", entry.get("activeParameters")))
                  if v is not None}
        models[repo] = {"name": short, "kind": m.get("kind", "text"),
                        "params": params,
                        "facets": facets, "languages": langs,
                        "community": (sent.get(short) or {}).get("by_source") or {},
                        "tasks": (sent.get(short) or {}).get("tasks_all") or {}}
    add_percentiles(models)
    for rec in models.values():
        rec["derived"] = derive(rec["facets"], rec["languages"])
    return models


def add_percentiles(models):
    """Rank each facet within the registry cohort that carries it."""
    pops = {}
    for rec in models.values():
        for key, f in rec["facets"].items():
            pops.setdefault(key, []).append(f["value"])
    for rec in models.values():
        for key, f in rec["facets"].items():
            f["pct"] = percentile(f["value"], pops[key])
            f["cohort"] = len(pops[key])


def merge_assessed(new, authored, old):
    """Written judgement in, from its own file rather than from the output.

    usecase-assessed.json is SOURCE: hand-written, or written by a model
    reading the facets below and told to cite them. Keeping it out of the
    generated file means a recompute cannot lose it, a diff shows judgement
    changing separately from measurement, and anything else that wants the
    prose -- a generated MODELS.md, say -- reads one machine-readable file
    rather than parsing a document.

    An entry still sitting in the old output is carried forward too, so a
    handwritten block added there directly is not silently dropped.
    """
    kept = 0
    for repo, rec in new.items():
        a = authored.get(repo) or (old.get("models", {}).get(repo) or {}).get("assessed")
        if a:
            rec["assessed"] = a
            kept += 1
    return kept


def load_authored(path):
    try:
        with open(path) as f:
            return json.load(f).get("assessed") or {}
    except (IOError, ValueError):
        return {}


# the two figures a verdict quotes from sentiment.json: `hf-discussions 123
# mentions` and `reddit ... 14% approval`. the source name as the verdicts spell
# it -- including the way prose spells it, which is not the way a key does --
# mapped to the key that file uses
SOURCE = r"hf-discussions|huggingface discussions?|reddit|hackernews|level1techs"
CITED = re.compile(r"\b(%s)\s+(\d+)\s+mentions" % SOURCE, re.I)
# and the same count with the source AFTER the number, which is how a sentence
# says it: `34 reddit mentions`. the evidence lists put the source first and the
# notes put it second, so reading only one order checks half the file -- the
# half that does not carry the argument
CITED_PROSE = re.compile(r"\b(\d+)\s+(%s)\s+mentions" % SOURCE, re.I)
CITED_APPROVAL = re.compile(r"\b(%s)\b[^.;,]{0,40}?(\d+)%%\s*approval" % SOURCE, re.I)
# an approval rate written as a bare `at 86%` with no `approval` after it. a
# percentage on its own is not a claim about reception -- it could be a
# benchmark -- so this only reads one that rides on a mention count of a named
# forum, which is the shape the notes actually use
CITED_PROSE_APPROVAL = re.compile(
    r"\b(\d+)\s+(%s)\s+mentions\s+at\s+(\d+)%%" % SOURCE, re.I)
# a line names more than one forum -- "hf-discussions 65 mentions, reddit 62 at
# 100% approval" -- so the gap between a source and its figure must not cross a
# comma, or the first source is charged with the second one's number. this check
# caught itself doing exactly that
CLAUSE = re.compile(r"[,;.]")
CITED_SOURCE = {"hf-discussions": "hf-discussions",
                "huggingface discussion": "hf-discussions",
                "huggingface discussions": "hf-discussions",
                "reddit": "reddit-localllama",
                "hackernews": "hackernews", "level1techs": "level1techs"}
# where a verdict can quote one. `evidence` is the list MODELS.md prints as the
# grounds for the judgement; the prose fields restate the same figures and drift
# the same way
QUOTING_FIELDS = ("evidence", "notes", "one_liner")


def cited_lines(blk):
    for field in QUOTING_FIELDS:
        v = blk.get(field)
        for line in (v if isinstance(v, list) else [v] if v else []):
            yield line


def check_citations(authored, sentiment, names):
    """Every figure a verdict quotes, against the capture it came from.

    The judgement in these blocks is a human's and stays theirs. The FIGURES are
    not: they sit in data/sentiment.json, and a verdict citing one that file
    disagrees with prints a wrong number in MODELS.md as the grounds for its own
    argument. That is what happened -- the captures moved and the prose did not.

    It is not a rounding problem. bonsai 27b's verdict called it the
    worst-received model in the corpus on "14% approval" where the capture says
    75%, and ornith 1.0 35b cited 0% where it says 50%. A count being stale
    misstates the weight of the evidence; an approval rate being stale can
    invert what it says.

    Only quoted figures are checked, and only in the shape the verdicts already
    use. Prose that describes without quoting is left alone.
    """
    bad = []
    for repo, blk in sorted(authored.items()):
        by = ((sentiment.get(names.get(repo)) or {}).get("by_source") or {})
        for line in cited_lines(blk):
            # (source, figure) whichever order the sentence puts them in, plus
            # the approval a prose count carries along behind it
            quoted = [(s, n, "mentions", "") for s, n in CITED.findall(line)]
            quoted += [(s, n, "mentions", "") for n, s in CITED_PROSE.findall(line)]
            quoted += [(s, n, "approval", "%") for s, n in CITED_APPROVAL.findall(line)]
            quoted += [(s, pct, "approval", "%")
                       for _, s, pct in CITED_PROSE_APPROVAL.findall(line)]
            for src, claimed, field, unit in quoted:
                actual = (by.get(CITED_SOURCE[src.lower()]) or {}).get(field)
                if actual is None or int(actual) != int(claimed):
                    bad.append((repo, src, field, int(claimed), actual, unit))
    seen = set()
    for row in bad:
        if row in seen:
            continue
        seen.add(row)
        repo, src, field, claimed, actual, unit = row
        print("!!! %s: verdict cites %s %s%s %s, the capture says %s"
              % (repo, src, claimed, unit, field,
                 "nothing" if actual is None else "%s%s" % (actual, unit)))
    print("citations: %d figure(s) quoted that the capture disagrees with"
          % len(seen))
    return 1 if seen else 0


def check_verdicts(authored, built, ledger_path=None, decided_path=None):
    """Verdicts whose evidence has moved since somebody wrote them.

    References keep a verdict's FIGURES live -- see research/verdicts.py -- and
    that is not the same as keeping its argument true. Muse glimmer's note
    reasoned from reddit "being unanimous the other way" when reddit read 100%;
    at 86% every rendered number is still right and the sentence is not.

    So `authored_against` records the values the author reasoned from -- in
    research/prose.json, the one ledger that covers every written surface --
    and this reports what has moved out from under them. A block with no
    snapshot is listed rather than failed: stamping one from today's values would assert
    that somebody re-read prose they have not, which is the only way this check
    can lie.

    A row a human has DECIDED at these figures is settled and skipped, the same
    rule review-verdicts uses. The two disagreed for a while -- that one honours
    the answer and this one, which is what the sweep punch list runs, did not --
    so eighteen verdicts somebody had re-read came back every sweep.
    """
    import prose
    led = prose.ledger(ledger_path or prose.LEDGER)
    here = os.path.dirname(os.path.abspath(__file__))
    try:
        with open(decided_path or os.path.join(here, "verdicts-decided.json")) as f:
            decided = json.load(f)
    except (IOError, ValueError):
        decided = {}
    models = (built or {}).get("models") or {}
    stale, unstamped, settled = [], [], 0
    for repo, blk in sorted((authored or {}).items()):
        facets = (models.get(repo) or {}).get("facets") or {}
        snap = prose.snapshot_for(repo, led)
        if not snap:
            unstamped.append(repo)
            continue
        was = (decided.get(repo) or {}).get("figures")
        if was is not None and was == verdicts.snapshot(sorted(snap), facets):
            settled += 1
            continue
        for key, why in verdicts.moved(snap, facets):
            stale.append((repo, key, why))

    for repo, key, why in stale:
        print("!!! %s: %s %s -- the verdict was written against the old figure"
              % (repo, key, why))
    print("verdicts: %d figure(s) moved under a verdict that vouched for them, "
          "%d decided" % (len(stale), settled))
    if unstamped:
        print("verdicts: %d block(s) carry no authored_against and are not "
              "checked; each gets one the next time it is edited" % len(unstamped))
        for repo in unstamped[:10]:
            print("    %s" % repo)
        if len(unstamped) > 10:
            print("    ... and %d more" % (len(unstamped) - 10))
    return 1 if stale else 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", default=OUT)
    ap.add_argument("--assessed", default=ASSESSED,
                    help="the written judgements, which this file only carries")
    ap.add_argument("--decided", default=None,
                    help="answers review-verdicts recorded; a row settled at "
                         "these figures is not reported again")
    ap.add_argument("--ledger", default=None,
                    help="who wrote each block and against which figures; "
                         "research/prose.json unless overridden")
    ap.add_argument("--check", action="store_true",
                    help="exit 1 if the file on disk is not what this would write")
    ap.add_argument("--missing", action="store_true",
                    help="list models with no assessed block")
    ap.add_argument("--check-citations", action="store_true",
                    help="exit 1 if a verdict quotes a mention count the "
                         "capture disagrees with")
    ap.add_argument("--check-verdicts", action="store_true",
                    help="exit 1 if a figure a verdict vouched for has moved "
                         "out from under its argument")
    ap.add_argument("--sentiment", help="override data/sentiment.json")
    ap.add_argument("--names", help="a {repo: short} map, for the fixtures")
    args = ap.parse_args()

    if args.check_verdicts:
        built = {}
        if os.path.exists(args.out):
            with open(args.out) as f:
                built = json.load(f)
        return check_verdicts(load_authored(args.assessed), built, args.ledger,
                              args.decided)

    if args.check_citations:
        sentiment = (json.load(open(args.sentiment)) if args.sentiment
                     else load("sentiment"))
        if args.names:
            names = json.load(open(args.names))
        else:
            bt = load_build_tables()
            names = {r: (m.get("name") or {}).get("short") or r
                     for r, m in (bt.registry() or {}).items()}
        return check_citations(load_authored(args.assessed), sentiment, names)

    bt = load_build_tables()
    registry = bt.registry()
    if not registry:
        sys.exit("!!! registry/models.yaml did not load")

    old = {}
    if os.path.exists(args.out):
        with open(args.out) as f:
            old = json.load(f)

    models = build(bt, registry)
    losses = epoch_losses(load("epoch"))
    if losses:
        print("note: %d epoch benchmark(s) score a loss and carry no facet: %s"
              % (len(losses), ", ".join(losses)), file=sys.stderr)
    kept = merge_assessed(models, load_authored(args.assessed), old)
    doc = {"version": 1,
           "provenance": provenance(["artificial-analysis", "gbench", "lmarena",
                                     "swe-rebench", "epoch", "model-cards",
                                     "sentiment"]),
           "models": models}
    text = json.dumps(doc, indent=1, sort_keys=True) + "\n"

    if args.missing:
        for repo, rec in sorted(models.items()):
            if not rec.get("assessed"):
                print("  %-45s %d facets" % (repo, len(rec["facets"])))
        print("\n%d of %d models have no assessed block"
              % (sum(1 for r in models.values() if not r.get("assessed")), len(models)))
        return

    if args.check:
        current = open(args.out).read() if os.path.exists(args.out) else ""
        if current != text:
            sys.exit("!!! %s is out of date, run: make usecase" % args.out)
        print("%s is current (%d models)" % (args.out, len(models)))
        return

    with open(args.out, "w") as f:
        f.write(text)
    facets = sum(len(r["facets"]) for r in models.values())
    print("wrote %s: %d models, %d facets, %d assessed blocks kept"
          % (args.out, len(models), facets, kept))


if __name__ == "__main__":
    sys.exit(main() or 0)
