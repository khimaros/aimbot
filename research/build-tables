#!/usr/bin/env python3

"""Emit the MODELS.md comparison tables from the committed data.

Joins data/artificial-analysis.json (scores) against data/gguf-sizes.json (what
actually fits) and prints markdown to stdout. The numbers in MODELS.md are
generated by this rather than typed by hand, so a data refresh shows up as a
table diff instead of a stale claim.

    ./build-tables            # all tables
    ./build-tables --table fit
"""

import argparse
import json
import math
import os
import re
import statistics
import subprocess
import sys

GIB = 2 ** 30

# weight budget on a 128gb strix halo. the box has 119.2 gib; ~110 gib is the
# practical resident ceiling once the host and compute buffers are paid for, and
# what is left for weights depends entirely on the model's kv cache. 105 is the
# measured-behaviour default: deepseek v4 flash 0731 runs UD-IQ3_XXS (97.1) plus
# a 10.2 gib dspark drafter, i.e. 107.3 gib resident, and glm-4.5-air has been
# run at ~109 gib. use --budget to test the sensitivity of the ranking.
BUDGET_GIB = 105.0

# MODELS.md ranks a model at the quant that fits the budget above, and caps
# some of them below it: past Q8 the extra bytes buy nothing measurable and cost
# decode, so every dense model and small moe is pinned there. that is a POLICY --
# "what to run at 105 gib" is a choice this document makes, and the registry
# holds facts -- so it lives here, keyed by the registry's own `name.short`.
# everything else about the roster is derived: which models, from which repo,
# with which ids, comes from registry/models.yaml. it used to be a table here,
# and adding a model to the registry then left this document silently unaware
# of it.
PINS = {
    "qwen3.6 27b": "Q8_0",
    "qwen3.6 35b a3b": "Q8_0",
    "qwen3.8 27b": "Q8_0",
    "muse glimmer": "Q8_0",
    "gemma 4 31b": "UD-Q8_K_XL",
    "gemma 4 26b a4b": "Q8_0",
    "gpt-oss-120b": "UD-Q8_K_XL",
    "qwen3 coder next": "Q8_0",
    "nemotron 3.5 lightning": "Q8_0",
}


def default_repo(m):
    """Which repo a model is READ from -- the same rule the viewer applies.

    Where a model ships two builds the registry says which one can speculate:
    qwen3.6-27b's plain repo is marked `speculative: false` and only the -MTP-
    one carries the nextn head, and taking whichever was listed first sized the
    build that cannot draft.
    """
    repos = []
    for q in m.get("quants") or []:
        if q["repo"] not in repos:
            repos.append(q["repo"])
    if (m.get("speculative") or {}).get("type"):
        for r in repos:
            if any(q["repo"] == r and q.get("speculative") is not False
                   for q in m.get("quants") or []):
                return r
    return repos[0] if repos else None


def roster():
    """Every text model in the registry, with the repo and ids to read it by.

    Yields (short, repo, pin, aa_slug, model). A model with no gguf repo is
    skipped; everything else is filtered downstream, by whether a source
    measured it and by whether a quant of it fits.
    """
    out = []
    for repo, m in registry_models().items():
        if m.get("kind", "text") != "text":
            continue
        gguf = default_repo(m)
        if not gguf:
            continue
        short = (m.get("name") or {}).get("short") or repo.lower()
        out.append((short, gguf, PINS.get(short), (m.get("ids") or {}).get("aa"), m))
    return out


# a gscore over a handful of games is noise. hy3 has 24 matches against
# deepseek's 46372, so it is excluded rather than compared.
GBENCH_MIN_MATCHES = 1000

# lmarena board to read. style-controlled, so a model is not rewarded for
# formatting its answers prettily.
LMARENA_BOARD = "text-overall-style_control"

# Composite weights, set by what each source measures that the others do not.
# research/analyze-correlations --redundancy is the input; re-run it after any
# data refresh, because these numbers are a property of the current roster.
#
# The intelligence index is NOT a component: across the 160 AA models carrying
# all three, II ~ 0.403*coding + 0.418*agentic at R^2 0.9845, so adding it would
# count the same measurement twice for 1.5% of new information. Every other AA
# field is >=0.82 rank-correlated with the index, so artificial analysis is ONE
# axis of evidence here, not fourteen.
#
# What the redundancy check then found, and what these weights answer:
#
#   source        r2 vs AA coding+agentic    new info    coverage
#   gbench        0.961                      4%          11/20
#   lmarena       0.547                      45%         11/20
#   swe-rebench   0.476                      52%          7/20
#   sentiment     0.089                      91%         18/20
#
# GBENCH was on 0.35, the largest single weight, and is 96% predictable from AA.
# It keeps a premium over its 4% because HOW it measures is a real property --
# played rather than graded, so there is no public problem set to train against
# -- but it can no longer outvote everything it agrees with.
#
# lmarena and swe-rebench were excluded for missing 9 and 13 of the roster. That
# is still true and is why they enter at 0.10 rather than higher: the composite
# renormalizes over present components, so a low weight bounds how far absence
# can move a rank. They are in at all because they are the two sources that
# disagree with AA the most, which is the whole reason to carry a second source.
# `card` is the model's own claims about itself, and it carries the smallest
# weight in the composite by a factor of two. it is here for one case: a model
# too new for anyone to have measured. qwen3.8 27b landed with nine benchmark
# claims and nothing else, and scoring it purely on imputation said less than
# its own card does.
#
# claims are bias-corrected before use. analyze-self-report joins card claims to
# AA and epoch on (model, benchmark): across 70 matches the median claim runs
# +0.9 over the third-party number and 42 of 70 overstate, so CARD_BIAS is
# subtracted. the MEDIAN is used rather than the mean (+3.2) because a handful
# of benchmark-variant mismatches -- "HLE" published both with and without
# tools -- put a long tail on the distribution that is measurement noise
# rather than overstatement. the constant stays at a round 1.0: the measured
# median has moved between 0.9 and 1.0 across captures, and chasing it would
# re-scale every card column for a tenth of a point at weight 0.05.
# sentiment came down from 0.15 to 0.05, and the 0.10 went to AA. this one is
# judgment against the table above rather than from it: sentiment carries the
# most information nobody else has (91% new, 18/20 coverage), and it is also
# the least trustworthy measurement here -- a blunt polarity lexicon over forum
# sentences, where "x is better than y" scores positive for both. independence
# is a reason to carry it, not a reason to let it move a rank by a sixth. AA is
# the opposite trade: one axis of evidence, but measured on a fixed harness
# across every model it scores.
WEIGHTS = {"eff_coding": 0.30, "eff_agentic": 0.30,
           "gbench": 0.15, "lmarena": 0.10, "swerebench": 0.10,
           "sentiment": 0.05, "card": 0.05}
CARD_BIAS = 1.0

# the components that are somebody MEASURING the model. a model carrying none of
# them cannot be ranked: the composite imputes what is missing, so a row with
# only a sentiment count comes out at the set median wearing a model's name.
# `card` is the model measuring itself and `sentiment` is people talking, so
# neither qualifies on its own.
THIRD_PARTY = ("eff_coding", "eff_agentic", "gbench", "lmarena", "swerebench")

# retention vs bits-per-weight, fitted to unsloth's aider polyglot sweep of
# deepseek v3.1 (671b): bf16 71.6 -> 5bit 70.7 -> 4bit 69.7 -> 3bit 68.4 ->
# 2bit 65.8 -> 1bit 55.7, with size converted to bpw
CURVE = [(2.21, 0.778), (2.92, 0.919), (3.39, 0.955), (4.72, 0.974), (5.77, 0.987), (16.0, 1.0)]

# display names and the natively-low-bpw exemption both come from the registry:
# `name.short` is the one name for a model across this document, the lexicon and
# the source-id table, and `native_low_bpw` is a property of the weights rather
# than of this roster.
_REGISTRY = None


def registry_models():
    global _REGISTRY
    if _REGISTRY is None:
        import yaml
        here = os.path.dirname(os.path.abspath(__file__))
        doc = yaml.safe_load(open(os.path.join(here, "..", "registry",
                                               "models.yaml"))) or {}
        _REGISTRY = doc.get("models") or {}
    return _REGISTRY


def by_gguf_repo():
    """gguf repo -> its registry entry, which is how ROSTER joins to facts."""
    out = {}
    for repo, m in registry_models().items():
        for q in (m.get("quants") or []) + (m.get("components") or []):
            out.setdefault(q["repo"], m)
    return out



def retention(bpw):
    if bpw <= CURVE[0][0]:
        return CURVE[0][1]
    for (x0, y0), (x1, y1) in zip(CURVE, CURVE[1:]):
        if x0 <= bpw <= x1:
            return y0 + (y1 - y0) * (bpw - x0) / (x1 - x0)
    return 1.0


def optional(path):
    try:
        return json.load(open(path))
    except (IOError, ValueError):
        return {}


def source_ids():
    """canonical model name -> its id in each source, from match-models.

    Every source names models its own way and three scripts used to keep private
    copies of the mapping. Reading the one table means the composite and
    analyze-correlations cannot silently disagree about which model is which,
    which matters when the weights are set from the correlations.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    out = subprocess.run([os.path.join(here, "match-models"), "--sources"],
                         stdout=subprocess.PIPE, text=True, check=True).stdout
    return json.loads(out)["sources"]


def gbench_score(ids):
    """Agentic-coding gscore where measured, else the overall gscore.

    Returns None rather than 0 when a model is absent or thinly played -- a
    missing measurement must not read as a bad one.
    """
    gid = ids.get("gbench")
    if not gid:
        return None
    rows = {m["model_id"]: m for m in optional("data/gbench.json").get("rankings", [])}
    m = rows.get(gid)
    if not m or (m.get("total_matches") or 0) < GBENCH_MIN_MATCHES:
        return None
    ac = m.get("agentic_coding") or {}
    if ac.get("gscore") is not None and (ac.get("games_played") or 0) >= 5:
        return ac["gscore"]
    return m.get("gscore")


def lmarena_score(ids):
    """Style-controlled arena rating: the only number here from human preference."""
    mid = ids.get("lmarena")
    if not mid:
        return None
    board = (optional("data/lmarena.json").get("boards") or {}).get(LMARENA_BOARD) or {}
    for e in board.get("entries") or []:
        if e.get("modelDisplayName") == mid:
            return e.get("rating")
    return None


def swerebench_score(ids):
    """Mean resolved rate over task windows with a real sample.

    Worth its own component because swe-rebench rebuilds its task set from pull
    requests merged after the models shipped, so a score here is the one number
    in the composite that cannot have been trained against.
    """
    mid = ids.get("swerebench")
    if not mid:
        return None
    for m in (optional("data/swe-rebench.json").get("models") or {}).values():
        if m.get("name") != mid:
            continue
        vals = [w["resolvedRate"]
                for w in ((m.get("range_stats") or {}).get("all") or {}).values()
                if (w.get("passN") or 0) > 0]
        if vals:
            return sum(vals) / len(vals)
    return None


def card_repo(short):
    """Registry base repo for a roster short name. The roster keys on gguf
    repos and the cards key on base repos, so the registry's own short name is
    the join -- rather than a hand-typed table of the same thing.

    The two spellings do not always agree (the roster says `deepseek v4 flash
    0731`, the registry `deepseek v4 flash`), so an exact miss falls back to a
    UNIQUE containment match. Ambiguity returns nothing rather than a guess:
    scoring one model with another's card would be worse than no card at all.
    """
    want = re.sub(r"[^a-z0-9]", "", short.lower())
    reg = registry()
    hits = []
    for repo, m in reg.items():
        got = re.sub(r"[^a-z0-9]", "", ((m.get("name") or {}).get("short") or "").lower())
        if not got:
            continue
        if got == want:
            return repo
        if got in want or want in got:
            hits.append(repo)
    return hits[0] if len(hits) == 1 else ""


def registry():
    global _REGISTRY
    if _REGISTRY is None:
        import yaml
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                            "..", "registry", "models.yaml")
        try:
            _REGISTRY = (yaml.safe_load(open(path)) or {}).get("models") or {}
        except (IOError, ImportError):
            _REGISTRY = {}
    return _REGISTRY


_REGISTRY = None


def card_score(repo):
    """The model's own claims, bias-corrected and normalized across claimants.

    Benchmarks are on different scales, so each is min-maxed across every model
    that claims it and the model's average percentile is its score. A model
    claiming one easy benchmark therefore cannot outrank one claiming six hard
    ones by picking its ground -- it is ranked only against models that chose
    the same ground.
    """
    cards = optional("data/model-cards.json")
    claims = (cards.get(repo) or {}).get("claimed") or {}
    if not claims:
        return None
    spans = {}
    for other in cards.values():
        for bench, val in (other.get("claimed") or {}).items():
            lo, hi = spans.get(bench, (val, val))
            spans[bench] = (min(lo, val), max(hi, val))
    pcts = []
    for bench, val in claims.items():
        lo, hi = spans[bench]
        if hi <= lo:
            continue
        pcts.append(100.0 * (max(val - CARD_BIAS, lo) - lo) / (hi - lo))
    return sum(pcts) / len(pcts) if pcts else None


def sentiment_score(ids, name):
    """One number from reddit: how much it is discussed x how well received.

    Volume is log-scaled -- 176 mentions is not 35x the evidence of 5 -- and
    multiplied by reception (median percentile against same-depth comments in
    the same thread, recentred so 50 is neutral).
    """
    s = optional("data/sentiment.json").get(name)
    if not s or not s.get("mentions"):
        return None
    volume = math.log1p(s["mentions"])
    rel = (s.get("median_rel") if s.get("median_rel") is not None else 50) / 50.0
    return volume * rel


def model_facts():
    """Derived per-model facts: parameter counts, for a model AA has not scored."""
    d = optional("data/model-facts.json")
    return d.get("models") or {k: v for k, v in d.items() if not k.startswith("_")}


# a repo carries more than quants: vision projectors, drafter heads and imatrix
# files all sit beside the weights. a full filename is NOT excluded here, unlike
# in the viewer -- AngelSlim publishes hy3's mtp build as `Hy3-Q2_K_XL-mtp.gguf`
# and that build is the one this document sizes, so the ceiling below is what
# keeps a repo's stray bf16 upload out rather than its file extension.
NOT_A_QUANT = re.compile(r"^(mmproj|mtp|dspark|dflash|eagle3)|imatrix", re.I)

# past q8 the extra bytes buy nothing measurable and cost decode speed, so the
# fit stops there rather than handing a small model bf16 because it happened to
# fit. same ceiling the viewer opens on, in the same units.
CAP_BPW = 11.0


def quant_at(repo, sizes, pin, budget, params_b):
    """The quant this document ranks a model at: the pin, or the largest that fits.

    "Fits" is two limits, not one -- the memory budget and the q8 ceiling --
    and a pin is honoured only where it clears both, so a stale pin cannot put
    a model on a rung this document says nothing runs at.
    """
    real = {k: v for k, v in (sizes.get(repo) or {}).items()
            if not NOT_A_QUANT.search(k)}
    bpw = lambda b: b * 8 / (params_b * 1e9) if params_b else 0
    ok = {k: v for k, v in real.items()
          if v / GIB <= budget and bpw(v) <= CAP_BPW}
    if not ok:
        return None, None
    if pin and pin in ok:
        return pin, ok[pin] / GIB
    gib, quant = sorted((v / GIB, k) for k, v in ok.items())[-1]
    return quant, gib


def load(budget=BUDGET_GIB):
    """Every registry text model with a quant that fits, joined to its scores.

    A model no source has measured and whose shape nothing publishes cannot be
    placed at all, so it drops out here and `--table unscored` says so instead.
    """
    aa = json.load(open("data/artificial-analysis.json"))
    sizes = json.load(open("data/gguf-sizes.json"))
    facts = model_facts()
    srcs = source_ids()
    rows = []
    for short, repo, pin, aa_slug, m in roster():
        # a roster repo the sizes do not carry drops the model from every table
        # without a word, which is how canonicalising two gemma repo spellings
        # silently deleted two rows. say so instead
        if not sizes.get(repo):
            print("!!! %-32s no sizes for %s" % (short, repo), file=sys.stderr)
            continue
        d = aa.get(aa_slug) if aa_slug else None
        f = facts.get(next(iter(k for k, v in registry_models().items() if v is m))) or {}
        total = (d or {}).get("totalParameters") or f.get("params_total_b")
        # AA has not scored it, but the weights say what shape it is, so it can
        # still rank on whatever else measured it with the rest imputed
        if d is None:
            if not total:
                continue
            d = {"name": short, "slug": "", "totalParameters": total,
                 "activeParameters": f.get("params_active_b"),
                 "intelligenceIndex": None, "codingIndex": None,
                 "agenticIndex": None}
        quant, gib = quant_at(repo, sizes, pin, budget, total)
        if quant is None:
            continue
        bpw = gib * GIB * 8 / (total * 1e9)
        ret = 1.0 if m.get("native_low_bpw") else retention(bpw)
        ids = srcs.get(short, {})
        # an unmeasured component stays None so the composite imputes it; scoring
        # it 0 would read as "measured, and bad"
        scale = lambda v: v * ret if isinstance(v, (int, float)) else None
        row = dict(name=short, d=d, repo=repo, quant=quant,
                         gib=gib, bpw=bpw, ret=ret,
                         eff=scale(d.get("intelligenceIndex")),
                         eff_coding=scale(d.get("codingIndex")),
                         eff_agentic=scale(d.get("agenticIndex")),
                         gbench=gbench_score(ids), lmarena=lmarena_score(ids),
                         swerebench=swerebench_score(ids),
                   sentiment=sentiment_score(ids, short),
                   card=card_score(card_repo(short)), ids=ids)
        # nothing measured it on any weighted component, so a composite would be
        # the set median wearing a model's name. `--table unscored` says so
        # instead of ranking it
        if any(row[k] is not None for k in THIRD_PARTY):
            rows.append(row)
    return rows


def composite(rows, weights=None, missing="median"):
    """Min-max each component across the set, then take a weighted mean.

    How a missing component is handled decides more than the weights do, and the
    obvious choice is the wrong one. Dropping it and renormalizing looks neutral
    but is not: it redistributes the missing weight onto whatever the model DOES
    have, so a model measured by two sources has each counted harder than a model
    measured by six. That is how a source with partial coverage moves ranks on
    absence rather than on evidence, which is the objection that kept lmarena and
    swe-rebench out of the composite in the first place.

    `median` instead imputes the set median of that component, so a model with no
    arena rating is treated as typical on arena rather than as exempt from it.
    Coverage is still reported, because an imputed score is a weaker claim.
    `renormalize` keeps the old behaviour for comparison.
    """
    w = weights or WEIGHTS
    fields = list(WEIGHTS)
    span, mid = {}, {}
    for f in fields:
        vals = sorted(r[f] for r in rows if r.get(f) is not None)
        span[f] = (vals[0], vals[-1]) if vals else (0.0, 1.0)
        lo, hi = span[f]
        norms = [100.0 * (v - lo) / (hi - lo) if hi > lo else 50.0 for v in vals]
        mid[f] = statistics.median(norms) if norms else 50.0
    for r in rows:
        total = wsum = 0.0
        have = 0
        for f in fields:
            v = r.get(f)
            if v is None and missing == "renormalize":
                continue
            if v is None:
                norm = mid[f]
            else:
                lo, hi = span[f]
                norm = 100.0 * (v - lo) / (hi - lo) if hi > lo else 50.0
                have += 1
            total += w[f] * norm
            wsum += w[f]
        r["score"] = total / wsum if wsum else 0.0
        r["coverage"] = "%d/%d" % (have, len(fields))
    return rows


def quant_label(tag):
    """Publishers that ship loose files rather than per-quant dirs leak filenames."""
    tag = tag.rsplit("/", 1)[-1]
    if tag.endswith(".gguf"):
        tag = tag[:-len(".gguf")]
    for prefix in ("Hy3-", "DeepSeek-V4-Flash-0731-"):
        if tag.startswith(prefix):
            tag = tag[len(prefix):]
    return tag


def pct(v):
    return "-" if v in (None, "$undefined") else "%.1f" % (v * 100)


def num(v, n=1):
    return "-" if v in (None, "$undefined") else "%.*f" % (n, v)


def table_fit(rows):
    """Benchmark detail, ordered by composite score so it reads against the
    headline table row for row."""
    print("| model | coding | agentic | TB2.1 | tau-bank | gdpval | hallu |")
    print("|---|--:|--:|--:|--:|--:|--:|")
    for r in sorted(rows, key=lambda r: -r["score"]):
        d, ret = r["d"], r["ret"]
        # coding and agentic are scaled by the same retention factor as II. that
        # transfer is best justified for coding: the curve was fitted on aider
        # polyglot, a coding benchmark. the remaining columns are left raw --
        # adjusting them would be extrapolation.
        adj = lambda v: "-" if v in (None, "$undefined") else "%.1f" % (v * ret)
        print("| %s | %s | %s | %s | %s | %s | %s |" % (
            r["name"], adj(d.get("codingIndex")), adj(d.get("agenticIndex")),
            pct(d.get("terminalbenchV21")), pct(d.get("tauBanking")),
            pct(d.get("gdpvalNormalized")), num(d.get("omniscience"))))


def table_score(rows):
    """The composite: every independent signal, weighted, on one row."""
    print("| model | score | quant | size (gib) | eff coding | eff agentic "
          "| gbench | arena | swe-reb | sentiment | card | data | (eff II) |")
    print("|---|--:|---|--:|--:|--:|--:|--:|--:|--:|--:|--:|--:|")
    for r in sorted(rows, key=lambda r: -r["score"]):
        g = "-" if r["gbench"] is None else "%.3f" % r["gbench"]
        a = "-" if r["lmarena"] is None else "%.0f" % r["lmarena"]
        sw = "-" if r["swerebench"] is None else "%.1f" % r["swerebench"]
        se = "-" if r["sentiment"] is None else "%.1f" % r["sentiment"]
        cd = "-" if r["card"] is None else "%.0f" % r["card"]
        # eff II is shown for reference but excluded from the score: it is 98.4%
        # explained by the two columns to its left
        print("| %s | **%.1f** | %s | %.1f | %s | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            r["name"], r["score"], quant_label(r["quant"]), r["gib"],
            num(r["eff_coding"]), num(r["eff_agentic"]), g, a, sw, se, cd,
            r["coverage"], num(r["eff"])))


# the weightings the sensitivity table sweeps. hand-kept until a refresh turned
# its conclusion upside down -- it still said minimax took second under six of
# seven when the data said qwen3.6 27b took it under five.
SWEEPS = [
    ("default", {}),
    ("the old weights (gbench 0.35, no arena/swe-reb)",
     {"gbench": 0.35, "lmarena": 0.0, "swerebench": 0.0, "card": 0.0}),
    ("coding-focused (0.45)", {"eff_coding": 0.45}),
    ("agentic-focused (0.45)", {"eff_agentic": 0.45}),
    ("swe-rebench-heavy (0.25)", {"swerebench": 0.25}),
    ("arena-heavy (0.25)", {"lmarena": 0.25}),
    ("sentiment dropped", {"sentiment": 0.0}),
]


def table_weights(_rows, budget=BUDGET_GIB, missing="median"):
    """Top four under each weighting, so the ranking's stability is checkable."""
    base = load(budget)
    print("| weighting | top four |")
    print("|---|---|")
    for label, over in SWEEPS:
        w = dict(WEIGHTS)
        w.update(over)
        top = [r["name"] for r in sorted(composite(base, w, missing),
                                         key=lambda r: -r["score"])[:4]]
        top[1] = "**%s**" % top[1]
        print("| %s | %s |" % (label, " > ".join(top)))


def table_arena(rows):
    """Human preference, beside the composite rank so coverage is visible.

    Hand-kept until a refresh left its rank column describing a ranking three
    models old. The elo and vote counts were current and the ranks beside them
    were not, which is the worst version of a stale table -- it looks checked.
    """
    lm = optional("data/lmarena.json").get("boards") or {}
    web = lm.get("webdev-overall-raw") or {}
    text = lm.get(LMARENA_BOARD) or {}
    def find(board, mid):
        for e in board.get("entries") or []:
            if e.get("modelDisplayName") == mid:
                return e
        return {}
    print("| model | composite rank | text elo | votes | webdev elo |")
    print("|---|--:|--:|--:|--:|")
    for i, r in enumerate(sorted(rows, key=lambda r: -r["score"]), 1):
        mid = (r["ids"] or {}).get("lmarena")
        t, w = (find(text, mid), find(web, mid)) if mid else ({}, {})
        print("| %s | %d | %s | %s | %s |" % (
            r["name"], i, num(t.get("rating"), 0),
            "{:,}".format(t["votes"]) if t.get("votes") else "-",
            num(w.get("rating"), 0)))


def table_effective(rows):
    """The decision table: what each model is worth *at the quant that fits*.

    This is the headline ranking. Sorting by raw intelligence index instead
    would imply quantization is free, which is the thing this document exists
    to disprove.
    """
    print("| model | total / active | quant | size (gib) | bpw | AA II | retention "
          "| effective II |")
    print("|---|---|---|--:|--:|--:|--:|--:|")
    # a model AA has not scored has no effective II to sort on and sinks to the
    # bottom rather than being dropped: its size and retention are still facts
    for r in sorted(rows, key=lambda r: (r["eff"] is not None, r["eff"] or 0), reverse=True):
        d = r["d"]
        shape = "%gb / %s" % (d["totalParameters"],
                              "%gb" % d["activeParameters"]
                              if d.get("activeParameters") else "?")
        print("| %s | %s | %s | %.1f | %.2f | %s | %.3f | **%s** |" % (
            r["name"], shape, quant_label(r["quant"]), r["gib"], r["bpw"],
            num(d["intelligenceIndex"]), r["ret"], num(r["eff"])))


# t/s measured on a 128gb strix halo, for calibration against the estimate
MEASURED = {"gpt-oss-120b": "55", "qwen3.6 27b": "7.4"}


def hub_popularity():
    """repo -> its hub listing row, for downloads and likes."""
    cat = optional("data/hf-catalog.json")
    pop = {r["id"]: r for r in (cat.get("trending") or [])}
    for rows_ in (cat.get("authors") or {}).values():
        for r in rows_:
            pop.setdefault(r["id"], r)
    return pop


def unranked(budget=BUDGET_GIB):
    """(short, repo, quant, gib, facts, model) for every roster model not ranked.

    Two reasons a model is here and they are different questions, so the caller
    splits them: nothing measured it, or nothing that fits measures it.
    """
    sizes = json.load(open("data/gguf-sizes.json"))
    facts = model_facts()
    ranked = {r["name"] for r in load(budget)}
    out = []
    for short, repo, pin, aa_slug, m in roster():
        if short in ranked:
            continue
        f = facts.get(next(iter(k for k, v in registry_models().items() if v is m))) or {}
        # the registry's own pin, not this document's budget rule: a model that
        # does not fit is being SIZED here rather than ranked, and the size to
        # report is the one the registry recommends
        rp = next((q["quant"] for q in m.get("quants") or [] if q["repo"] == repo), None)
        b = (sizes.get(repo) or {}).get(rp or "")
        if b is None:
            quant, gib = quant_at(repo, sizes, pin, budget, f.get("params_total_b"))
        else:
            quant, gib = rp, b / GIB
        out.append((short, repo, quant, gib, f, m))
    return out


def size_row(short, repo, quant, gib, f, m, pop):
    p = pop.get(repo) or {}
    note = (m.get("quants") or [{}])[0].get("note") or m.get("notes") or ""
    return "| %s | %s | %s | %s / %s | %s | %s | %s |" % (
        short, quant_label(quant) if quant else "-",
        "%.1f" % gib if gib else "?",
        "%gb" % f["params_total_b"] if f.get("params_total_b") else "?",
        "%gb" % f["params_active_b"] if f.get("params_active_b") else "?",
        format(p.get("downloads") or 0, ",") if p else "-",
        p.get("likes") if p else "-",
        note.replace("\n", " ").strip())


def table_unscored(_rows, budget=BUDGET_GIB):
    """What can be said about a model no benchmark suite has measured.

    Deliberately not a ranking and deliberately not merged into the composite:
    every column here is either a file fact or a popularity count, and neither
    predicts whether the model is any good. It exists because the alternative
    -- leaving them out -- silently implies the roster is exhaustive when two
    of these are running on the target machine right now.
    """
    pop = hub_popularity()
    print("| model | quant | size (gib) | total / active | downloads | likes | note |")
    print("|---|---|--:|---|--:|--:|---|")
    for short, repo, quant, gib, f, m in unranked(budget):
        if gib and gib > budget:
            continue
        print(size_row(short, repo, quant, gib, f, m, pop))


def table_oversize(_rows, budget=BUDGET_GIB):
    """The models this box cannot hold, sized so the gap is a number.

    They are carried because they are what the runnable models are being
    compared against: dropping them would leave the roster looking like the
    whole of open weights rather than the part of it that fits.
    """
    pop = hub_popularity()
    print("| model | smallest quant | size (gib) | total / active | downloads | likes | note |")
    print("|---|---|--:|---|--:|--:|---|")
    rows = [r for r in unranked(budget) if r[3] and r[3] > budget]
    for short, repo, quant, gib, f, m in sorted(rows, key=lambda r: r[3]):
        print(size_row(short, repo, quant, gib, f, m, pop))


def table_speed(rows, eff_bw=160e9):
    """Decode is bandwidth bound: bytes/token ~ active_params * bpw / 8."""
    print("| model | active | bpw | gb/token | est. t/s | measured |")
    print("|---|--:|--:|--:|--:|---|")
    out = []
    for r in rows:
        # no published active count, so there is nothing to divide the bandwidth
        # by. a guess here would read like a measurement, so the row is absent
        active = r["d"].get("activeParameters")
        if not active:
            continue
        b = active * 1e9 * r["bpw"] / 8
        out.append((eff_bw / b, r, b))
    for ts, r, b in sorted(out, reverse=True):
        d = r["d"]
        # dense models read every weight per token; worth marking, it is why they
        # sit at the bottom of this table despite topping the intelligence one
        dense = " (dense)" if d["totalParameters"] == d["activeParameters"] else ""
        print("| %s%s | %gb | %.2f | %.2f | %.0f | %s |" % (
            r["name"], dense, d["activeParameters"], r["bpw"], b / 1e9, ts,
            MEASURED.get(r["name"], "")))


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--table",
                    choices=["score", "fit", "effective", "arena", "weights",
                             "speed", "unscored", "oversize", "all"],
                    default="all")
    ap.add_argument("--budget", type=float, default=BUDGET_GIB,
                    help="gib available for weights (default %(default)s)")
    ap.add_argument("--missing", choices=["median", "renormalize"], default="median",
                    help="how to handle a component a model has no measurement for")
    ap.add_argument("--weights", metavar="K=V,...",
                    help="override composite weights, e.g. gbench=0.45,sentiment=0")
    args = ap.parse_args()
    w = dict(WEIGHTS)
    if args.weights:
        for pair in args.weights.split(","):
            k, _, v = pair.partition("=")
            if k.strip() not in w:
                raise SystemExit("unknown weight %r; known: %s" % (k, ", ".join(w)))
            w[k.strip()] = float(v)
    rows = composite(load(args.budget), w, args.missing)
    for name, fn in [("score", table_score), ("fit", table_fit),
                     ("effective", table_effective), ("arena", table_arena),
                     ("weights", table_weights), ("speed", table_speed),
                     ("unscored", table_unscored), ("oversize", table_oversize)]:
        if args.table in (name, "all"):
            if args.table == "all":
                print("\n## %s\n" % name)
            fn(rows)


if __name__ == "__main__":
    main()
