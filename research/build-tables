#!/usr/bin/env python3

"""Emit the MODELS.md tables that are about FILES rather than about rank.

Joins data/gguf-sizes.json against the registry and the forum captures, and
prints markdown to stdout: what a rung costs, what it decodes at, what nothing
has scored, what does not fit at all, and how often each model comes up.

The ranking is NOT here. This file used to carry a second composite -- its own
weights, its own normalization, its own memory budget -- and it answered
differently from `docs/index.html`, which README calls canonical and which every
ranked block in MODELS.md is generated from. Two implementations of one
composite is the drift this repository exists to remove, so the ranking, the
weighting sensitivity, the arena table and the effective-intelligence table all
come from `research/dashboard-table`, which runs the page. What is left here is
the half the page does not answer.

    ./build-tables            # all of them
    ./build-tables --table speed
"""

import argparse
import json
import math
import os
import re
import statistics
import subprocess
import sys

import rungs

GIB = 2 ** 30


AIMBOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "scripts", "aimbot")


def dashboard_picks(ram=None):
    """({registry key: rung}, hardware) -- the dashboard's best quant for each model.

    The page fits every rung each repo publishes against the hardware and takes
    the one it predicts is best, and this document reads that pick rather than
    choosing a rung a second way: a hand-kept table of per-model picks here once
    disagreed with the page it was meant to describe. Where nothing fits, the
    rung is the smallest published and `fits` is false. `ram` is `--budget`,
    for sensitivity; unset, the page's own default box; 0, no budget at all.
    """
    cmd = [AIMBOT, "--all", "--json"] + (["--ram", str(ram), "--reserve", "0"]
                                         if ram is not None else [])
    d = json.loads(subprocess.run(cmd, stdout=subprocess.PIPE, text=True, check=True).stdout)
    return {r["repo"]: r["rung"] for r in d["rows"] if r.get("rung")}, d["hardware"]


def held_by(rung):
    """What keeps a rung from fitting, or None where it fits.

    One sentence: the box cannot hold the weights and the cache at the context
    the view asks for. A window shorter than the view is not a second one --
    the page charges a model for the window it has.
    """
    return None if rung.get("fits") else "memory"


def default_repo(m):
    """Which repo a model is READ from -- the same rule the viewer applies.

    Where a model ships two builds the registry says which one can speculate:
    qwen3.6-27b's plain repo is marked `speculative: false` and only the -MTP-
    one carries the nextn head, and taking whichever was listed first sized the
    build that cannot draft.
    """
    repos = rungs.repos(m)
    if (m.get("speculative") or {}).get("type"):
        for r in repos:
            if r.get("speculative") is not False:
                return r["repo"]
    return repos[0]["repo"] if repos else None


def roster():
    """Every text model in the registry, with the repo and ids to read it by.

    Yields (short, key, repo, aa_slug, model). A model with no gguf repo is
    skipped; everything else is filtered downstream, by whether a source
    measured it and by whether a quant of it fits.
    """
    out = []
    for key, m in registry_models().items():
        if m.get("kind", "text") != "text":
            continue
        gguf = default_repo(m)
        if not gguf:
            continue
        short = (m.get("name") or {}).get("short") or key.lower()
        out.append((short, key, gguf, (m.get("ids") or {}).get("aa"), m))
    return out


# a gscore over a handful of games is noise. hy3 has 24 matches against
# deepseek's 46372, so it is excluded rather than compared.
GBENCH_MIN_MATCHES = 1000

# lmarena board to read. style-controlled, so a model is not rewarded for
# formatting its answers prettily.
LMARENA_BOARD = "text-overall-style_control"

# what a vendor's claim about its own model is discounted by before anything
# uses it. analyze-self-report joins card claims to AA and epoch on (model,
# benchmark): across 70 matches the median claim runs +0.9 over the third-party
# number and 42 of 70 overstate. the MEDIAN rather than the mean (+3.2), because
# a handful of benchmark-variant mismatches -- "HLE" is published both with and
# without tools -- put a long tail on the distribution that is measurement noise
# rather than overstatement. it stays at a round 1.0: the measured median has sat
# between 0.9 and 1.0 across captures and chasing it would re-scale every card
# column for a tenth of a point. research/analyze-usecase reads this.
CARD_BIAS = 1.0

# the components that are somebody MEASURING the model, as against the model
# measuring itself or people talking about it. a row carrying none of them is
# not a measured model, which is what separates the sized-but-unranked tables
# below from the ranking the page computes.
THIRD_PARTY = ("eff_scicode", "eff_terminalbench", "gbench", "lmarena", "swerebench")

# retention vs bits-per-weight, fitted to unsloth's aider polyglot sweep of
# deepseek v3.1 (671b): bf16 71.6 -> 5bit 70.7 -> 4bit 69.7 -> 3bit 68.4 ->
# 2bit 65.8 -> 1bit 55.7, with size converted to bpw
CURVE = [(2.21, 0.778), (2.92, 0.919), (3.39, 0.955), (4.72, 0.974), (5.77, 0.987), (16.0, 1.0)]

# display names and the natively-low-bpw exemption both come from the registry:
# `name.short` is the one name for a model across this document, the lexicon and
# the source-id table, and `native_low_bpw` is a property of the weights rather
# than of this roster.
_REGISTRY = None


def registry_models():
    global _REGISTRY
    if _REGISTRY is None:
        import yaml
        here = os.path.dirname(os.path.abspath(__file__))
        doc = yaml.safe_load(open(os.path.join(here, "..", "registry",
                                               "models.yaml"))) or {}
        _REGISTRY = doc.get("models") or {}
    return _REGISTRY


def by_gguf_repo():
    """gguf repo -> its registry entry, which is how ROSTER joins to facts."""
    out = {}
    for repo, m in registry_models().items():
        for r in rungs.weight_repos(m):
            out.setdefault(r, m)
    return out



def retention(bpw):
    if bpw <= CURVE[0][0]:
        return CURVE[0][1]
    for (x0, y0), (x1, y1) in zip(CURVE, CURVE[1:]):
        if x0 <= bpw <= x1:
            return y0 + (y1 - y0) * (bpw - x0) / (x1 - x0)
    return 1.0


def optional(path):
    try:
        return json.load(open(path))
    except (IOError, ValueError):
        return {}


def source_ids():
    """canonical model name -> its id in each source, from match-models.

    Every source names models its own way and three scripts used to keep private
    copies of the mapping. Reading the one table means the composite and
    analyze-correlations cannot silently disagree about which model is which,
    which matters when the weights are set from the correlations.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    out = subprocess.run([os.path.join(here, "match-models"), "--sources"],
                         stdout=subprocess.PIPE, text=True, check=True).stdout
    return json.loads(out)["sources"]


def gbench_score(ids):
    """Agentic-coding gscore where measured, else the overall gscore.

    Returns None rather than 0 when a model is absent or thinly played -- a
    missing measurement must not read as a bad one.
    """
    gid = ids.get("gbench")
    if not gid:
        return None
    rows = {m["model_id"]: m for m in optional("data/gbench.json").get("rankings", [])}
    m = rows.get(gid)
    if not m or (m.get("total_matches") or 0) < GBENCH_MIN_MATCHES:
        return None
    ac = m.get("agentic_coding") or {}
    if ac.get("gscore") is not None and (ac.get("games_played") or 0) >= 5:
        return ac["gscore"]
    return m.get("gscore")


def lmarena_score(ids):
    """Style-controlled arena rating: the only number here from human preference."""
    mid = ids.get("lmarena")
    if not mid:
        return None
    board = (optional("data/lmarena.json").get("boards") or {}).get(LMARENA_BOARD) or {}
    for e in board.get("entries") or []:
        if e.get("modelDisplayName") == mid:
            return e.get("rating")
    return None


def swerebench_score(ids):
    """Mean resolved rate over task windows with a real sample.

    Worth its own component because swe-rebench rebuilds its task set from pull
    requests merged after the models shipped, so a score here is the one number
    in the composite that cannot have been trained against.
    """
    mid = ids.get("swerebench")
    if not mid:
        return None
    for m in (optional("data/swe-rebench.json").get("models") or {}).values():
        if m.get("name") != mid:
            continue
        vals = [w["resolvedRate"]
                for w in ((m.get("range_stats") or {}).get("all") or {}).values()
                if (w.get("passN") or 0) > 0]
        if vals:
            return sum(vals) / len(vals)
    return None


def card_repo(short):
    """Registry base repo for a roster short name. The roster keys on gguf
    repos and the cards key on base repos, so the registry's own short name is
    the join -- rather than a hand-typed table of the same thing.

    The two spellings do not always agree (the roster says `deepseek v4 flash
    0731`, the registry `deepseek v4 flash`), so an exact miss falls back to a
    UNIQUE containment match. Ambiguity returns nothing rather than a guess:
    scoring one model with another's card would be worse than no card at all.
    """
    want = re.sub(r"[^a-z0-9]", "", short.lower())
    reg = registry()
    hits = []
    for repo, m in reg.items():
        got = re.sub(r"[^a-z0-9]", "", ((m.get("name") or {}).get("short") or "").lower())
        if not got:
            continue
        if got == want:
            return repo
        if got in want or want in got:
            hits.append(repo)
    return hits[0] if len(hits) == 1 else ""


def registry():
    global _REGISTRY
    if _REGISTRY is None:
        import yaml
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                            "..", "registry", "models.yaml")
        try:
            _REGISTRY = (yaml.safe_load(open(path)) or {}).get("models") or {}
        except (IOError, ImportError):
            _REGISTRY = {}
    return _REGISTRY


_REGISTRY = None


def card_score(repo):
    """The model's own claims, bias-corrected and normalized across claimants.

    Benchmarks are on different scales, so each is min-maxed across every model
    that claims it and the model's average percentile is its score. A model
    claiming one easy benchmark therefore cannot outrank one claiming six hard
    ones by picking its ground -- it is ranked only against models that chose
    the same ground.
    """
    cards = optional("data/model-cards.json")
    claims = (cards.get(repo) or {}).get("claimed") or {}
    if not claims:
        return None
    spans = {}
    for other in cards.values():
        for bench, val in (other.get("claimed") or {}).items():
            lo, hi = spans.get(bench, (val, val))
            spans[bench] = (min(lo, val), max(hi, val))
    pcts = []
    for bench, val in claims.items():
        lo, hi = spans[bench]
        if hi <= lo:
            continue
        pcts.append(100.0 * (max(val - CARD_BIAS, lo) - lo) / (hi - lo))
    return sum(pcts) / len(pcts) if pcts else None


def sentiment_score(ids, name):
    """One number from reddit: how much it is discussed x how well received.

    Volume is log-scaled -- 176 mentions is not 35x the evidence of 5 -- and
    multiplied by reception (median percentile against same-depth comments in
    the same thread, recentred so 50 is neutral).
    """
    s = optional("data/sentiment.json").get(name)
    if not s or not s.get("mentions"):
        return None
    volume = math.log1p(s["mentions"])
    rel = (s.get("median_rel") if s.get("median_rel") is not None else 50) / 50.0
    return volume * rel


def model_facts():
    """Derived per-model facts: parameter counts, for a model AA has not scored."""
    d = optional("data/model-facts.json")
    return d.get("models") or {k: v for k, v in d.items() if not k.startswith("_")}




def load(budget=None, picks=None):
    """Every registry text model with a quant that fits, joined to its scores.

    A model no source has measured and whose shape nothing publishes cannot be
    placed at all, so it drops out here and `--table unscored` says so instead.
    """
    aa = json.load(open("data/artificial-analysis.json"))
    sizes = json.load(open("data/gguf-sizes.json"))
    facts = model_facts()
    srcs = source_ids()
    picks = dashboard_picks(budget)[0] if picks is None else picks
    rows = []
    for short, key, repo, aa_slug, m in roster():
        # a roster repo the sizes do not carry drops the model from every table
        # without a word, which is how canonicalising two gemma repo spellings
        # silently deleted two rows. say so instead
        if not sizes.get(repo):
            print("!!! %-32s no sizes for %s" % (short, repo), file=sys.stderr)
            continue
        rung = picks.get(key) or {}
        if not rung.get("fits"):
            continue
        d = aa.get(aa_slug) if aa_slug else None
        f = facts.get(key) or {}
        total = (d or {}).get("totalParameters") or f.get("params_total_b")
        # AA has not scored it, but the weights say what shape it is, so it can
        # still rank on whatever else measured it with the rest imputed
        if d is None:
            if not total:
                continue
            d = {"name": short, "slug": "", "totalParameters": total,
                 "activeParameters": f.get("params_active_b"),
                 "intelligenceIndex": None, "scicode": None,
                 "terminalbenchV21": None}
        repo, quant, gib = rung["repo"], rung["quant"], rung["gib"]
        bpw = gib * GIB * 8 / (total * 1e9)
        ret = 1.0 if m.get("native_low_bpw") else retention(bpw)
        ids = srcs.get(short, {})
        # an unmeasured component stays None so the composite imputes it; scoring
        # it 0 would read as "measured, and bad"
        scale = lambda v: v * ret if isinstance(v, (int, float)) else None
        row = dict(name=short, d=d, repo=repo, quant=quant,
                         gib=gib, bpw=bpw, ret=ret,
                         eff=scale(d.get("intelligenceIndex")),
                         eff_scicode=scale(d.get("scicode")),
                         eff_terminalbench=scale(d.get("terminalbenchV21")),
                         gbench=gbench_score(ids), lmarena=lmarena_score(ids),
                         swerebench=swerebench_score(ids),
                   sentiment=sentiment_score(ids, short),
                   card=card_score(card_repo(short)), ids=ids)
        # nothing measured it on any weighted component, so a composite would be
        # the set median wearing a model's name. `--table unscored` says so
        # instead of ranking it
        if any(row[k] is not None for k in THIRD_PARTY):
            rows.append(row)
    return rows

def quant_label(tag):
    """Publishers that ship loose files rather than per-quant dirs leak filenames."""
    tag = tag.rsplit("/", 1)[-1]
    if tag.endswith(".gguf"):
        tag = tag[:-len(".gguf")]
    for prefix in ("Hy3-", "DeepSeek-V4-Flash-0731-"):
        if tag.startswith(prefix):
            tag = tag[len(prefix):]
    return tag

def num(v, n=1):
    return "-" if v in (None, "$undefined") else "%.*f" % (n, v)

MEASURED = {"gpt-oss-120b": "55", "qwen3.6 27b": "7.4"}


def hub_popularity(cat=None, cards=None):
    """repo -> its hub row, for downloads and likes.

    Two captures answer this and they do not agree. `hf-catalog.json` is a
    LISTING, built to find repos the roster does not carry, and its count for a
    new repo lags behind: it had prism's bonsai 2 27b at 0 downloads with the
    likes right, two days after a release that had 405,609. `model-cards.json`
    holds a row fetched per repo for every key the registry names, and that one
    was current.

    So the per-repo row wins where there is one, and the listing stays the
    fallback -- it is the only capture with anything to say about a repo the
    registry has never heard of, which is the whole point of collecting it.
    """
    cat = optional("data/hf-catalog.json") if cat is None else cat
    cards = optional("data/model-cards.json") if cards is None else cards
    pop = {}
    for repo, card in (cards or {}).items():
        if isinstance(card, dict) and card.get("hub"):
            pop[repo] = card["hub"]
    for r in (cat.get("trending") or []):
        pop.setdefault(r["id"], r)
    for rows_ in (cat.get("authors") or {}).values():
        for r in rows_:
            pop.setdefault(r["id"], r)
    return pop


def unranked(budget=None):
    """(short, repo, quant, gib, held, facts, model) for every roster model not ranked.

    `held` is None where a rung fits, else "memory".

    Two reasons a model is here and they are different questions, so the caller
    splits them: nothing measured it, or nothing that fits measures it. The rung
    is the dashboard's -- its pick where one fits, its smallest where memory
    holds it back.
    """
    facts = model_facts()
    picks, _ = dashboard_picks(budget)
    ranked = {r["name"] for r in load(budget, picks)}
    out = []
    for short, key, repo, aa_slug, m in roster():
        if short in ranked:
            continue
        rung, f = picks.get(key) or {}, facts.get(key) or {}
        out.append((short, rung.get("repo") or repo, rung.get("quant"), rung.get("gib"),
                    held_by(rung), f, m))
    return out


def size_row(short, repo, quant, gib, f, m, pop):
    import notes as note_refs
    p = pop.get(repo) or {}
    # the note written about THIS rung, where there is one, and the model's own
    # otherwise
    hit = rungs.facts_for(m, quant, repo) if quant else None
    note = ((hit or (None, None, {}))[2].get("note")) or m.get("notes") or ""
    # the references in a note become figures here rather than being stored
    # rendered, so this column cannot print a size the repo stopped having
    note = note_refs.render(note, repo, [k for k in ((hit or (0, None))[1], quant) if k],
                            note_refs.load(), model=repo)[0]
    label = quant_label(quant) if quant else "-"
    return "| %s | %s | %s | %s / %s | %s | %s | %s |" % (
        short, label, "%.1f" % gib if gib else "?",
        "%gb" % f["params_total_b"] if f.get("params_total_b") else "?",
        "%gb" % f["params_active_b"] if f.get("params_active_b") else "?",
        format(p.get("downloads") or 0, ",") if p else "-",
        p.get("likes") if p else "-",
        note.replace("\n", " ").strip())


def table_unscored(_rows, budget=None):
    """What can be said about a model no benchmark suite has measured.

    Deliberately not a ranking and deliberately not merged into the composite:
    every column here is either a file fact or a popularity count, and neither
    predicts whether the model is any good. It exists because the alternative
    -- leaving them out -- silently implies the roster is exhaustive when two
    of these are running on the target machine right now.
    """
    pop = hub_popularity()
    print("| model | quant | size (gib) | total / active | downloads | likes | note |")
    print("|---|---|--:|---|--:|--:|---|")
    for short, repo, quant, gib, held, f, m in unranked(budget):
        if held == "memory":
            continue
        print(size_row(short, repo, quant, gib, f, m, pop))


def table_oversize(_rows, budget=None):
    """The models this box cannot hold, sized so the gap is a number.

    They are carried because they are what the runnable models are being
    compared against: dropping them would leave the roster looking like the
    whole of open weights rather than the part of it that fits.
    """
    pop = hub_popularity()
    print("| model | smallest quant | size (gib) | total / active | downloads | likes | note |")
    print("|---|---|--:|---|--:|--:|---|")
    rows = [r for r in unranked(budget) if r[4] == "memory"]
    for short, repo, quant, gib, held, f, m in sorted(rows, key=lambda r: r[3]):
        print(size_row(short, repo, quant, gib, f, m, pop))


# the three tasks the forum table breaks out, of the sixteen the matcher keys.
# they are the ones this document is about; the rest are in data/sentiment.json
FORUM_TASKS = ("agentic", "planning", "long context")
FORUM_FLOOR = 20


def table_forum(_rows, budget=None):
    """How often each model comes up on r/LocalLLaMA, and how it lands.

    This was typed by hand for four captures, which is how it came to show
    qwen3.6 27b leading on 311 mentions against a capture reading 198, with the
    model that actually leads listed third. `median rel` is a percentile against
    comments at the same reply depth in the same thread, because a raw upvote
    count is not comparable across threads.
    """
    sentiment = optional("data/sentiment.json")
    rows = []
    for short, blk in sentiment.items():
        got = ((blk.get("by_source") or {}).get("reddit-localllama")) or {}
        if (got.get("mentions") or 0) < FORUM_FLOOR:
            continue
        rows.append((got["mentions"], short, got))
    print("| model | mentions | top-level | median rel | %s |"
          % " | ".join(FORUM_TASKS))
    print("|---|--:|--:|--:|%s" % ("--:|" * len(FORUM_TASKS)))
    for mentions, short, got in sorted(rows, key=lambda r: (-r[0], r[1])):
        tasks = got.get("tasks") or {}
        cells = ["%s" % (tasks[t]["n"] if t in tasks else "")
                 for t in FORUM_TASKS]
        median = got.get("median_rel")
        print("| %s | %d | %s | %s | %s |"
              % (short, mentions, got.get("top_level", ""),
                 "" if median is None else round(median), " | ".join(cells)))


def table_speed(rows, eff_bw=160e9):
    """Decode is bandwidth bound: bytes/token ~ active_params * bpw / 8."""
    print("| model | active | bpw | gb/token | est. t/s | measured |")
    print("|---|--:|--:|--:|--:|---|")
    out = []
    for r in rows:
        # no published active count, so there is nothing to divide the bandwidth
        # by. a guess here would read like a measurement, so the row is absent
        active = r["d"].get("activeParameters")
        if not active:
            continue
        b = active * 1e9 * r["bpw"] / 8
        out.append((eff_bw / b, r, b))
    for ts, r, b in sorted(out, reverse=True):
        d = r["d"]
        # dense models read every weight per token; worth marking, it is why they
        # sit at the bottom of this table despite topping the intelligence one
        dense = " (dense)" if d["totalParameters"] == d["activeParameters"] else ""
        print("| %s%s | %gb | %.2f | %.2f | %.0f | %s |" % (
            r["name"], dense, d["activeParameters"], r["bpw"], b / 1e9, ts,
            MEASURED.get(r["name"], "")))


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--table",
                    choices=["speed", "unscored", "oversize", "forum", "all"],
                    default="all")
    ap.add_argument("--budget", type=float,
                    help="gib of memory to fit in, for sensitivity; unset, the "
                         "dashboard's own default box")
    args = ap.parse_args()
    rows = load(args.budget)
    for name, fn in [("speed", table_speed), ("unscored", table_unscored),
                     ("oversize", table_oversize), ("forum", table_forum)]:
        if args.table in (name, "all"):
            if args.table == "all":
                print("\n## %s\n" % name)
            fn(rows)


if __name__ == "__main__":
    main()
