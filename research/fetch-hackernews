#!/usr/bin/env python3

"""Fetch hacker news stories and comments into data/hackernews.json.

Queries are the REGISTRY plus a handful of themes: one search per model, from
the name a person would type, so a model added to the roster is asked about on
the next sweep instead of waiting for somebody to think of it. Nine hand-written
queries used to be the whole corpus, which meant the speech and image halves --
and every text model nobody had written a query for -- were scored on whatever
prose the other nine happened to drag in.

Unlike reddit, hn needs no browser: the algolia search api is open and returns
comment bodies directly. Stories are matched per query, then the top comments
of each matching story are pulled by story id.

That is one request per query plus one per story, so fetches go through
./httpcache and reuse anything younger than --max-age. Algolia sends no etag,
so the revalidation path never fires and only the age check saves the request.
"""

import argparse
import html
import json
import os
import re
import subprocess
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import capture  # noqa: E402  the do-not-shrink guard
import roster  # noqa: E402  the model names to search for

import urllib.parse

HERE = os.path.dirname(os.path.abspath(__file__))
API = "https://hn.algolia.com/api/v1/search?%s"

# the queries no model name covers: a box, a practice, a size class. these are
# about the CONVERSATION rather than about one checkpoint, which is why they
# stay hand-written while the model queries are derived.
THEMES = [
    "Qwen 3.6", "GLM 5.2", "Kimi K3", "MiniMax", "DeepSeek V4",
    "gpt-oss", "Strix Halo", "benchmaxxing", "local LLM 128GB",
]

# `model_queries` lives in roster.py: four collectors search a forum for the
# roster and each one used to keep its own list of who is on it.


def api(cache, refresh, max_age, **params):
    url = API % urllib.parse.urlencode(params)
    cmd = [os.path.join(HERE, "httpcache"), url, "--key", "hn-" + cache,
           "--max-age", str(max_age)]
    if refresh:
        cmd.append("--refresh")
    try:
        return json.loads(subprocess.run(cmd, stdout=subprocess.PIPE, text=True).stdout)
    except ValueError:
        return {}


def clean(s):
    return re.sub(r"\s+", " ", html.unescape(re.sub("<[^>]+>", "", s or ""))).strip()


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--stories", type=int, default=6,
                    help="stories per THEME query")
    ap.add_argument("--model-stories", type=int, default=3,
                    help="stories per registry-model query, which there are two "
                         "orders more of")
    ap.add_argument("--models", action=argparse.BooleanOptionalAction, default=True,
                    help="also query for every model in the registry")
    ap.add_argument("--registry", default=roster.REGISTRY)
    ap.add_argument("--comments", type=int, default=12)
    ap.add_argument("--out", default="data/hackernews.json")
    ap.add_argument("--max-age", type=int, default=6 * 3600, metavar="SECONDS",
                    help="reuse a cached response younger than this (default 6h)")
    ap.add_argument("--refresh", action="store_true", help="ignore the cache, refetch")
    ap.add_argument("--allow-shrink", action="store_true",
                    help="write even when the result holds fewer records "
                         "than the capture on disk")
    args = ap.parse_args()

    def get(cache, **params):
        return api(cache, args.refresh, args.max_age, **params)

    queries = [(q, args.stories) for q in THEMES]
    if args.models:
        queries += [(q, args.model_stories) for q in roster.model_queries(args.registry)]

    # ONE STORY, ONE PLACE. the same thread answers several queries once the
    # roster is asking -- three qwen entries and a `Qwen 3.6` theme all match the
    # same launch thread -- and analyze-task-mentions counts a mention per
    # sentence per THREAD. it dedupes threads by url when counting how many a
    # model appeared in, but not when counting the mentions themselves, so a
    # story stored under three queries would score triple. it is also the
    # difference between one comment fetch and three.
    out, seen = {}, {}
    for q, want in queries:
        slug = re.sub(r"\W+", "_", q)
        hits = get("q-" + slug, query=q, tags="story",
                   hitsPerPage=want).get("hits", [])
        stories, dupes = [], 0
        for h in hits:
            sid = h["objectID"]
            if sid in seen:
                dupes += 1
                continue
            seen[sid] = q
            cs = get("s-" + sid, tags="comment,story_%s" % sid, hitsPerPage=60).get("hits", [])
            comments = [clean(c.get("comment_text"))[:1200] for c in cs]
            comments = [c for c in comments if len(c) > 120][:args.comments]
            stories.append(dict(id=sid, title=h.get("title"), points=h.get("points"),
                                num_comments=h.get("num_comments"),
                                created_at=(h.get("created_at") or "")[:10],
                                url="https://news.ycombinator.com/item?id=%s" % sid,
                                comments=comments))
        out[q] = stories
        print("  %-28s %d stories%s" % (q, len(stories),
                                        ", %d already had" % dupes if dupes else ""))

    written, now, before = capture.write(args.out, out, len, args.allow_shrink,
                                         "queries")
    if not written:
        sys.exit(capture.refused(args.out, now, before, "queries"))
    print("wrote %s: %d queries, %d unique stories"
          % (args.out, len(out), len(seen)))


if __name__ == "__main__":
    main()
