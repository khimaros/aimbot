#!/usr/bin/env python3

"""Fetch huggingface repo discussions into data/hf-discussions.json.

This is the only source in this repo where breakage is reported against a
*specific quant of a specific repo*. Reddit argues about whether a model is
good; the discussion tab on unsloth/Laguna-S-2.1-GGUF is where someone says
UD-Q5_K_XL emits no tokens under rocm on strix halo. MODELS.md and the roadmap
already cite that kind of report by hand -- this collects it.

Repos come from THE REGISTRY -- every base repo, every quant and every
component -- unioned with repos.txt. That claim used to read "the same list
fetch-gguf-sizes sizes", and it stopped being true when sizes moved to the
registry and this did not: sizes covered 112 repos while this covered 41, and
everything added to the roster since, including the whole speech and image half,
had no discussion coverage at all.

Bodies are pulled PER MODEL rather than per repo. A model is several repos here
-- its own, one or more gguf conversions, sometimes a vae or a text encoder --
and the question "what are people reporting about qwen3-tts" is answered across
all of them at once. Per-repo would also multiply the fetch by however many
conversions a model happens to have, which is not a measure of how much there is
to read.

The listing carries titles, comment counts and reactions but no bodies, so
--bodies fetches the full thread for the most-discussed N per repo. Everything
fetched is written out whole rather than trimmed to what today's analysis
wants, so a later question needs no refetch.
"""

import argparse
import json
import os
import re
import subprocess
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import capture  # noqa: E402  the do-not-shrink guard

import time

HERE = os.path.dirname(os.path.abspath(__file__))
LIST = "https://huggingface.co/api/models/%s/discussions?p=%d"
DETAIL = "https://huggingface.co/api/models/%s/discussions/%d"
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/140.0.0.0 Safari/537.36")
PER_PAGE = 50


def get(url, key, max_age, refresh):
    cmd = [os.path.join(HERE, "httpcache"), url, "--key", key,
           "--max-age", str(max_age), "--header", "User-Agent: " + UA]
    if refresh:
        cmd.append("--refresh")
    out = subprocess.run(cmd, stdout=subprocess.PIPE, text=True).stdout
    try:
        return json.loads(out)
    except ValueError:
        return None


def slug(repo):
    return re.sub(r"\W+", "_", repo)


def thread_text(detail):
    """Flatten a discussion into its comments, oldest first."""
    out = []
    for e in detail.get("events") or []:
        if e.get("type") != "comment":
            continue
        data = e.get("data") or {}
        raw = (data.get("latest") or {}).get("raw") or ""
        if not raw.strip():
            continue
        out.append(dict(
            author=(e.get("author") or {}).get("name"),
            created=e.get("createdAt"),
            reactions=sum(r.get("count", 0) for r in (data.get("reactions") or [])),
            text=raw.strip()))
    return out


def registry_repos(path):
    """{repo: the model it belongs to} for every repo the registry names.

    A model is its base repo plus its quants and components, and all of them
    have a discussion tab. The base repo is where the vendor's own users report;
    a gguf repo is where somebody says UD-Q5_K_XL emits no tokens under rocm.
    """
    try:
        import yaml
    except ImportError:
        sys.exit("!!! pyyaml not found")
    models = (yaml.safe_load(open(path)) or {}).get("models") or {}
    out = {}
    for base, m in models.items():
        out.setdefault(base, base)
        for w in (m.get("quants") or []) + (m.get("components") or []):
            if w.get("repo"):
                # first writer wins: two models can share a conversion, and the
                # aggregate should not claim it twice
                out.setdefault(w["repo"], base)
    return out


def by_model(out):
    """{model: [(repo, discussion), ...]} over everything collected.

    The aggregate the roster actually wants: what is being reported about THIS
    MODEL, wherever it was posted. A repo that belongs to no registry model --
    repos.txt carries a few -- is grouped under its own name so nothing is lost.
    """
    groups = {}
    for repo, box in out.items():
        model = box.get("model") or repo
        for disc in box.get("discussions") or []:
            groups.setdefault(model, []).append((repo, disc))
    return groups


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--repos", default="repos.txt")
    ap.add_argument("--registry",
                    default=os.path.join(HERE, "..", "registry", "models.yaml"))
    ap.add_argument("--out", default="data/hf-discussions.json")
    ap.add_argument("--bodies", type=int, default=12, metavar="N",
                    help="pull full threads for the N most-discussed per MODEL, "
                         "across all of its repos (0 = titles only)")
    ap.add_argument("--pages", type=int, default=2, help="listing pages per repo")
    ap.add_argument("--max-age", type=int, default=6 * 3600)
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--delay", type=float, default=0.3)
    ap.add_argument("--allow-shrink", action="store_true",
                    help="write even when the result holds fewer records "
                         "than the capture on disk")
    args = ap.parse_args()

    with open(args.repos) as f:
        listed = [l.split("#")[0].strip() for l in f]
    owner = registry_repos(args.registry)
    # registry order first, then whatever repos.txt adds on its own: the
    # registry is the roster and repos.txt is a hand-kept extra
    repos = list(owner) + [r for r in listed if r and r not in owner]

    out, threads = {}, 0
    for repo in repos:
        found = []
        for p in range(args.pages):
            d = get(LIST % (repo, p), "hfd-%s-p%d" % (slug(repo), p), args.max_age, args.refresh)
            if not d or not d.get("discussions"):
                break
            found += d["discussions"]
            if len(found) >= (d.get("count") or 0):
                break
            time.sleep(args.delay)
        if not found:
            print("  %-52s no discussions" % repo, file=sys.stderr)
            continue

        rows = []
        for x in found:
            rows.append(dict(
                num=x.get("num"), title=x.get("title"), status=x.get("status"),
                is_pr=x.get("isPullRequest"), created=x.get("createdAt"),
                author=(x.get("author") or {}).get("name"),
                comments=x.get("numComments") or 0,
                reaction_users=x.get("numReactionUsers") or 0,
                reactions={r["reaction"]: r["count"] for r in (x.get("topReactions") or [])}))

        out[repo] = dict(count=len(rows), discussions=rows,
                         model=owner.get(repo))
        print("  %-52s %3d discussions" % (repo, len(rows)), file=sys.stderr)

    # bodies are where the useful detail is, and issues attract replies, so
    # comment count is the cheapest proxy for "worth reading". the ranking is
    # ACROSS a model's repos: the loudest thread about qwen3-tts may be on the
    # cstr conversion rather than on the checkpoint, and a per-repo budget would
    # spend the same number of fetches on a repo with two discussions as on one
    # with two hundred.
    for model, group in by_model(out).items():
        want = sorted(group, key=lambda x: -x[1]["comments"])[:args.bodies]
        for repo, r in want:
            time.sleep(args.delay)
            det = get(DETAIL % (repo, r["num"]), "hfd-%s-%d" % (slug(repo), r["num"]),
                      args.max_age, args.refresh)
            if det:
                r["thread"] = thread_text(det)
                threads += 1
        if want:
            print("  %-52s %d bodies over %d repo(s)"
                  % (model, len(want), len({r for r, _ in want})), file=sys.stderr)

    written, now, before = capture.write(args.out, out, len, args.allow_shrink,
                                         "repos")
    if not written:
        sys.exit(capture.refused(args.out, now, before, "repos"))
    groups = by_model(out)
    total = sum(v["count"] for v in out.values())
    print("wrote %s: %d repos over %d model(s), %d discussions, %d full threads"
          % (args.out, len(out), len(groups), total, threads))
    # the aggregate, printed rather than stored: it is a GROUP BY over what was
    # just written, so a consumer can recompute it from the capture and a second
    # copy in the file could only ever disagree with the first
    for model, group in sorted(groups.items(), key=lambda kv: -len(kv[1]))[:10]:
        print("  %-46s %3d discussions over %d repo(s)"
              % (model, len(group), len({r for r, _ in group})))


if __name__ == "__main__":
    main()
