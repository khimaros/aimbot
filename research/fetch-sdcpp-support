#!/usr/bin/env python3

"""Which image models stable-diffusion.cpp loads, from its own detector.

    fetch-sdcpp-support             # write data/sdcpp-support.json
    fetch-sdcpp-support --report    # what the registry says against what it finds

The same question `fetch-llama-support` answers for text and `fetch-crispasr`
answers for speech, and it needs a third method: sd.cpp never reads
`general.architecture`. `ModelLoader::get_sd_version()` sniffs TENSOR NAMES --
`embed_image_indicator.weight` is ideogram 4, `txtfusion.projector.weight` is
krea 2, `layers.0.adaLN_sa_ln.weight` is ernie image -- so the join is between
that table and the tensor names each gguf actually carries.

Both halves are read rather than assumed:

  the table    src/model_loader.cpp at master, parsed for the `find("...")`
               literals in each `if` and the VERSION_ it returns. a two-arm
               condition is one outcome with two spellings, which is why this
               parses blocks rather than lines: krea 2's first arm is the one
               its ggufs use and a line-at-a-time regex sees only the second.
  the tensors  the gguf's own header, over a ranged GET. huggingface's parse of
               a gguf serves three fields and the tensor list is not one of
               them, so the header is walked here the way fetch-gguf-voices
               walks it for speaker names -- the tensor table sits directly
               after the metadata this shares a reader with.

Reading the CURRENT source matters more than it sounds. A nine-month-old clone
of sd.cpp on this machine has no ideogram, krea or ernie in it at all, and
answering from it would have reported three models as unsupported that upstream
gained dedicated headers, docs and example assets for.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

import capture
import rungs

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = "data/sdcpp-support.json"
RAW = "https://raw.githubusercontent.com/leejet/stable-diffusion.cpp/master/"
LOADER_URL = RAW + "src/model_loader.cpp"
FUNCTION = "SDVersion ModelLoader::get_sd_version()"
# the prefix sd.cpp compares against and a standalone diffusion gguf does not
# carry: it is added by the loader's own name conversion, so a signature is
# matched against the tail
PREFIX = "model.diffusion_model."
# the detector's TWO spellings of one test, and taking only the first was
# silently losing eleven arms of it. `.find(...)` asks whether the name contains
# the literal; `name == "..."` asks whether it IS the literal, which is what
# sd.cpp writes where a prefix match would claim a sibling. qwen image 2.1's
# signature is the second kind, and the model reached the report as `no
# signature` -- a model the runtime documents, read as one it cannot load,
# which is the dangerous direction for this table to be wrong in.
#
# both are collected into the same key space because the join downstream is a
# SUBSTRING test over the gguf's tensor names either way: `==` is narrower in
# sd.cpp than the join is here, so a signature recorded off one can only
# over-match, and every literal in this table is a full tensor name anyway.
FIND = re.compile(r'\.name\.find\("([^"]+)"\)|\.name\s*==\s*"([^"]+)"')
# a third test, of ANOTHER tensor: whether the file holds one by this name at
# all. compared to `end()` in place it is a presence or an absence, which a
# tensor table answers exactly; kept in a variable it is the first half of a
# dimension test, which this does not read
LOOKUP = re.compile(r'tensor_storage_map\.find\("([^"]+)"\)\s*([!=]=)\s*'
                    r'tensor_storage_map\.end\(\)')
OUTCOME = re.compile(r"return\s+(VERSION_\w+)|^\s*(\w+)\s*=\s*true;")
# how much of the file to read for the tensor table. the metadata comes first
# and a diffusion gguf's is small, so the first window is almost always enough
WINDOWS = (1 << 20, 8 << 20, 64 << 20)


def load_voices_reader():
    """fetch-gguf-voices' gguf walker, imported rather than restated."""
    path = os.path.join(HERE, "fetch-gguf-voices")
    spec = importlib.util.spec_from_loader(
        "gguf_voices", importlib.machinery.SourceFileLoader("gguf_voices", path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def get(url, key, max_age, refresh):
    cmd = [os.path.join(HERE, "httpcache"), url, "--key", key,
           "--max-age", str(max_age)]
    if refresh:
        cmd.append("--refresh")
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)
    return proc.stdout if proc.returncode == 0 and proc.stdout.strip() else None


def parse_signatures(source):
    """{signature: outcome} out of the detector: the rules with no condition."""
    return parse_rules(source)[0]


def parse_rules(source):
    """({signature: outcome}, [conditional rule]) out of the detector.

    A rule is one `if` over the tensor's name and everything inside its braces.
    The literals of its condition are its signatures -- a two-arm `if` is one
    rule with two spellings, and both of sd.cpp's ways of writing an arm count,
    see FIND -- and each outcome inside it is read at the depth it sits at: a
    return in the rule's own block is what the signature means, and a return
    under a lookup of a second tensor is the same signature with that lookup as
    a condition, kept beside it rather than flattened into it.
    """
    start = source.find(FUNCTION)
    if start < 0:
        return {}, []
    body = source[start:]
    end = body.find("\n}\n")
    body = body[:end] if end > 0 else body

    out, cond, depth = {}, [], 0
    rule = None
    for line in body.splitlines():
        line = line.split("//")[0]
        before, depth = depth, depth + line.count("{") - line.count("}")
        # one group per spelling, and exactly one of them is set per match
        found = [a or b for a, b in FIND.findall(line)]
        if found and rule is None:
            rule = {"base": before, "sigs": [], "outer": [], "inner": [],
                    "dirty": False, "opened": False}
        if rule is None:
            continue
        own = before == rule["base"]
        # a rule this cannot model EXACTLY is dropped rather than approximated.
        # a dimension test and a lookup kept in a variable are the two shapes:
        # mage flow is both -- its outer condition is qwen image's own
        # signature and `img_in->second.ne[0] == 128` is what separates them --
        # so flattening it into two alternatives made every flux model match
        # mage flow, since they carry `img_in.weight` too. an AND read as an OR
        # is how a detector table starts claiming models it would never return.
        #
        # a block that CAPTURES the tensor is the third. three blocks spell
        # their condition with `==` and then do `input_block_weight =
        # tensor_storage;` rather than returning: they are not rules, they are
        # the tensors the post-loop branches measure. a name tested INSIDE
        # another name's rule is the fourth, since it is a second tensor's rule
        # and this reads one.
        lookups = LOOKUP.findall(line)
        if ("->second" in line or ".ne[" in line or "= tensor_storage;" in line
                or line.count("tensor_storage_map.find") != len(lookups)
                or (found and not own)):
            rule["dirty"] = True
        if own:
            rule["sigs"] += found
        rule["outer" if own else "inner"] += [(n, op == "!=") for n, op in lookups]
        hit = OUTCOME.search(line)
        if hit and not rule["dirty"]:
            tests = rule["outer"] + rule["inner"]
            # deeper than the rule's own block with no lookup behind it is a
            # branch on a flag (`if (is_unet) { is_xl = true; }`), which says
            # nothing about this signature
            if before > rule["base"] + 1 and not rule["inner"]:
                tests = None
            for sig in rule["sigs"] if tests is not None else []:
                outcome = hit.group(1) or hit.group(2)
                if tests:
                    cond.append({"signature": sig, "outcome": outcome,
                                 "present": [n for n, there in tests if there],
                                 "absent": [n for n, there in tests if not there]})
                else:
                    out.setdefault(sig, outcome)
        rule["opened"] = rule["opened"] or depth > rule["base"]
        if depth < before and depth <= rule["base"] + 1:
            rule["inner"] = []
        # the rule ends where its braces do, so nothing it read outlives it.
        # the capture blocks' eleven literals used to, and attached to the first
        # `return` after the loop -- `unet.conv_in.weight` on VERSION_WAN2_2_S2V
        if rule["opened"] and depth <= rule["base"]:
            rule = None
    return out, cond


def tensor_names(reader, repo, filename):
    """Every tensor name in a gguf, over a ranged GET of its header."""
    url = "https://huggingface.co/%s/resolve/main/%s" % (repo, filename)
    for window in WINDOWS:
        try:
            h = reader.Header(reader.fetch_header(url, window))
            if h.take(4) != b"GGUF":
                return None
            h.u32()
            count = h.u64()
            for _ in range(h.u64()):
                h.string()
                h.value(h.u32())
            names = []
            for _ in range(count):
                names.append(h.string())
                for _ in range(h.u32()):
                    h.u64()
                h.u32()
                h.u64()
            return names
        except EOFError:
            continue
        except Exception as e:
            print("!!! %s: %s" % (repo, e), file=sys.stderr)
            return None
    print("!!! %s: header exceeds %d bytes" % (repo, WINDOWS[-1]), file=sys.stderr)
    return None


# the post-loop branches that are decided by FLAGS ALONE, transcribed from
# `get_sd_version()`. only these: the sibling branch that resolves plain flux
# reads `input_block_weight.ne[0]` to tell fill from controls from flex, and a
# reader that does not read dimensions has no business guessing between them.
#
#     if (is_flux2) { return has_single_block_47 ? VERSION_FLUX2
#                                                : VERSION_FLUX2_KLEIN; }
FLAG_RESOLVE = {
    "is_flux2": lambda got: ("VERSION_FLUX2" if "has_single_block_47" in got
                             else "VERSION_FLUX2_KLEIN"),
}


def tail(name):
    """A tensor name as a standalone diffusion gguf spells it."""
    return name[len(PREFIX):] if name.startswith(PREFIX) else name


def match(names, signatures, conditional=()):
    """(version, signature) for what these tensors resolve to.

    `find` in sd.cpp is a substring test against the prefixed name, so the tail
    of the signature is matched against the tensor as the gguf spells it.

    A conditional rule is tried before the plain reading of its signature,
    which is the order the detector returns in: the lookup sits in front of the
    return it guards. Its lookups are whole names, so they are matched whole.

    Some families are decided AFTER the tensor loop, from flags rather than from
    one signature, and only the branches that are pure flag logic are modelled
    here -- see FLAG_RESOLVE. The rest of that post-loop code reads tensor
    DIMENSIONS (`input_block_weight.ne[0] == 384` separates flux fill from flux
    controls), which this does not read, so those land on the flag itself. A
    flag is a real answer: `is_flux` means sd.cpp recognises the file as that
    family and will pick a generation within it.
    """
    seen = lambda sig: any(tail(sig) in n for n in names)
    held = set(names)
    has = lambda name: name in held or tail(name) in held
    met = [(c["outcome"], c["signature"]) for c in conditional
           if seen(c["signature"]) and all(has(n) for n in c["present"])
           and not any(has(n) for n in c["absent"])]
    refined = {sig for _, sig in met}
    hits = met + [(outcome, sig) for sig, outcome in signatures.items()
                  if sig not in refined and seen(sig)]
    if not hits:
        return None, None
    got = {outcome for outcome, _ in hits}
    for flag, decide in FLAG_RESOLVE.items():
        if flag in got:
            return decide(got), next(s for o, s in hits if o == flag)
    for outcome, sig in hits:
        if outcome.startswith("VERSION_"):
            return outcome, sig
    return hits[0]


def diffusion_repos(registry):
    """(model, repo) for each model's first repo of diffusion weights.

    sd.cpp detects an architecture by tensor NAME, and every rung of one
    conversion carries the same names, so one repo per model is enough.
    """
    out = []
    for repo, m in sorted(registry.items()):
        hit = next((r["repo"] for r in rungs.repos(m) if r.get("role") == "diffusion"), None)
        if hit:
            out.append((repo, hit))
    return out


def smallest_file(sizes, repo):
    """The cheapest weight of a repo to read a tensor table from, as a key."""
    keys = [k for k in sizes.get(repo) or {} if ":" not in k]
    return min(keys, key=lambda k: sizes[repo][k]) if keys else None


def load_registry(path):
    try:
        import yaml
    except ImportError:
        sys.exit("!!! pyyaml not found")
    return (yaml.safe_load(open(path)) or {}).get("models") or {}


# an outcome that names an architecture, against one that refines another.
# sd.cpp's table mixes them: `VERSION_SD3` and `is_wan` are models it loads,
# `has_multiple_encoders` and `has_middle_block_1` are follow-up bits that tell
# two variants of one family apart. only the first kind can be a roster gap.
ARCHITECTURE = re.compile(r"^(VERSION_|is_)")


def report(payload, registry):
    found = payload.get("models") or {}
    signatures = payload.get("signatures") or {}
    print("stable-diffusion.cpp: %d signatures, %d model(s) tested"
          % (len(signatures), len(found)))
    # image AND video: they run on the same binary and the same detector reads
    # both, so filtering to one kind hid three entries this collector had just
    # finished identifying
    for repo, m in sorted(registry.items()):
        if m.get("kind") not in ("image", "video"):
            continue
        claims = "stable-diffusion.cpp" in (m.get("engine") or [])
        hit = found.get(repo) or {}
        print("  %-34s registry=%-5s detector=%s"
              % ((m.get("name") or {}).get("short"), "yes" if claims else "no",
                 hit.get("version") or "no signature"))

    # the other direction, which this report used to leave out. crispasr's
    # README names a repo per backend and can be listed as models; sd.cpp names
    # none, so the widest true statement is which ARCHITECTURES the detector
    # knows that nothing in the roster has matched -- each one is a family to go
    # and find a checkpoint for rather than a model to add
    carried = {(v or {}).get("version") for v in found.values() if v}
    # an `is_X` is the family gate a `VERSION_X...` sits behind, so flux 2 being
    # carried as VERSION_FLUX2 answers `is_flux2` too. the comparison is on the
    # family TOKEN and not a substring: `is_flux` is flux 1 and VERSION_FLUX2
    # does not cover it, though one name contains the other
    families = {v.split("_")[1] for v in carried if v and "_" in v}
    known = sorted({o for o in signatures.values() if ARCHITECTURE.match(o)})
    missing = [o for o in known
               if o not in carried
               and not (o.startswith("is_") and o[3:].upper() in families)]
    print()
    print("%d architecture(s) the detector knows that the roster does not carry:"
          % len(missing))
    for o in missing:
        print("   %s" % o)
    print("  sd.cpp publishes no repo for any of them, so each needs a "
          "checkpoint found by hand before it can be an entry")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", default=OUT)
    ap.add_argument("--url", default=LOADER_URL)
    ap.add_argument("--registry",
                    default=os.path.join(HERE, "..", "registry", "models.yaml"))
    ap.add_argument("--cache-key", default="sdcpp")
    ap.add_argument("--max-age", type=int, default=24 * 3600)
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--report", action="store_true")
    ap.add_argument("--allow-shrink", action="store_true")
    args = ap.parse_args()

    registry = load_registry(args.registry)
    if args.report and os.path.exists(args.out):
        report(json.load(open(args.out)), registry)
        return

    source = get(args.url, args.cache_key, args.max_age, args.refresh)
    if not source:
        sys.exit("!!! could not read %s" % args.url)
    signatures, conditional = parse_rules(source)
    if not signatures:
        sys.exit("!!! no signatures found -- get_sd_version() moved or changed shape")

    reader = load_voices_reader()
    models = {}
    sizes = json.load(open(os.path.join(HERE, "data", "gguf-sizes.json")))
    for repo, weights in diffusion_repos(registry):
        key = smallest_file(sizes, weights)
        if not key:
            continue
        # a tag is not a filename, and a ranged GET needs one. the same resolver
        # the voices collector uses, which anchors on the END of the stem
        # because `q8_0` matches three files in some repos
        name = key if rungs.is_filename(key) else reader.resolve_filename(weights, key)
        names = tensor_names(reader, weights, name) if name else None
        if not names:
            continue
        version, sig = match(names, signatures, conditional)
        models[repo] = {"repo": weights, "tensors": len(names),
                        "version": version, "signature": sig}
        print("  %-46s %-22s %s" % (repo, version or "no signature", sig or ""),
              file=sys.stderr)

    payload = {"signatures": dict(sorted(signatures.items())),
               "conditional": conditional,
               "models": dict(sorted(models.items()))}
    written, now, before = capture.write(
        args.out, payload, lambda p: len(p["signatures"]),
        allow_shrink=args.allow_shrink)
    if not written:
        sys.exit(capture.refused(args.out, now, before))
    print("wrote %s: %d signatures, %d model(s), %d detected"
          % (args.out, len(signatures), len(models),
             sum(1 for m in models.values() if m["version"])))
    if args.report:
        report(payload, registry)


if __name__ == "__main__":
    main()
