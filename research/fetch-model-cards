#!/usr/bin/env python3

"""Extract the benchmark numbers models claim about themselves, into
data/model-cards.json.

These are the weakest evidence in the corpus and they are collected anyway,
because they are often the ONLY numbers a new model has -- artificial analysis
took weeks to score qwen3.8-27b, and in the meantime the card was all there was.

They are weak for a reason that is measurable rather than cynical. On the
qwen3.8-27b card, the three benchmarks where a competitor's score could be
checked against artificial analysis matched AA to the decimal (muse glimmer's
terminal-bench 51.7, GPQA 83.5, HLE 22.0), while the vendor's own two models
came in 0.3 to 3.6 points ABOVE their AA scores on the same benchmarks. So the
competitor column was copied and the home column was re-run, on a harness that
is a little kinder. That is not fraud, it is a house harness -- but it means a
card's own numbers are not comparable to the numbers beside them.

So this stores `claimed` (the model's own column) separately from `others` (what
the card says about everyone else), and analyze-self-report measures the gap
against third-party sources. A card claim should never be worth as much as a
measured one, and now there is a number for how much less.

Cards are wildly heterogeneous -- markdown tables, HTML tables with inline
styles, prose -- so extraction is best-effort and records what it could not
parse rather than silently dropping it.

Besides the numbers, the card is also the only place the vendor says what the
model is FOR, so its opening paragraph and its feature bullets are kept as
`summary` and `highlights`, and the hub's own structured metadata (pipeline
tag, tags, license, downloads) as `hub`. Those feed analyze-usecase, which is
where the question "what should I use this for" is actually answered.
"""

import argparse
import html
import json
import os
import re
import subprocess
import sys
from html.parser import HTMLParser

HERE = os.path.dirname(os.path.abspath(__file__))
RAW = "https://huggingface.co/%s/raw/main/README.md"
API = "https://huggingface.co/api/models/%s"
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/140.0.0.0 Safari/537.36")

# hub fields worth keeping. downloads and likes are not quality, but they are
# the only measure of adoption that covers every model rather than the fifth
# of them a leaderboard scored.
HUB_FIELDS = ["pipeline_tag", "library_name", "downloads", "likes", "gated",
              "createdAt", "lastModified"]

# the opening prose of a card, which is where the vendor says what it built.
# markdown noise that is never a summary: badges, images, tables, headings,
# rules, blockquote callouts, and the bullet lists `highlights` already takes.
SUMMARY_SKIP = re.compile(r"^\s*(!\[|\[!\[|#|\||>|[-*+]\s|-{3,}|\*{3,}|$)")
SUMMARY_MIN = 60
SUMMARY_MAX = 600
HIGHLIGHT_HEADING = re.compile(
    r"^#{1,4}\s*.*\b(highlight|key feature|features|introduction|overview|"
    r"what.s new|capabilit)", re.I)
HIGHLIGHT_MAX = 8
HIGHLIGHT_CHARS = 240

# benchmark names as cards write them -> the key third-party sources use, so a
# claim can be put beside a measurement. the left side is matched loosely
# (lowercased, punctuation stripped); anything unmatched is kept verbatim under
# `unmatched` so the table grows from evidence rather than guesswork.
BENCH = {
    "terminalbench": "terminalbench", "terminalbench21": "terminalbench",
    "terminalbench20": "terminalbench", "terminusterminalbench": "terminalbench",
    "gpqa": "gpqa", "gpqadiamond": "gpqa",
    "hle": "hle", "humanityslastexam": "hle",
    "swebenchverified": "swebench_verified", "swebench": "swebench_verified",
    "swebenchpro": "swebench_pro",
    "livecodebench": "livecodebench", "livecodebenchv6": "livecodebench",
    "aime": "aime", "aime2025": "aime", "aime2024": "aime",
    "scicode": "scicode",
    "ifbench": "ifbench", "ifeval": "ifeval",
    "aiderpolyglot": "aider_polyglot",
    "deepswe": "deepswe", "deepswe11": "deepswe",
    "mmlu": "mmlu", "mmlupro": "mmlu_pro", "mmmu": "mmmu", "mmmupro": "mmmu_pro",
    "arcagi": "arc_agi", "arcagi2": "arc_agi_2",
    "tau2": "tau2", "tau2bench": "tau2", "taubench": "tau2",
    "osworld": "osworld", "osworldverified": "osworld",
    "gdpval": "gdpval", "critpt": "critpt", "weirdml": "weirdml",
}
NUM = re.compile(r"^-?\d+(?:\.\d+)?$")
# longest alias first: "swebench" is a substring of "swebenchpro", and a card
# that nests the benchmark inside a capability label ("Agentic terminal coding
# / Terminal Bench 2.1 (Terminus)") flattens to one cell containing both
BENCH_BY_LEN = None


def match_bench(label):
    global BENCH_BY_LEN
    if BENCH_BY_LEN is None:
        BENCH_BY_LEN = sorted(BENCH, key=len, reverse=True)
    n = norm(label)
    if not n:
        return None
    for alias in BENCH_BY_LEN:
        if alias in n:
            return BENCH[alias]
    return None


def norm(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())


class Tables(HTMLParser):
    """Collect HTML tables as rows of cell text. Cards use them with heavy
    inline styling and nested divs, so cell text is flattened."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.tables, self._t, self._row, self._cell, self._depth = [], None, None, None, 0

    def handle_starttag(self, tag, attrs):
        if tag == "table":
            self._t = []
        elif tag == "tr" and self._t is not None:
            self._row = []
        elif tag in ("td", "th") and self._row is not None:
            self._cell = []
            self._depth = int(dict(attrs).get("colspan", 1) or 1)

    def handle_data(self, data):
        if self._cell is not None:
            self._cell.append(data)

    def handle_endtag(self, tag):
        if tag in ("td", "th") and self._cell is not None:
            self._row.append(" ".join(" ".join(self._cell).split()))
            self._cell = None
        elif tag == "tr" and self._row is not None:
            if self._row:
                self._t.append(self._row)
            self._row = None
        elif tag == "table" and self._t is not None:
            if self._t:
                self.tables.append(self._t)
            self._t = None


def markdown_tables(text):
    out, cur = [], []
    for line in text.split("\n"):
        if line.strip().startswith("|") and line.count("|") >= 3:
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if all(set(c) <= set("-: ") for c in cells):
                continue
            cur.append(cells)
        elif cur:
            if len(cur) > 1:
                out.append(cur)
            cur = []
    if len(cur) > 1:
        out.append(cur)
    return out


def own_column(header, repo, names):
    """Which column is this model? Cards put the subject first as often as not,
    but never reliably, so match the header against the repo and known names."""
    want = [norm(repo.split("/")[-1])] + [norm(n) for n in names if n]
    best, score = None, 0
    for i, cell in enumerate(header):
        c = norm(cell)
        if not c:
            continue
        for w in want:
            if not w:
                continue
            if c == w:
                return i
            if (w in c or c in w) and len(c) > score:
                best, score = i, len(c)
    return best


def parse_tables(tables, repo, names):
    claimed, others, unmatched = {}, {}, []
    for t in tables:
        if len(t) < 2:
            continue
        header = t[0]
        col = own_column(header, repo, names)
        if col is None:
            continue
        for row in t[1:]:
            if len(row) <= col or not row[0]:
                continue
            key = match_bench(row[0])
            val = row[col].replace("%", "").strip().strip("*")
            val = val.split()[0] if val else ""
            if not NUM.match(val):
                continue
            if not key:
                unmatched.append({"label": row[0], "value": float(val)})
                continue
            claimed[key] = float(val)
            peers = {}
            for i, cell in enumerate(header):
                if i in (0, col) or len(row) <= i:
                    continue
                v = row[i].replace("%", "").strip().strip("*")
                v = v.split()[0] if v else ""
                if NUM.match(v):
                    peers[cell] = float(v)
            if peers:
                others.setdefault(key, {}).update(peers)
    return claimed, others, unmatched



# sampler recommendations, which cards state as prose rather than in a table.
# both formats are in use: one line of `temperature=1.0, top_p=0.95, ...`, or a
# bulleted list with one setting per line, so consecutive lines are joined.
SAMPLER_KV = re.compile(r"\b(temperature|temp|top_p|top_k|min_p|presence_penalty|"
                        r"repetition_penalty|repeat_penalty)\b\s*[=:]\s*`?(\d+(?:\.\d+)?)")
SAMPLER_FIELD = {"temperature": "temp", "temp": "temp", "top_p": "top_p",
                 "top_k": "top_k", "min_p": "min_p",
                 "presence_penalty": "presence_penalty",
                 "repetition_penalty": "repeat_penalty",
                 "repeat_penalty": "repeat_penalty"}


# a card states settings for two different reasons: what to RUN the model at,
# and what a benchmark was evaluated at. ornith's only numbers are a
# Terminal-Bench harness description, which is not a recommendation.
# these are STEMS, so they take no trailing boundary: `\bevaluat\b` never
# matched "evaluated" and `\bharness\b` never matched "harnesses", which is how
# a footnote reading "evaluated with the Claude Code and mini-SWE-agent
# harnesses" read as a recommendation. it only ever caught the uninflected form.
HARNESS = re.compile(r"\b(bench|harness|evaluat|protocol|scaffold|we (?:run|report)|"
                     r"terminus|swe-bench|arena)", re.I)
# a line break, or the conjunction that separates two recommendations in one
# sentence. splitting on it is what stops the second mode overwriting the first.
CLAUSE = re.compile(r",?\s+(?:while|whereas)\s+", re.I)
# a card is markdown WITH html in it, and the tags are not part of a label.
# stripping them is not cosmetic: the label is what a reader sees AND what the
# HARNESS test reads, and qwen3.8-flash-next's benchmark footnote opens with 70
# characters of inline style before it says anything -- so the tag rendered
# verbatim on the vendor tab and pushed "evaluated ... harnesses" past the 80
# characters the filter looks at, letting a methodology note through as a
# recommendation to run the model at.
TAG = re.compile(r"<[^>]+>")


MAX_LABEL = 80


def label_for(part):
    """What introduces a sampler set, without the numbers in it.

    The values are rendered beside the label, so carrying them in the label too
    is noise -- and it was what pushed the text past the cap, which then cut a
    word in half: qwen3.8-flash-next read "Thinking Mode: `temperature=1.0`,
    `top_p=0.95`, `top_k=20`, `min_p=0.0`, `presen". What identifies a set is
    the phrase BEFORE the first assignment, so that is the label.

    A card that states the numbers with no prose in front of them -- a python
    snippet, one argument per line -- has nothing to say here and gets an empty
    label, which the viewer renders as no label rather than as a stray fragment.
    """
    m = SAMPLER_KV.search(part)
    head = (part[:m.start()] if m else part).strip().strip("*->`:, ").strip()
    if len(head) <= MAX_LABEL:
        return head
    # cut on a word boundary; a label ending mid-token reads as corruption
    return head[:MAX_LABEL].rsplit(" ", 1)[0].rstrip(",;:") + "..."


def sampler_sets(text):
    """Labelled sampler sets a card documents, in document order.

    A python snippet counts as one: unsloth ships `presence_penalty=2.0` only in
    a code sample for qwen3.6, where the prose never mentions it, and that is
    exactly the kind of divergence worth recording rather than smoothing over.

    A sentence documenting TWO modes is split on its conjunction: nemotron 3
    nano writes "temperature=1.0 and top_p=1.0 are recommended for reasoning
    tasks, while temperature=0.6 and top_p=0.95 are recommended for tool
    calling", which is two recommendations rather than one contradictory set.
    """
    out, cur, label = [], {}, ""
    seen = set()

    def flush():
        # a card states the same numbers in prose, in a code block and in a
        # table, and that is one recommendation rather than three. the first
        # label wins because it is the one with the prose around it
        nonlocal cur, label
        key = tuple(sorted(cur.items()))
        if len(cur) >= 2 and not HARNESS.search(label) and key not in seen:
            seen.add(key)
            out.append({"label": label, "values": cur})
        cur, label = {}, ""

    for line in (text or "").split("\n"):
        parts = CLAUSE.split(TAG.sub(" ", line))
        for n, part in enumerate(parts):
            found = SAMPLER_KV.findall(part)
            if found:
                # a conjunction starts a NEW recommendation, so the one being
                # accumulated has to close before it rather than merge with it.
                # so does a line that carries a WHOLE set on its own: qwen lists
                # its two modes as consecutive bullets, and flushing only on a
                # line with no sampler at all merged them -- setdefault kept the
                # first bullet's numbers and the second lost its name with them.
                # a line bearing one assignment is a snippet argument instead,
                # and those still accumulate across lines into one set.
                if cur and (n or len(found) > 1):
                    flush()
                if not cur:
                    label = label_for(part)
                for k, v in found:
                    cur.setdefault(SAMPLER_FIELD[k], float(v))
            elif cur:
                flush()
    flush()
    return out


def strip_frontmatter(text):
    """Drop the yaml block a card opens with; its keys come from the api."""
    if not text.startswith("---"):
        return text, {}
    end = text.find("\n---", 3)
    if end < 0:
        return text, {}
    head, body = text[3:end], text[end + 4:]
    meta = {}
    for line in head.split("\n"):
        if ":" in line and not line.startswith((" ", "-", "\t")):
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip()
    return body, meta


def summary(text):
    """The card's first real paragraph: what the vendor says it built.

    Cards open with a wall of badge images and centred html, so the markup is
    stripped first and then the first paragraph that reads as sentences wins.
    Best-effort by design -- a card that is all tables gets no summary rather
    than a row of pipes.
    """
    body, _ = strip_frontmatter(text or "")
    body = re.sub(r"<!--.*?-->", " ", body, flags=re.S)
    body = re.sub(r"!\[[^\]]*\]\([^)]*\)", " ", body)          # images and badges
    body = re.sub(r"<[^>]+>", " ", body)                       # centred html wrappers
    for para in re.split(r"\n\s*\n", body):
        lines = [l.strip() for l in para.split("\n")
                 if not SUMMARY_SKIP.match(l.strip())]
        s = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", " ".join(lines))
        s = " ".join(s.replace("**", "").split())
        # the link bar cards put under the title survives tag stripping as a
        # row of pipe-separated names, and is not a description of anything
        if s.count("|") >= 2:
            continue
        if len(s) >= SUMMARY_MIN and len(s.split()) >= 10:
            return s[:SUMMARY_MAX]
    return ""


def highlights(text):
    """Feature bullets under a highlights-shaped heading, in document order."""
    body, _ = strip_frontmatter(text or "")
    out, collecting = [], False
    for line in body.split("\n"):
        s = line.strip()
        if s.startswith("#"):
            collecting = bool(HIGHLIGHT_HEADING.match(s))
            continue
        if not collecting or not s.startswith(("-", "*", "+")):
            continue
        item = re.sub(r"^[-*+]\s*", "", s)
        item = re.sub(r"<[^>]+>", "", item)
        item = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", item).replace("**", "")
        item = " ".join(item.split())
        if len(item) > 20:
            out.append(item[:HIGHLIGHT_CHARS])
        if len(out) >= HIGHLIGHT_MAX:
            break
    return out


def hub_meta(repo, max_age, refresh):
    """The hub's own structured metadata, which needs no card to parse."""
    cmd = [os.path.join(HERE, "httpcache"), API % repo,
           "--key", "hub-%s" % repo.replace("/", "_"),
           "--max-age", str(max_age), "--header", "User-Agent: " + UA]
    if refresh:
        cmd.append("--refresh")
    raw = subprocess.run(cmd, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True).stdout
    try:
        d = json.loads(raw)
    except ValueError:
        return {}
    out = {k: d[k] for k in HUB_FIELDS if d.get(k) is not None}
    # the licence lives in cardData on some repos and only in the tags on
    # others, so take whichever answered
    out["license"] = (d.get("cardData") or {}).get("license") or next(
        (t.split(":", 1)[1] for t in (d.get("tags") or []) if t.startswith("license:")), None)
    out["tags"] = [t for t in (d.get("tags") or [])
                   if ":" not in t and t not in ("region", "endpoints_compatible")]
    return {k: v for k, v in out.items() if v not in (None, [], "")}


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--registry", default=os.path.join(HERE, "..", "registry", "models.yaml"))
    ap.add_argument("--out", default="data/model-cards.json")
    ap.add_argument("--max-age", type=int, default=6 * 3600)
    ap.add_argument("--refresh", action="store_true")
    args = ap.parse_args()

    import yaml
    reg = yaml.safe_load(open(args.registry)).get("models") or {}

    out = {}
    for repo, m in reg.items():
        if "/" not in repo:
            continue
        cmd = [os.path.join(HERE, "httpcache"), RAW % repo,
               "--key", "card-%s" % repo.replace("/", "_"),
               "--max-age", str(args.max_age)]
        if args.refresh:
            cmd.append("--refresh")
        text = subprocess.run(cmd, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True).stdout
        # an entry is written even with no card at all: the hub metadata below
        # answers "what is this and who publishes it" for the image and speech
        # models, which have no benchmark table anywhere
        p = Tables()
        try:
            p.feed(text)
        except Exception:
            pass
        names = [(m.get("name") or {}).get("short")]
        claimed, others, unmatched = parse_tables(
            p.tables + markdown_tables(text), repo, names)
        out[repo] = {"claimed": claimed, "others": others,
                     "unmatched": unmatched[:20],
                     "samplers": sampler_sets(text),
                     "summary": summary(text), "highlights": highlights(text),
                     "hub": hub_meta(repo, args.max_age, args.refresh),
                     "card_url": "https://huggingface.co/%s" % repo}
        # the quant repo is what actually gets run, and it does not always say
        # the same thing as the base repo
        qrepo = ((m.get("quants") or [{}])[0]).get("repo")
        if qrepo:
            qcmd = [os.path.join(HERE, "httpcache"), RAW % qrepo,
                    "--key", "qcard-%s" % qrepo.replace("/", "_"),
                    "--max-age", str(args.max_age)]
            if args.refresh:
                qcmd.append("--refresh")
            qtext = subprocess.run(qcmd, stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, text=True).stdout
            qsets = sampler_sets(qtext)
            if qsets:
                out[repo]["quant_repo"] = qrepo
                out[repo]["quant_samplers"] = qsets
        print("  %-40s %d claimed, %d unmatched, %s summary, %d highlights"
              % (repo, len(claimed), len(unmatched),
                 "no" if not out[repo]["summary"] else "a",
                 len(out[repo]["highlights"])), file=sys.stderr)

    with open(args.out, "w") as f:
        json.dump(out, f, indent=1, sort_keys=True)
    print("wrote %s: %d cards, %d with claims"
          % (args.out, len(out), sum(1 for v in out.values() if v["claimed"])))


if __name__ == "__main__":
    main()
