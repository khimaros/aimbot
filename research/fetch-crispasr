#!/usr/bin/env python3

"""Fetch crispasr's own catalog of what it loads into data/crispasr.json.

    fetch-crispasr                  # both documents
    fetch-crispasr --report         # what the registry does and does not carry

One binary carries ~119 ggml runtimes, and which one a file needs is the whole
difference between two entries that otherwise run identically. That fact was
hand-written on 19 registry models, which meant the roster knew about the
backends somebody had already looked up and nothing about the rest -- kokoro
has a crispasr backend and the registry said it had none.

Two documents, because neither is complete on its own:

  README.md               the model tables. one row per backend, with the
                          huggingface repos it was measured against -- the base
                          checkpoint as the link text, the gguf conversion as
                          the href. this is the only place the repos appear.
  docs/feature-matrix.md  the capability bits, generated by the project from
                          `crispasr --list-backends-json`. no repos at all, so
                          it answers "can this backend diarize" and never "what
                          does it load".

The join is by repo, not by name: `parakeet` is a backend, four checkpoints and
two publishers, and matching on the word would claim all of them.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

import capture

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = "data/crispasr.json"
RAW = "https://raw.githubusercontent.com/CrispStrobe/CrispASR/main/"
README_URL = RAW + "README.md"
MATRIX_URL = RAW + "docs/feature-matrix.md"

# the sections of the readme that carry model tables, and what a row in each
# one IS. a backend under `Audio codecs` is a companion file another backend
# loads rather than something to transcribe with, and the distinction decides
# whether a registry entry would be a model or a component.
SECTIONS = {
    "ASR backends": "asr",
    "Speech-to-speech audio upscaling and restoration": "s2s",
    "Text-to-Speech models": "tts",
    "Translation": "translate",
    "Post-processing models": "post",
    "Audio codecs": "codec",
    "Music & audio analysis": "music",
}

HEADING = re.compile(r"^#{2,4}\s+(.*?)\s*$")
LINK = re.compile(r"\[([^\]]+)\]\((https?://huggingface\.co/[^)\s]+)\)")
# `**qwen3-tts**`, and `**foxnose** *(speaker diarization)*` -- the parenthetical
# is prose about the row rather than a second backend name
BACKEND = re.compile(r"\*\*([a-z0-9][a-z0-9._-]*)\*\*", re.I)
REPO = re.compile(r"^[A-Za-z0-9][\w.-]*/[\w.-]+$")


def get(url, key, max_age, refresh):
    """The document, through the shared cache. None if it could not be read."""
    cmd = [os.path.join(HERE, "httpcache"), url, "--key", key,
           "--max-age", str(max_age)]
    if refresh:
        cmd.append("--refresh")
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)
    return proc.stdout if proc.returncode == 0 and proc.stdout.strip() else None


# `general.architecture` -> backend, read out of crispasr's own table rather
# than guessed from the repos its readme links. THE POINT OF THE WHOLE FILE.
#
# A backend name is crispasr's word for one of its runtimes; an architecture is
# what a gguf says it is in its own header, and it is the only thing a registry
# model and an engine can be compared on. The alternative -- naming a backend by
# hand on each model -- knows only about the models somebody already looked up,
# which is how kokoro sat here with no engine while crispasr had a backend for
# it.
#
# The table is the same one every crispasr surface dispatches through, and its
# header says why it exists: two copies of it drifted, the C ABI's copy was
# missing 113 architecture strings, and `Session::open()` returned NULL for
# models the CLI opened fine. It also says component GGUFs -- voice packs,
# codecs, VAD and LID helpers -- are deliberately absent so an unknown
# architecture yields nothing rather than a backend that would fail on load.
# That is the property this repo needs most: it is a table that under-reports
# on purpose.
ARCH_MAP_URL = RAW + "src/core/arch_backend_map.h"
ENTRY = re.compile(r'\{\s*"([^"]+)"\s*,\s*"([^"]+)"\s*\}')


def parse_arch_map(text):
    """{architecture: backend} out of the C table, in the order it lists them."""
    out = {}
    for arch, backend in ENTRY.findall(text):
        out.setdefault(arch, backend)
    return out


def repo_of(url):
    """`owner/name` out of a huggingface url, or None for a collection or a file.

    A url that names a tree, a blob or a file inside a repo still names the
    repo, so it is truncated rather than dropped -- crispasr links straight at
    `ggerganov/whisper.cpp/` and at `.../tree/main` in the same table.
    """
    path = url.split("huggingface.co/", 1)[-1].strip("/")
    for cut in ("/tree/", "/blob/", "/resolve/"):
        path = path.split(cut, 1)[0]
    parts = [p for p in path.split("/") if p]
    if len(parts) < 2 or parts[0] in ("collections", "spaces", "datasets"):
        return None
    return "/".join(parts[:2])


def row_models(cells):
    """(base repos, gguf repos) named by one table row.

    The link TEXT is the checkpoint and the href is usually a conversion of it,
    so both are kept and told apart by where they came from: a text that reads
    `owner/name` is a repo somebody can fetch, and a text that reads `1.7B-Base`
    is a label for the href beside it.
    """
    base, gguf = [], []
    for text, url in LINK.findall(" ".join(cells)):
        repo = repo_of(url)
        if repo and repo not in gguf:
            gguf.append(repo)
        label = text.strip("`* ")
        if REPO.match(label) and label not in base:
            base.append(label)
    return base, gguf


def parse_readme(text):
    """{backend: {section, kind, models, gguf, languages, license}}."""
    out, section = {}, None
    for line in text.splitlines():
        head = HEADING.match(line)
        if head:
            section = head.group(1)
            continue
        if not line.startswith("|") or SECTIONS.get(section) is None:
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 2 or set(cells[0]) <= set("-: "):
            continue
        names = BACKEND.findall(cells[0])
        if not names:
            continue
        base, gguf = row_models(cells[1:])
        for name in names:
            rec = out.setdefault(name.lower(), {
                "section": section, "kind": SECTIONS[section],
                "models": [], "gguf": []})
            for r in base:
                if r not in rec["models"]:
                    rec["models"].append(r)
            for r in gguf:
                if r not in rec["gguf"]:
                    rec["gguf"].append(r)
            if len(cells) >= 5:
                rec.setdefault("languages", cells[-2])
                rec.setdefault("license", cells[-1])
    return out


def parse_matrix(text):
    """{backend: [capability, ...]} off the generated feature matrix."""
    caps, header = {}, None
    for line in text.splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if header is None:
            if cells and cells[0].lower() == "backend":
                header = [c.strip() for c in cells[1:]]
            continue
        if set(cells[0]) <= set("-: "):
            continue
        name = cells[0].strip("`* ").lower()
        if not name:
            continue
        caps[name] = sorted(header[i].lower() for i, c in enumerate(cells[1:])
                            if i < len(header) and c)
    return caps


def load_registry(path):
    try:
        import yaml
    except ImportError:
        sys.exit("!!! pyyaml not found")
    return (yaml.safe_load(open(path)) or {}).get("models") or {}


def resolver():
    """resolve-ids as a module: its key spaces and its matcher, not a second set.

    The question here -- does any board score this checkpoint -- is the one
    resolve-ids answers for the registry, down to the open-weights filter and
    the tier words that keep `mini` from matching `pro`. Restating it would be
    two matchers to keep agreeing.
    """
    path = os.path.join(HERE, "..", "scripts", "resolve-ids")
    spec = importlib.util.spec_from_loader(
        "resolve_ids", importlib.machinery.SourceFileLoader("resolve_ids", path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


SPACES = None


def board_hits(backend):
    """{board: row key} for a backend's checkpoints, over every board here.

    Matched on the repo BASENAME, because a board publishes a product name and
    crispasr publishes a repo and the two share no id: `cstr/chatterbox-GGUF`
    reaches the board's `chatterbox`, and `-GGUF` is dropped first because no
    board has ever heard of a conversion.
    """
    global SPACES
    if SPACES is None:
        ri = resolver()
        SPACES = (ri, {s: sp for spaces in ri.key_spaces().values()
                       for s, sp in spaces.items()})
    ri, spaces = SPACES
    wants, sized = [], []
    for repo in backend["models"] + backend["gguf"]:
        stem = repo.split("/")[-1]
        for cut in ("-GGUF", "-GGML", "-gguf", "-hf"):
            if stem.endswith(cut):
                stem = stem[: -len(cut)]
        for cand in (stem, repo.replace("/", "-")):
            n = ri.norm(cand)
            if n and n not in wants:
                wants.append(n)
            s = ri.norm(ri.SIZE.sub("", cand))
            if s and s != n and s not in sized:
                sized.append(s)
    hits = {}
    for board, space in spaces.items():
        found, _ = ri.candidates(space, wants, sized)
        if found:
            hits[board] = found
    return hits


def by_arch(payload, registry):
    """Which registry models crispasr loads, DERIVED from the architecture.

    The comparison the hand-written blocks were standing in for: a gguf says
    what it is in its own header, crispasr's catalog says which header each of
    its backends was published against, and the intersection is the answer for
    every model at once rather than for the ones somebody looked up.
    """
    index = payload.get("arch") or {}
    if not index:
        print("\nno architectures resolved; run without --no-archs", file=sys.stderr)
        return
    support = json.load(open(os.path.join(HERE, "data/llama-support.json")))
    repo_arch = support.get("repos") or {}

    agree, differ, new = [], [], []
    for repo, m in sorted(registry.items()):
        written = ((m.get("crispasr") or {}).get("backend")
                   or next((q["crispasr"]["backend"] for q in (m.get("quants") or [])
                            if (q.get("crispasr") or {}).get("backend")), None))
        found = None
        for q in (m.get("quants") or []):
            arch = repo_arch.get(q.get("repo"))
            if arch and arch in index:
                found = index[arch]
                break
        if written and found == written:
            agree.append((repo, written))
        elif written and found != written:
            differ.append((repo, written, found))
        elif found:
            new.append((repo, found))

    print("\nby ARCHITECTURE: %d model(s) agree with what is written on them, "
          "%d disagree, %d are supported and say nothing"
          % (len(agree), len(differ), len(new)))
    for repo, written, found in differ:
        print("  %-46s written %-22s derived %s" % (repo, written, found or "-"))
    for repo, found in new:
        print("  %-46s %s" % (repo, found))


def report(payload, registry):
    """What the catalog says the roster is missing, in three questions."""
    backends = payload["backends"]
    owned = {}
    for repo, m in registry.items():
        owned[repo] = repo
        for q in (m.get("quants") or []) + (m.get("components") or []):
            owned[q["repo"]] = repo
    # a model that names ANY crispasr use is claimed: the diarizers carry
    # `crispasr.diarize` rather than a backend, and reading only backends
    # reported foxnose as an unclaimed runtime for a weight the registry has
    # carried under that recipe from the start
    claimed = {r for r, m in registry.items()
               if m.get("crispasr") or any(q.get("crispasr")
                                           for q in (m.get("quants") or []))}
    named = {b for m in registry.values()
             for b in [((m.get("crispasr") or {}).get("backend"))]
             + [((q.get("crispasr") or {}).get("backend"))
                for q in (m.get("quants") or [])] if b}

    print("crispasr: %d backends, %d with a repo, %d capability rows, "
          "%d architectures"
          % (len(backends), sum(1 for b in backends.values() if b["gguf"] or b["models"]),
             len(payload.get("caps") or {}), len(payload.get("arch") or {})))
    by_arch(payload, registry)

    unclaimed = []
    for name, b in sorted(backends.items()):
        hits = {owned[r] for r in b["models"] + b["gguf"] if r in owned}
        hits -= claimed
        if hits and name not in named:
            unclaimed.append((name, sorted(hits)))
    print("\n%d backend(s) load a model this registry ALREADY carries and are "
          "not named on it:" % len(unclaimed))
    for name, hits in unclaimed:
        print("  %-24s %s" % (name, ", ".join(hits)))

    missing = [(n, b) for n, b in sorted(backends.items())
               if (b["models"] or b["gguf"])
               and not any(r in owned for r in b["models"] + b["gguf"])]
    scored = [(n, b, hits) for n, b in missing
              for hits in [board_hits(b)] if hits]
    print("\n%d of those are SCORED by a board this repo already collects, "
          "which makes them the ones worth adding:" % len(scored))
    for name, b, hits in scored:
        print("  %-24s %-6s %s" % (name, b["kind"],
                                   ", ".join("%s=%s" % kv for kv in sorted(hits.items()))))

    print("\n%d backend(s) name weights the registry does not carry at all:"
          % len(missing))
    for name, b in missing:
        print("  %-24s %-6s %s" % (name, b["kind"],
                                   ", ".join((b["models"] + b["gguf"])[:2])))


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", default=OUT)
    ap.add_argument("--url", default=README_URL)
    ap.add_argument("--matrix-url", default=MATRIX_URL)
    ap.add_argument("--arch-url", default=ARCH_MAP_URL)
    ap.add_argument("--registry",
                    default=os.path.join(HERE, "..", "registry", "models.yaml"))
    ap.add_argument("--cache-key", default="crispasr")
    # a readme moves when somebody adds a backend, which is weekly at most
    ap.add_argument("--max-age", type=int, default=24 * 3600)
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--report", action="store_true",
                    help="print the gaps against the registry and write nothing")
    ap.add_argument("--allow-shrink", action="store_true")
    args = ap.parse_args()

    if args.report and os.path.exists(args.out):
        payload = json.load(open(args.out))
        report(payload, load_registry(args.registry))
        return

    readme = get(args.url, args.cache_key, args.max_age, args.refresh)
    if not readme:
        sys.exit("!!! could not read %s" % args.url)
    backends = parse_readme(readme)
    if not backends:
        sys.exit("!!! no backend tables found -- the readme structure changed")

    matrix = get(args.matrix_url, args.cache_key + "-matrix", args.max_age,
                 args.refresh)
    caps = parse_matrix(matrix) if matrix else {}
    table = get(args.arch_url, args.cache_key + "-arch", args.max_age,
                args.refresh)
    index = parse_arch_map(table) if table else {}
    if table and not index:
        sys.exit("!!! the architecture table parsed empty -- its shape changed")

    payload = {"backends": dict(sorted(backends.items())),
               "caps": dict(sorted(caps.items())),
               "arch": dict(sorted(index.items()))}
    written, now, before = capture.write(
        args.out, payload, lambda p: len(p["backends"]),
        allow_shrink=args.allow_shrink)
    if not written:
        sys.exit(capture.refused(args.out, now, before))
    print("wrote %s: %d backends (%d with repos), %d capability rows"
          % (args.out, len(backends),
             sum(1 for b in backends.values() if b["gguf"] or b["models"]),
             len(caps)))
    if args.report:
        report(payload, load_registry(args.registry))


if __name__ == "__main__":
    main()
