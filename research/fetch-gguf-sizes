#!/usr/bin/env python3

"""Resolve real GGUF quant sizes into data/gguf-sizes.json.

Nominal parameter counts do not tell you what will fit: unsloth's UD-* quants
mix precisions per tensor, sharded quants live in per-quant subdirectories, and
natively-MXFP4 models like gpt-oss-120b are the same size at every quant tag.
This sums the actual byte totals reported by the huggingface tree API, grouped
by quant tag, so MODELS.md can compare against a real memory budget.

Repos come from the registry's quants and components, unioned with repos.txt
(one per line, '#' comments ignored) for models sized only as a comparison.
"""

import argparse
import collections
import json
import os
import re
import subprocess
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import capture  # noqa: E402  the do-not-shrink guard


TREE = "https://huggingface.co/api/models/%s/tree/main?recursive=true"
# A trailing -00001-of-000NN shard suffix is stripped so shards aggregate.
# Some publishers emit `Motif3-Q5_K_M.gguf-00001-of-00005.gguf`, keeping the
# .gguf of the unsharded name, so the separator before the shard index is
# `-` or `.gguf-`. Without that alternative every shard tags as its own quant
# and a 213gib model reads as five that each fit.
#
# The tag is either the whole stem or a `-`-separated field in it, and it is
# matched case-insensitively, because publishers do all three: unsloth writes
# `Model-UD-IQ4_XS.gguf`, andrijdavid writes a bare `Q8_0.gguf`, rodrigomt
# writes `s2-pro-q8_0.gguf`. The last two matched nothing and fell to the
# filename fallback below, which is a key no registry would think to write --
# so voxtral and s2-pro simply went unsized, with no error to notice.
#
# `_` is deliberately NOT a separator. kokoro ships `Kokoro_espeak_Q8.gguf`
# beside `Kokoro_no_espeak_Q8.gguf`, and admitting `_` collapses two different
# files into one `Q8` holding their combined bytes.
# The digit after the type is load-bearing: without it `F` alone matches the
# first letter of `Fixture_espeak_Q8.gguf` and the lazy tail swallows the whole
# stem. Every quant tag in this corpus is a type followed by a number --
# IQ4_XS, Q8_0, BF16, MXFP4, TQ1_0 -- so requiring one is what keeps `^` safe.
QUANT = re.compile(r"(?:^|-)((?:UD-|AD-)?(?:IQ|Q|BF|F|MXFP|NVFP|TQ)\d[A-Za-z0-9_]*?)"
                   r"(?:(?:\.gguf)?-\d{5}-of-\d{5})?\.gguf$", re.I)
# what counts as weights. whisper.cpp publishes 33 ggml `.bin` files and not a
# single gguf, so a `.gguf`-only filter skipped the repo entirely and it never
# appeared in the output at all -- a different failure from a mis-parsed tag,
# and a quieter one. `ggml-` keeps this to that convention rather than
# sweeping up every stray .bin a repo happens to carry.
WEIGHTS = re.compile(r"(?:\.gguf|^ggml-[^/]*\.bin)$", re.I)
# Speculative-decoding sidecars are named after the *target* quant, so
# `dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf` otherwise tags as a 10gib "Q8_0"
# quant of a 284b model.
#
# Position is what separates a sidecar from a main model that embeds the draft
# head, and both naming styles are in use:
#   dspark-DeepSeek-...-Q8_0.gguf   marker before the quant -> a 10gib drafter
#   Bonsai-27B-dspark-Q4_1.gguf     marker before the quant -> a 1.7gib drafter
#   Hy3-Q2_K_XL-mtp.gguf            marker after the quant  -> the 94gib model
# A file with no recognisable quant token at all (dflash-kquant.gguf,
# ...-dspark-bf16.gguf) is a sidecar whatever the position.
SIDECAR = re.compile(r"\b(dspark|dflash|mtp|eagle3)\b", re.I)
QUANT_AT = re.compile(r"(?:UD-|AD-)?(?:IQ|Q|BF|F|MXFP|NVFP|TQ)\d[A-Za-z0-9_]*")


def is_sidecar(path):
    m = SIDECAR.search(path)
    if not m:
        return False
    q = QUANT_AT.search(path)
    return m.start() < q.start() if q else True


HERE = os.path.dirname(os.path.abspath(__file__))

# a quantizer adds rungs to a repo in the days after release and then stops. the
# etag makes each revalidation free in bytes but not in round trips, and there
# is one per repo, so the window is what keeps a daily sweep off the network
MAX_AGE = 48 * 3600


def tree(repo, max_age=MAX_AGE, refresh=False):
    # the hub sends etags, so a revalidation past the window is a cheap 304
    cmd = [os.path.join(HERE, "httpcache"), TREE % repo,
           "--key", "hf-" + repo.replace("/", "_"), "--max-age", str(max_age)]
    if refresh:
        cmd.append("--refresh")
    out = subprocess.run(cmd, stdout=subprocess.PIPE, text=True).stdout
    try:
        t = json.loads(out)
    except ValueError:
        return None
    return t if isinstance(t, list) else None


def quants(repo, max_age=MAX_AGE, refresh=False):
    t = tree(repo, max_age, refresh)
    if t is None:
        return None
    agg = collections.defaultdict(int)
    for e in t:
        path = e.get("path", "")
        if e.get("type") != "file" or not WEIGHTS.search(path):
            continue
        size = e.get("size") or (e.get("lfs") or {}).get("size") or 0
        if "/" in path:
            tag = path.split("/")[0]
        else:
            m = QUANT.search(path)
            # uppercased so `s2-pro-q8_0.gguf` and `Model-Q8_0.gguf` are one
            # rung. every tag that matched before this was already uppercase,
            # so no existing key moves
            tag = m.group(1).upper() if m else path
        if "mmproj" in path.lower():
            tag = "mmproj:" + tag
        elif is_sidecar(path):
            marker = SIDECAR.search(path).group(1).lower()
            if not tag.lower().startswith(marker):
                tag = "%s:%s" % (marker, tag)
        agg[tag] += size
    return dict(agg)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--repos", default="repos.txt")
    ap.add_argument("--out", default="data/gguf-sizes.json")
    ap.add_argument("--max-age", type=int, default=MAX_AGE,
                    help="skip revalidation entirely below this age; 0 always revalidates")
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--allow-shrink", action="store_true",
                    help="write even when the result holds fewer records "
                         "than the capture on disk")
    args = ap.parse_args()

    with open(args.repos) as f:
        extra = [l.split("#")[0].strip() for l in f]
    # the registry names every gguf repo a consumer can select; repos.txt adds
    # the ones sized only to show they do NOT fit. union, so neither list has to
    # be the complete one -- keyed case-insensitively because the hub resolves
    # either spelling, and repos.txt's gemma-4-31b-it against the registry's
    # gemma-4-31B-it was fetching one repo twice and storing it as two
    repos = {r.lower(): r for r in extra if r}
    try:
        import yaml
        reg = os.path.join(HERE, "..", "registry", "models.yaml")
        for m in ((yaml.safe_load(open(reg)) or {}).get("models") or {}).values():
            for q in (m.get("quants") or []) + (m.get("components") or []):
                if q.get("repo"):
                    repos[q["repo"].lower()] = q["repo"]
    except (IOError, ImportError):
        pass

    out = {}
    for repo in sorted(repos.values()):
        q = quants(repo, args.max_age, args.refresh)
        if q is None:
            print("  %-52s unavailable" % repo, file=sys.stderr)
            continue
        out[repo] = {k: v for k, v in sorted(q.items(), key=lambda kv: kv[1])}
        print("  %-52s %d quants" % (repo, len(q)), file=sys.stderr)

    written, now, before = capture.write(args.out, out, len, args.allow_shrink,
                                         "repos")
    print("%s %s: %d repos" % ("wrote" if written else "did NOT write",
                               args.out, len(out)))
    if not written:
        sys.exit(capture.refused(args.out, now, before, "repos"))


if __name__ == "__main__":
    main()
