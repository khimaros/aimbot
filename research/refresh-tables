#!/usr/bin/env python3

"""Re-run every generated table in MODELS.md and write the output back.

The document marks each generated block with the command that produced it:

    <!-- generated by research/build-tables --table score -->
    | model | score | ...

This finds those markers, runs the command, and replaces the markdown table
immediately below. Hand-swapping them was how a refreshed capture left half the
document quoting the previous one -- adding a model changes six tables, and the
ones nobody remembered to regenerate were the ones that went stale.

    ./refresh-tables            # rewrite MODELS.md in place
    ./refresh-tables --check    # exit 1 if any table is out of date
    ./refresh-tables --diff     # show what would change
"""

import argparse
import difflib
import os
import re
import subprocess
import sys

MARKER = re.compile(r"<!--\s*generated by (.+?)\s*-->")
HERE = os.path.dirname(os.path.abspath(__file__))
DOC = os.path.join(HERE, "..", "MODELS.md")


def run(cmd):
    """Run a marker's command from the repo root, since that is how it is written."""
    argv = cmd.split()
    argv[0] = os.path.join(HERE, "..", argv[0])
    r = subprocess.run(argv, cwd=HERE, stdout=subprocess.PIPE, text=True)
    if r.returncode != 0:
        raise SystemExit("%s failed (%d)" % (cmd, r.returncode))
    return [l for l in r.stdout.strip().split("\n") if l.startswith("|")]


def rewrite(lines):
    """Replace each marked table with fresh output; return (lines, [changed cmds])."""
    out, changed, i = [], [], 0
    while i < len(lines):
        out.append(lines[i])
        m = MARKER.search(lines[i])
        i += 1
        if not m:
            continue
        # keep the blank line the marker is followed by, then swallow the table
        while i < len(lines) and not lines[i].startswith("|"):
            out.append(lines[i])
            i += 1
        old = []
        while i < len(lines) and lines[i].startswith("|"):
            old.append(lines[i])
            i += 1
        new = run(m.group(1))
        if old != new:
            changed.append(m.group(1))
        out.extend(new)
    return out, changed


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--doc", default=DOC)
    ap.add_argument("--check", action="store_true", help="exit 1 if anything is stale")
    ap.add_argument("--diff", action="store_true")
    args = ap.parse_args()

    lines = open(args.doc).read().split("\n")
    new, changed = rewrite(lines)

    if args.diff:
        sys.stdout.writelines(difflib.unified_diff(
            [l + "\n" for l in lines], [l + "\n" for l in new], "before", "after"))
    if not changed:
        print("all %d tables current" % len(MARKER.findall("\n".join(lines))))
        return
    print("stale: %s" % ", ".join(changed))
    if args.check:
        sys.exit(1)
    if not args.diff:
        with open(args.doc, "w") as f:
            f.write("\n".join(new))
        print("rewrote %s" % os.path.relpath(args.doc, HERE))


if __name__ == "__main__":
    main()
