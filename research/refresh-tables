#!/usr/bin/env python3

"""Re-run every generated block in MODELS.md and write the output back.

The document marks each generated block with the command that produced it:

    <!-- generated by research/build-tables --table unscored -->
    | model | quant | ...

This finds those markers, runs the command, and replaces what follows. Hand-
swapping them was how a refreshed capture left half the document quoting the
previous one -- adding a model changes six tables, and the ones nobody
remembered to regenerate were the ones that went stale.

A block is a TABLE by default, which ends where the pipes stop. Prose cannot be
delimited that way, so a generator that emits prose closes its block with an
explicit end marker and everything between the two is replaced:

    <!-- generated by research/build-sections --section picks -->
    ...anything at all...
    <!-- end generated -->

That is what lets the written judgement live in `usecase-assessed.json` and be
rendered here, rather than being typed twice and diverging.

    ./refresh-tables            # rewrite MODELS.md in place
    ./refresh-tables --check    # exit 1 if any block is out of date
    ./refresh-tables --diff     # show what would change
"""

import argparse
import difflib
import os
import re
import subprocess
import sys

MARKER = re.compile(r"<!--\s*generated by (.+?)\s*-->")
END = re.compile(r"<!--\s*end generated\s*-->")
HERE = os.path.dirname(os.path.abspath(__file__))
DOC = os.path.join(HERE, "..", "MODELS.md")


def run(cmd, table_only=True):
    """Run a marker's command from the repo root, since that is how it is written."""
    argv = cmd.split()
    argv[0] = os.path.join(HERE, "..", argv[0])
    r = subprocess.run(argv, cwd=HERE, stdout=subprocess.PIPE, text=True)
    if r.returncode != 0:
        raise SystemExit("%s failed (%d)" % (cmd, r.returncode))
    lines = r.stdout.strip().split("\n")
    return [l for l in lines if l.startswith("|")] if table_only else lines


def rewrite(lines):
    """Replace each marked table with fresh output; return (lines, [changed cmds])."""
    out, changed, i = [], [], 0
    while i < len(lines):
        out.append(lines[i])
        m = MARKER.search(lines[i])
        i += 1
        if not m:
            continue
        # a prose block declares where it ends; a table ends where the pipes do
        closed = next((j for j in range(i, len(lines)) if END.search(lines[j])), None)
        if closed is not None and not any(
                MARKER.search(lines[j]) for j in range(i, closed)):
            old, i = lines[i:closed], closed
            new = run(m.group(1), table_only=False)
        else:
            # keep the blank line the marker is followed by, then swallow the table
            while i < len(lines) and not lines[i].startswith("|"):
                out.append(lines[i])
                i += 1
            old = []
            while i < len(lines) and lines[i].startswith("|"):
                old.append(lines[i])
                i += 1
            new = run(m.group(1))
        if old != new:
            changed.append(m.group(1))
        out.extend(new)
    return out, changed


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--doc", default=DOC)
    ap.add_argument("--check", action="store_true", help="exit 1 if anything is stale")
    ap.add_argument("--diff", action="store_true")
    args = ap.parse_args()

    lines = open(args.doc).read().split("\n")
    new, changed = rewrite(lines)

    if args.diff:
        sys.stdout.writelines(difflib.unified_diff(
            [l + "\n" for l in lines], [l + "\n" for l in new], "before", "after"))
    if not changed:
        print("all %d blocks current" % len(MARKER.findall("\n".join(lines))))
        return
    print("stale: %s" % ", ".join(changed))
    if args.check:
        sys.exit(1)
    if not args.diff:
        with open(args.doc, "w") as f:
            f.write("\n".join(new))
        print("rewrote %s" % os.path.relpath(args.doc, HERE))


if __name__ == "__main__":
    main()
