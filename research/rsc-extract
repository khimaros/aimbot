#!/usr/bin/env python3

"""Extract JSON records from a next.js RSC flight payload; emit one per line.

    rsc-extract <url> --match '"modelKey":' [--key NAME] [--max-age S] [--refresh]

Three of the sites this repo reads -- artificial analysis, lmarena and
swe-rebench -- are next.js apps with no public api that ship their entire
dataset inline as an RSC stream, split across `self.__next_f.push([1, "..."])`
calls. Reassembling those chunks yields the page's data as JSON.

--match is a literal substring, and what gets emitted is the JSON object
*enclosing* each occurrence, so matching a field name returns whole records,
with flight's `$undefined` sentinel decoded to null. Output is json lines,
which keeps this a filter: each collector pipes it into whatever shaping that
site needs rather than importing anything.

Fetching goes through ./httpcache, so callers inherit its etag revalidation,
--max-age and stale-on-failure behaviour.
"""

import argparse
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
CHUNK = re.compile(r'self\.__next_f\.push\(\[1,(".*?")\]\)</script>', re.S)
UNDEFINED = "$undefined"


def flight_payload(html):
    """Reassemble the RSC stream from the __next_f chunks."""
    buf = ""
    for chunk in CHUNK.findall(html):
        try:
            buf += json.loads(chunk)
        except ValueError:
            pass
    return buf


def decode(o):
    """Flight sentinels to python values.

    The RSC wire format writes a missing value as the STRING `$undefined`
    rather than omitting the key, so a field artificial analysis never measured
    arrives as text sitting in a column of floats -- which ranks as a TypeError
    the first time something sorts or compares it. Every other `$` string in
    these payloads is a lazy-module or symbol reference belonging to the react
    element tree rather than to a data record, so it is passed through.
    """
    if isinstance(o, dict):
        return {k: decode(v) for k, v in o.items()}
    if isinstance(o, list):
        return [decode(v) for v in o]
    return None if o == UNDEFINED else o


def object_at(s, pos):
    """Return the JSON object enclosing pos, or None.

    Walks back to the opening brace, then forward with a string-aware depth
    count so braces inside string values do not terminate the object early.
    """
    i, depth = pos, 0
    while i >= 0:
        if s[i] == "}":
            depth += 1
        elif s[i] == "{":
            if depth == 0:
                break
            depth -= 1
        i -= 1
    if i < 0:
        return None
    depth, instr, esc = 0, False, False
    for j in range(i, len(s)):
        c = s[j]
        if instr:
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                instr = False
        elif c == '"':
            instr = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return s[i:j + 1]
    return None


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("url")
    ap.add_argument("--match", required=True, help="literal substring; the enclosing object is emitted")
    ap.add_argument("--key", help="httpcache cache name")
    ap.add_argument("--max-age", type=int, default=6 * 3600)
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--header", action="append", default=[])
    ap.add_argument("--min-bytes", type=int, default=100000,
                    help="fail rather than emit nothing if the page came back short")
    args = ap.parse_args()

    cmd = [os.path.join(HERE, "httpcache"), args.url, "--max-age", str(args.max_age)]
    if args.key:
        cmd += ["--key", args.key]
    if args.refresh:
        cmd.append("--refresh")
    for h in args.header:
        cmd += ["--header", h]
    html = subprocess.run(cmd, stdout=subprocess.PIPE, text=True).stdout
    if len(html) < args.min_bytes:
        sys.exit("fetch failed or page too small: %d bytes" % len(html))

    buf = flight_payload(html)
    if not buf:
        sys.exit("no __next_f chunks -- the page is probably not a next.js app any more")

    n = 0
    for m in re.finditer(re.escape(args.match), buf):
        frag = object_at(buf, m.start())
        if not frag:
            continue
        try:
            rec = decode(json.loads(frag))
        except ValueError:
            continue
        print(json.dumps(rec, sort_keys=True))
        n += 1
    if not n:
        sys.exit("payload had no object matching %r -- the page structure changed" % args.match)
    print("%s: %d records from %d payload chars" % (args.url[:60], n, len(buf)), file=sys.stderr)


if __name__ == "__main__":
    main()
