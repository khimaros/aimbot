       "a speech model has no forum prose to match, so it is not: %r" % out)


# a llama.cpp small enough to build in a test and shaped like the real one in
# the three places the collector reads: the arch table, the file types and the
# tensor types. `qwen3tts` is here unhyphenated on purpose -- it is the near
# miss that a header spelling it `qwen3-tts` has to be caught by
ARCH_CPP_V1 = """
static const std::map<llm_arch, const char *> LLM_ARCH_NAMES = {
    { LLM_ARCH_LLAMA, "llama" },
};
"""
ARCH_CPP_V2 = ARCH_CPP_V1.replace(
    '{ LLM_ARCH_LLAMA, "llama" },',
    '{ LLM_ARCH_LLAMA, "llama" },\n    { LLM_ARCH_QWEN3TTS, "qwen3tts" },')
LLAMA_H = "enum llama_ftype {\n    LLAMA_FTYPE_MOSTLY_Q4_K_M = 15,\n};\n"
GGML_H = "enum ggml_type {\n    GGML_TYPE_Q4_K = 12,\n};\n"


def fake_llama_cpp(tmp):
    """A git repo where `qwen3tts` arrives in a later, tagged commit."""
    d = os.path.join(tmp, "llama.cpp")
    os.makedirs(os.path.join(d, "src"))
    os.makedirs(os.path.join(d, "include"))
    os.makedirs(os.path.join(d, "ggml", "include"))

    def git(*a):
        subprocess.run(("git", "-C", d, "-c", "user.email=t@t", "-c", "user.name=t")
                       + a, check=True, capture_output=True)

    subprocess.run(("git", "init", "-q", "-b", "master", d), check=True,
                   capture_output=True)
    write = lambda p, s: open(os.path.join(d, p), "w").write(s)
    write("include/llama.h", LLAMA_H)
    write("ggml/include/ggml.h", GGML_H)
    write("src/llama-arch.cpp", ARCH_CPP_V1)
    git("add", "-A")
    git("commit", "-qm", "first")
    git("tag", "b1000")
    write("src/llama-arch.cpp", ARCH_CPP_V2)
    git("add", "-A")
    git("commit", "-qm", "add qwen3tts")
    git("tag", "b2000")
    # a later release, so "first tag containing it" has to pick b2000 not b3000
    write("src/llama-arch.cpp", ARCH_CPP_V2 + "// later\n")
    git("add", "-A")
    git("commit", "-qm", "unrelated")
    git("tag", "b3000")
    return d


SUPPORT_REGISTRY = """
version: 1
models:
  Vendor/Supported:
    kind: text
    quants:
    - {repo: Test-Support/Supported-GGUF, quant: Q4_K_M}
  Vendor/Hyphenated:
    kind: text
    quants:
    - {repo: Test-Support/Hyphenated-GGUF, quant: Q4_K_M}
"""


def seed_gguf_header(repo, architecture):
    """Put huggingface's parse of a gguf header in the cache the collector reads."""
    key = "facts-%s-ggufmeta" % repo.replace("/", "_")
    purge(key)
    with open(os.path.join(CACHE, key + ".body"), "w") as f:
        json.dump({"gguf": {"architecture": architecture}}, f)
    return key


@test
def llama_support_dates_an_arch_from_the_release_that_introduced_it():
    """the oldest build that loads a file, resolved rather than typed.

    Runs the real collector against a real git history, so what is under test
    is the `-S` search and the tag walk -- the two things that would silently
    return the wrong release if either were subtly wrong. b3000 also contains
    the commit; the answer is the FIRST tag that does, which is b2000.
    """
    tmp = tempfile.mkdtemp()
    keys = [seed_gguf_header("Test-Support/Supported-GGUF", "qwen3tts"),
            seed_gguf_header("Test-Support/Hyphenated-GGUF", "qwen3-tts")]
    try:
        reg = os.path.join(tmp, "models.yaml")
        with open(reg, "w") as f:
            f.write(SUPPORT_REGISTRY)
        out = os.path.join(tmp, "llama-support.json")
        r = subprocess.run(
            [os.path.join(RESEARCH, "fetch-llama-support"), "--registry", reg,
             "--llama", fake_llama_cpp(tmp), "--ref", "master", "--out", out,
             "--max-age", "86400"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if r.returncode:
            raise AssertionError("fetch-llama-support exited %d: %s"
                                 % (r.returncode, r.stderr.strip()))
        got = json.load(open(out))
    finally:
        for k in keys:
            purge(k)
        shutil.rmtree(tmp)

    eq(got["arch"]["qwen3tts"]["mainline"], True, "the arch mainline carries")
    eq(got["arch"]["qwen3tts"]["since"], "b2000",
       "the FIRST release containing the commit, not the newest")
    eq(got["arch"]["qwen3tts"].get("near"), None, "an exact hit needs no near")

    # the failure that costs the most to miss: the lookup is `==`, so a header
    # one hyphen off matches nothing and the file does not load
    eq(got["arch"]["qwen3-tts"]["mainline"], False, "a hyphenated header is absent")
    eq(got["arch"]["qwen3-tts"]["near"], "qwen3tts", "and names the spelling it misses")

    eq(got["quants"], ["Q4_K", "Q4_K_M"], "both type tables are captured")
    eq(got["repos"]["Test-Support/Supported-GGUF"], "qwen3tts", "repo to arch")


@test
def a_model_off_mainline_must_say_where_to_get_a_build():
    """`mainline: false` alone asserts a file loads nowhere, which is never true."""
    base = """
version: 1
models:
  Vendor/Model:
    kind: text
