@test
def an_alias_that_claims_a_sibling_is_an_error():
    """`name.match` is a regex over forum prose and must not claim another model.

    Every matching model counts the sentence, so an overlap inflates the
    flagship with its sibling's reception and leaves the sibling reading as
    undiscussed. CONTRIBUTING.md has said so since `ling[\\s-]*3\\.0` swallowed
    ling 3.0 tiny, but nothing checked it, so it came back as `\\bornith\\b`.
    """
    code, findings, _ = validate(SIBLING_REGISTRY)
    hits = [x for x in findings if "widget 1.0 9b" in x["error"]]
    eq(len(hits), 1, "the overlap is one finding, got %r" % (findings,))
    eq(hits[0]["where"], "Fixture/Widget-1.0-35B",
       "reported against the pattern that is too broad, not its victim")
    eq(code, 1, "an overlap fails the lint rather than printing a note")


