def tts_fixture_html():
    """One text-to-speech row in the shape the real page ships it.

    The score sits on the nested `model`, so the collector matches the OUTER
    row's price field and reaches in for it -- which is the part of the field
    table a fixture has to exercise.
    """
    record = {"pricePer1mCharacters": 30,
              "host": {"name": "Fixture Host"},
              "performance": {"medianCharactersPerSecond": 51.0},
              "model": {"name": "Fixture TTS", "slug": "fixture-tts",
                        "isOpenWeights": True, "qualityElo": 1100.5,
                        "releaseDate": "2026-01-01",
                        "creator": {"name": "Fixture Labs"},
                        "family": {"slug": "fixture"}}}
    payload = json.dumps({"endpoints": [record]})
    chunks = "".join(
        "<script>self.__next_f.push([1,%s])</script>" % json.dumps(part)
        for part in (payload[:len(payload) // 2], payload[len(payload) // 2:]))
    # rsc-extract refuses a page under 100kb, because a short body is how a
    # blocked or redirected fetch presents itself. that guard is the real one
    # this collector runs behind, so the fixture clears it rather than the test
    # asking for a lower bound the sweep would never use
    padding = "<!-- %s -->" % ("x" * 100000)
    return "<!doctype html><html><body>%s%s</body></html>" % (padding, chunks)


