#!/usr/bin/env python3

"""end-to-end tests for the research collectors.

    ./tests/collectors

the viewer suite in ./e2e boots the shipped page; this one exercises the python
side of the sweep the way the sweep runs it: the REAL executable as a
subprocess, over a REAL http request, against a fixture served from localhost.
nothing here reaches the network, and nothing here imports a collector -- a
collector that only works when imported is not what `make sweep` runs.

each case gets its own httpcache key under a `test-` prefix and removes it
afterwards, so a run leaves the real cache untouched.
"""

import http.server
import json
import os
import shutil
import socketserver
import subprocess
import sys
import tempfile
import threading

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
RESEARCH = os.path.join(ROOT, "research")
CACHE = os.path.join(RESEARCH, ".cache")

# a next.js page ships its data as escaped json inside __next_f chunks. the
# flight encoding writes a missing value as the STRING "$undefined" rather than
# omitting the key, which is the whole point of this fixture
RECORDS = [
    {"slug": "has-everything", "name": "Has Everything",
     "intelligenceIndex": 42.5, "medianOutputTokensPerSecond": 137.0,
     "omniscienceAccuracy": 0.61},
    {"slug": "no-speed", "name": "No Speed",
     "intelligenceIndex": 31.0, "medianOutputTokensPerSecond": "$undefined",
     "omniscienceAccuracy": "$undefined"},
]

cases = []


def test(fn):
    cases.append(fn)
    return fn


def fixture_html():
    """the records wrapped the way next.js streams them."""
    payload = json.dumps({"models": RECORDS})
    chunks = "".join(
        "<script>self.__next_f.push([1,%s])</script>" % json.dumps(part)
        for part in (payload[:len(payload) // 2], payload[len(payload) // 2:]))
    return "<!doctype html><html><body>%s</body></html>" % chunks


class Serve(socketserver.TCPServer):
    allow_reuse_address = True


def serve(directory):
    """(url_base, shutdown) for a localhost server over `directory`."""
    handler = lambda *a, **kw: http.server.SimpleHTTPRequestHandler(
        *a, directory=directory, **kw)
    httpd = Serve(("127.0.0.1", 0), handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    return "http://127.0.0.1:%d" % httpd.server_address[1], httpd.shutdown


def purge(key):
    for name in (key + ".body", key + ".meta", key + ".body.new", key + ".meta.hdr"):
        p = os.path.join(CACHE, name)
        os.path.exists(p) and os.remove(p)


def rsc_extract(url, key, match='"intelligenceIndex":'):
    """[record] as the collectors get them, straight off the executable."""
    purge(key)
    try:
        r = subprocess.run([os.path.join(RESEARCH, "rsc-extract"), url,
                            "--match", match, "--key", key,
                            "--min-bytes", "200", "--max-age", "0"],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    finally:
        purge(key)
    if r.returncode:
        raise AssertionError("rsc-extract exited %d: %s" % (r.returncode, r.stderr.strip()))
    return [json.loads(l) for l in r.stdout.splitlines()]


def eq(got, want, what):
    if got != want:
        raise AssertionError("%s: got %r, want %r" % (what, got, want))


def validate(models_yaml, *flags):
    """(returncode, findings, stdout) from models-validate over a fixture registry.

    sampling.yaml is the real one: the fixtures here are about names, and a
    profile that does not resolve would fail them for the wrong reason.
    """
    tmp = tempfile.mkdtemp()
    try:
        with open(os.path.join(tmp, "models.yaml"), "w") as f:
            f.write(models_yaml)
        shutil.copy(os.path.join(ROOT, "registry", "sampling.yaml"), tmp)
        facts = os.path.join(tmp, "facts.json")
        with open(facts, "w") as f:
            f.write("{}")
        argv = [os.path.join(ROOT, "scripts", "models-validate"),
                "--registry", tmp, "--facts", facts]
        # a report writes to the same stdout the json goes to, so the findings
        # come from a run with no report flag on it
        r = subprocess.run(argv + ["--json"],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        plain = subprocess.run(argv + list(flags),
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    finally:
        shutil.rmtree(tmp)
    try:
        findings = json.loads(r.stdout)
    except ValueError:
        raise AssertionError("models-validate wrote no json: %s" % r.stderr.strip())
    return r.returncode, findings, plain.stdout


@test
def flight_undefined_becomes_null():
    """a missing value must not reach a collector as the string "$undefined".

    percentile ranking in analyze-usecase compares facet values against the
    cohort, so one string in a population of floats is a TypeError that kills
    the whole sweep rather than dropping one number.
    """
    tmp = tempfile.mkdtemp()
    try:
        with open(os.path.join(tmp, "page.html"), "w") as f:
            f.write(fixture_html())
        base, stop = serve(tmp)
        try:
            recs = rsc_extract(base + "/page.html", "test-rsc-undefined")
        finally:
            stop()
    finally:
        shutil.rmtree(tmp)

    by_slug = {r["slug"]: r for r in recs}
    eq(sorted(by_slug), ["has-everything", "no-speed"], "records extracted")

    missing = by_slug["no-speed"]
    eq(missing["medianOutputTokensPerSecond"], None, "an absent speed is null")
    eq(missing["omniscienceAccuracy"], None, "an absent omniscience score is null")
    eq(missing["intelligenceIndex"], 31.0, "a real number beside it survives")
    eq(missing["name"], "No Speed", "a real string beside it survives")

    present = by_slug["has-everything"]
    eq(present["medianOutputTokensPerSecond"], 137.0, "a measured speed is untouched")
    eq(present["omniscienceAccuracy"], 0.61, "a measured score is untouched")


REGISTRY_FIXTURE = """version: 1
models:
  Vendor/Model-A:
    quants:
    - {repo: Quanter/Model-A-GGUF, quant: Q8_0}
    - {repo: Other/Model-A-GGUF, quant: F16}
  Vendor/Model-B:
    quants:
    - {repo: Quanter/MODEL-b-GGUF, quant: Q8_0}
    components:
    - {repo: Vendor/Model-B-Encoder, quant: F16}
"""


@test
def tracked_counts_the_registry_not_just_repos_txt():
    """a repo the registry serves is carried, however it got there.

    repos.txt is a hand-kept sizing list and the registry is the roster, so
    reading only the former puts repos this document already serves under a
    heading that says it does not carry them. case is folded because the hub
    and the registry disagree on it for the same repo.
    """
    tmp = tempfile.mkdtemp()
    try:
        reg = os.path.join(tmp, "models.yaml")
        repos = os.path.join(tmp, "repos.txt")
        with open(reg, "w") as f:
            f.write(REGISTRY_FIXTURE)
        with open(repos, "w") as f:
            f.write("Seeded/Only-In-Repos-Txt\n# a comment\n\n")
        r = subprocess.run([os.path.join(RESEARCH, "fetch-hf-catalog"), "--tracked",
                            "--repos", repos, "--registry", reg],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    finally:
        shutil.rmtree(tmp)
    if r.returncode:
        raise AssertionError("fetch-hf-catalog --tracked exited %d: %s"
                             % (r.returncode, r.stderr.strip()))
    got = set(r.stdout.split())

    eq("vendor/model-a" in got, True, "a base repo is carried")
    eq("quanter/model-a-gguf" in got, True, "a quant source is carried")
    eq("other/model-a-gguf" in got, True, "a second quant source is carried")
    eq("vendor/model-b-encoder" in got, True, "a component repo is carried")
    eq("seeded/only-in-repos-txt" in got, True, "repos.txt still counts")
    eq("quanter/model-b-gguf" in got, True, "case is folded, not compared raw")
    eq(sorted(got), sorted(x.lower() for x in got), "everything is lowercased")
    eq("# a comment" in got, False, "comments are not repos")

# a tree listing exercising every naming convention this corpus has run into.
# served from the httpcache rather than a socket: fetch-gguf-sizes builds its
# own hub url, so seeding the cache is what makes the REAL executable run with
# no network instead of adding a --url flag only a test would pass.
SIZE_REPO = "test-sizes/Fixture-GGUF"
SIZE_TREE = [
    # the shape the tag regex was written for, sharded
    {"type": "file", "path": "Fixture-UD-IQ4_XS-00001-of-00002.gguf", "size": 3},
    {"type": "file", "path": "Fixture-UD-IQ4_XS-00002-of-00002.gguf", "size": 4},
    # andrijdavid ships voxtral as a bare tag: the filename IS the quant
    {"type": "file", "path": "Q8_0.gguf", "size": 10},
    # rodrigomt ships s2-pro lowercased
    {"type": "file", "path": "fixture-q4_k_m.gguf", "size": 20},
    # kokoro separates its variants with `_`, so `_` must NOT be a separator or
    # these two collapse into one bogus `Q8` worth their combined size
    {"type": "file", "path": "Fixture_espeak_Q8.gguf", "size": 100},
    {"type": "file", "path": "Fixture_no_espeak_Q8.gguf", "size": 200},
    # whisper.cpp publishes ggml `.bin`, never gguf
    {"type": "file", "path": "ggml-large-v3-turbo-q8_0.bin", "size": 40},
    {"type": "file", "path": "mmproj-F16.gguf", "size": 5},
    {"type": "file", "path": "README.md", "size": 1},
]


def seed_cache(key, payload, raw=False):
    """Put a body in the http cache so a collector replays it offline."""
    os.path.isdir(CACHE) or os.makedirs(CACHE)
    body = os.path.join(CACHE, key + ".body")
    with open(body, "w") as f:
        f.write(payload) if raw else json.dump(payload, f)
    with open(os.path.join(CACHE, key + ".meta"), "w") as f:
        json.dump({}, f)
    return [body, os.path.join(CACHE, key + ".meta")]


@test
def every_publisher_naming_convention_yields_a_quant_tag():
    """A tag the sizer cannot parse is not an error, it is a missing model.

    The fallback records the whole filename, so a repo either happens to match
    the naming the regex expects or the registry has to be hand-fitted to a
    filename. voxtral and whisper went unsized that way and became invisible
    to a consumer's memory budget -- no warning, just absent.
    """
    key = "hf-" + SIZE_REPO.replace("/", "_")
    written = seed_cache(key, SIZE_TREE)
    tmp = tempfile.mkdtemp()
    try:
        repos = os.path.join(tmp, "repos.txt")
        with open(repos, "w") as f:
            f.write(SIZE_REPO + "\n")
        out = os.path.join(tmp, "sizes.json")
        r = subprocess.run([os.path.join(RESEARCH, "fetch-gguf-sizes"),
                            "--repos", repos, "--out", out, "--max-age", "3600"],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if r.returncode:
            raise AssertionError("fetch-gguf-sizes exited %d: %s"
                                 % (r.returncode, r.stderr.strip()))
        with open(out) as f:
            got = json.load(f)[SIZE_REPO]
    finally:
        shutil.rmtree(tmp)
        for p in written:
            os.path.exists(p) and os.remove(p)

    eq(got.get("UD-IQ4_XS"), 7, "shards of one rung aggregate, as before")
    eq(got.get("Q8_0"), 10, "a bare `Q8_0.gguf` is the tag, not a filename")
    eq(got.get("Q4_K_M"), 20, "a lowercase tag is read and normalised")
    eq(got.get("mmproj:F16"), 5, "the projector is still marked, not counted as a rung")
    eq("README.md" in got, False, "a non-weight file is not a quant")
    eq(got.get("ggml-large-v3-turbo-q8_0.bin"), 40,
       "ggml .bin is summed: whisper publishes nothing else")
    # the collision guard: `_` is not a separator
    eq(got.get("Fixture_espeak_Q8.gguf"), 100, "an `_`-separated variant keeps its name")
    eq(got.get("Fixture_no_espeak_Q8.gguf"), 200, "and so does the one beside it")
    eq(got.get("Q8"), None, "the two never collapse into one bogus rung")

# the shape that reached the vendor tab as literal markup. a card is markdown
# WITH html in it, and qwen3.8-flash-next's benchmark footnote opens with a
# 70-character <p style> before it says anything -- which both rendered
# verbatim and pushed "evaluated ... harnesses" past the 80 characters the
# harness filter reads, so a methodology note passed as a recommendation
CARD_FIXTURE = """---
license: other
---

# Fixture

## Best Practices

- Thinking Mode: `temperature=1.0`, `top_p=0.95`, `top_k=20`, `min_p=0.0`
- Instruct (or non-thinking) mode: `temperature=0.7`, `top_p=0.80`, `top_k=20`, `min_p=0.5`

<p style="margin-top:12px;font-size:10px;line-height:1.4;opacity:0.7">1. DeepSWE 1.1: evaluated with the Claude Code and mini-SWE-agent harnesses, temperature=0.6, top_p=0.8, 256K context window.</p>
"""

CARD_REGISTRY = """version: 1
models:
  Fixture/Card-Model:
    kind: text
    name: {short: fixture card model}
"""


@test
def a_card_label_is_prose_not_markup():
    """A sampler label is shown to a reader, so it cannot be an html tag.

    Stripping tags is not cosmetic: the label is also what the harness filter
    tests, and 70 characters of inline style crowd the words that identify a
    benchmark note out of the window it looks at. So the markup made a
    methodology footnote look like a recommendation to run the model at.
    """
    repo = "Fixture/Card-Model"
    written = seed_cache("card-" + repo.replace("/", "_"), CARD_FIXTURE, raw=True)
    written += seed_cache("hub-" + repo.replace("/", "_"), {}, raw=False)
    tmp = tempfile.mkdtemp()
    try:
        reg = os.path.join(tmp, "models.yaml")
        with open(reg, "w") as f:
            f.write(CARD_REGISTRY)
        out = os.path.join(tmp, "cards.json")
        r = subprocess.run([os.path.join(RESEARCH, "fetch-model-cards"),
                            "--registry", reg, "--out", out,
                            "--max-age", "3600"],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if r.returncode:
            raise AssertionError("fetch-model-cards exited %d: %s"
                                 % (r.returncode, r.stderr.strip()))
        with open(out) as f:
            sets = json.load(f)[repo]["samplers"]
    finally:
        shutil.rmtree(tmp)
        for q in written:
            os.path.exists(q) and os.remove(q)

    for x in sets:
        eq("<" in x["label"], False, "no label carries markup: %r" % x["label"])
    eq(len(sets), 2, "two modes, and the benchmark footnote is neither")
    # adjacent complete recommendations used to merge: flush only fired on a
    # line with NO sampler on it, and setdefault kept the first line's values,
    # so the second mode lost both its numbers and its name
    eq(sets[0]["label"], "Thinking Mode",
       "labelled by the prose that introduces it, without the values it "
       "already renders beside: %r" % sets[0]["label"])
    eq(sets[0]["values"].get("temp"), 1.0, "the first mode keeps its numbers")
    eq(sets[1]["label"], "Instruct (or non-thinking) mode",
       "the second mode keeps its own name: %r" % sets[1]["label"])
    eq(sets[1]["values"].get("temp"), 0.7, "and its own numbers")
    eq(sets[1]["values"].get("min_p"), 0.5, "not the first mode's")
    for x in sets:
        # the values are shown next to the label, so carrying them in the label
        # is noise -- and it is what pushed the text past the cap that then cut
        # `presence_penalty` in half as "presen"
        eq("=" in x["label"], False, "no label repeats its own values: %r" % x["label"])


