@test
def a_model_with_no_block_gets_one_rather_than_being_skipped():
    """only ever replacing a block means never filling one in.

    `resolve-ids` could rewrite an `ids:` block and not create one, so a model
    added without one was matched, counted as filled and silently dropped --
    qwen3.8 flash next carried AA and lmarena ids for a full capture that way
    and reached MODELS.md unscored. Both cases are checked together because the
    fix has to insert WITHOUT relocating the block the other model already has.
    """
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "registry_patch", os.path.join(ROOT, "scripts", "registry_patch.py"))
    rp = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(rp)

    tmp = tempfile.mkdtemp()
    try:
        path = os.path.join(tmp, "models.yaml")
        with open(path, "w") as f:
            f.write(PATCH_FIXTURE)
        n = rp.patch_blocks(path, {
            "Vendor/Has-Block": {"ids": ["    ids:", "      aa: new-value"]},
            "Vendor/No-Block": {"ids": ["    ids:", "      aa: fresh"]},
        }, after="quants")
        got = open(path).read()
    finally:
        shutil.rmtree(tmp)

    import yaml
    doc = yaml.safe_load(got)["models"]
    eq(n, 2, "both models patched")
    eq(doc["Vendor/No-Block"]["ids"], {"aa": "fresh"}, "a missing block is CREATED")
    eq(doc["Vendor/Has-Block"]["ids"], {"aa": "new-value"}, "an existing one is replaced")
    eq("old-value" in got, False, "and the old values are gone")

    # the rest of the file is the part a human wrote, and a deriver that
    # reformats it makes every future diff unreadable
    eq("a note a human wrote, which nothing here may reformat" in got, True,
       "prose survives")
    eq("# a comment explaining the sampling below" in got, True, "comments survive")
    # only keys that open a block; `notes:` carries its value inline
    lines = got.split("\n")
    order = [l.strip().rstrip(":") for l in lines
             if l.startswith("    ") and l.endswith(":") and not l.startswith("     ")]
    eq(order, ["quants", "sampling", "ids", "quants", "ids", "sampling"],
       "an existing block stays where it sat; only the new one goes after quants")

    # running it again must not append a second copy
    tmp = tempfile.mkdtemp()
    try:
        path = os.path.join(tmp, "models.yaml")
        with open(path, "w") as f:
            f.write(got)
        rp.patch_blocks(path, {"Vendor/No-Block": {"ids": ["    ids:", "      aa: fresh"]}},
                        after="quants")
        again = open(path).read()
    finally:
        shutil.rmtree(tmp)
    eq(again.count("      aa: fresh"), 1, "a second pass does not duplicate the block")


@test
def a_dead_source_cannot_empty_a_capture():
    """the failure that made this necessary, in the order it actually happened.

    `fetch-reddit --refresh` does not read the existing file -- that is what
    refresh means -- so when old.reddit stopped serving parseable html it
    rebuilt its output from nothing, fetched nothing, and wrote 0 searches, 0
    listings and 0 threads over a capture holding 38, 3 and 147. It exited
    non-zero AFTER the write, which is no protection at all, and
    `scripts/sweep --refresh` passes --refresh to every collector.

    Nothing in this repo can rebuild that corpus: it accumulated over months of
    sweeps from a source that no longer answers.
    """
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "capture", os.path.join(RESEARCH, "capture.py"))
    cap = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(cap)

    tmp = tempfile.mkdtemp()
    try:
        path = os.path.join(tmp, "capture.json")
        good = {"a": 1, "b": 2, "c": 3}
        eq(cap.write(path, good, len)[0], True, "the first write always lands")
        eq(json.load(open(path)), good, "and it is what was passed")

        # the dead-source shape: a run that produced nothing
        written, now, before = cap.write(path, {}, len)
        eq(written, False, "an empty result must not overwrite a full capture")
        eq((now, before), (0, 3), "and it reports both counts")
        eq(json.load(open(path)), good, "the capture on disk is untouched")

        # one record short is still short. the guard is crude on purpose, but a
        # source half-answering is exactly as unnoticed as one not answering
        eq(cap.write(path, {"a": 1, "b": 2}, len)[0], False, "n-1 is refused too")
        eq(len(json.load(open(path))), 3, "still untouched")

        # growing and staying level are the normal cases and must not be blocked
        eq(cap.write(path, {"a": 9, "b": 2, "c": 3}, len)[0], True,
           "same size, different contents, is a normal capture")
        eq(json.load(open(path))["a"], 9, "and the new contents are written")
        eq(cap.write(path, {"a": 1, "b": 2, "c": 3, "d": 4}, len)[0], True,
           "growing is the normal case")

        # a human who knows the smaller result is right can say so
        eq(cap.write(path, {"a": 1}, len, allow_shrink=True)[0], True,
           "--allow-shrink is the override")
        eq(len(json.load(open(path))), 1, "and it really writes")

        # no capture yet is not a shrink
        fresh = os.path.join(tmp, "new.json")
        eq(cap.write(fresh, {}, len)[0], True, "an empty first capture is allowed")
    finally:
        shutil.rmtree(tmp)


@test
def dotenv_configures_the_llm_without_overriding_the_environment():
    """`.env` is read, and loses to anything already exported.

    That order is what lets one run be pointed elsewhere without editing the
    file (`AIMBOT_LLM_MODEL=other make llm`), and what stops a stale `.env` from
    quietly winning over an endpoint somebody exported on purpose. It is also
    the half that is easy to get backwards.
    """
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "llm_under_test", os.path.join(RESEARCH, "llm.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)

    tmp = tempfile.mkdtemp()
    keep = {k: os.environ.get(k) for k in
            ("AIMBOT_LLM_URL", "AIMBOT_LLM_MODEL", "AIMBOT_LLM_KEY", "T_QUOTED")}
    try:
        path = os.path.join(tmp, ".env")
        with open(path, "w") as f:
            f.write("# a comment\n\n"
                    "AIMBOT_LLM_URL=http://example:9/v1\n"
                    "export AIMBOT_LLM_MODEL=from-file\n"
                    'T_QUOTED="quoted value"\n'
                    "not a pair\n")
        for k in keep:
            os.environ.pop(k, None)
        got = mod.load_env(path)
        eq(got.get("AIMBOT_LLM_MODEL"), "from-file", "`export ` prefix is stripped")
        eq(got.get("T_QUOTED"), "quoted value", "quotes come off the value")
        eq("not a pair" in got, False, "a line with no `=` is skipped, not guessed at")
        eq(os.environ["AIMBOT_LLM_URL"], "http://example:9/v1", "and it reaches os.environ")

        # an exported value must survive a later load
        os.environ["AIMBOT_LLM_MODEL"] = "exported-wins"
        mod.load_env(path)
        eq(os.environ["AIMBOT_LLM_MODEL"], "exported-wins",
           "the environment beats the file")

        eq(mod.load_env(os.path.join(tmp, "absent")), {}, "a missing .env is fine")

        # no model anywhere means every llm step skips itself, which is what
        # keeps a sweep on a machine with no endpoint identical to before
        mod.ENV_FILE = os.path.join(tmp, "absent")
        for k in keep:
            os.environ.pop(k, None)
        eq(mod.configured(), None, "unconfigured is None")
        os.environ["AIMBOT_LLM_MODEL"] = "something"
        eq(mod.configured()[0], mod.DEFAULT_URL, "and the url falls back to the default")
    finally:
        for k, v in keep.items():
            os.environ.pop(k, None)
            if v is not None:
                os.environ[k] = v
        shutil.rmtree(tmp)


