      .reduce((s, [, share]) => s + share, 0);
    if (unknown > 0.5) bad.push(m.short + ' ' + a.quant + ' = ' + a.real_bpw
      + ' bpw over ' + (unknown * 100).toFixed(0) + '% unsized');
