  const missing = all.filter(s => !(model(s).engines || []).length);
  ok(missing.length >= 2, 'entries that name no runtime at all: ' + missing);
  ok(missing.includes('supertonic-3'), 'including the onnx-only one');

  RESET();
});

test('the vram filter judges what has a size, and passes what has none', () => {
  RESET();
  filters.mods = new Set(['t2a']);
  // the vram filter ALONE: the defaults also carry the licence one, and half
  // the talkers here ship under bespoke terms, so leaving it on would answer
  // this question with a roster the other filter had already decided
  filters.flags = new Set(['fits']);
  filters.licenses = new Set();
  filters.engines = new Set();
  setHardware({...DEFAULT_HARDWARE, budget: 96});

  // `fits vram` is on by DEFAULT, so it decides whether an onnx-only entry is
  // reachable at all. a model with no quants makes no vram claim: reading "no
  // quant fits" off zero quants states something the data does not say, and
  // hides the entry behind a control whose label is about memory. the runtime
  // filter is the one that means unservable.
  const shown_ = visible().map(m => m.short);
  ok(shown_.includes('supertonic-3'),
     'an entry with no quants survives the vram filter: ' + shown_);

  // and the filter still bites on models that DO have sizes
  setHardware({...DEFAULT_HARDWARE, budget: 1});
  const tiny = visible().map(m => m.short);
  ok(tiny.length < shown_.length, 'a 1gib budget drops rows: ' + tiny);
  ok(tiny.every(s => !quantChoices(model(s)).length || fitsBudget(model(s))),
     'everything left either has no size or fits');

  RESET();
});

// `fits vram` off is the reader saying they do not want the page deciding what
// they may look at, and the ladder was still answering with the fit: the biggest
// rung on screen stayed the largest one that clears the budget, which is the
// same number whether or not the box was ever asked about. the filter decides
// which ROWS survive; the ladder decides which RUNGS one model has, and those
// are different questions. the row a model reads as stays the fit either way --
// one row has to name one quant.
test('turning the vram filter off opens the ladder rather than capping it', () => {
  RESET();
  const short_ = 'qwen3.8 flash next';
  const rows = () => expand(visible().filter(m => m.short === short_))
    .map(r => (r._q || {}).gib).filter(Boolean);
  const published = Math.max(...model(short_).repos
    .flatMap(q => (q.available || []).map(a => a.gib || 0)));

  setLadder(true);
  const on = rows();
  filters.flags.delete('fits');
  const off = rows();
  RESET();

  ok(published > Math.max(...on),
     'the budget hides the top of this ladder: ' + published + ' published');
  ok(off.length > on.length,
     'switching the filter off adds rungs: ' + on.length + ' -> ' + off.length);
  eq(Math.max(...off), published,
     'and what comes back is the whole ladder, largest published rung included');
});

// THE QUANT COLUMN NAMES A RUNG. it used to print `does not fit` where nothing
// clears the budget, which is an answer to `fits vram` sitting in a column about
// which file the row is read from -- and loudest exactly when that filter was
// switched off, when the reader has said they are not asking. The row reads the
// smallest rung the repo publishes instead, so the gib and bpw beside the name
// describe the file named rather than going blank, and the fit stays where it
// belongs: in `fits vram`, which still bites.
test('the quant column names a rung when none of them fits', () => {
  RESET();
  eq(col('quant').t, 'quant', 'the column is about the quant, not the fit');

  const m = model('qwen3.8 flash next');
  setHardware({...DEFAULT_HARDWARE, budget: 8});
  ok(!activeQuant(m), 'nothing it publishes fits an 8 gib box');
  ok(!fitsBudget(m), 'and the fit still knows: the filter has an answer to give');

  filters.flags.delete('fits');
  const cell = col('quant').cell(m);
  eq(/does not fit/.test(cell), false, 'the cell names a rung: ' + cell);
  const rungs = quantChoices(m);
  const named = (cell.match(/<td[^>]*>([^<]+)/) || [])[1];
  ok(rungs.some(c => c.quant === named),
     'a rung of its own, got ' + named);
  eq(named, rungs.filter(c => c.gib).reduce((a, b) => b.gib < a.gib ? b : a).quant,
     'the smallest one, which is the rung that comes closest to the box');
  ok(/warn/.test(cell), 'and the miss is marked: ' + cell);
  ok(/\d/.test(col('size').cell(m)),
     'the weight of that rung prints rather than a dash: ' + col('size').cell(m));

  // and the name is a NAME, not a read: the discount stays on the fit, because
  // a percentile is a rank over the whole roster and scoring the models nobody
  // can load at their smallest rung re-ranks the models somebody can
  ok(effective, '`quant adjusted` is on by default, which is where this bites');
  eq(modelRetention(m), 1,
     'a row naming a rung nothing fits is discounted at nothing: '
     + modelRetention(m));
  setHardware({...DEFAULT_HARDWARE});
  const one = D.models.find(x => !x.native_low_bpw && activeQuant(x)
    && activeQuant(x).bpw);
  ok(!!one, 'some non-exempt row fits a rung');
  near(modelRetention(one), retention(activeQuant(one).bpw, one, activeQuant(one)),
       1e-9, 'and it is discounted at the rung it reads, not at a named one');
  RESET();
});

// THE OTHER HALF of the same rule, and the one that matters more: naming a rung
// nobody could load is only honest while the page has stopped claiming to filter
// on it. with `fits vram` ON nothing on screen may name a rung over the box --
// not the row, and not one rung of the expanded ladder -- and the ladder has to
// weigh the drafter the row weighs, since a rung the row could never read has no
// business being offered as a row of its own.
test('with fits vram on, nothing on screen names a quant that does not fit', () => {
  RESET();
  ok(filters.flags.has('fits'), 'the filter is on by default, which is the case');
  const over = [];
  for (const m of visible()) {
    for (const q of fittingQuants(m)) {
      const need = q.gib + kvGib(m, wantCtx(m)) + draftGib(m);
      if (q.gib && need > usable()) over.push(`${m.short} ${q.quant} at ${q.gib}`);
    }
    const cell = col('quant').cell(m);
    if (/class="warn"/.test(cell)) over.push(m.short + ' (row)');
  }
  eq(over.join(', '), '', 'rows naming a rung over the usable vram: ' + over.join(', '));

  // and the rungs the ladder hides with the filter on come back when it is off,
  // which is the difference the two cases are about
  const with_ = expand(visible()).length;
  filters.flags.delete('fits');
  ok(expand(visible()).length > with_,
     'switching the filter off returns the rungs it was hiding');
  RESET();
});

// THE LICENCE FILTER SELECTS TIERS rather than answering one yes-or-no. the
// boolean could only ask "hide what is restricted", so the two questions behind
// it had no control at all: "what could i run if i could ship under a community
// licence", and "which are the ones nobody here has read", which is the list
// somebody has to work through. three checkboxes answer all three.
//
// it opens on ALL THREE tiers, so the default view hides nothing on licence
// grounds and the control is there to narrow with. it briefly defaulted to
// `permissive` alone, which hid 16 text models including most of the frontier
// open-weights tier -- qwen3.8 flash next, kimi k3, both minimax flagships,
// nemotron super -- and four of them on `unknown`, which is an absence of a
// claim about the terms rather than a claim against them.
test('the licence filter selects tiers, and opens on all of them', () => {
  RESET();
  filters.mods = new Set();
  filters.engines = new Set();

  const tierOf = s => licenseOf(model(s)).tier;
  eq([...filters.licenses].sort().join(','), 'permissive,restricted,unknown',
     'the page opens with every tier selected');
  const kept = visible().map(m => m.short);
  ok(kept.length, 'the filter leaves a roster');
  // every tier is represented, which is the point of the default
  ['permissive', 'restricted', 'unknown'].forEach(t => ok(
    kept.some(s => tierOf(s) === t), t + ' models are visible by default'));

  // each tier selects its own and nothing else, so the menu can answer the two
  // questions the boolean could not
  for (const t of ['permissive', 'restricted', 'unknown']) {
    filters.licenses = new Set([t]);
    const got = visible().map(m => m.short);
    ok(got.length, t + ' is a tier some model on this roster is actually in');
    ok(got.every(s => tierOf(s) === t),
       'only ' + t + ' survives selecting it: ' + got.filter(s => tierOf(s) !== t));
  }

  // a union, the way the runtime menu is one
  filters.licenses = new Set(['permissive', 'unknown']);
  const union = visible().map(m => m.short);
  ok(union.length, 'two tiers leave a roster');
  ok(union.every(s => tierOf(s) !== 'restricted'),
     'and select their union and nothing else');

  // picking none is no filter at all, which is how the restricted ones come back
  filters.licenses = new Set();
  const all = visible().map(m => m.short);
  ok(all.length > union.length, 'selecting none is every licence: '
     + all.length + ' against ' + union.length);
  ok(all.some(s => tierOf(s) === 'restricted'),
     'some models ARE restricted, or the case proves nothing');
  ok(all.some(s => tierOf(s) === 'unknown'),
     'and some carry a licence nothing here classifies');

  // the boolean is GONE rather than sitting beside its replacement, or a shared
  // link could carry two controls disagreeing about the same question
  eq(FLAGS.some(f => f.k === 'permissive'), false,
     'the `permissive` flag is not also offered');

  RESET();
});

