       'so the 1b must not rank above it on evidence it does not have');
  });

// `have/want` counts factors and the composite spends WEIGHT, and the two
// disagree in both directions: qwen3.5-27b carries four of the cheap factors
// and g9v3 3b one of the dear ones, for the same 28.6% of the asked weight.
// reporting 4/7 against 1/7 says one is four times better evidenced, and a
// coverage floor reading the weight would unscore the 4/7 while keeping the
// 1/7 -- so the column has to report what the floor and the shrinkage read.
test('evidence reports the weight that was measured, not the count of factors',
  () => {
    RESET();
    // found rather than named: which two models share a covered weight moves
    // with every forum capture, and a pair typed here went stale the sweep one
    // of them was first discussed
    const share = m => askedWeight(m) ? coveredWeight(m) / askedWeight(m) : 0;
    const dear = D.models.find(d => share(d) > 0 && D.models.some(c =>
      scored(c).have > scored(d).have && Math.abs(share(c) - share(d)) < 1e-9));
    ok(dear, 'some two models share a covered weight on different factor counts');
    const cheap = D.models.find(c => scored(c).have > scored(dear).have
      && Math.abs(share(c) - share(dear)) < 1e-9);
    ok(scored(cheap).have > scored(dear).have,
       'one is measured on more factors than the other');
    near(coveredWeight(cheap) / askedWeight(cheap),
         coveredWeight(dear) / askedWeight(dear), 0.01,
         'on the same share of the weight');
    near(col('evidence').get(cheap), col('evidence').get(dear), 0.01,
         'so the column sorts them together rather than four places apart');
    // the same two questions score() asks: `relevant` is whether the VIEW
    // wants this factor, `asked` whether the model could answer it. a speech
    // model in the text view is asked nothing, which is a coverage of 0
    const coverOf = m => {
      const ks = Object.keys(W).filter(k => W[k] && relevant(k) && asked(m, k));
      const all = ks.reduce((a, k) => a + W[k], 0);
      return all ? ks.filter(k => facetPct(m, k) !== null)
        .reduce((a, k) => a + W[k], 0) / all : 0;
    };
    D.models.forEach(m => near(col('evidence').get(m), coverOf(m), 1e-9,
      m.short + ': evidence is the measured share of the asked weight'));
  });

// the four qwen3-tts entries were keyed on a gguf conversion, so `repo` and
// `publisher` -- which every join in this registry runs on -- named the person
// who converted the weights rather than the team that trained them, and there
// was no link to the qwen weights anywhere on the page.
test('a model is read from the weights, not from a conversion of them', () => {
  RESET();
  D.models.forEach(m => {
    // unless there is nowhere else to key it: prism published bonsai 2 27b as
    // gguf and mlx and no unpacked weights at all, so the alternative to this
    // key is not a better one, it is dropping the model
    if (m.gguf_only) return;
    // a repo whose NAME says it is a conversion. nvidia publishes its own gguf
    // inside the weights repo, so nemotron-3-diar's key and its pinned file
    // share a repo and nothing is lost by it -- publisher, card and facts all
    // still resolve to the team that trained the thing. what this rule is
    // against is keying on somebody ELSE'S conversion, and the name is how the
    // registry tells the two apart, so the test reads it the same way.
    const conversion = s => /[-_.](gguf|ggml)$/i.test(s);
    const conversions = new Set(m.repos.map(q => q.repo).filter(conversion));
    ok(!conversions.has(m.repo), m.short + ' is keyed on ' + m.repo
      + ', which is one of its own quants');
  });
  const tts = D.models.filter(m => m.short.startsWith('qwen3-tts'));
  eq(tts.length, 4, 'the four qwen3-tts entries are carried');
  tts.forEach(m => eq(m.publisher, 'Qwen',
    m.short + ' is published by the team that trained it'));
});

