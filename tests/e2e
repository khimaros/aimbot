test('a model that publishes no context window still fits', () => {
  RESET();
  // the default asks for 131072, which is the setting that exposed this
  eq(minCtx, 131072, 'the default context');
  const noWindow = D.models.filter(m => !m.facts.context_native);
  ok(noWindow.length > 10, 'the roster has models with no window (' + noWindow.length + ')');
  ok(noWindow.every(m => m.kind !== 'text'),
     'no TEXT model relies on this: they all publish a window');

  // `(context_native || 0) >= minCtx` read absent as zero, so every one of
  // these reported `does not fit` on a box with 116gib free
  const sized = noWindow.filter(m => m.quants.some(q => q.gib));
  ok(sized.length > 5, 'enough of them are sized to be a real test');
  const bad = sized.filter(m => !fitsBudget(m)).map(m => m.short);
  eq(bad.join(', '), '', 'sized models with no window must fit');

  // and the fit is still doing its job: a window SHORTER than asked for is
  // still a miss, which is the case the check exists for
  const short = D.models.filter(m => m.facts.context_native
    && m.facts.context_native < minCtx);
  ok(short.every(m => !fitsBudget(m)),
     'a model whose window is genuinely too short still does not fit');
});

