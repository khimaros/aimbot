test('one number says what a rung is worth, to the fit and to the discount', () => {
  RESET();
  filters.flags.delete('fits');
  // lfm2.5 2.6b publishes a Q4_0 with a drafter folded into the file: 2.97 gib
  // of 4.70-bit weights, which is a bigger FILE than its Q6_K and a worse
  // QUANT. size ordered it second from the top of the ladder, and the ceiling
  // and the discount already read the tensor table, so the three of them
  // disagreed about what the rung was worth
  const m = model('lfm2.5 2.6b');
  const qs = fittingQuants(m);
  const q4 = qs.find(q => q.quant === 'Q4_0'), q6 = qs.find(q => q.quant === 'Q6_K');
  ok(q4 && q6, 'both rungs are on the ladder');
  ok(q4.gib > q6.gib, 'the q4 file is the bigger of the two');
  ok(qs.indexOf(q4) > qs.indexOf(q6), 'and the ladder ranks it below anyway');

  // THE ONE CALCULATION: what the ordering reads is what the ceiling reads is
  // what the quality discount reads. minicpm-v 4.6 is where it bites hardest --
  // its parameter count names a vision encoder the gguf ships as a separate
  // file, so every rung reads 1.7x too cheap on the derived figure
  for (let i = 1; i < qs.length; i++) {
    ok(rungBpw(qs[i]) <= rungBpw(qs[i - 1]),
       'best first on the one number: ' + qs[i - 1].quant + ' ' + rungBpw(qs[i - 1])
       + ' then ' + qs[i].quant + ' ' + rungBpw(qs[i]));
  }
  const v = model('minicpm-v 4.6'), vq = activeQuant(v);
  near(modelRetention(v), retention(rungBpw(vq), v, vq), 1e-9,
       'the discount reads the tensor-table bits');
  ok(modelRetention(v) > retention(vq.bpw, v, vq) + 1e-6,
     'which is better news than the derived figure gave: ' + modelRetention(v)
     + ' against ' + retention(vq.bpw, v, vq));
  RESET();
});

