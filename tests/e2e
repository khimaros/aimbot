  const k = JSON.parse(piProvider(model('kimi k3'),
                                  {repo: 'r', quant: 'Q'}, 'thinking', true));
  const ke = k.providers.local.models[0];
  eq(ke.compat.chatTemplateKwargs.thinking_effort.omitWhenOff, true,
