  }
});

// the sentence is printed at build time from the PUBLISHED percentile, and the
// table under it ranked the quant-discounted cohort beneath a header that said
// neither: qwen3.8 flash next read `aa.terminalbench p99` over a percentile of
// 96, and hovering the p99 said p96.
test('the evidence table agrees with the sentence it sits under', () => {
  RESET();
  setEffective(true);
  const cited = D.models.flatMap(x => ((x.assessed || {}).evidence || [])
    .map(e => [x, (Array.isArray(e) ? e : []).find(p => typeof p !== 'string')]))
    .filter(([x, p]) => p && !p.repo && x.facets[p.key] && x.facets[p.key].pct != null
      && scaledFacet(p.key) && facetPctRaw(x, p.key) !== x.facets[p.key].pct);
  ok(cited.length, 'some verdict cites a figure the discount re-ranks');
  const [m, part] = cited[0];
  const f = m.facets[part.key];
  const tableOf = () => tabOverview(m).split('<h3>evidence cited</h3>')[1].split('</table>')[0];
  let table = tableOf();
  eq(table.includes('<th>source</th>'), false,
     'the figure in the claim links its source, so no column repeats it');
  eq(table.includes('value now'), false, 'and no header says "now" about a figure with no date');
  const row = table.split('<tr>').find(r => r.includes('>' + esc(part.shown) + '<'));
  ok(row, 'there is a row for ' + part.shown);
  const cells = [...row.matchAll(/<td class="n"[^>]*>([^<]*)</g)].map(x => x[1]);
  eq(cells[0], String(num(f.value, DIGITS[(D.facet_meta[part.key] || {}).unit] ?? 2)),
     'the value is the one the source published');
  eq(cells[1], String(f.pct), 'the percentile is the one the sentence prints: ' + part.shown);
  eq(cells[2], String(facetPctRaw(m, part.key)), 'and the discounted rank has a column of its own');

  // the hover on a figure leads with what the figure says
  const said = proseRef(part, m).note;
  ok(said.includes('p' + f.pct + ' of ' + f.cohort), 'the hover repeats the printed rank: ' + said);
  ok(said.includes('p' + facetPctRaw(m, part.key) + ' quant adjusted'),
     'and names the discounted one as that: ' + said);

  setEffective(false);
  table = tableOf();
  eq(table.includes('quant adjusted'), false, 'with the discount off there is no column for it');
  eq(proseRef(part, m).note.includes('quant adjusted'), false, 'nor a line in the hover');
  setEffective(true);
  RESET();
});

test('a quoted comment in a verdict links to the thread it was said in', () => {
