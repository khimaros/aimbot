// the curve's lowest fitted point is deepseek v3.1 at 2.21 bpw, and below that
// `retention` returns that point's value forever -- a 1.30 bpw rung reads as
// keeping 77.8% of its score because the curve has nothing to say and says the
// last thing it knew. quesma's qwen3.8 27b sweep is the first measurement in
// that region and it found collapse to chance at 1.8 bpw, so the flat part is
// not merely unevidenced, it is evidenced against on at least one model.
test('a quant below the curve is marked as a floor, not a prediction', () => {
  RESET();
  // 96gb is where the clamp actually bites: four models drop to a rung under
  // 2.21 bpw and each is multiplied by the curve's last known value
  setHardware({...DEFAULT_HARDWARE, budget: 96, cap: 'none', floor: 'none'});
  const lowest = curveFor(model('kimi k3')).points[0][0];
  ok(lowest > 1.5, 'the curve starts well above one bit (' + lowest + ')');

  const under = D.models.filter(m => {
    const q = activeQuant(m);
    return q && q.bpw && q.bpw < lowest && !m.native_low_bpw;
  });
  ok(under.length > 0, 'some model is served a rung under the curve at 96gb');
  under.forEach(m => ok(belowCurve(m),
    m.short + ' is under the curve at ' + activeQuant(m).bpw
      + ' bpw and nothing says so'));

  const over = D.models.find(m => {
    const q = activeQuant(m);
    return q && q.bpw && q.bpw > lowest + 1;
  });
  eq(belowCurve(over), false, over.short + ' is inside the curve and must not be marked');

  // a natively low-bpw model is exempt from the curve, so it is not extrapolating
  // off the end of one -- the flag and the marker must not fight
  const native = D.models.filter(m => m.native_low_bpw);
  ok(native.length >= 3, 'the roster carries natively low-bpw weights');
  native.forEach(m => eq(belowCurve(m), false,
    m.short + ' is exempt from the curve, so it is not below it'));
  RESET();
});

// a milestone is a frontier model the roster is READ AGAINST, never ranked
// with: every percentile on this page is computed inside the open-weights
// cohort, so a closed model entering it would move all of them silently.
test('a milestone is carried as a line, not as a row', () => {
  RESET();
  const ms = D.milestones || {};
  const keys = Object.keys(ms);
  ok(keys.length >= 1, 'the payload carries at least one milestone');

  keys.forEach(k => {
    const m = ms[k];
    ok(typeof m.index === 'number' && m.index > 0, k + ' carries an index');
    ok(m.label && m.as_of, k + ' says what it is and as of when');
    ok(!D.models.some(x => x.repo === k || x.short === m.label),
      k + ' is in the roster as well as beside it, which would move every'
      + ' percentile on the page');
  });

  // and the comparison it exists for: the raw index, not the composite, since
  // the milestone is on artificial analysis' scale and the quality column is a
  // percentile within this registry
  const line = ms[keys[0]].index;
  const scored = D.models.filter(m => m.facets['aa.intelligence']);
  ok(scored.length > 20, 'enough models carry the index to compare');
  const over = scored.filter(m => m.facets['aa.intelligence'].value >= line);
  ok(over.length > 0 && over.length < scored.length,
    'the milestone splits the roster rather than including or excluding all of it'
    + ' (' + over.length + ' of ' + scored.length + ')');
});

// the milestone is a line the payload carries, not a control on the page: no
// flag is built from one, and a stored or shared filter set naming a flag this
// page does not offer is dropped rather than travelling in every later link.
test('a milestone is not offered as a filter', () => {
  RESET();
  eq(FLAGS.some(f => f.k.startsWith('ms-')), false,
    'no flag is built from a milestone, got ' + FLAGS.map(f => f.k).join(','));

  applyState({f: {flags: ['fits', 'ms-' + Object.keys(D.milestones)[0]]}});
  eq([...filters.flags].join(','), 'fits',
    'the flag the page offers survives and the one it does not is dropped');
  RESET();
});

// a measured curve can be SHORT: quesma ran qwen3.8 27b on terminal-bench at
// three arms and the lowest is 3.11 bpw. clamping on its last point below that
// would read 0.904 where the fitted curve says 0.778 -- a measurement making
// thin quants look BETTER than the fit, which is backwards. below its own range
// a measured curve defers to the fitted one instead.
// the curve is installed rather than read off the roster, because whether a
// measurement can rank a model at all depends on how many publishers that model
// has, and that is a fact about today's captures rather than about the rule.
test('a short measured curve defers to the fitted one below its range', () => {
  RESET();
  const m = D.models.find(x => x.kind === 'text' && !x.native_low_bpw
    && new Set(quantChoices(x).map(c => c.repo)).size === 1
    && quantChoices(x).some(c => rungBpw(c) > 8));
  ok(m, 'a model published by one quantizer, which is what a sweep can rank');
  const sweep = {points: [[5, 0.9], [16, 1]], kind: 'score', metric: 'synthetic',
                 quant_repo: quantChoices(m)[0].repo};
  D.retention.measured[m.repo] = [sweep];
  clearScores();
  try {
    const own = curveFor(m);
    eq(own.kind, 'measured', m.short + ' uses its own curve');
    const lo = own.points[0][0], fit = D.retention.fitted.points;
    const below = lo - 1, inside = (lo + own.points[own.points.length - 1][0]) / 2;
    ok(below > 0, 'there is room under the measured range');
    // inside its range the measurement wins
    near(retention(inside, m), interpAt(own.points, inside), 1e-9,
      'inside the measured range the measurement is used');
    // below it, the fitted curve -- and NOT the measured curve's floor
    near(retention(below, m), interpAt(fit, below), 1e-9,
      'below the measured range the fitted curve is used');
    ok(Math.abs(retention(below, m) - own.points[0][1]) > 1e-9,
      'and not the measured curve clamped at its lowest point, which would be '
      + own.points[0][1] + ' against the fit\'s ' + interpAt(fit, below).toFixed(3));
  } finally {
    delete D.retention.measured[m.repo];
    clearScores();
  }
});

// and a second publisher ends the sweep's authority over the ranking: its own
// rungs are still what it measured, and the other's are not, so no measured
// number can rank the two against each other.
test('a second publisher takes the ranking off a sweep that measured one', () => {
  RESET();
  const m = D.models.find(x => x.kind === 'text' && !x.native_low_bpw
    && new Set(quantChoices(x).map(c => c.repo)).size === 1
    && quantChoices(x).some(c => rungBpw(c) > 8));
  ok(m, 'a single-publisher model to add one to');
  const repo = quantChoices(m)[0].repo;
  D.retention.measured[m.repo] = [{points: [[5, 0.9], [16, 1]], kind: 'score',
                                   metric: 'synthetic', quant_repo: repo}];
  clearScores();
  eq(curveFor(m).kind, 'measured', 'one publisher, and the sweep ranks it');
  // pretend a second quantizer published a rung of the same model
  const rung = quantChoices(m)[0];
  m.repos[0].available = (m.repos[0].available || [Object.assign({}, rung)])
    .concat([Object.assign({}, rung, {quant: rung.quant + '-OTHER'})]);
  const before = m.repos.length;
  m.repos.push({repo: 'someone-else/' + repo.split('/').pop(),
                 quant: 'Q8_0', available: [{quant: 'Q8_0', gib: 1, bpw: 8}]});
  clearScores();
  try {
    const c = curveFor(m);
    ok(c.kind !== 'measured', 'a rung nobody swept cannot be ranked by the sweep'
      + ', so the model shares one scale: got ' + c.kind);
    eq(unusedSweeps(m, c).length, 1, 'and the sweep is still there to be shown');
    ok(quantChoices(m).every(x => curveFor(m, x).kind === c.kind),
      'every rung of the model is discounted on that one curve');
  } finally {
    m.repos.length = before;
    delete D.retention.measured[m.repo];
    clearScores();
  }
});

// ISTA-DASLab's card runs its own GSQ-RCO rungs and unsloth's UD rungs over the
// same three benchmarks, and at 2.5 bpw they differ by more than eight points of
// task average. so "the curve for qwen3.8 27b" is not one thing: a measurement
// answers for the FILES it ran, and a rung from another repo falls back to the
// median or the fit rather than borrowing a number nobody measured for it.
test('a measured curve is only applied to the files it measured', () => {
  RESET();
  const carried = D.models.filter(m => ((D.retention.measured || {})[m.repo] || []).length);
  ok(carried.length, 'some model carries a measured curve');
  carried.forEach(m => {
    (D.retention.measured[m.repo]).forEach(c => ok(c.quant_repo,
      m.short + ': a score curve has to name the gguf repo it ran, got '
      + JSON.stringify(c.ref)));
    const c = curveFor(m);
    if (c.kind !== 'measured') return;
    // ranking a model off a sweep is honest only when the sweep ran every rung
    // the model publishes. a publisher's own curve against its own base says
    // nothing about another quantizer's file at the same bits per weight, and
    // the two numbers do not even land on the same level -- which is how a 3.37
    // bpw rung came to outscore a 5.37 one of the same model
    const repos = new Set(quantChoices(m).map(x => x.repo));
    eq(repos.size, 1, m.short + ' is ranked by ' + c.src.quant_repo + ' while its '
      + 'rungs come from ' + [...repos].join(', '));
    eq([...repos][0], c.src.quant_repo,
       m.short + ': the ranking curve has to be the one run on the repo that '
       + 'publishes them');
  });
});

// the two measured curves on this roster are not one scale. ISTA's own sweep of
// its GSQ-RCO rungs of qwen3.8 flash next reads 0.994 kept at 3.37 bpw, where
// the fit every other model borrows reads 0.955 there and 0.982 at 5.37. so a
// ladder that discounts one rung of a model by each ranks FEWER BITS HIGHER, in
// the column whose whole job is saying which file to run -- and the row the fit
// picks, the one with the most bits, then reads as a worse choice than a rung
// four rows down. a measurement is a curve of one quantizer's FILES against its
// own bf16 base, so it carries a model's ranking only when it speaks for every
// rung that model publishes; otherwise every rung is discounted on the common
// curve, which is the scale the rest of the roster is on to begin with.
test('a model is discounted on one scale, not one curve per repo', () => {
  RESET();
  const carried = D.models.filter(m => ((D.retention.measured || {})[m.repo] || []).length);
  ok(carried.length >= 2, 'more than one model carries a measured curve');
  carried.forEach(m => {
    const on = new Set(quantChoices(m).map(c => {
      const c2 = curveFor(m, c);
      return c2.kind + ' over ' + c2.points.length + ' points';
    }));
    eq(on.size, 1, m.short + ' would rank its rungs on ' + [...on].join(' vs '));
  });
});

// the same rule as the question a reader is actually asking of a ladder: does
// the rung with more bits ever score lower than the one with fewer.
test('more bits per weight never score lower within a model', () => {
  RESET();
  setHardware({...DEFAULT_HARDWARE, budget: 128});
  setLadder(true);
  const bad = [];
  D.models.forEach(m => {
    const rows = expand([m]).filter(r => r._q && scored(r).value !== null);
    for (let i = 1; i < rows.length; i++) {
      const more = rows[i - 1], less = rows[i];
      if (!(rungBpw(less._q) < rungBpw(more._q))) continue;
      if (scored(less).value > scored(more).value + 0.05) {
        bad.push(m.short + ': ' + less._q.quant + ' at ' + rungBpw(less._q)
          + 'bpw scores ' + scored(less).value.toFixed(1) + ' over ' + more._q.quant
          + ' at ' + rungBpw(more._q) + 'bpw on ' + scored(more).value.toFixed(1));
      }
    }
  });
  setLadder(false);
  eq(bad.join(' | '), '', 'a ladder that ranks fewer bits higher');
});

// and the pick agrees with the column it prints. `best quant` chooses on bits
// per weight, so if the row it lands on is outscored by a lower rung on the same
// model the two halves of the page are answering `which one` differently.
test('the rung the fit picks is the one its own ladder scores highest', () => {
  RESET();
  setHardware({...DEFAULT_HARDWARE, budget: 128});
  const bad = [];
  visible().forEach(m => {
    const q = activeQuant(m), mine = scored(m).value;
    if (!q || mine === null) return;
    fittingQuants(m).forEach(other => {
      const v = scored(Object.assign(Object.create(m), {_q: other, _s: null})).value;
      if (v !== null && v > mine + 0.05) {
        bad.push(m.short + ' reads ' + q.quant + ' at ' + mine.toFixed(1)
          + ' while ' + other.quant + ' scores ' + v.toFixed(1));
      }
    });
  });
  eq(bad.join(' | '), '', 'the row on screen is not the top of its own ladder');
});

// a rendered reference is still a measurement, and the reader should be able to
// ask it the same question they can ask the cell: where did this come from. the
// rendered form is `key pNN` rather than a bare number precisely so it can be
// recognised again, which is what makes this possible without shipping anything
// extra -- the page refuses to print a brace and that has not changed.
// the quant notes under `what the registry pins` shipped as flat strings after
// everything else became parts, so they rendered correctly and hovered at
// nothing -- a silent gap the [object Object] guard below cannot see, because a
// string is exactly what the renderer handles without complaint. the invariant
// is not "it draws", it is "a reference that resolved is reachable".
test('a note that resolved a reference is hoverable where it is shown', () => {
  RESET();
  const tabs = {operate: tabOperate, overview: tabOverview,
                quality: tabQuality, vendor: tabVendor,
                quantization: tabQuantization, community: tabCommunity};
  const resolved = v => Array.isArray(v)
    && v.filter(p => p && typeof p === 'object' && !p.missing && p.shown);
  let checked = 0;
  D.models.forEach(m => {
    // the notes the page draws unconditionally. a sampling profile's note is
    // NOT here: the operate tab draws the selected profile's table and the
    // others are a chip away, so a static render cannot prove it reachable and
    // cannot prove it lost either
    // a rung's own `runtime` block is here too: it is where a file mainline
    // cannot load says so, even when the model's architecture is merged
    const rungs = (m.repos || []).concat(m.components || []);
    const held = [m.notes, (m.speculative || {}).note, (m.runtime || {}).note]
      .concat(rungs.map(q => q.note), rungs.map(q => (q.runtime || {}).note));
    const drawn = Object.values(tabs)
      .filter(fn => typeof fn === 'function').map(fn => fn(m));
    held.forEach(note => {
      const parts = resolved(note);
      if (!parts || !parts.length) return;
      // find the NOTE by its own words rather than by the figure in it: a
      // `{card}` renders as a url that half the page also prints, so matching
      // the figure finds some other sentence and calls this one drawn
      const mark = (note.filter(p => typeof p === 'string')
        .map(p => p.trim()).sort((a, b) => b.length - a.length)[0] || '');
      if (mark.length < 25) return;
      checked++;
      const page = drawn.find(html_ => html_.includes(esc(mark)));
      ok(page, m.short + ': a note is shipped and drawn nowhere -- "'
         + mark.slice(0, 60) + '"');
      if (!page) return;
      parts.forEach(part => {
        const at = page.indexOf('>' + esc(part.shown) + '<');
        if (at === -1) return;
        const open = page.slice(0, at + 1).lastIndexOf('<a ');
        const tag = open === -1 ? '' : page.slice(open, at + 1);
        ok(tag.endsWith('>') && tag.includes('data-ref='),
           m.short + ': "' + part.shown + '" is printed with nothing behind it');
      });
    });
  });
  ok(checked > 30, 'and there were resolved references to reach, got ' + checked);
});

// prose ships as parts, so every place that used to `esc()` a note now has to
// render a list. one that was missed does not throw -- it prints the words
// `[object Object]` into the page, which is the only way this change can fail
// quietly.
test('no tab prints a part list as an object', () => {
  RESET();
  const tabs = {overview: tabOverview, quality: tabQuality, community: tabCommunity,
                vendor: tabVendor, quantization: tabQuantization, operate: tabOperate};
  let drawn = 0;
  D.models.forEach(m => {
    Object.entries(tabs).forEach(([name, fn]) => {
      if (typeof fn !== 'function') return;
      let html_;
      try { html_ = fn(m); } catch (e) { ok(false, m.short + ' ' + name + ': ' + e); return; }
      drawn++;
      ok(!/\[object Object\]/.test(html_),
         m.short + ' ' + name + ' printed a part list as an object');
    });
  });
  ok(drawn > 300, 'and there were tabs to draw, got ' + drawn);
});

test('a figure in the assessment carries its source, the way the cell does', () => {
  RESET();
  // prose ships as parts: words, and the reference between them with the key it
  // resolved. the renderer is the only thing that knows which reference made
  // which figure, so it says, rather than the page matching the words back.
  const m = D.models.find(x => ((x.assessed || {}).notes || [])
    .some(p => typeof p === 'object' && x.facets[p.key]));
  ok(m, 'some verdict quotes a facet its model carries');

  const part = m.assessed.notes.find(p => typeof p === 'object' && m.facets[p.key]);
  ok(part.shown && !/[{}]/.test(part.shown),
     'the figure is rendered, not a brace: ' + part.shown);

  const html_ = tabOverview(m);
  const at = html_.indexOf(esc(part.shown));
  ok(at > -1, part.key + ' is printed in the panel as ' + part.shown);
  // the tag it sits in, whole -- the reference payload is longer than any
  // fixed window back from the figure
  const open = html_.slice(0, at).lastIndexOf('<a ');
  const tag = open === -1 ? '' : html_.slice(open, at);
  ok(tag.endsWith('>') && tag.includes('data-ref='),
     part.key + ' is hoverable where it stands in the sentence: ' + tag.slice(0, 60));
  ok(html_.slice(at).startsWith(esc(part.shown) + '</a>'),
     'and the anchor wraps the figure itself, nothing more');

  // a comparison against ANOTHER model renders bare -- `33.9 p82`, with the
  // facet named once by the half before it -- so there is nothing in the words
  // to recognise. it is attributable only because the part carries the repo.
  const cross = D.models.flatMap(x => ((x.assessed || {}).notes || []))
    .find(p => typeof p === 'object' && p.repo);
  if (cross) {
    ok(cross.key && !/[a-z]/.test(cross.shown.replace(/p\d+|[\d.\s-]/g, '')),
       'a cross-model figure prints bare and still names its facet: '
       + cross.key + ' -> ' + cross.shown);
  }
});

// the sentence is printed at build time from the PUBLISHED percentile, and the
// table under it ranked the quant-discounted cohort beneath a header that said
// neither: qwen3.8 flash next read `aa.terminalbench p99` over a percentile of
// 96, and hovering the p99 said p96.
test('the evidence table agrees with the sentence it sits under', () => {
  RESET();
  setEffective(true);
  const cited = D.models.flatMap(x => ((x.assessed || {}).evidence || [])
    .map(e => [x, (Array.isArray(e) ? e : []).find(p => typeof p !== 'string')]))
    .filter(([x, p]) => p && !p.repo && x.facets[p.key] && x.facets[p.key].pct != null
      && scaledFacet(p.key) && facetPctRaw(x, p.key) !== x.facets[p.key].pct);
  ok(cited.length, 'some verdict cites a figure the discount re-ranks');
  const [m, part] = cited[0];
  const f = m.facets[part.key];
  const tableOf = () => tabOverview(m).split('<h3>evidence cited</h3>')[1].split('</table>')[0];
  let table = tableOf();
  eq(table.includes('<th>source</th>'), false,
     'the figure in the claim links its source, so no column repeats it');
  eq(table.includes('value now'), false, 'and no header says "now" about a figure with no date');
  const row = table.split('<tr>').find(r => r.includes('>' + esc(part.shown) + '<'));
  ok(row, 'there is a row for ' + part.shown);
  const cells = [...row.matchAll(/<td class="n"[^>]*>([^<]*)</g)].map(x => x[1]);
  eq(cells[0], String(num(f.value, DIGITS[(D.facet_meta[part.key] || {}).unit] ?? 2)),
     'the value is the one the source published');
  eq(cells[1], String(f.pct), 'the percentile is the one the sentence prints: ' + part.shown);
  eq(cells[2], String(facetPctRaw(m, part.key)), 'and the discounted rank has a column of its own');

  // the hover on a figure leads with what the figure says
  const said = proseRef(part, m).note;
  ok(said.includes('p' + f.pct + ' of ' + f.cohort), 'the hover repeats the printed rank: ' + said);
  ok(said.includes('p' + facetPctRaw(m, part.key) + ' quant adjusted'),
     'and names the discounted one as that: ' + said);

  setEffective(false);
  table = tableOf();
  eq(table.includes('quant adjusted'), false, 'with the discount off there is no column for it');
  eq(proseRef(part, m).note.includes('quant adjusted'), false, 'nor a line in the hover');
  setEffective(true);
  RESET();
});

test('a quoted comment in a verdict links to the thread it was said in', () => {
  RESET();
  // a verdict quotes reception as `"the words" {q:1a2b3c4d}`. the id is what
  // makes the words checkable, and it has to print as the words -- hoverable to
  // the comment and linked to the thread -- rather than as the brace
  const quoted = D.models.flatMap(m => ['one_liner', 'notes']
    .flatMap(f => [].concat((m.assessed || {})[f] || []))
    .filter(p => typeof p === 'object' && /^q:/.test(p.key || ''))
    .map(p => ({m, p})));
  ok(quoted.length > 0, 'some verdict quotes a comment');
  const loose = quoted.filter(({p}) => p.missing);
  ok(!loose.length, 'every quote id resolves to a comment the capture holds: '
     + loose.map(({m, p}) => m.short + ' ' + p.key).join(', '));
  quoted.forEach(({m, p}) => {
    ok(/^"[^"]+"$/.test(p.shown) && /^https?:\/\//.test(p.url || ''),
       m.short + ': a quote prints as its words and carries a url: ' + JSON.stringify(p));
  });
  const {m, p} = quoted[0];
  const html_ = tabOverview(m);
  ok(html_.includes('>' + esc(p.shown) + '</a>'),
     m.short + ': the quoted words are the anchor in the panel');
  ok(!/\{q:[0-9a-f]+\}/.test(html_), m.short + ': and no quote id is printed raw');
});

// the verdicts name their figures now -- `{aa.speed}` rather than `aa.speed
// p77` -- so that the number a reader sees is read from the capture at build
// time and cannot be the one somebody typed last year. that only holds if
// something RENDERS them: shipped raw, the page prints the brace.
test('a verdict ships its figures rendered, never as a raw reference', () => {
  RESET();
  const raw = /\{[a-z][a-z0-9_.-]*\}/i;
  const fields = ['one_liner', 'notes', 'use_for', 'avoid_for', 'evidence'];
  let checked = 0;
  // prose is a list of parts, and a part that resolved carries the figure in
  // `shown`. one that did NOT is left holding its brace on purpose, so this
  // still reads every word a reader will see
  const words = v => typeof v === 'string' ? v
    : (v || []).map(p => typeof p === 'string' ? p : p.shown).join('');
  D.models.forEach(m => {
    const a = m.assessed || {};
    fields.forEach(f => {
      const v = a[f];
      if (!v || !v.length) return;
      const many = Array.isArray(v) && v.some(x => Array.isArray(x));
      (many ? v : [v]).forEach(one => {
        checked++;
        const text = words(one);
        ok(!raw.test(text), m.short + ' ' + f + ' still carries a reference: ' + text);
      });
    });
  });
  ok(checked > 300, 'and there were verdicts to check, got ' + checked);

  // and the registry notes, which reference their own vocabulary -- `{gib}`,
  // `{card}`. these hang off six different blocks and the renderer only knew
  // two of them, so `sampling.thinking.note` shipped the brace to the page.
  let notes = 0;
  const walk = (o, where) => {
    // the model-level note ships as PARTS now, the way the assessment does;
    // the ones in table cells are still flat strings
    const asParts = Array.isArray(o) && o.some(x => x && x.shown !== undefined);
    if (typeof o === 'string' || asParts) {
      notes++;
      const text = typeof o === 'string' ? o
        : o.map(x => typeof x === 'string' ? x : x.shown).join('');
      ok(!raw.test(text), where + ' ships a raw reference: ' + text.slice(0, 90));
    } else if (o && typeof o === 'object') {
      Object.entries(o).forEach(([k, v]) => {
        if (k === 'note' || k === 'notes' || (v && typeof v === 'object')) {
          walk(v, where + '.' + k);
        }
      });
    }
  };
  D.models.forEach(m => ['notes', 'sampling', 'speculative', 'runtime', 'thinking',
                         'turns', 'quants', 'components']
    .forEach(f => walk(m[f], m.short + '.' + f)));
  ok(notes > 150, 'and there were notes to check, got ' + notes);
});

// lmarena's collector captures eleven boards and the roster read one of them.
// `image_edit` rates three models this registry already carries, on millions of
// votes, and the data was sitting in the capture unused. editing is not
// generation, so it is a SEPARATE facet rather than more evidence for the same
// question -- a model that edits well has not thereby been shown to draw well.
test('the image roster carries lmarena edit ratings where the board has them', () => {
  RESET();
  const scored = D.models.filter(m => m.facets['lmarena-edit.rating']);
  ok(scored.length >= 3, 'several carried models are on the edit board, got '
    + scored.length);
  scored.forEach(m => {
    eq(m.kind, 'image', m.short + ' is on an image board and is not an image model');
    const f = m.facets['lmarena-edit.rating'];
    ok(f.value > 500 && f.value < 2000, m.short + ' has an elo-shaped rating');
    ok(f.votes > 0, m.short + ' carries the vote count the rating rests on');
  });
  // and it is not silently the same number as the generation board
  const both = scored.filter(m => m.facets['lmarena-t2i.rating']);
  ok(both.length > 0, 'some model is on both boards');
  ok(both.some(m => m.facets['lmarena-edit.rating'].value
                 !== m.facets['lmarena-t2i.rating'].value),
     'editing and generation are scored separately, not copied');
});

test('the kv cache follows each model\'s own attention geometry', () => {
  // gemma 4 31b runs a 1024-token window on all but every fifth layer, so its
  // cache at 128k is a fraction of what layers * kv_heads * head_dim implies
  const g = model('gemma 4 31b'), a = g.facts.attn;
  const naive = 2 * (a.full_layers + a.other_layers) * a.kv_heads * a.head_dim
    * KV_BYTES * 131072 / (1024 ** 3);
  const real = kvGib(g, 131072);
  ok(real < naive / 3, 'windowed layers are not counted as global ('
    + real.toFixed(1) + ' vs ' + naive.toFixed(1) + ' gib)');
  near(real, 20.78, 0.05, 'gemma 4 31b kv at 128k');
});

