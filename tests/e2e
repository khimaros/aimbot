test('the publisher menu reads in one alphabet, not two', () => {
  RESET();
  drawPublishers();
  const order = [...html('#pub-ms').matchAll(/data-pub="([^"]*)"/g)].map(x => x[1]);
  ok(order.length > 10, 'the menu lists the roster: ' + order.length);
  // a publisher name is capitalized however its owner felt -- `Qwen` beside
  // `google` -- and ascii order puts EVERY capital ahead of every lowercase
  // one, so the menu read as two alphabets and `zai-org` sat above `Zyphra`
  const want = [...order].sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
  eq(order.join(','), want.join(','), 'the menu is ordered case insensitively');
  ok(order.join(',') !== [...order].sort().join(','),
     'and the roster mixes cases, so that is a different list from ascii order');
});

