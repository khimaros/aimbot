#!/usr/bin/env python3

"""end-to-end tests for the registry viewer.

    ./tests/e2e             # run them
    ./tests/e2e --keep      # leave the generated probe behind to read

the page is one html file with no build step, no imports and no framework, so
it is tested the way it ships: the REAL script out of docs/index.html, the REAL
docs/data.json, and a dom stub thin enough that it is the page's arithmetic
being exercised rather than a mock of it. a test that asserts on rendered html
asserts on the same string a browser is handed.

`node --check` is not a substitute and was tried first. it passes a stray
backtick that turns half the file into a template literal, which is exactly the
failure that reaches a reader as a blank page, so every check here boots.

the stub memoizes elements by selector, so innerHTML written by drawTable is
readable afterwards. querySelectorAll returns nothing, which means event
handlers never bind -- interaction is driven by calling the function the
handler would have called, which is the same code path.
"""

import argparse
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
PROBE = os.path.join(HERE, ".probe.js")

sys.path.insert(0, os.path.join(ROOT, "scripts"))
import pageboot  # noqa: E402  the stub and the boot, shared with dashboard-table

# helpers the cases assert with. the dom stub itself lives in scripts/pageboot.py,
# shared with the generator so the page under test and the page MODELS.md is
# generated from are the same boot.
HELPERS = """
const cases = [];
const test = (name, fn) => cases.push([name, fn]);
function near(got, want, tol, what) {
  if (Math.abs(got - want) > tol) {
    throw new Error(what + ': got ' + got + ', want ' + want + ' +-' + tol);
  }
}
function eq(got, want, what) {
  if (got !== want) throw new Error(what + ': got ' + JSON.stringify(got)
    + ', want ' + JSON.stringify(want));
}
function ok(cond, what) { if (!cond) throw new Error(what); }
const model = short => {
  const m = D.models.find(x => x.short === short);
  if (!m) throw new Error('no model named ' + short);
  return m;
};
// the preset keys the drawn <select> is offering, read off the html the page
// wrote rather than off the table it was built from
const presetOptions = () =>
  [...document.querySelector('#preset').innerHTML.matchAll(/value="([^"]*)"/g)]
    .map(m => m[1]).filter(Boolean);
"""

RUNNER = """
setTimeout(() => {
  if (!D) { console.log('FAIL the page never booted'); process.exit(1); }
  let bad = 0;
  for (const [name, fn] of cases) {
    try {
      fn();
      console.log('ok   ' + name);
    } catch (e) {
      bad++;
      console.log('FAIL ' + name + '\\n       ' + ((e && e.message) || e));
    }
  }
  console.log(cases.length + ' cases, ' + bad + ' failed');
  process.exit(bad ? 1 : 0);
}, 50);
"""

# every case runs against a booted page. reset() first where a case leaves the
# page in a state a later one would read, since they share one boot.
CASES = r"""
const RESET = () => {
  setHardware({...DEFAULT_HARDWARE});
  W = {...D.weights};
  hidden = new Set(DEFAULT_HIDDEN);
  // the filters are shared state across cases too: one that clears the runtime
  // filter to isolate another must not leave the next case filtering on nothing
  filters.mods = new Set(DEFAULT_MODALITIES);
  filters.flags = new Set(DEFAULT_FLAGS);
  filters.engines = new Set(DEFAULT_ENGINES);
  filters.pubs = new Set();
  reweigh();
};

