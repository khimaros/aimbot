  ok(all.length > runnable.length, 'and that is strictly more rows');

  // the image models used to be four of these and are not any more: reading
  // stable-diffusion.cpp's own detector rather than writing the claim by hand
  // found all five of them, ernie and krea included
  const missing = all.filter(s => !(model(s).engines || []).length);
  ok(missing.length >= 2, 'entries that name no runtime at all: ' + missing);
  ok(missing.includes('supertonic-3'), 'including the onnx-only one');

  RESET();
});

