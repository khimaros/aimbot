// THE BUG: breeze-tts-2 is 3.2 gib at Q8_0 and read `does not fit` on a box
// with 116 gib free. nothing about that is a memory answer -- the model
// declares a 2048-token window, the page asks every model for 131072, and the
// shortfall was being reported through a control labelled `fits vram`.
//
// the rule above was already half of this argument: a model publishing NO
// window "has not failed to reach one", because a context window is a text
// model's promise. a vocoder that happens to declare the text its encoder takes
// has not made that promise either. so the demand applies where it is a
// question -- `kind: text`, the registry's own word for a model you serve as a
// chat or completion endpoint -- and nowhere else.
test('a context budget is a question about text models, not about a vocoder', () => {
  RESET();
  filters.mods = new Set();
  filters.flags = new Set();
  filters.licenses = new Set();
  eq(minCtx, 131072, 'the default context is the setting that exposed this');

  const bt2 = model('breeze-tts-2');
  ok(bt2.facts.context_native && bt2.facts.context_native < minCtx,
     'it declares a window far shorter than the demand: ' + bt2.facts.context_native);
  ok(bt2.quants.some(q => q.gib && q.gib < 5), 'and a rung that plainly fits');
  ok(fitsBudget(bt2), 'so it fits');
  ok(activeQuant(bt2), 'and reads a rung rather than `does not fit`');

  // it was never one model: 21 non-text entries declare a short window, which
  // is most of the speech roster plus both translators and both punctuators
  const shortOther = D.models.filter(m => m.kind !== 'text'
    && m.facts.context_native && m.facts.context_native < minCtx && m.quants.length);
  ok(shortOther.length > 10,
     'this was hiding a lot of the roster: ' + shortOther.length);
  ok(shortOther.every(m => fitsBudget(m)),
     'none of them is excluded for a context nobody asks them for: '
     + shortOther.filter(m => !fitsBudget(m)).map(m => m.short));

  // and the kv cache charged against them is the one they can actually hold,
  // not 131072 tokens of a window they do not have
  ok(kvGib(bt2, minCtx) < kvGib(bt2, minCtx * 4) + 1e-9,
     'the cache is not charged past the window');

  RESET();
});

