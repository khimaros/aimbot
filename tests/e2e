test('a share link carries only what was changed, and round-trips', () => {
  RESET();
  filters.mods = new Set(DEFAULT_MODALITIES);
  filters.flags = new Set(DEFAULT_FLAGS);
  filters.q = ''; filters.pubs = new Set();
  sort = {k: 'score', dir: -1};

  // an untouched page has nothing to say
  eq(JSON.stringify(shareState()), '{}', 'defaults produce an empty payload');
  eq(shareLink().includes('#'), false, 'and a link with no fragment');

  // move one of each KIND of setting
  const facet = Object.keys(D.weights)[0];
  setHardware({budget: 64, minCtx: 32768});
  W = {...D.weights, [facet]: 0.99};
  filters.mods = new Set(['t2a']);
  filters.q = 'kokoro';
  sort = {k: 'name', dir: 1};

  const st = shareState();
  eq(st.hw.budget, 64, 'the changed budget travels');
  eq(st.hw.minCtx, 32768, 'and the changed context');
  eq('reserve' in st.hw, false, 'an untouched hardware key does not');
  eq(st.w[facet], 0.99, 'the moved weight travels');
  eq(Object.keys(st.w).length, 1, 'and only the moved one');
  eq(st.f.mods.join(','), 't2a', 'the modality travels');
  eq(st.f.q, 'kokoro', 'the search travels');
  eq('flags' in st.f, false, 'untouched flags do not');
  eq(st.sort.k, 'name', 'the sort travels');

  // the link parses back to the same payload, through the real encoder
  const link = shareLink();
  ok(link.includes('#s='), 'the fragment carries the payload: ' + link);
  const json = decodeURIComponent(/[#&]s=([^&]+)/.exec(link)[1]);
  eq(JSON.stringify(JSON.parse(json)), JSON.stringify(st), 'the payload round-trips');

  // and applying it reproduces the settings
  RESET();
  filters.q = ''; filters.mods = new Set(DEFAULT_MODALITIES); sort = {k: 'score', dir: -1};
  applyState(JSON.parse(json));
  eq(budget, 64, 'budget restored');
  eq(minCtx, 32768, 'context restored');
  eq(W[facet], 0.99, 'weight restored');
  eq([...filters.mods].join(','), 't2a', 'modality restored');
  eq(filters.q, 'kokoro', 'search restored');
  eq(sort.k, 'name', 'sort restored');

  RESET();
  filters.q = ''; filters.mods = new Set(DEFAULT_MODALITIES); sort = {k: 'score', dir: -1};
});

