// shrinking toward the middle stops a single GOOD factor carrying a model up,
// and by the same arithmetic it stops a single BAD one pulling it down: at 5%
// coverage 91% of the composite is the prior, so the number reported is not
// about the model. minicpm5 1b is measured once, at the 13th percentile, and
// read 47 -- ahead of the 2b that beat it on that very factor and three more.
// below COVER_FLOOR of the asked weight there is no number worth printing.
test('a score the prior would decide is not printed at all', () => {
  RESET();
  const m = model('minicpm5 1b');
  const s = scored(m);
  ok(coveredWeight(m) < COVER_FLOOR * askedWeight(m),
     'minicpm5 1b is measured on a sliver of the weight ('
       + (coveredWeight(m) / askedWeight(m)).toFixed(3) + ')');
  eq(s.value, null, 'so it reports no quality rather than the prior wearing'
     + ' a model name');
  eq(col('score').cell(m).includes('>-<'), true,
     'and the cell prints the same dash an unmeasured model gets');
  // the dash is shared with zero coverage and the reason is not: saying
  // "unmeasured" of a model somebody did measure is the error this avoids
  const detail = tabOverview(m);
  ok(!detail.includes('unmeasured'), 'the detail does not call it unmeasured');
  ok(detail.includes('5% of the weight'),
     'it says how much was measured and that it was not enough');
});

