test('an un-discounted facet does not move with the quant', () => {
  RESET();
  const m = squeezed('aa.non_hallucination');
  setEffective(false);
  const raw = facetPctRaw(m, 'aa.non_hallucination');
  setEffective(true);
  eq(facetPctRaw(m, 'aa.non_hallucination'), raw, 'hallucination is left alone');
  ok(modelRetention(m) < 0.95,
     'while ' + m.short + ' is genuinely discounted, x' + modelRetention(m).toFixed(3));
  ok(scaledFacet('aa.coding') && !scaledFacet('aa.non_hallucination'),
     'the two sit on opposite sides of the evidence line');
