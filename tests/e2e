test('the kv cache follows each model\'s own attention geometry', () => {
  // gemma 4 31b runs a 1024-token window on all but every fifth layer, so its
  // cache at 128k is a fraction of what layers * kv_heads * head_dim implies
  const g = model('gemma 4 31b'), a = g.facts.attn;
  const naive = 2 * (a.full_layers + a.other_layers) * a.kv_heads * a.head_dim
    * KV_BYTES * 131072 / (1024 ** 3);
  const real = kvGib(g, 131072);
  ok(real < naive / 3, 'windowed layers are not counted as global ('
    + real.toFixed(1) + ' vs ' + naive.toFixed(1) + ' gib)');
  near(real, 20.78, 0.05, 'gemma 4 31b kv at 128k');
});

