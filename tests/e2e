  const cross = D.models.flatMap(x => ((x.assessed || {}).notes || []))
    .find(p => typeof p === 'object' && p.repo);
  if (cross) {
    ok(cross.key && !/[a-z]/.test(cross.shown.replace(/p\d+|[\d.\s-]/g, '')),
       'a cross-model figure prints bare and still names its facet: '
