  ok(activeQuant(model('qwen3.6 27b')).repo.includes('MTP'), 'because it IS the build');
  // gemma, glimmer and deepseek ship it beside the quants
  [['gemma 4 31b', 0.4, 0.6], ['muse glimmer', 1.4, 1.7],
   ['deepseek v4 flash 0731', 9, 11]].forEach(([s, lo, hi]) => {
