// a measured curve can be SHORT: quesma ran qwen3.8 27b on terminal-bench at
// three arms and the lowest is 3.11 bpw. clamping on its last point below that
// would read 0.904 where the fitted curve says 0.778 -- a measurement making
// thin quants look BETTER than the fit, which is backwards. below its own range
// a measured curve defers to the fitted one instead.
test('a short measured curve defers to the fitted one below its range', () => {
  RESET();
  const m = D.models.find(x => (D.retention.measured || {})[x.repo]);
  ok(m, 'some model carries a measured curve');
  const own = curveFor(m);
  eq(own.kind, 'measured', m.short + ' uses its own curve');

  const lo = own.points[0][0];
  const fit = D.retention.fitted.points;
  const below = lo - 0.5;
  ok(below > 0, 'there is room under the measured range');

  // inside its range the measurement wins
  const inside = (lo + own.points[own.points.length - 1][0]) / 2;
  near(retention(inside, m), interpAt(own.points, inside), 1e-9,
    'inside the measured range the measurement is used');

  // below it, the fitted curve -- and NOT the measured curve's floor
  near(retention(below, m), interpAt(fit, below), 1e-9,
    'below the measured range the fitted curve is used');
  ok(Math.abs(retention(below, m) - own.points[0][1]) > 1e-9,
    'and not the measured curve clamped at its lowest point, which would be '
    + own.points[0][1] + ' against the fit\'s ' + interpAt(fit, below).toFixed(3));
});

