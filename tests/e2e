test('a factor that did not exist last visit reaches a returning reader', () => {
  // THE BUG THIS EXISTS FOR: the speech and image boards were collected, joined
  // and given default weights, every test passed, and a reader who had opened
  // the page before still saw a dash beside every voice model. their weights
  // were in localStorage from before those factors existed, and a stored map
  // wins over the defaults -- so the new keys were simply not in it.
  const before = {'aa.scicode': 0.3, 'aa.terminalbench': 0.3, 'lmarena.rating': 0.1};
  store.set('weights', before);
  store.set('weights-base', before);

  const back = restoreWeights();
  ok(back['aa-stt.accuracy'] > 0,
     'a factor added since is adopted at its default: ' + JSON.stringify(back));
  ok(back['aa-t2i.elo'] > 0, 'the image board too');
  eq(back['aa.scicode'], 0.3, 'and what the reader set is untouched');

  // a factor they turned OFF is a decision, not an absence: it is missing from
  // the stored map and present in the snapshot beside it, which is how the two
  // are told apart
  const zeroed = {...D.weights};
  delete zeroed['aa.terminalbench'];
  store.set('weights', zeroed);
  store.set('weights-base', D.weights);
  eq('aa.terminalbench' in restoreWeights(), false,
     'a weight dropped to zero stays dropped');

  store.set('weights', null);
  store.set('weights-base', null);
  RESET();
});

test('a speech model is scored on the boards that rank speech', () => {
  RESET();
  filters.mods = new Set();  // no shape picked is every shape
  filters.flags = new Set();

  // the complaint this exists for: every voice model showed a dash, including
  // the ones artificial analysis publishes a number for
  const speech = D.models.filter(m => m.kind === 'speech');
  const rated = speech.filter(m => scored(m).value !== null);
  ok(rated.length >= 5, 'speech models carry a composite: ' + rated.length
     + ' of ' + speech.length);

  // and it is the accuracy ordering, not the error-rate one
  const stt = D.models.filter(m => m.facets['aa-stt.accuracy'])
    .sort((a, b) => b.facets['aa-stt.accuracy'].value - a.facets['aa-stt.accuracy'].value);
  ok(stt.length >= 3, 'several transcribers are scored');
  ok(scored(stt[0]).value > scored(stt[stt.length - 1]).value,
     'the most accurate transcriber outranks the least: '
     + stt.map(m => m.short + '=' + num(scored(m).value, 0)));

  // a text model is not measured by a word error rate, and counting the speech
  // sliders against it would read as missing evidence rather than as a
  // question nobody asked of it
  const text = D.models.find(m => m.kind === 'text' && m.facets['aa.scicode']);
  ok(scored(text).want <= 7, text.short + ' is judged on the text weights only,'
     + ' got want=' + scored(text).want);
  ok(scored(rated[0]).want <= 4, rated[0].short + ' likewise, got want='
     + scored(rated[0]).want);

  // image generation is the same question again, over the boards that rate it
  const pics = D.models.filter(m => m.kind === 'image');
  const scoredPics = pics.filter(m => scored(m).value !== null);
  ok(scoredPics.length >= 3, 'image models carry a rating: ' + scoredPics.length
     + ' of ' + pics.length);
  // three boards rate generated pictures -- artificial analysis, lmarena and
  // the genai showdown -- and they disagree, which is why all three are
  // weighted rather than averaged. the fourth is reception: every non-text
  // model carries a `name.match` now, so what forums say reaches an image model
  // the same way it reaches a language one
  eq(scored(scoredPics[0]).want, 4,
     'and are judged on the three generation boards plus what forums said');

  RESET();
});

