test('a model is scored on the evidence the current view is asking about', () => {
  RESET();
  // the a2t roster is two populations: transcription models, and LLMs that also
  // take audio. they were scored on disjoint evidence and ranked in one column,
  // so inkling sat 12th on an AUDIO TO TEXT board on the strength of its
  // reasoning scores -- 34th on what it is measured to transcribe.
  const transcribes = m => (m.modalities.input || []).includes('audio')
    && (m.modalities.output || []).includes('text');
  const both = D.models.filter(m => m.kind === 'text' && transcribes(m));
  const pure = D.models.filter(m => m.kind === 'speech' && transcribes(m));
  ok(both.length >= 5, 'several models are in both rosters: ' + both.length);
  ok(pure.length > 20, 'and most of the a2t roster is not: ' + pure.length);

  const scoreIn = (mod, m) => {
    filters.mods = new Set([mod]);
    clearScores();
    return scored(m);
  };

  // a pure transcriber is asked nothing outside its own half, so restricting
  // the view to that half cannot move it. this is the guarantee that makes the
  // change safe: the roster the board is FOR does not re-rank
  pure.forEach(m => {
    const a = scoreIn('a2t', m).value, b = scoreIn('any2t', m).value;
    eq(a, b, m.short + ' scores the same whichever view asks');
  });

  // the dual-capability models are the whole of the difference
  const moved = both.filter(m =>
    scoreIn('a2t', m).want !== scoreIn('text', m).want);
  eq(moved.length, both.length,
     'every model in both rosters is judged on fewer factors in a2t');
  both.forEach(m => {
    ok(scoreIn('a2t', m).want < scoreIn('text', m).want,
       m.short + ' is asked fewer questions as a transcriber than as an LLM');
  });

  RESET();
});

test('changing the shape re-scores, rather than serving a cached answer', () => {
  RESET();
