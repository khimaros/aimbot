test('latent attention is not costed as a key and a value per head', () => {
  RESET();
  // kimi k3, ling 3.0 flash and deepseek v4 flash all cache one compressed
  // vector per token per layer instead
  ['kimi k3', 'ling 3.0 flash', 'deepseek v4 flash 0731'].forEach(s => {
    const a = model(s).facts.attn;
    ok(a.latent > 0, s + ' declares a latent width');
    ok(kvPerToken(a) < 2 * a.kv_heads * a.head_dim * KV_BYTES,
       s + ' costs less than the naive geometry');
    eq(kvPerToken(a), a.latent * KV_BYTES, s + ' is one vector, not two');
  });
  // ling was reading 84 gib at 128k before this
  ok(kvGib(model('ling 3.0 flash'), 131072) < 8,
     'ling 3.0 flash at 128k, got ' + kvGib(model('ling 3.0 flash'), 131072).toFixed(1));
});

