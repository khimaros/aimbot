test('generation speed is bandwidth over the bytes a token reads', () => {
  RESET();
  setHardware({bandwidth: 256, flops: 60});
  const m = model('gemma 4 31b'), q = activeQuant(m), t = tgTps(m), y = draftYield(m);
  near(t.empty, y * 256e9 * BW_EFFICIENCY / (activeB(m) * 1e9 * q.bpw / 8), 1e-6,
       'empty-cache generation');
  near(t.full,
       y * 256e9 * BW_EFFICIENCY
         / (activeB(m) * 1e9 * q.bpw / 8 + kvGib(m, minCtx) * (1024 ** 3)),
       1e-6, 'full-cache generation');
  ok(t.full < t.empty, 'a resident cache costs something');
  near(ppTps(m), 60e12 * FLOPS_EFFICIENCY / (2 * activeB(m) * 1e9), 1e-6,
       'prefill');
});

test('every declared drafter earns a yield, whatever the method', () => {
  RESET();
  ['qwen3.6 27b', 'qwen3.8 27b', 'gemma 4 31b', 'muse glimmer',
   'deepseek v4 flash 0731'].forEach(s => {
    const m = model(s);
    ok(draftKind(m), s + ' declares a drafter');
    ok(draftYield(m) > 1.8, s + ' earns a yield, got ' + draftYield(m).toFixed(2));
    near(tgTps(m).empty / draftYield(m),
         256e9 * BW_EFFICIENCY / (activeB(m) * 1e9 * activeQuant(m).bpw / 8),
         1e-6, s + ': the base underneath it is the plain read');
  });
  eq(draftYield(model('gpt-oss-120b')), 1, 'a model with no drafter gets none');
  // more drafts is worth less each time, which is why the registry stops at 3
  // for qwen3.8 and goes to 6 for qwen3.6
  ok(draftYield(model('qwen3.6 27b')) - draftYield(model('qwen3.8 27b')) < 0.2,
     'doubling the draft count is worth under a fifth of a token');
});

test('the yield reproduces the one measured drafting run', () => {
  // qwen3.8 27b on a strix halo under vulkan with the mtp predictor, from
  // MODELS.md: 16.68 / 14.24 / 12.74 t/s at UD-Q5_K_XL / Q6_K / Q8_0
  RESET();
  const m = model('qwen3.8 27b');
  const eff = 256e9 * BW_EFFICIENCY;
  [['UD-Q5_K_XL', 16.68], ['Q6_K', 14.24], ['Q8_0', 12.74]].forEach(([q, measured]) => {
    const c = quantChoices(m).find(x => x.quant === q);
    ok(c, q + ' is in the registry');
    const est = draftYield(m) * eff / (activeB(m) * 1e9 * c.bpw / 8);
    const off = Math.abs(est - measured) / measured;
    ok(off < 0.25, q + ': estimated ' + est.toFixed(2) + ' against ' + measured
      + ' measured, ' + (off * 100).toFixed(0) + '% off');
  });
});

test('a sidecar drafter is resident, so it counts against vram', () => {
  RESET();
  // no hand-written pairings survive: every drafter is discovered as a file in
  // the model's own repo
  D.models.forEach(m => eq((m.speculative || {}).draft_repo, undefined,
    m.short + ' pins no hand-made drafter'));
  // qwen folds the head into the -MTP- build, so the quant already paid
