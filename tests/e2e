});

test('every rung of the ladder passes the same fit test as the top one', () => {
  RESET();
  setLadder(true);
  const room = usable() - kvGib(model('muse glimmer'), minCtx);
  for (const q of fittingQuants(model('muse glimmer'))) {
    ok(q.gib <= room, q.quant + ' clears the budget');
    ok(q.bpw <= capBpw() && q.bpw >= floorBpw(), q.quant + ' clears cap and floor');
  }
  setHardware({cap: 'q4'});
  ok(fittingQuants(model('muse glimmer')).every(q => q.bpw <= 5.3),
     'lowering the ceiling drops the rungs above it');
  RESET();
  setLadder(false);
});

test('an expanded row is scored at its own quant', () => {
  RESET();
  setLadder(true);
  setEffective(true);
  const rows = expand(visible()).filter(r => r.repo === model('muse glimmer').repo);
  ok(rows.length > 1, 'glimmer expanded');
  const top = rows[0], bottom = rows[rows.length - 1];
  ok(top._q.bpw > bottom._q.bpw, 'the rungs differ in bits per weight');
  ok(modelRetention(top) > modelRetention(bottom), 'and in retention');
  ok(scored(top).value > scored(bottom).value,
     'so a 2-bit rung scores below an 8-bit one ('
     + scored(top).value.toFixed(1) + ' vs ' + scored(bottom).value.toFixed(1) + ')');
  setEffective(false);
  rows.forEach(r => { r._s = null; });
  near(scored(rows[0]).value, scored(rows[rows.length - 1]).value, 1e-9,
       'raw scores are the model\'s, so every rung reads the same');
  RESET();
  setLadder(false);
});

