test('a filter menu opens on its button and swallows the click', () => {
  RESET();
  drawFilterMenus();
  // the runtime picker: modality went back to a native single select, and this
  // control is the one that stayed a menu you pick several things from
  eq(html('#engines-ms').includes('ms-menu open'), false, 'it starts shut');

  document.querySelector('#engines-ms .ms-btn').onclick();
  ok(html('#engines-ms').includes('ms-menu open'), 'the button opens it');

  // THE BUG THIS EXISTS FOR: opening it redraws the wrapper's innerHTML, which
  // DETACHES the node that was clicked. the document handler that closes a menu
  // on an outside click then asked `does the wrapper contain the target`, got
  // false for a click that was plainly inside, and shut the menu in the same
  // gesture that opened it -- so neither dropdown could be opened at all. the
  // wrapper stops the click instead, and it has to be the wrapper rather than
  // the button, because the button is the node that gets replaced.
  //
  // the assertion above cannot catch that on its own: the dom stub never
  // dispatches, so the document handler does not run here the way it does in a
  // browser. this is the half that encodes the fix.
  let stopped = false;
  document.querySelector('#engines-ms').onclick({stopPropagation: () => { stopped = true; }});
  ok(stopped, 'a click inside the dropdown never reaches the document');

  document.querySelector('#engines-ms .ms-btn').onclick();
  eq(html('#engines-ms').includes('ms-menu open'), false, 'and it closes again');
  RESET();
});

test('the help panel stays down while a dropdown is open', () => {
  RESET();
  const tip = document.querySelector('#tip');
  // a fake hover target: the stub has no closest(), and what is being checked
  // is the handler's decision rather than the dom's traversal
  const over = help => onHover({target: {closest: sel =>
    sel === '[data-help]' && help
      ? {dataset: {help}, getBoundingClientRect: () => ({left: 0, bottom: 0})}
      : null}});

  openMenu = null;
  over('what this control does');
  eq(tip.style.display, 'block', 'hovering a control explains it');

  // THE BUG: opening a menu redraws the wrapper, and a redraw under a pointer
  // that has not moved fires `mouseover` for the node that replaced the one it
  // was over -- so the panel the click had just dismissed came straight back,
  // and clicking read as doing nothing
  openMenu = 'modality-ms';
  over('what this control does');
  eq(tip.style.display, 'none', 'with a menu open, nothing explains itself');

  openMenu = null;
  over(null);
  eq(tip.style.display, 'none', 'and hovering nothing hides it again');
  RESET();
});

