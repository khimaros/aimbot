test('quant adjustment leaves an interval scale alone', () => {
  RESET();
  // an elo has an arbitrary zero: 1435 is not "twice as good" as 717, so
  // multiplying it by a retention fraction is not a discount, it is a
  // translation whose size depends on where the scale happens to start.
  // x0.93 on lmarena is -101 elo, which is the entire spread of this registry.
  const moved = [];
  D.models.filter(m => m.facets['lmarena.rating']).forEach(m => {
    setEffective(false);
    const raw = facetPctRaw(m, 'lmarena.rating');
    setEffective(true);
    const eff = facetPctRaw(m, 'lmarena.rating');
    if (raw !== eff) moved.push(m.short + ' p' + raw + ' -> p' + eff);
  });
  eq(moved.length, 0, 'arena percentiles must not move with the quant\n'
    + '       moved: ' + moved.join('; '));
});
"""


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--keep", action="store_true", help="leave the probe on disk")
    args = ap.parse_args()

    r = pageboot.run(HELPERS + CASES + RUNNER, PROBE, keep=args.keep)
    sys.exit(r.returncode)


if __name__ == "__main__":
    main()
