// a model this budget can only run well below bf16, whichever it happens to be
const squeezed = key => D.models.filter(m => m.facets[key] && !m.native_low_bpw)
  .sort((a, b) => modelRetention(a) - modelRetention(b))[0];

test('quant adjustment discounts a ratio scale and reranks on it', () => {
  RESET();
  setEffective(true);
  // a coding index has a real zero, so discounting it is a statement about
  // measured skill rather than about where a scale starts
  const m = squeezed('aa.coding');
  ok(modelRetention(m) < 0.95,
     m.short + ' is discounted at the quant that fits, x' + modelRetention(m).toFixed(3));
  ok(facetValue(m, 'aa.coding') < m.facets['aa.coding'].value,
     'the coding index comes down with it');
});

test('the discount reaches only what the curve is evidence for', () => {
  RESET();
  setEffective(true);
  const meta = Object.keys(D.facet_meta);
  const scaled = meta.filter(scaledFacet);
  ok(scaled.length > 20 && scaled.length < meta.length / 2,
     'a minority of facets, not almost all (' + scaled.length + ' of ' + meta.length + ')');
  // the sweep behind the curve is a code-editing pass rate
  ['aa.coding', 'swerebench.resolved', 'gbench.oneshot', 'lang.rust',
   'epoch.aider_polyglot', 'card.swebench_verified'].forEach(k =>
    ok(scaled.includes(k), k + ' is code, so the curve answers for it'));
  ['aa.non_hallucination', 'card.mmlu', 'epoch.chess_puzzles',
   'epoch.lech_mazur_writing', 'aa.tau_banking', 'card.mmmu',
   'aa.intelligence'].forEach(k =>
    ok(!scaled.includes(k), k + ' is not code, so it keeps its published number'));
});

test('every facet is classified, and un-discounted ones say why', () => {
  const meta = Object.keys(D.facet_meta);
  const loose = meta.filter(k => !whyNotScaled(k));
  eq(loose.join(', '), '', 'facets with no evidence classification');
  const named = new Set(D.retention.evidence.flatMap(e => e.facets));
  meta.forEach(k => ok(named.has(k), k + ' appears in exactly one group'));
  D.retention.evidence.forEach(e => {
