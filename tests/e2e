test('quantization is its own tab, and the discount follows the quant you picked', () => {
  RESET();
  // everything about what a quant IS was spread over the operate tab, between
  // the run snippets and the sampler table -- the rung ladder, the published
  // sweep -- and it has its own tab now. what the registry says about each repo
  // is one more fact about the files, so it is there too.
  ok(TABS.includes('quantization'), 'the tab exists: ' + TABS);

  // qwen3.8 27b is the model three people ran on their own files, so it is the
  // one that shows both halves of the rule: whichever curve answered is named,
  // and every sweep is listed whether or not it answered
  const measured = D.models.find(x => (D.retention.measured[x.repo] || []).length);
  ok(measured, 'the roster carries a measured curve');
  openModel(measured.repo, 'quantization');
  const html_ = html('#body');
  const curve = curveFor(measured);
  // which curve answered lives where the discount is drawn -- the operate tab's
  // panel -- and the sweeps that did not answer have to say so there, because
  // they are printed three rows below on THIS tab as if they were the evidence
  const drawn = tabOperate(measured);
  ok(drawn.includes(curve.kind), 'the panel names the curve that answered: ' + curve.kind);
  if (unusedSweeps(measured, curve).length) {
    ok(drawn.includes('this model carries'),
       'and says why the sweeps on the next tab did not carry the ranking');
  }
  // EVERY sweep of this model, not just the one its own rung is scored against:
  // the tab is about what a quant is, and two people measuring the same model
  // on different files is the most interesting thing that can be true of it
  D.retention.measured[measured.repo].forEach(c => {
    ok(html_.includes(c.metric), 'and names what was measured: ' + c.metric);
    ok(html_.includes(c.quant_repo), 'and whose files: ' + c.quant_repo);
  });

  // the rung ladder is here, and NOTHING here follows the operate tab's chips:
  // it is every rung of every repo that publishes one, with the rung the page
  // SCORES in bold -- the one the discount above was computed at. drawn against
  // the picked repo instead, choosing a quant to write a command for would
  // silently redraw a tab about scoring.
  ok(html_.includes('quants in'), 'the ladder is on the tab about quants');
  eq(html_.includes('data-pick-quant'), false, 'and there is nothing to pick');
  const repos = [...new Set(quantChoices(measured).map(c => c.repo))];
  repos.forEach(r => ok(html_.includes('quants in <span class="faint">' + r),
     'every publishing repo gets its ladder, missing ' + r));
  ok(html_.includes('the repos it is published in'), 'the repos are on the tab about files');
  eq(html_.includes('what the quality discount did'), false,
     'and the discount is not: it is arithmetic about the rung picked on operate');

  openModel(measured.repo, 'operate');
  const op = html('#body');
  eq(op.includes('quants in'), false, 'the ladder is not on operate as well');
  eq(op.includes('the repos it is published in'), false, 'nor the repos');
  ok(op.includes('data-pick-quant'), 'the pickers stay, since a snippet reads them');
  // the command is what a reader opens the tab for; the other configs are not
  const opened = [...op.matchAll(/<details[^>]*\bopen\b[^>]*>\s*<summary[^>]*>([^<]*)</g)]
    .map(x => x[1]);
  eq(opened.length, 1, 'one config is open: ' + opened);
  ok(opened[0].startsWith('llama-server'), 'and it is the llama-server one: ' + opened);
  ok(/<details class="snippet">/.test(op), 'the rest stay closed');

  // the discount is about ONE file, and the file is the one picked. a measured
  // curve answers only for the repo it ran, so picking a rung out of another
  // repo has to change the curve as well as the bits
  const discount = page => {
    const at = page.indexOf('<h3>what the quality discount did');
    ok(at !== -1, 'the discount is drawn on operate');
    return page.slice(at, page.indexOf('<h3>', at + 4));
  };
  const seen = new Set();
  ops = {runtime: 'llama.cpp', repo: null, quant: null, profile: null};
  repoChoices(measured).forEach(r => {
    const pick = quantChoices(measured).filter(c => c.repo === r && c.bpw)
      .sort((a, b) => a.bpw - b.bpw)[0];
    if (!pick) return;
    ops = {runtime: 'llama.cpp', repo: r, quant: pick.quant, profile: null};
    const block = discount(tabOperate(measured));
    ok(block.includes(esc(pick.quant)), r + ': the block names the picked rung ' + pick.quant);
    const kept = num(retention(rungBpw(pick), measured, pick) * 100, 1) + '%';
    ok(block.includes(kept), r + ': and what that rung keeps, ' + kept + ': ' + block);
    // and the curve is the MODEL's rather than each repo's: a sweep of one
    // publisher's files cannot rank another's, so what answers here is the same
    // for every rung the model publishes and the panel says which one it was
    eq(block.includes('measured on these files'),
       curveFor(measured, pick).kind === 'measured',
       r + ': the panel claims a measurement only when a sweep ranks this model');
    eq(curveFor(measured, pick).kind, curveFor(measured).kind,
       r + ': every rung shares the one curve the model is ranked on');
    seen.add(block);
  });
  ok(seen.size > 1, 'different picks draw different arithmetic');

  ops = {runtime: null, repo: null, quant: null, profile: null};
  closeModel();
  RESET();
});

// a sweep is published in ladder order and that is the LAST order to read it
// in: the question a reader brings to it is which rung to pull, and the answer
// is a row the ladder buries. byteshape's qwen3.8 27b sweep interleaves plain
// rungs with unsloth's dynamic ones -- Q4_0 at 4.62 bpw diverges more than
// UD-Q4_K_S at 4.42 -- so in ladder order that comparison is the reader's to
// make. the measured tables read worse still, ascending retention, which puts
// the rung that keeps the least at the top.
test('the quant sweep tables are sorted best first', () => {
  RESET();
  // <quant, bpw, value> off each drawn row, in the order drawn. the value cell
  // is the only inner `<span>` of a row, the bar around it carrying a class
  const ROW = /<tr><td>([^<]*)<\/td><td class="n dim">([^<]*)<\/td>(?:(?!<\/tr>)[\s\S])*?<span>([\d.]+)/g;
  // the body of each table under that heading, without the header row, whose
  // own </tr> would come before every cell the rows are checked for
  const sections = (page, head) => page.split('<h3>').filter(s => s.startsWith(head))
    .map(s => s.slice(s.indexOf('<tbody>'), s.indexOf('</table>')));
  let seen = 0, crossed = 0;
  const check = (m, head, curves) => {
    const drawn = sections(tabQuantization(m), head);
    eq(drawn.length, curves.length, m.short + ': one `' + head + '` table per sweep');
    curves.forEach((c, n) => {
      const rows = [...drawn[n].matchAll(ROW)].map(r => [r[1], +r[2], +r[3]]);
      eq(rows.length, c.points.length, m.short + ' ' + c.metric + ': every rung drawn');
      seen++;
      // read top to bottom, the value column runs best to worst. retention
      // declares no direction because a share of bf16 only runs one way
      const sign = c.better === 'lower' ? 1 : -1;
      rows.forEach((r, i) => i && ok(sign * (r[2] - rows[i - 1][2]) >= 0,
        m.short + ' ' + c.metric + ': ' + r[0] + ' at ' + r[2] + ' is drawn under '
        + rows[i - 1][0] + ' at ' + rows[i - 1][2] + ', which is worse'));
      // the rung NAME travels with its own number: quants and points are two
      // parallel arrays, and sorting one of them is how they come apart
      if (c.quants) rows.forEach(([quant, bpw]) => {
        const at = c.quants.indexOf(quant);
        ok(at !== -1, m.short + ': ' + quant + ' is not a rung of this sweep');
        if (at !== -1) near(c.points[at][0], bpw, 0.005,
          m.short + ' ' + quant + ': drawn against another rung\'s bpw');
      });
      // the source cell spans the table off whichever row sorted first
      eq((drawn[n].match(/rowspan=/g) || []).length, 1,
         m.short + ' ' + c.metric + ': one source cell');
      ok(drawn[n].indexOf('rowspan=') < drawn[n].indexOf('</tr>'),
         m.short + ' ' + c.metric + ': the source cell is not on the first row');
      // where the sweep is not monotonic in bpw, best-first is a REORDER rather
      // than a reversal of the ladder, which is the whole reason to do it
      const bpws = rows.map(r => r[1]);
      const runs = dir => bpws.every((b, i) => !i || dir * (b - bpws[i - 1]) >= 0);
      if (!runs(1) && !runs(-1)) crossed++;
    });
  };
  D.models.forEach(m => {
    const measured = (D.retention.measured || {})[m.repo] || [];
    const proxies = (D.retention.proxies || {})[m.repo] || [];
    if (measured.length) check(m, 'measured on this model', measured);
    if (proxies.length) check(m, 'published quant sweep', proxies);
  });
  ok(seen > 5, 'there were sweeps to read, got ' + seen);
  ok(crossed > 0, 'and best-first crosses the ladder somewhere rather than'
     + ' just reversing it');
});

