// the verdicts name their figures now -- `{aa.speed}` rather than `aa.speed
// p77` -- so that the number a reader sees is read from the capture at build
// time and cannot be the one somebody typed last year. that only holds if
// something RENDERS them: shipped raw, the page prints the brace.
test('a verdict ships its figures rendered, never as a raw reference', () => {
  RESET();
  const raw = /\{[a-z][a-z0-9_.-]*\}/i;
  const fields = ['one_liner', 'notes', 'use_for', 'avoid_for', 'evidence'];
  let checked = 0;
  // prose is a list of parts, and a part that resolved carries the figure in
  // `shown`. one that did NOT is left holding its brace on purpose, so this
  // still reads every word a reader will see
  const words = v => typeof v === 'string' ? v
    : (v || []).map(p => typeof p === 'string' ? p : p.shown).join('');
  D.models.forEach(m => {
    const a = m.assessed || {};
    fields.forEach(f => {
      const v = a[f];
      if (!v || !v.length) return;
      const many = Array.isArray(v) && v.some(x => Array.isArray(x));
      (many ? v : [v]).forEach(one => {
        checked++;
        const text = words(one);
        ok(!raw.test(text), m.short + ' ' + f + ' still carries a reference: ' + text);
      });
    });
  });
  ok(checked > 300, 'and there were verdicts to check, got ' + checked);

  // and the registry notes, which reference their own vocabulary -- `{gib}`,
  // `{card}`. these hang off six different blocks and the renderer only knew
  // two of them, so `sampling.thinking.note` shipped the brace to the page.
  let notes = 0;
  const walk = (o, where) => {
    // the model-level note ships as PARTS now, the way the assessment does;
    // the ones in table cells are still flat strings
    const asParts = Array.isArray(o) && o.some(x => x && x.shown !== undefined);
    if (typeof o === 'string' || asParts) {
      notes++;
      const text = typeof o === 'string' ? o
        : o.map(x => typeof x === 'string' ? x : x.shown).join('');
      ok(!raw.test(text), where + ' ships a raw reference: ' + text.slice(0, 90));
    } else if (o && typeof o === 'object') {
      Object.entries(o).forEach(([k, v]) => {
        if (k === 'note' || k === 'notes' || (v && typeof v === 'object')) {
          walk(v, where + '.' + k);
        }
      });
    }
  };
  D.models.forEach(m => ['notes', 'sampling', 'speculative', 'runtime', 'thinking',
                         'turns', 'quants', 'components']
    .forEach(f => walk(m[f], m.short + '.' + f)));
  ok(notes > 150, 'and there were notes to check, got ' + notes);
});

