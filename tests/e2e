// the weighted mean over the factors present, before shrinkage: what the
// composite used to be, and what the cases below measure the shrinkage against
const rawScore = m => {
  const only = Object.keys(W).filter(k => W[k] && asked(m, k)
    && facetPct(m, k) !== null);
  return only.reduce((a, k) => a + W[k] * facetPct(m, k), 0)
    / only.reduce((a, k) => a + W[k], 0);
};
const coveredWeight = m => Object.keys(W)
  .filter(k => W[k] && asked(m, k) && facetPct(m, k) !== null)
  .reduce((a, k) => a + W[k], 0);
const askedWeight = m => Object.keys(W).filter(k => W[k] && asked(m, k))
  .reduce((a, k) => a + W[k], 0);

test('a missing factor is shrunk toward the middle, never scored zero', () => {
  RESET();
  const m = model('qwen3.5-27b');
