  // multiplying it by a retention fraction is not a discount, it is a
  // translation whose size depends on where the scale happens to start.
  // x0.93 on lmarena is -101 elo, which is the entire spread of this registry.
  const moved = [];
  D.models.filter(m => m.facets['lmarena.rating']).forEach(m => {
    setEffective(false);
    const raw = facetPctRaw(m, 'lmarena.rating');
    setEffective(true);
    const eff = facetPctRaw(m, 'lmarena.rating');
    if (raw !== eff) moved.push(m.short + ' p' + raw + ' -> p' + eff);
  });
  eq(moved.length, 0, 'arena percentiles must not move with the quant\n'
    + '       moved: ' + moved.join('; '));
});

test('the pi config states the level vocabulary the template actually accepts', () => {
  RESET();
  // pi cannot read a chat template, so every level it offers has to be spelled
  // out. a level the template would reject has to be spelled out too, as null,
  // or pi offers it and the request raises.
  const ink = model('inkling small');
  const cfg = JSON.parse(piProvider(ink, {repo: 'r', quant: 'Q'}, 'thinking', true));
  const e = cfg.providers.local.models[0];

  eq(e.thinkingLevelMap.off, 'none',
     'the template calls the bottom of its scale `none`, and pi calls it `off`');
  eq(e.thinkingLevelMap.medium, 'medium', 'a level both agree on passes through');
  // the registry aliases xhigh onto max for this model, which resolves what a
  // PROFILE asked for. advertising it to pi as well would disagree with the
  // config llama-tools deploys, whose vocabulary stops at max
  eq(e.thinkingLevelMap.xhigh, null, 'a profile alias is not a level pi may ask for');
  eq(Object.keys(e.thinkingLevelMap).length, 7, 'every pi level is stated, present or not');

  // audio is in this model's modalities and pi's schema rejects it outright
  eq(JSON.stringify(e.input), '["text","image"]', 'audio is dropped, image is kept');
  eq(e.compat.thinkingFormat, 'chat-template', 'a graded knob is set through kwargs');
  ok(!('omitWhenOff' in e.compat.chatTemplateKwargs.reasoning_effort),
     'the template has its own word for off, so the kwarg must still be sent');

  // a plain on/off gate is a different format, and has no graded vocabulary
  const g = JSON.parse(piProvider(model('gemma 4 31b'),
                                  {repo: 'r', quant: 'Q'}, 'thinking', true));
  const ge = g.providers.local.models[0];
  eq(ge.compat.thinkingFormat, 'qwen-chat-template', 'a toggle is not a graded knob');
  eq(ge.thinkingLevelMap.high, 'high', 'a toggle offers on and off only');
  eq(ge.thinkingLevelMap.medium, null, 'and hides every level in between');

  // a knob that grades levels AND keeps a separate gate omits the kwarg to
