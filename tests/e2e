  ok(s.have < s.want, 'this model is measured by only some of the factors');
  ok(s.value > 0, 'and still scores on the ones it has');
  const k = SHRINK_LAMBDA * (askedWeight(m) - coveredWeight(m));
  near(s.value,
       (rawScore(m) * coveredWeight(m) + k * SHRINK_PRIOR)
         / (coveredWeight(m) + k),
       1e-9, 'the composite is the mean over present factors, shrunk by the'
         + ' weight that measured nothing');
});

// renormalizing over present factors redistributes the missing weight onto
// whatever the model DOES have, so the fewer factors it carries the harder each
// one counts -- which is how bonsai 27b took 19th of 92 on a single 0.05 forum
// percentile, ahead of the qwen3.6 27b it is a 1-bit rebuild of at 6/7.
// research/build-tables rejected the same arithmetic in its composite()
// docstring; these cases are the page agreeing with it.
//
// shrinking fixed the ranking and left a number behind, and at this coverage
// the number was the prior wearing a model's name -- 50 for a model nobody had
// measured. so under COVER_FLOOR the composite is withheld rather than shrunk.
test('one thin factor cannot carry a whole composite', () => {
  RESET();
  const m = model('bonsai 27b');
  const s = scored(m);
  ok(s.have < s.want / 2, 'nothing but the forums has scored bonsai 27b ('
    + s.have + '/' + s.want + ')');
  ok(coveredWeight(m) < COVER_FLOOR * askedWeight(m), 'on a sliver of the weight');
  eq(s.value, null, 'so it is given no composite at all, rather than one the'
     + ' prior decides (renormalized it would have read '
     + rawScore(m).toFixed(1) + ')');
});

