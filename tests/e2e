test('the page carries its own icon, and it is a monochrome crosshair', () => {
  const links = [...PAGE_HTML.matchAll(/<link\b[^>]*rel="icon"[^>]*>/g)];
  eq(links.length, 1, 'exactly one icon link');
  const href = (links[0][0].match(/href="([^"]*)"/) || []).pop() || '';
  ok(href.startsWith('data:image/svg+xml,'), 'inlined, not fetched: ' + href);
  eq((PAGE_HTML.match(/href="[^"]*favicon/g) || []).length, 0,
     'nothing asks the host for an icon file');
  // a bare # is the url's own terminator, and a quote ends the attribute
  eq(/[#"&<>]/.test(href), false, 'the encoding has to survive an href');
  eq(/[^\x00-\x7f]/.test(links[0][0]), false, 'an href stays ascii');

  const svg = decodeURIComponent(href.slice('data:image/svg+xml,'.length));
  ok(svg.startsWith('<svg') && /xmlns="http:\/\/www\.w3\.org\/2000\/svg"/.test(svg),
