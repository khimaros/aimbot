test('the runtime filter is a multi-select over what actually loads a model', () => {
  RESET();
  filters.mods = new Set(['all']);
  filters.flags = new Set();

  eq([...filters.engines].sort().join(','),
     'crispasr,llama.cpp,stable-diffusion.cpp',
     'three runtimes are on by default');

  const shown_ = visible().map(m => m.short);
  ok(shown_.includes('whisper-large-v3-turbo'), 'crispasr models are in');
  ok(shown_.includes('z-image-turbo'), 'and the one stable-diffusion.cpp loads');
  // breeze-tts-2's gguf needs a C++ reimplementation published beside it, and
  // that runtime is not selected. kokoro is NOT this case, though its gguf is a
  // TTS.cpp file: crispasr has a kokoro backend and converts the checkpoint
  // itself, so it is in under a runtime that reads none of the pinned rungs
  eq(shown_.includes('breeze-tts-2'), false,
     'a model whose only runtime is unselected is out');

