  W = {...D.weights};
  hidden = new Set(DEFAULT_HIDDEN);
  // the filters are shared state across cases too: one that clears the runtime
  // filter to isolate another must not leave the next case filtering on nothing
  filters.mods = new Set(DEFAULT_MODALITIES);
  filters.flags = new Set(DEFAULT_FLAGS);
  filters.engines = new Set(DEFAULT_ENGINES);
  filters.licenses = new Set(DEFAULT_LICENSES);
  filters.pubs = new Set();
  filters.minParams = null;
  filters.maxParams = null;
  reweigh();
};

test('the roster can say what it is MISSING, and does it one way', () => {
  RESET();
  filters.mods = new Set();  // no shape picked is every shape
  filters.flags = new Set();
  // and no tier picked is every licence. this case is about what nothing here
  // RUNS, which is a different question from what a reader could ship under
  filters.licenses = new Set();

  // there used to be a `has gguf` toggle beside the runtime filter, asking the
  // same question with none of the answer, and the two disagreed: turning it
  // off still hid supertonic-3, because the runtime filter was hiding it for
  // its own reason. one control now, and clearing it is what shows the entries
  // carried precisely because nothing here serves them.
  const runnable = visible().map(m => m.short);
  eq(runnable.includes('supertonic-3'), false,
     'with a runtime selected, weights nothing loads are out');

  filters.engines = new Set();
  const all = visible().map(m => m.short);
