test('what verdict measured on the served gguf is half of a decision model\'s score', () => {
  // jevbench's board reads each model in bf16 off its author's server; verdict
  // runs the public items through the quantized file a host actually serves.
  // the decision models and the text models that measured as one both carry it
  ['winnow-12b', 'gemma 4 12b', 'decider-4b'].forEach(short => {
    const f = model(short).facets;
    ['verdict.accuracy', 'verdict.hard', 'verdict.calibration'].forEach(k =>
      ok(f[k] && f[k].value > 0 && f[k].value <= 1, short + ' carries ' + k));
    ok(/\.gguf at /.test(f['verdict.accuracy'].ref.note),
       short + ' names the file it ran: ' + f['verdict.accuracy'].ref.note);
  });
  // the board reads bf16 on the author's server and verdict reads the file a
  // host serves, so the two halves of the decision score weigh the same, split
  // the way the board's is. `hard` is a slice of `accuracy` and rides at zero
  const sum = prefix => Object.keys(D.weights).filter(k => k.startsWith(prefix))
    .reduce((a, k) => a + D.weights[k], 0);
  near(sum('verdict.'), sum('jev.'), 1e-9, 'verdict weighs what the board does');
  eq(D.weights['verdict.accuracy'], D.weights['jev.intelligence'], 'being right');
  eq(D.weights['verdict.calibration'], D.weights['jev.calibration'], 'knowing it');
  eq(D.weights['verdict.hard'], 0, 'a slice of the whole is not weighted beside it');
  // FOR DECISION MODELS: nine text models carry these numbers too, and a factor
  // asked by kind would put a decision score in every language model's
  // denominator. it is asked by capability, like the board it re-runs
  RESET();
  ok(asked(model('winnow-12b'), 'verdict.accuracy'), 'asked of a decision model');
  eq(asked(model('gemma 4 12b'), 'verdict.accuracy'), false,
     'and not of a text model that happens to carry it');
  eq(asked(model('qwen3.8 27b'), 'verdict.accuracy'), false,
     'nor of one that does not');
  const g = D.groups.find(x => x.name === 'verdict');
  ok(g && g.about.includes('gguf'), 'and the group says what was measured: ' + JSON.stringify(g));
});

test('audio.cpp and gufo are engines their own catalogs claim', () => {
  RESET();
  // two runtimes the registry never WRITES: each project publishes a catalog of
  // what it loads, naming huggingface repos, and `build-viewer` joins that to the
  // registry. so a family that stops shipping a checkpoint stops being an option
  // the moment the capture is refreshed, and no model can be marked as loading
  // under an engine its own bytes disagree with.
  const rt = k => (D.config.runtimes || []).find(r => r.k === k);
  ok(rt('audio.cpp'), 'audio.cpp is a runtime the config declares');
  ok(rt('gufo'), 'and so is gufo');
  ok(DEFAULT_ENGINES.indexOf('audio.cpp') < 0 && DEFAULT_ENGINES.indexOf('gufo') < 0,
     'neither is on by default: ' + DEFAULT_ENGINES.join(','));

  ok(runtimesFor(model('omnivoice')).some(r => r.k === 'audio.cpp'),
     'omnivoice runs under audio.cpp');
  ok(runtimesFor(model('qwen3.8 27b')).some(r => r.k === 'gufo'),
     'and qwen3.8 27b under gufo');

  // AUDIO.CPP LOADS A PACKAGE AND NOT THE RUNG ON THE ROW, so the command
  // installs that package and points --model at where it lands. an `hf://` here
  // would be a path audio.cpp has no way to read.
  //
  // WHICH package is the part this page will not guess. a family publishes its
  // own gguf of the checkpoint AND a snapshot of the checkpoint itself, and the
  // spec says nothing that attributes a gguf to one checkpoint rather than a
  // sibling in the same family, so the command names the package downloaded from
  // the repo this entry is keyed on and counts the rest.
  ops = {runtime: 'audio.cpp', repo: null, quant: null, profile: null};
  const ac = snippets(model('omnivoice')).map(s => s.text).join('\n');
  ok(/^audiocpp_model_manager install omnivoice_safetensors/m.test(ac),
     'the package is installed by the manager: ' + ac);
  ok(ac.includes('--family omnivoice'), 'the loader is named, not sniffed');
  ok(ac.includes('--task tts'), 'and so is the task');
  ok(ac.includes('--model models/OmniVoice'),
     'a snapshot package is a directory: ' + ac);
  ok(/^# omnivoice publishes \d+ package/m.test(ac),
     'and the other packages are counted, not hidden: ' + ac);
  ok(!ac.includes('hf://'), 'and no hf:// reference reaches a local path');

  // where the checkpoint IS distributed as gguf, the same rule lands on a file
  // inside its target directory, which is the shape most families take
  ops = {runtime: 'audio.cpp', repo: null, quant: null, profile: null};
  const bit = snippets(model('vibevoice-bitnet')).map(s => s.text).join('\n');
  ok(bit.includes('--model models/VibeVoice-ASR-BitNet/vibeasr-vae-encoder-i8_s.gguf'),
     'a gguf package names its file: ' + bit);

  // ONE FAMILY, TWO CHECKPOINTS. `qwen3_asr` is 0.6b and 1.7b, and the family's
  // own recommended package is the 1.7b. handing it to the 0.6b row prints a
  // command for a model three times the size of the row above it, which is the
  // same class of wrong as the wrong crispasr conversion: it runs, and it is not
  // this model.
  ops = {runtime: 'audio.cpp', repo: null, quant: null, profile: null};
  const small = snippets(model('qwen3-asr-0.6b')).map(s => s.text).join('\n');
  ok(small.includes('models/Qwen3-ASR-0.6B'),
     'the 0.6b takes the package from its own repo: ' + small);
  ok(!small.includes('1.7b'), 'and never the family default: ' + small);
  ok(small.includes('--task asr') && small.includes('--audio audio.wav'),
     'an asr family is given audio and not text: ' + small);

  // GUFO LOADS THE FILE ITS GUIDE WAS MEASURED AT, drafter included. the sidecar
  // flag is the guide's own -- dflash-model here, mtp-model next door -- and a
  // command that dropped it starts a server with no drafter at a fraction of the
  // figure the guide quotes, silently.
  ops = {runtime: 'gufo', repo: null, quant: 'UD-Q4_K_XL', profile: null};
  const g = snippets(model('qwen3.8 27b')).map(s => s.text).join('\n');
  // the path `hf download` actually lands a file at, rather than a directory
  // this page invented: the cache layout is `hf download`'s own report, and its
  // snapshot directory IS the revision -- so the pinned revision is both what
  // gets fetched and what gets pointed at, with no layout to agree on first
  const CACHE = '~/.cache/huggingface/hub';
  const at = (repo, rev, file) =>
    `${CACHE}/models--${repo.replace('/', '--')}/snapshots/${rev}/${file}`;
  ok(/^gufo serve /m.test(g), 'the fragment invokes gufo: ' + g);
  ok(g.includes('gufo serve --port 8080 llm \\\n  --model '
     + at('unsloth/Qwen3.8-27B-GGUF', '4ca720788d1e01f1bff70c033e0d0028fd02e502',
          'Qwen3.8-27B-UD-Q4_K_XL.gguf')),
     'the subcommand comes before --model, at the default download path: ' + g);
  ok(g.includes('--speculative dflash2'), 'at the mode it was measured with');
  ok(g.includes('--dflash-model '
     + at('z-lab/Qwen3.8-27B-DFlash2-GGUF',
          '2d9571f8ce46e151f61c6499c99dee6079e1d610',
          'Qwen3.8-27B-DFlash2-Q4_K_M.gguf')),
     'with the draft from its own repo, in its own cache entry: ' + g);
  ok(g.includes('--revision 4ca720788d1e01f1bff70c033e0d0028fd02e502'),
     'the download names the revision, which is the directory: ' + g);
  ok(!g.includes('--local-dir'),
     'and nothing settles a directory the path would then have to agree with: ' + g);
  ok(!/ --model models\//.test(g), 'no models/ layout of ours: ' + g);
  ok(g.includes('HF_HOME'),
     'the note says the cache location is a default and can move: ' + g);
  // EVERY NOTE ON ITS OWN LINE. three of them became one comma-separated line
  // when the notes went from a single string to a list, and every `includes`
  // assertion above still passed -- a comment block that reads as prose mush is
  // not a comment block, and it certainly is not copy-pasteable
  const head = g.split('\n').slice(0, g.split('\n').findIndex(l => /^gufo serve /.test(l)));
  head.forEach((l, i) => ok(/^# |^hf download /.test(l) || /^hf download /.test(l),
     'note line ' + i + ' is a comment or the fetch, not a fragment: ' + l));
  ok(!head.join('').includes(',#'), 'no notes smeared together with commas: ' + g);
  ok(head.filter(l => /^# /.test(l)).length >= 2,
     'the warnings survive as their own lines: ' + head.join('|'));

  ops = {runtime: 'gufo', repo: null, quant: null, profile: null};
  const flash = snippets(model('qwen3.8 flash next')).map(s => s.text).join('\n');
  ok(flash.includes('--speculative mtp') && flash.includes('--mtp-model'),
     'the mtp build gets the mtp flag: ' + flash);
  ok(!flash.includes('--dflash-model'),
     'and not the dflash one: ' + flash);

  // the engine filter asks the same question the chips do, in the other
  // direction: picking gufo is asking what THAT loads
  filters.mods = new Set();
  filters.flags = new Set();
  filters.licenses = new Set();
  filters.engines = new Set(['gufo']);
  const gufoOnly = visible().map(m => m.short);
  ok(gufoOnly.includes('qwen3.8 27b') && gufoOnly.includes('qwen-image-2.1'),
     'gufo loads them: ' + gufoOnly.join(','));
  eq(gufoOnly.includes('whisper-large-v3-turbo'), false,
     'and gufo does not load whisper');

  ops = {runtime: null, repo: null, quant: null, profile: null};
  filters.engines = new Set(DEFAULT_ENGINES);
  RESET();
});

