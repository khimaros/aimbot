  ok(all.length > runnable.length, 'and that is strictly more rows');

  const missing = all.filter(s => !(model(s).engines || []).length);
  ok(missing.length >= 5, 'several entries name no runtime at all: ' + missing);
  ok(missing.includes('krea-2-raw'), 'including the image models with no loader');

