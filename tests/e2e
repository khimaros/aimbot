  eq(bx + ',' + by + ',' + bw + ',' + bh, '0,0,32,32', 'a square canvas');

  // monochrome in the literal sense: one colour, and no hue to clash with a
  // reader's tab bar. mid grey because the one icon has to read on a light tab
  // bar and a dark one, and a #fff reticle is invisible on the first.
  const colors = [...new Set(svg.match(/#[0-9a-f]{6}/g) || [])];
  eq(colors.length, 1, 'one colour: ' + colors.join(','));
  const [cr, cg, cb] = colors[0].slice(1).match(/../g).map(h => parseInt(h, 16));
  eq(cg, cr, 'no hue: r == g');
  eq(cb, cr, 'no hue: r == b');
  ok(cr >= 0x55 && cr <= 0xaa, 'dark enough for a light tab bar, light enough '
     + 'for a dark one: ' + colors[0]);
  eq(/gradient|animat|<style/i.test(svg), false, 'a mark, not an effect');

  // a crosshair: a ring, a centre, and four ticks
  eq((svg.match(/<circle/g) || []).length, 2, 'a ring and a centre');
  eq(((svg.match(/<path[^>]*d="([^"]*)"/) || []).pop() || '').split('M').length - 1, 4,
