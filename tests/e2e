// the curve's lowest fitted point is deepseek v3.1 at 2.21 bpw, and below that
// `retention` returns that point's value forever -- a 1.30 bpw rung reads as
// keeping 77.8% of its score because the curve has nothing to say and says the
// last thing it knew. quesma's qwen3.8 27b sweep is the first measurement in
// that region and it found collapse to chance at 1.8 bpw, so the flat part is
// not merely unevidenced, it is evidenced against on at least one model.
test('a quant below the curve is marked as a floor, not a prediction', () => {
  RESET();
  // 96gb is where the clamp actually bites: four models drop to a rung under
  // 2.21 bpw and each is multiplied by the curve's last known value
  setHardware({...DEFAULT_HARDWARE, budget: 96, cap: 'none', floor: 'none'});
  const lowest = curveFor(model('kimi k3')).points[0][0];
  ok(lowest > 1.5, 'the curve starts well above one bit (' + lowest + ')');

  const under = D.models.filter(m => {
    const q = activeQuant(m);
    return q && q.bpw && q.bpw < lowest && !m.native_low_bpw;
  });
  ok(under.length > 0, 'some model is served a rung under the curve at 96gb');
  under.forEach(m => ok(belowCurve(m),
    m.short + ' is under the curve at ' + activeQuant(m).bpw
      + ' bpw and nothing says so'));

  const over = D.models.find(m => {
    const q = activeQuant(m);
    return q && q.bpw && q.bpw > lowest + 1;
  });
  eq(belowCurve(over), false, over.short + ' is inside the curve and must not be marked');

  // a natively low-bpw model is exempt from the curve, so it is not extrapolating
  // off the end of one -- the flag and the marker must not fight
  const native = D.models.filter(m => m.native_low_bpw);
  ok(native.length >= 3, 'the roster carries natively low-bpw weights');
  native.forEach(m => eq(belowCurve(m), false,
    m.short + ' is exempt from the curve, so it is not below it'));
  RESET();
});

