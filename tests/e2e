  ok(qs.length > 1, 'glimmer publishes a ladder');
  eq(qs[0].quant, activeQuant(m).quant, 'it leads with the one the fit picks');
  for (let i = 1; i < qs.length; i++) {
    ok(qs[i].gib < qs[i - 1].gib, 'largest first');
