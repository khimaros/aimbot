  const all = visible().map(m => m.short);
  ok(all.includes('supertonic-3'), 'clearing it says what is missing');
  ok(all.length > runnable.length, 'and that is strictly more rows');

  // the image models used to be four of these and are not any more: reading
  // stable-diffusion.cpp's own detector rather than writing the claim by hand
