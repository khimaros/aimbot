#!/usr/bin/env python3

"""Check that the registry is internally consistent.

Everything downstream treats these files as ground truth, so their keys have to
resolve to each other first: a sampling profile a model names must exist in
sampling.yaml, a sampler value must be in range, a quant must say which repo
publishes it. A consumer checks its own config against the registry itself --
what shape that config takes is not this repo's business.

    models-validate          # human-readable
    models-validate --json   # machine-readable findings

Exit status is 1 if anything failed, so it drops straight into a precommit.
"""

import argparse
import functools
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REGISTRY = os.path.join(HERE, "..", "registry")

try:
    import yaml
except ImportError:
    sys.exit("!!! pyyaml not found")


def load(path):
    with open(path) as f:
        return yaml.safe_load(f)


class Findings:
    def __init__(self):
        self.rows = []

    def add(self, where, msg):
        self.rows.append({"where": where, "error": msg})


def check_modalities(models, facts, f):
    """`modalities.input` against what the model's own config says it consumes.

    This is the one typed field with a derived counterpart, and the two had
    drifted on 21 of 54 entries -- most of them missing `video` where the
    config carries a video token, and one, deepseek v4 flash, claiming image
    and audio for a text-only model whose config has neither encoder.

    Only `input` is checked: nothing here derives what a model emits, so
    `output` stays typed and unverified.
    """
    rows = []
    for repo, m in (models.get("models") or {}).items():
        want = (facts.get(repo) or {}).get("input")
        if not want:
            continue
        got = (m.get("modalities") or {}).get("input") or []
        if sorted(got) != sorted(want):
            rows.append((repo, got, want))
            f.add(repo, "modalities.input %s but its config says %s"
                  % (",".join(got) or "-", ",".join(want)))
    return rows


def check_aliases(models, f):
    """No model's `name.match` may claim another model's name.

    The alias is a regex over forum prose and EVERY matching model counts the
    sentence, so an overlap inflates one model with another's reception and
    leaves the other reading as undiscussed. It is checked against both names a
    reader would type -- the short name and the repo's own -- because the
    patterns that go wrong are the ones ending in a bare family name, where a
    sibling and a whole later generation fall inside them.
    """
    rows = [(repo, (m.get("name") or {}).get("short"),
             (m.get("name") or {}).get("match"))
            for repo, m in sorted((models.get("models") or {}).items())]
    for repo, _, pattern in rows:
        if not pattern:
            continue
        try:
            # re.I because that is how match-models compiles it
            r = re.compile(pattern, re.I)
        except re.error:
            continue
        for other, oshort, _ in rows:
            if other == repo or not oshort:
                continue
            for target in (oshort, other.split("/", 1)[-1]):
                if r.search(target):
                    f.add(repo, "name.match also claims %s (matches %r), so a "
                          "sentence about it counts for both" % (oshort, target))
                    break


def report_aliases(models):
    """Text models with no `name.match`, which sentiment therefore scores zero.

    match-models builds its lexicon out of the models that have one, so a
    missing alias never errors anywhere: the model matches no sentence and
    reads as undiscussed. Whether one is worth writing is a judgement -- an
    image or speech model has no forum prose to match at all -- so this prints.
    """
    rows = [(repo, (m.get("name") or {}).get("short"))
            for repo, m in sorted((models.get("models") or {}).items())
            if m.get("kind", "text") == "text"
            and not (m.get("name") or {}).get("match")]
    print("\naliases: %d text model(s) with no name.match, scored zero by sentiment"
          % len(rows))
    for repo, short in rows:
        print("  %-46s %s" % (repo, short))
    return rows


# what a `runtime:` block may say. the model-level one is derived by
# scripts/resolve-runtime; the quant-level one is hand-written, and is the only
# place `fork`, `branch` and `tracking` are ever set
RUNTIME_FIELDS = {"arch", "mainline", "since", "merged", "near",
                  "fork", "branch", "tracking", "patch", "note"}
RELEASE = re.compile(r"^b\d+$")

# the ways a block can answer "so where do I get a build that loads this": a
# fork to clone, an upstream PR or issue to watch, a patch shipped beside the
# weights, or a mainline name the header only just misses
WHERE = ("fork", "tracking", "patch", "near")


def check_runtime(rt, where, f):
    """A runtime block has to name a build a consumer could actually go and get.

    `mainline: false` with nothing else is the assertion that a file loads
    nowhere, which is never what is meant: something built it, and a reader
    whose model is off mainline needs the fork to go to. `since:` is a llama.cpp
    release tag rather than a date because that is what a consumer pins.
    """
    if rt is None:
        return
    if not isinstance(rt, dict):
        f.add(where, "runtime must be a mapping, got %r" % (rt,))
        return
    unknown = sorted(set(rt) - RUNTIME_FIELDS)
    if unknown:
        f.add(where, "unknown runtime field(s) %s (known: %s)"
              % (", ".join(unknown), ", ".join(sorted(RUNTIME_FIELDS))))
    if not isinstance(rt.get("mainline"), bool):
        f.add(where, "runtime.mainline %r must be true or false" % (rt.get("mainline"),))
    if rt.get("since") and not RELEASE.match(str(rt["since"])):
        f.add(where, "runtime.since %r must be a llama.cpp release tag, like b10660"
              % (rt["since"],))
    if rt.get("mainline") is False and not any(rt.get(k) for k in WHERE):
        f.add(where, "runtime.mainline false needs one of %s: something built "
                     "this file, and a reader off mainline needs where to go"
              % ", ".join(WHERE))
    if rt.get("mainline") is True and rt.get("fork"):
        f.add(where, "runtime.fork is for what mainline does NOT carry; "
                     "mainline true and a fork together say nothing")
    if rt.get("branch") and not rt.get("fork"):
        f.add(where, "runtime.branch names a branch of nothing without a fork:")


# what a `crispasr:` block may say. `runtime:` answers "which llama.cpp release
# loads this"; this answers the same question for the other engine on the
# roster, which is not a llama.cpp release at all but a backend name.
CRISPASR_FIELDS = {"backend", "diarize", "labels_speakers"}
# what a weight can be to a diarization run. neither transcribes: an embedder
# turns a span of audio into a speaker vector, a segmenter says only WHEN the
# speaker changed
DIARIZE_ROLES = ("embedder", "segmentation")
DIARIZE_KIND = "diarize"


def check_crispasr(cr, where, f):
    """A crispasr block says what one binary does with this file, and only one.

    A weight is something you transcribe WITH or something you diarize with,
    never both -- `--backend` loads it as the ASR model and `--diarize-embedder`
    loads it beside one, and a block claiming both describes no invocation. The
    joint models are not the exception they look like: moss-diarize diarizes as
    part of decoding, so it is a backend and nothing else.

    Valid on a model or on one of its quants. A quant's overrides, for the same
    reason `runtime:` does: whether an engine can load a file is a property of
    how that ONE FILE was converted, not of the checkpoint. qwen3-tts is the
    case -- two conversions of identical weights, one namespacing its metadata
    `qwen3-tts` and one `qwen3tts`, and crispasr reads only the second.
    """
    if cr is None:
        return
    if not isinstance(cr, dict):
        f.add(where, "crispasr must be a mapping, got %r" % (cr,))
        return
    unknown = sorted(set(cr) - CRISPASR_FIELDS)
    if unknown:
        f.add(where, "unknown crispasr field(s) %s (known: %s)"
              % (", ".join(unknown), ", ".join(sorted(CRISPASR_FIELDS))))
    named = [k for k in ("backend", "diarize") if cr.get(k)]
    if len(named) != 1:
        f.add(where, "crispasr names %s; it takes exactly one of backend (an ASR "
                     "runtime) or diarize (a weight --diarize loads)"
              % (", ".join(named) or "neither backend nor diarize"))
    if cr.get("diarize") and cr["diarize"] not in DIARIZE_ROLES:
        f.add(where, "crispasr.diarize %r must be one of %s"
              % (cr["diarize"], ", ".join(DIARIZE_ROLES)))
    # whether the MODEL labels speakers while decoding, which decides whether a
    # client should ask for diarization at all -- and the two answers want
    # opposite requests, with no error either way. it belongs beside `backend`
    # because it is a property of what that backend emits, and it is
    # hand-written because nothing derives it: crispasr's own feature matrix
    # carries a `diarize` bit that is true for every ASR backend, since it says
    # the post-step is available rather than that the model labels anything.
    if "labels_speakers" in cr:
        if not isinstance(cr["labels_speakers"], bool):
            f.add(where, "crispasr.labels_speakers %r must be true or false"
                  % (cr["labels_speakers"],))
        elif not cr.get("backend"):
            f.add(where, "crispasr.labels_speakers describes what a BACKEND "
                         "emits, so it needs one; a diarizer weight labels "
                         "nothing by itself")


# every runtime this registry knows how to name. two of them are never WRITTEN
# -- llama.cpp comes from `runtime.arch` and crispasr from a `crispasr:` block
# -- and are listed because the derived list mixes with the written one and the
# same vocabulary has to cover both. a name not here is a typo: `sd.cpp` and
# `stable-diffusion.cpp` would filter as two runtimes and neither would hold the
# models the other has.
ENGINES = ("llama.cpp", "vllm", "crispasr", "whisper.cpp",
           "stable-diffusion.cpp", "TTS.cpp", "Breeze-TTS-2.cpp")
# the two the registry states some other way, so writing them again is a second
# place for the same fact to be wrong
DERIVED_ENGINES = ("llama.cpp", "crispasr")


def check_engine(m, where, f):
    """`engine:` lists the runtimes that load these weights, spelled one way."""
    engine = m.get("engine")
    if engine is None:
        return
    if not isinstance(engine, list) or not engine:
        f.add(where, "engine must be a non-empty list of runtime names, got %r"
              % (engine,))
        return
    for name in engine:
        if name not in ENGINES:
            f.add(where, "unknown engine %r (known: %s)"
                  % (name, ", ".join(ENGINES)))
        elif name in DERIVED_ENGINES:
            f.add(where, "engine %r is derived -- %s -- so writing it here is a "
                         "second copy that can disagree"
                  % (name, "from runtime.arch" if name == "llama.cpp"
                     else "from the crispasr block"))
    if len(set(engine)) != len(engine):
        f.add(where, "engine lists a runtime twice: %s" % ", ".join(engine))


def check_diarize_kind(m, where, f):
    """`kind: diarize` and a diarize role are the same statement, so they agree.

    The kind is what stops a diarizer being read as a model somebody serves: it
    has no chat template, no context and no transcript, and every consumer
    listing the speech roster would otherwise count it as one. Model-level only
    -- a quant carries no kind, and a diarizer has one conversion anyway.
    """
    kind = m.get("kind", "text")
    role = ((m.get("crispasr") or {}).get("diarize"))
    if kind == DIARIZE_KIND and not role:
        f.add(where, "kind %s needs a crispasr.diarize saying what --diarize "
                     "loads it as; nothing else here can use the file" % DIARIZE_KIND)
    elif role and kind != DIARIZE_KIND:
        f.add(where, "crispasr.diarize and kind %s go together; this says kind %s"
              % (DIARIZE_KIND, kind))


def check_registry(models, sampling, f):
    """The registry has to be internally consistent before anything can lean on it."""
    known_profiles = set(sampling.get("profiles") or {})
    known_fields = set(sampling.get("fields") or {})
    known_tags = set((sampling["fields"].get("tuned") or {}).get("of") or [])
    known_sources = set(sampling.get("sources") or {})

    if sampling.get("default") not in known_profiles:
        f.add("sampling.yaml", "default profile %r is not defined"
              % sampling.get("default"))

    seen_short = {}
    for repo, m in (models.get("models") or {}).items():
        if repo.count("/") != 1:
            f.add(repo, "key must be a huggingface repo, owner/name")

        short = ((m.get("name") or {}).get("short") or "").strip()
        if not short:
            f.add(repo, "name.short is required; it is what tables print")
        elif short in seen_short:
            f.add(repo, "name.short %r already used by %s" % (short, seen_short[short]))
        else:
            seen_short[short] = repo

        pattern = (m.get("name") or {}).get("match")
        if pattern:
            try:
                re.compile(pattern)
            except re.error as e:
                f.add(repo, "name.match is not a valid regex: %s" % e)

        kind = m.get("kind", "text")
        quants = m.get("quants") or []
        if not quants and kind == "text":
            f.add(repo, "at least one quant is required")
        for q in quants:
            if not q.get("repo") or not q.get("quant"):
                f.add(repo, "every quant needs both repo and quant: %r" % (q,))
            # `quant:` names the rung and `file:` names the object where a repo
            # does not name its files after the tag. a filename in `quant:` is
            # the thing this split exists to stop
            if str(q.get("quant") or "").lower().endswith((".gguf", ".bin")):
                f.add(repo, "quant %r is a filename; put it in `file:` and give "
                            "`quant:` the tag the rung IS" % q.get("quant"))
            where = "%s/%s" % (repo, q.get("quant"))
            check_runtime(q.get("runtime"), where, f)
            check_crispasr(q.get("crispasr"), where, f)
        check_runtime(m.get("runtime"), repo, f)
        check_crispasr(m.get("crispasr"), repo, f)
        check_engine(m, repo, f)
        check_diarize_kind(m, repo, f)

        # the level a client gets by sending nothing has to be a level the
        # template accepts, or the entry is describing two different knobs. a
        # toggle has no vocabulary: its values are the booleans themselves, and
        # a consumer sending the STRING "off" would turn thinking ON
        think = m.get("thinking") or {}
        if think.get("kind") == "boolean":
            if "default" in think and not isinstance(think["default"], bool):
                f.add(repo, "thinking.default %r must be true or false for a "
                      "boolean knob" % (think["default"],))
            if think.get("accepts"):
                f.add(repo, "a boolean knob has no accepts; its values are true and false")
        elif think.get("default") and think["default"] not in (think.get("accepts") or []):
            f.add(repo, "thinking.default %r is not one of thinking.accepts %s"
                  % (think["default"], think.get("accepts") or []))

        # only text models have samplers to name; an image or speech server has
        # no temperature to set
        profiles = m.get("sampling") or {}
        if not profiles and kind == "text":
            f.add(repo, "at least one sampling profile is required")
        prefix = sampling.get("upstream_prefix") or ""
        for name, prof in profiles.items():
            # `upstream-tool-use` is the vendor's set for a profile this registry
            # deliberately departs from; it qualifies a known name rather than
            # inventing one, so validate the part it qualifies
            base = name[len(prefix):] if prefix and name.startswith(prefix) else name
            if base not in known_profiles:
                f.add("%s/%s" % (repo, name),
                      "profile is not in sampling.yaml (known: %s)"
                      % ", ".join(sorted(known_profiles)))
            if (prof or {}).get("source") == "tuned-here" and not (prof or {}).get("note"):
                f.add("%s/%s" % (repo, name),
                      "source tuned-here needs a note: these numbers match no "
                      "card and no shipped config, so only prose says why")
            for field, val in (prof or {}).items():
                if field not in known_fields:
                    f.add("%s/%s" % (repo, name), "unknown sampler field %r" % field)
                    continue
                spec = sampling["fields"][field]
                if field == "tuned":
                    bad = [t for t in (val or []) if t not in known_tags]
                    if bad:
                        f.add("%s/%s" % (repo, name), "unknown tuned tags %s" % bad)
                    continue
                # a declared level has to be one the vocabulary knows, which is
                # the check that catches sending a model the "high" its chat
                # template raises an exception on
                if field == "source":
                    if val not in known_sources:
                        f.add("%s/%s" % (repo, name),
                              "source %r is not one of %s"
                              % (val, ", ".join(sorted(known_sources))))
                    continue
                if field == "note":
                    if not isinstance(val, str) or not val.strip():
                        f.add("%s/%s" % (repo, name), "note must be prose")
                    continue
                if field == "thinking":
                    levels = spec.get("of") or []
                    if val not in levels:
                        f.add("%s/%s" % (repo, name),
                              "thinking level %r is not one of %s"
                              % (val, ", ".join(levels)))
                    continue
                if isinstance(val, bool) or not isinstance(val, (int, float)):
                    f.add("%s/%s" % (repo, name), "%s must be a number, got %r"
                          % (field, val))
                    continue
                lo, hi = spec.get("min"), spec.get("max")
                if lo is not None and val < lo or hi is not None and val > hi:
                    f.add("%s/%s" % (repo, name),
                          "%s = %r outside [%s, %s]" % (field, val, lo, hi))


# samplers the vendor ships, against the profiles somebody typed from a release
# post. FIELDS maps our name to generation_config.json's
FIELDS = {"temp": "temperature", "top_p": "top_p", "top_k": "top_k",
          "min_p": "min_p", "repeat_penalty": "repetition_penalty",
          "presence_penalty": "presence_penalty"}


def report_samplers(models, facts):
    """Which models have no profile matching the samplers they ship.

    A mismatch is not an error: `instruct` is meant to differ from a thinking
    default, and a vendor ships one set where the registry names several. It is
    a prompt to go and look, so it prints rather than failing.
    """
    rows = []
    for repo, m in sorted((models.get("models") or {}).items()):
        shipped = (facts.get(repo) or {}).get("samplers_shipped") or {}
        profiles = m.get("sampling") or {}
        if not shipped or not profiles:
            continue
        best, agree = None, -1
        for name, prof in profiles.items():
            n = sum(1 for ours, theirs in FIELDS.items()
                    if theirs in shipped and ours in (prof or {})
                    and abs(float(prof[ours]) - float(shipped[theirs])) < 1e-9)
            if n > agree:
                best, agree = name, n
        checkable = sum(1 for ours, theirs in FIELDS.items()
                        if theirs in shipped and ours in (profiles[best] or {}))
        if agree < checkable:
            diff = ", ".join("%s ours=%s shipped=%s" % (ours, (profiles[best] or {}).get(ours),
                                                        shipped[theirs])
                             for ours, theirs in FIELDS.items()
                             if theirs in shipped and ours in (profiles[best] or {})
                             and float((profiles[best] or {})[ours]) != float(shipped[theirs]))
            rows.append((repo, best, agree, checkable, diff))
    print("\nsamplers: %d model(s) whose closest profile differs from what ships" % len(rows))
    for repo, best, agree, checkable, diff in rows:
        print("  %-46s %s matches %d/%d: %s" % (repo, best, agree, checkable, diff))
    return rows


PREFIX = "upstream-"


def report_cards(models, cards):
    """Registry profiles against the sampler sets the cards document.

    Stronger evidence than generation_config.json, which ships ONE set where a
    card documents several modes -- comparing against it alone made every
    deliberate tool-use profile look wrong. Also reports where the quant repo
    and the base repo disagree, since the quant is what actually gets run.
    """
    unmatched, diverged = [], []
    for repo, m in sorted((models.get("models") or {}).items()):
        c = cards.get(repo) or {}
        sets = c.get("samplers") or []
        profiles = m.get("sampling") or {}
        for name, prof in sorted(profiles.items()):
            if not sets or not prof:
                continue
            # a departure with an `upstream-` sibling is recorded rather than
            # accidental, so the sibling is what has to match the card
            if PREFIX + name in profiles:
                continue
            best, miss = None, None
            for s in sets:
                common = [k for k in s["values"] if k in prof]
                bad = [k for k in common if float(prof[k]) != s["values"][k]]
                if miss is None or len(bad) < len(miss):
                    best, miss = s, bad
            if miss:
                unmatched.append((repo, name, best["label"],
                                  ", ".join("%s ours=%s card=%s"
                                            % (k, prof[k], best["values"][k]) for k in miss)))
        base = {k: v for s in sets for k, v in s["values"].items()}
        for s in c.get("quant_samplers") or []:
            extra = {k: v for k, v in s["values"].items()
                     if k in base and all(v != b["values"].get(k)
                                          for b in sets if k in b["values"])}
            if extra:
                diverged.append((repo, c.get("quant_repo"), s["label"], extra))

    print("\ncards: %d profile(s) matching no documented set" % len(unmatched))
    for repo, name, label, diff in unmatched:
        print("  %-40s %-9s vs %-46s %s" % (repo.split("/")[-1], name, label, diff))
    print("\ncards: %d case(s) where the quant repo states a value the base never does"
          % len(diverged))
    for repo, qrepo, label, extra in diverged:
        print("  %s -> %s" % (repo, qrepo))
        print("     %s" % label)
        print("     %s" % ", ".join("%s=%s" % kv for kv in sorted(extra.items())))
    return unmatched, diverged


# a quantizer's own label around a type name: whose ladder it is, then which
# recipe within it. neither says anything about what the tensors are
QUANT_PREFIX = re.compile(r"^[A-Z]{2}-")
QUANT_DECOR = re.compile(r"(?:_(?:XL|L|XS|S|M)|_STOCK|_FLAT|-MIXED)$")
# a drafter head, a projector or an imatrix rather than a rung of the ladder
NOT_A_RUNG = re.compile(r"mmproj|imatrix|dspark|dflash|mtp|\.gguf$|\.bin$|-bf16$|:", re.I)
# ik_llama.cpp interleaves rows for its own kernels and names the result `_R4`;
# prism re-blocks a type at a different group size and names it `_G64`. both are
# distinct tensor layouts under a familiar-looking name, which is the case a
# name lookup cannot catch: mainline has a `Q2_0`, at QK2_0 64 rather than 128
REPACKED = re.compile(r"_R\d+$")
REGROUPED = re.compile(r"_G\d+$")
FAMILY = re.compile(r"^([A-Z]+\d+)")


def fork_type(tag, known):
    """Why a stock build cannot load this rung, or None if it can.

    An exact name lookup is not the test and trying it that way was wrong twice.
    Publishers label files with names mainline never defines -- `UD-Q4_K_XL`,
    `AP-IQ4_M`, `AD-NVFP4_AI2` -- and those load, because a file type is a label
    while the tensors inside carry their own types. So this asks about the
    layout instead:

      repacked   `_R4`, ik_llama's row-interleaved tensors
      regrouped  `_G64`, the same type name over a different block size
      family     `IQ5_*`, `IQ6_*` -- mainline defines nothing in that family at
                 all, so no reading of the name gets you a loadable file

    Everything else is treated as a publisher's label for mainline tensors.
    That is the conservative direction: this drives a warning on a page, and
    calling a loadable file unloadable is the worse error.
    """
    if NOT_A_RUNG.search(tag):
        return None
    t = QUANT_PREFIX.sub("", tag).upper()
    if REPACKED.search(t):
        return "%s: row-interleaved, ik_llama.cpp only" % t
    if REGROUPED.search(t):
        return "%s: a different block size under a mainline type name" % t
    # decoration nests -- `UD-Q8_K_XL` is `Q8_K` under two of them
    for _ in range(3):
        if t in known:
            return None
        stripped = QUANT_DECOR.sub("", t)
        if stripped == t:
            break
        t = stripped
    if t in known:
        return None
    fam = FAMILY.match(t)
    if fam and fam.group(1) in _families(frozenset(known)):
        return None
    return "%s: mainline defines nothing in this family" % t


@functools.lru_cache(maxsize=4)
def _families(known):
    """`IQ4` from `IQ4_XS` -- cached, because the page asks this per rung."""
    return {FAMILY.match(k).group(1) for k in known if FAMILY.match(k)}


def report_runtime(models, support, sizes):
    """What a stock llama.cpp will not load, from both ends.

    Two different failures, so two lists. An architecture mainline has no entry
    for refuses the file outright and is already recorded per model. A quant
    TYPE mainline has no name for is subtler: the model loads at other rungs, so
    the pin is fine and only part of the ladder is unreachable -- laguna m.1
    publishes 28 rungs and 10 of them are ik_llama.cpp's, which the dashboard
    otherwise offers a reader as if they were choices.

    The name list is what mainline's own headers enumerate, so it needs no
    maintenance here, but a tag is a directory name rather than a declared type
    and the two only mostly agree. So the tag is reduced before it is judged:
    the publisher prefix comes off (`UD-`, `AP-`, `AD-`), then the decoration
    unsloth and bartowski add to say which recipe rather than which type
    (`_XL`, `_L`, `_STOCK`). Only what survives that is looked up.

    Reducing is what makes this worth printing. Checking tags as-published
    flagged 60 of 63 repos, which is a report nobody reads; reducing first
    leaves 4, and every one is a real fork type -- ik_llama's, prism's `_G64`
    group size, and nvidia's NVFP4. It stays a report rather than an error
    because it is still a guess about a name, not a load.
    """
    known = set(support.get("quants") or [])
    if not known:
        print("\nruntime: no quant name list captured; run research/fetch-llama-support")
        return [], []
    off = [(repo, (m.get("runtime") or {}))
           for repo, m in sorted((models.get("models") or {}).items())
           if (m.get("runtime") or {}).get("mainline") is False]
    print("\nruntime: %d model(s) whose architecture mainline does not carry" % len(off))
    for repo, rt in off:
        print("  %-44s %-16s %s" % (repo, rt.get("arch") or "-",
                                    rt.get("tracking") or rt.get("fork")
                                    or rt.get("patch") or "nowhere recorded"))

    rungs = []
    for repo, m in sorted((models.get("models") or {}).items()):
        for qrepo in {q["repo"] for q in (m.get("quants") or []) if q.get("repo")}:
            bad = sorted({r for r in (fork_type(t, known)
                                      for t in (sizes.get(qrepo) or {})) if r})
            if bad:
                rungs.append((qrepo, len(sizes.get(qrepo) or {}), bad))
    print("\nruntime: %d repo(s) publishing rungs mainline cannot load"
          % len(rungs))
    for qrepo, total, bad in rungs:
        print("  %s -- %d of %d rungs" % (qrepo, len(bad), total))
        for reason in bad:
            print("     %s" % reason)
    return off, rungs


def report_thinking(models, facts):
    """Models whose knob grades levels that nothing states.

    A template that validates its levels enumerates them, so they are derived.
    One that interpolates the value verbatim cannot be read for a vocabulary --
    the registry has to declare it under `thinking.accepts` or clients get no
    gradation at all. This is the list of models still in that gap.
    """
    rows = []
    for repo, m in sorted((models.get("models") or {}).items()):
        t = (facts.get(repo) or {}).get("thinking") or {}
        if not t.get("knob") or t.get("levels") or t.get("toggle"):
            continue
        if t.get("value_type") == "float":
            continue  # a level name would fail the template's own assertion
        if (m.get("thinking") or {}).get("accepts"):
            continue
        rows.append((repo, ",".join(t["knob"]), t.get("default") or "-"))
    print("\nthinking: %d model(s) with a graded knob and no declared levels" % len(rows))
    for repo, knob, dflt in rows:
        print("  %-46s knob=%-20s template default=%s" % (repo, knob, dflt))
    return rows


def check_backend_reachable(models, data, f):
    """A named crispasr backend has to be one a PINNED FILE would dispatch to.

    This is the over-reporting guard. `crispasr:` says which of ~119 runtimes
    loads a model, and it is hand-written, so it can name a backend for a
    checkpoint whose conversion crispasr has never seen. That is not a small
    distinction: crispasr's own arch table knows `gemma4_e2b`, the gguf this
    registry pins for gemma 4 declares `gemma4`, and nothing would have caught
    the claim that crispasr loads it -- it does not, it loads cstr's separate
    ASR conversion of the same checkpoint.

    Two rules, both conservative, because the obvious third one is wrong.

      1. the name is a backend crispasr COMPILES IN, from the feature matrix it
         generates out of `--list-backends-json`. that caught `gemma4-e4b`,
         which is a row in crispasr's readme -- named after the model -- and not
         a backend: the readme says the E4B "runs on `--backend gemma4-e2b`".
      2. some pinned file is one crispasr RECOGNISES: its declared architecture
         appears in `src/core/arch_backend_map.h`, the table every crispasr
         surface dispatches through. that caught gemma 4 outright -- the gguf
         this registry pins declares `gemma4` and the table knows `gemma4_e2b`,
         so crispasr loads cstr's separate ASR conversion and not our file.

    The rule NOT applied is `the written backend must equal the detected one`.
    `--backend` overrides detection, and three legitimate entries fail that
    test: qwen3-asr detects as `qwen3` and is documented as `qwen3-1.7b`, and
    both qwen3-tts customvoice rungs detect as the base `qwen3-tts`.

    What none of this tests is whether the file then WORKS. A table entry means
    the binary picks a backend, not that the tensors match: this registry has
    two qwen3-tts conversions whose headers both dispatch to `qwen3-tts` and
    only one of which loads. That claim stays hand-written, with the evidence in
    the model's notes.
    """
    crispasr = data.get("crispasr") or {}
    table, names = crispasr.get("arch") or {}, crispasr.get("caps") or {}
    repo_arch = (data.get("llama-support") or {}).get("repos") or {}
    if not table or not repo_arch or not names:
        return
    for repo, m in sorted((models.get("models") or {}).items()):
        blocks = [(repo, m.get("crispasr"))]
        blocks += [("%s/%s" % (repo, q.get("quant")), q.get("crispasr"))
                   for q in (m.get("quants") or [])]
        for where, block in blocks:
            backend = (block or {}).get("backend")
            if not backend:
                continue
            if backend not in names:
                f.add(where, "crispasr backend %r is not one the binary carries; "
                             "the feature matrix lists %d and this is not among "
                             "them" % (backend, len(names)))
            # every file this model pins, since a model-level block speaks for
            # the whole entry and a quant-level one still ships in a repo
            archs = {repo_arch[q["repo"]] for q in (m.get("quants") or [])
                     if q.get("repo") in repo_arch}
            if not archs:
                continue  # no gguf header anywhere: whisper ships ggml .bin
            if not any(a in table for a in archs):
                f.add(where, "no pinned file is one crispasr recognises: %s "
                             "declares %s and its table knows none of them"
                      % (repo, ", ".join(sorted(archs))))


def check_sdcpp_detected(models, data, f):
    """A stable-diffusion.cpp claim has to be one its DETECTOR makes.

    The other half of the over-reporting guard, and it needs a different method
    from the crispasr one: sd.cpp never reads `general.architecture`. Its
    `get_sd_version()` sniffs tensor names, so `fetch-sdcpp-support` reads that
    table out of the current source and the tensor names out of each gguf's own
    header, and this checks the claim against what it found.

    A model with no entry at all is not an error: the collector may not have run
    on this checkout, or a header may be unreadable. What is an error is a claim
    the detector was asked about and did not make.
    """
    found = (data.get("sdcpp") or {}).get("models") or {}
    if not found:
        return
    for repo, m in sorted((models.get("models") or {}).items()):
        if "stable-diffusion.cpp" not in (m.get("engine") or []):
            continue
        hit = found.get(repo)
        if hit and not hit.get("version"):
            f.add(repo, "stable-diffusion.cpp is claimed and its detector finds "
                        "no signature in %s: %d tensors read and none of the %d "
                        "rules matched"
                  % (hit.get("repo"), hit.get("tensors") or 0,
                     len((data.get("sdcpp") or {}).get("signatures") or {})))


def report_speech(models):
    """The two gaps in the speech roster: no engine to load it, no source to rank it.

    A text model says which llama.cpp release loads it and lint fails if it
    cannot, and five leaderboards score it. The speech half had neither, so
    which server to point at kokoro rather than whisper was knowledge a consumer
    kept somewhere else, and nothing said whether a model on the roster was any
    good. Both print rather than failing: a model whose only runtime is a
    one-off server is a real thing (fish s2-pro is one), and so is a model no
    board has got to yet.
    """
    def backends(m):
        """Every crispasr backend that reaches this model, quants included.

        A model whose only loadable conversion is one of its quants is engined:
        qwen3-tts names none at the model level because only the cstr rung
        carries the metadata namespace crispasr reads.
        """
        blocks = [m.get("crispasr")] + [q.get("crispasr") for q in m.get("quants") or []]
        return sorted({b["backend"] for b in blocks if (b or {}).get("backend")})

    speech = [(repo, m) for repo, m in sorted((models.get("models") or {}).items())
              if m.get("kind") == "speech"]
    unengined = [(repo, m) for repo, m in speech if not backends(m)]
    unscored = [(repo, m) for repo, m in speech
                if not any((m.get("ids") or {}).values())]
    served = {}
    for repo, m in sorted((models.get("models") or {}).items()):
        for backend in backends(m):
            served.setdefault(backend, []).append((m.get("name") or {}).get("short"))

    print("\nspeech: %d of %d model(s) naming no engine to load them"
          % (len(unengined), len(speech)))
    for repo, m in unengined:
        print("  %-46s %s" % (repo, (m.get("name") or {}).get("short")))
    print("\nspeech: %d of %d model(s) no leaderboard scores" % (len(unscored), len(speech)))
    for repo, m in unscored:
        print("  %-46s %s" % (repo, (m.get("name") or {}).get("short")))
    print("\nspeech: %d crispasr backend(s) carry the roster" % len(served))
    for backend, shorts in sorted(served.items()):
        print("  %-16s %s" % (backend, ", ".join(sorted(shorts))))
    return unengined, unscored


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--registry", default=REGISTRY)
    ap.add_argument("--facts", default=os.path.join(HERE, "..", "research",
                                                    "data", "model-facts.json"))
    ap.add_argument("--samplers", action="store_true",
                    help="report profiles that disagree with generation_config.json")
    ap.add_argument("--thinking", action="store_true",
                    help="report graded knobs whose levels nothing declares")
    ap.add_argument("--modalities", action="store_true",
                    help="report modalities.input against each model's own config")
    ap.add_argument("--cards", action="store_true",
                    help="report profiles against the sampler sets cards document")
    ap.add_argument("--aliases", action="store_true",
                    help="report text models with no name.match to score them by")
    ap.add_argument("--runtime", action="store_true",
                    help="report what a stock llama.cpp build will not load")
    ap.add_argument("--speech", action="store_true",
                    help="report speech models with no engine and no score")
    ap.add_argument("--model-cards", default=os.path.join(HERE, "..", "research",
                                                          "data", "model-cards.json"))
    ap.add_argument("--support", default=os.path.join(HERE, "..", "research",
                                                      "data", "llama-support.json"))
    ap.add_argument("--sizes", default=os.path.join(HERE, "..", "research",
                                                    "data", "gguf-sizes.json"))
    ap.add_argument("--crispasr", default=os.path.join(HERE, "..", "research",
                                                       "data", "crispasr.json"))
    ap.add_argument("--sdcpp", default=os.path.join(HERE, "..", "research",
                                                    "data", "sdcpp-support.json"))
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    models = load(os.path.join(args.registry, "models.yaml"))
    sampling = load(os.path.join(args.registry, "sampling.yaml"))

    f = Findings()
    facts = load(args.facts) or {}
    check_registry(models, sampling, f)
    # an overlap silently inflates one model and empties another, and neither
    # shows up as a wrong number anywhere downstream, so it fails rather than
    # printing: CONTRIBUTING.md has warned about it since ling 3.0 tiny
    check_aliases(models, f)
    # a typed field with a derived counterpart is drift waiting to happen, so
    # this one is an error rather than a report you have to remember to run
    rows = check_modalities(models, facts, f)
    # the over-reporting guard: a hand-written engine claim against the engine's
    # own dispatch table. both inputs are captures, so a checkout without them
    # skips it rather than failing on a missing file
    check_backend_reachable(models, {"crispasr": load(args.crispasr) or {},
                                     "llama-support": load(args.support) or {}}, f)
    check_sdcpp_detected(models, {"sdcpp": load(args.sdcpp) or {}}, f)
    if args.modalities:
        print("\nmodalities: %d model(s) disagreeing with their own config" % len(rows))
        for repo, got, want in sorted(rows):
            print("  %-46s registry=%-24s config=%s"
                  % (repo, ",".join(got) or "-", ",".join(want)))
    if args.samplers:
        report_samplers(models, load(args.facts) or {})
    if args.thinking:
        report_thinking(models, load(args.facts) or {})
    if args.cards:
        report_cards(models, load(args.model_cards) or {})
    if args.aliases:
        report_aliases(models)
    if args.runtime:
        report_runtime(models, load(args.support) or {}, load(args.sizes) or {})
    if args.speech:
        report_speech(models)

    if args.json:
        json.dump(f.rows, sys.stdout, indent=1)
        print()
    else:
        for row in f.rows:
            print("!!! %s: %s" % (row["where"], row["error"]), file=sys.stderr)
        print("registry: %d models, %d profiles, %d error(s)"
              % (len(models.get("models") or {}),
                 len(sampling.get("profiles") or {}), len(f.rows)))
    sys.exit(1 if f.rows else 0)


if __name__ == "__main__":
    main()
