#!/usr/bin/env python3

"""Match registry models against each source's own key space, and fill in
`ids`.

Every source names models its own way and there are five of them, so filling
this by hand is 100+ strings that no one will re-check. This searches each
source's actual key space and reports what it matched, what was ambiguous, and
what it could not find -- a miss recorded as "" is a fact (the source does not
carry the model), which is different from a lookup nobody attempted.

Matching is deliberately conservative. It normalizes away punctuation and
compares against the repo basename and the registry short name, and it only
accepts a candidate when exactly one survives. Anything ambiguous is printed
for a human rather than guessed, because a wrong id silently scores one model
with another's numbers.

    resolve-ids                # report only
    resolve-ids --write        # update registry/models.yaml
    resolve-ids --unclaimed    # models a source scores that the roster lacks

`--unclaimed` runs the match the other way round. Every sweep already collects
five leaderboards and the hub's gguf listings, so a model that is scored by one
AND has a gguf on the hub AND is absent from the registry is a roster candidate
the data already knew about. Nothing looked, which is how granite 4.2 30b sat
in artificial analysis' key space for four days while the discovery report
ranked it 39th by lifetime downloads and printed the top 25.
"""

import argparse
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "..", "research", "data")

sys.path.insert(0, HERE)
import registry_patch  # noqa: E402  the splice, shared with resolve-runtime

try:
    import yaml
except ImportError:
    sys.exit("!!! pyyaml not found")


def norm(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())


def load(name, data=None):
    try:
        return json.load(open(os.path.join(data or DATA, "%s.json" % name)))
    except (IOError, ValueError):
        return {}


def open_keys(rows, open_field, id_fields=()):
    """{normalized name: real id} for one board, OPEN-WEIGHTS ONLY.

    The filter is the whole point. Every speech and image board is dominated by
    hosted endpoints, and a vendor's API SKU shares a family name with the
    checkpoint it grew from while being neither the same weights nor the same
    stack:
    artificial analysis scores `qwen3-tts-vc-realtime` at 925 elo on alibaba
    cloud, and the registry carries gguf conversions of the open Qwen3-TTS at a
    different codec rate. Matching those would put a hosted arena rating on a
    local q8_0, so a row the source itself says is not downloadable is not
    offered to the matcher at all.

    A host qualifier is stripped as a second spelling rather than replacing the
    first: artificial analysis writes one model as both `Whisper Large v3 Turbo`
    and `Whisper Large v3 Turbo, Telnyx`, which are two hosts of one checkpoint.
    """
    space = {}
    for key, r in rows.items():
        if not r.get(open_field):
            continue
        names = [key, r.get("name")]
        for n in list(names):
            if n and "," in n:
                names.append(n.rsplit(",", 1)[0])
        for field in id_fields:
            v = r.get(field)
            if v:
                # a host api id is often the huggingface repo, which is the most
                # precise handle any of these boards publishes. the `:` is a
                # replicate-style content hash, and it names no model
                names += [v, v.split("/")[-1].split(":")[0]]
        for n in names:
            if n:
                space.setdefault(norm(n), key)
    return space


def jev_space(rows):
    """{normalized name: board key} for JevBench, downloadable weights only.

    `open` is a free-text field there -- `yes`, `true`, `weights` (a repo that
    ships but is not a checkpoint you fetch), `no`, and absent for six rows whose
    class is a baseline rather than a system -- so truthiness would read `no` as
    open. rows the board itself does not rank -- `partial`, `honorable_mention`,
    which were not run to the end -- are left out as well.

    Both spellings go in, because a registry model is named by its repo and the
    board names a run: `decider-4b-v2` is the key and "decider 4b v2 (Mapika)" is
    the display. the version stays in the value a caller writes into `ids`, so a
    hub repo that has moved to v2.1 reads as a disagreement between two sources.
    """
    space = {}
    for key, r in rows.items():
        if str(r.get("open") or "").lower() not in ("yes", "true", "weights"):
            continue
        if r.get("listing") not in (None, "ranked"):
            continue
        for n in (key, r.get("display")):
            if n:
                space.setdefault(norm(n), key)
    return space


def key_spaces(data=None):
    """{kind: {source: {normalized name: real id}}} for every source that names models.

    Split by the modality a source MEASURES. A text leaderboard has no opinion
    about a transcription model and a synthesis arena has none about a text one,
    so running every model against every source would fill the registry with
    empty ids nobody can ever resolve -- and would let one fuzzy hit put a
    speech score on a text model.
    """
    out = {}

    aa = load("artificial-analysis", data)
    out["aa"] = {}
    for slug, r in aa.items():
        # skip the non-reasoning twins: the roster scores reasoning mode
        if slug.endswith("-non-reasoning"):
            continue
        out["aa"].setdefault(norm(r.get("name")), slug)
        out["aa"].setdefault(norm(slug), slug)

    gb = load("gbench", data)
    out["gbench"] = {}
    for m in gb.get("rankings") or []:
        mid = m.get("model_id") or ""
        out["gbench"].setdefault(norm(mid.split("/")[-1]), mid)
        out["gbench"].setdefault(norm(m.get("model")), mid)

    lm = load("lmarena", data)
    out["lmarena"] = {}
    for board in (lm.get("boards") or {}).values():
        for e in board.get("entries") or []:
            n = e.get("modelDisplayName")
            if n:
                out["lmarena"].setdefault(norm(n), n)

    sw = load("swe-rebench", data)
    out["swerebench"] = {}
    for m in (sw.get("models") or {}).values():
        n = m.get("name")
        if n:
            out["swerebench"].setdefault(norm(n), n)

    ep = load("epoch", data)
    out["epoch"] = {}
    for r in ep.get("eci") or []:
        mv = (r.get("Model version") or "").split("/")[-1].rsplit("_", 1)[0]
        if mv:
            out["epoch"].setdefault(norm(mv), mv)
        dn = r.get("Display name") or r.get("Model name")
        if dn:
            out["epoch"].setdefault(norm(dn), mv or dn)

    speech = load("artificial-analysis-speech", data)
    spoken = {
        "aa-stt": open_keys(speech.get("speech-to-text") or {}, "openWeights",
                            ("hostApiId",)),
        "aa-stt-streaming": open_keys(speech.get("speech-to-text-streaming") or {},
                                      "openWeights", ("hostApiId",)),
        "aa-tts": open_keys(speech.get("text-to-speech") or {}, "openWeights",
                            ("slug",)),
        "tts-arena": open_keys(load("tts-arena", data), "open"),
        "voicearena": open_keys(load("voicearena", data), "openSource"),
    }
    # the one board keyed the way this registry is. every other space here maps
    # a display name and needs the open-weights filter to keep a hosted SKU out;
    # this one publishes a huggingface repo id, so the key space is those ids
    # under the same normalisation `roster_names` applies to a repo's last
    # segment -- an exact join rather than a resemblance
    spoken["open-asr"] = {}
    for repo, row in ((load("open-asr", data) or {}).get("models") or {}).items():
        if not row.get("open_weights"):
            continue
        stem = repo.split("/")[-1]
        spoken["open-asr"].setdefault(norm(stem), repo)
        # `-hf` is the same weights in transformers layout and the only spelling
        # variant this board uses. it goes in the key space so an exact join
        # reaches it, rather than being left to the substring pass -- which on a
        # repo-keyed board finds a DIFFERENT model
        if stem.lower().endswith("-hf"):
            spoken["open-asr"].setdefault(norm(stem[:-3]), repo)
    # the image board publishes a huggingface url rather than a flag, so the
    # same field decides openness AND supplies the most precise name any of
    # these boards gives: a repo path. it points at a COLLECTION for a couple of
    # them, which normalizes to the family name and is matched as one more
    # spelling rather than trusted as a repo
    pictured = {"aa-t2i": open_keys(load("artificial-analysis-image", data),
                                    "openWeightsUrl", ("openWeightsUrl",))}
    # lmarena's image board, which the collector has been capturing all along
    # and nothing read: 76 entries over 6.1m votes, and the same open-weights
    # filter as everywhere else -- the board is mostly hosted SKUs and three of
    # its top rows are proprietary tiers of models this registry carries.
    def lm_open(board):
        """{normalized display name: display name} for one board, open weights only.

        The `models` map is the filter and not the licence string: eight
        image_edit rows carry a non-proprietary licence and only some of those
        are weights anybody can fetch -- hunyuan-image-3.0-instruct is
        `tencent-hunyuan-community` and not open by the board's own reckoning.
        """
        out = {}
        for e in ((lm.get("boards") or {}).get(board) or {}).get("entries") or []:
            name = e.get("modelDisplayName")
            if name and ((lm.get("models") or {}).get(name) or {}).get("openWeights"):
                out.setdefault(norm(name), name)
        return out

    pictured["lmarena-t2i"] = lm_open("text_to_image-overall-raw")
    # editing is a different job from generation and gets its own id: a model
    # that rewrites a picture well has not thereby been shown to draw one. the
    # collector has been capturing this board all along too
    pictured["lmarena-edit"] = lm_open("image_edit-overall-raw")
    # the showdown, which is the one image source here that is a measurement
    # rather than a poll. keyed by the site's own generator id, so `FLUX2_DEV`
    # and "FLUX.2 [dev]" are two spellings of one row rather than two rows --
    # the site renames a model after it ships and the id is what its records
    # join on. `locallyHostable` is its open-weights flag and it agrees with
    # this registry where lmarena's licence string does not: ideogram 4 and
    # krea 2 are hostable here and both have ggufs the roster pins
    showdown = ((load("genai-showdown", data) or {}).get("boards") or {})
    for source, name in (("showdown-t2i", "text-to-image"),
                         ("showdown-edit", "image-editing")):
        pictured[source] = open_keys((showdown.get(name) or {}).get("models") or {},
                                     "locallyHostable")
    # nothing scores a diarizer: there is no third-party DER board for the
    # embedders and segmenters, which is why crispasr's own figure is the only
    # number this repo has for them and it is quoted in the model's notes
    # the board the decision half is scored on, and the only source here whose
    # rows are decision models, rerankers and classifiers rather than chat models
    decision = {"jev": jev_space((load("jevbench", data) or {}).get("systems") or {})}
    return {"text": out, "speech": spoken, "image": pictured,
            "decision": decision, "diarize": {}}


# what each facet group MEASURES, so a model is offered the ones its own
# modalities say it could be on. kind was the wrong question and was quietly
# costing data: gemma 4 e4b is `kind: text` with an audio encoder, crispasr
# transcribes with it under `--backend gemma4-e4b`, and voice arena publishes
# its word error rate in seven languages -- none of which the roster could see
# while the speech boards were offered to `kind: speech` alone.
#
# the viewer reads this a second way, to decide what the CURRENT VIEW is asking
# rather than what a model could answer, so a group that is not a leaderboard
# has to declare itself too. `lang` is gbench's per-language rates under another
# prefix and `card` is the text benchmarks a vendor printed on its own card;
# both are evidence about writing and reasoning. `community` is deliberately
# absent, because it is the one group with no capability behind it -- any model
# can be discussed, whatever it does.
#
# only the leaderboard names are looked up by `spaces_for` below, so the two
# additions are inert here and load-bearing there.
BOARD_NEEDS = {
    "aa": "text", "gbench": "text", "lmarena": "text", "swerebench": "text",
    "epoch": "text", "lang": "text", "card": "text",
    "aa-stt": "transcribes", "aa-stt-streaming": "transcribes",
    "voicearena": "transcribes", "open-asr": "transcribes",
    "aa-tts": "synthesizes", "tts-arena": "synthesizes",
    "aa-t2i": "draws", "lmarena-t2i": "draws", "lmarena-edit": "draws",
    "showdown-t2i": "draws", "showdown-edit": "draws",
    "jev": "decides",
}


def can(model):
    """What a model does, from its derived modalities and its kind."""
    mod = model.get("modalities") or {}
    ins, outs = set(mod.get("input") or []), set(mod.get("output") or [])
    out = set()
    if model.get("kind", "text") == "text":
        out.add("text")
    if "audio" in ins and "text" in outs:
        out.add("transcribes")
    if "audio" in outs:
        out.add("synthesizes")
    if "image" in outs:
        out.add("draws")
    # a capability rather than a shape: what a decision model emits is a
    # probability per option, which is no modality, so `kind` is the only thing
    # that says it. the same table in scripts/roster.js has to agree or the page
    # and the derive disagree about who is being asked
    if model.get("kind") == "decision":
        out.add("decides")
    return out


def spaces_for(model, by_kind):
    """The key spaces this model is a candidate in, as one flat mapping."""
    able, out = can(model), {}
    for spaces in by_kind.values():
        for source, space in spaces.items():
            if BOARD_NEEDS.get(source) in able:
                out[source] = space
    return out


# a trailing parameter count, which sources drop as often as they keep: AA and
# lmarena both call meta-models/Muse-Glimmer-30B just `muse-glimmer`
SIZE = re.compile(r"[-_](\d+(?:\.\d+)?)b(?:[-_]a\d+(?:\.\d+)?b)?$", re.I)

# words that name a DIFFERENT model in the same family rather than the same one
# spelled longer. `kimi-k3` fuzzy-matched lmarena's `kimi-k3-max`, which is the
# hosted flagship and not the open weights this registry tracks -- AA lists both
# and scores them apart. an effort level does the same: gpt-oss-120b at `high`
# is not gpt-oss-120b at `low`
TIER = ("max", "pro", "ultra", "turbo", "mini", "nano", "lite", "plus", "air",
        "preview", "instant", "low", "high", "medium", "xhigh", "thinking",
        "reasoning", "instruct", "chat", "base")


def tiered(want, key):
    """True if `key` is `want` plus a qualifier that names a different model."""
    if not key.startswith(want):
        return False
    return key[len(want):] in TIER


# boards where a near miss is a different MODEL rather than a different
# spelling, so nothing but an exact normalized hit is accepted.
#
# `open-asr` is keyed on huggingface repo ids rather than display names, and
# resemblance between two of those is not evidence of anything: the substring
# pass put `moonshine-base` on `moonshine-tiny`'s row and `omniASR-LLM-300M` on
# the 7B's, which is the failure the docstring below is about arriving through
# the one door it did not cover.
#
# the showdown gets in for the other reason: it names a model without its size
# class. "FLUX.2 Klein" is one row for a family this registry carries as a 4B
# and a 9B, and the `sized` pass -- which strips the parameter count and
# compares what is left -- matched it for BOTH, giving two models one score.
# `candidates` only sees one model at a time, so nothing there can catch that.
# the site's own description says the row is the 9B, which is prose rather than
# a handle, so the honest answer is to leave it unmatched.
EXACT_ONLY = {"open-asr", "showdown-t2i", "showdown-edit"}


def candidates(space, wants, sized=(), exact_only=False):
    """Exact normalized hit first; else a unique substring hit.

    `sized` are the same names with the parameter count removed, and they are
    tried EXACT only. Substring matching them would be reckless -- `gemma-4`
    is inside `gemma-4-31b`, so gemma-4-12b would silently take the 31b's
    scores, which is the one failure this whole script is written to avoid.

    `exact_only` turns the rest of it off for a board that publishes repo ids,
    where resemblance is not evidence of anything.
    """
    for w in wants:
        if w and w in space:
            return space[w], "exact"
    if exact_only:
        return None, "miss"
    hits = set()
    for w in wants:
        if len(w) < 6:
            continue
        for k, v in space.items():
            if w == k or (w in k and abs(len(w) - len(k)) <= 4 and not tiered(w, k)):
                hits.add(v)
    if len(hits) == 1:
        return hits.pop(), "fuzzy"
    if len(hits) > 1:
        return None, "ambiguous:%d" % len(hits)
    sized_hits = {space[w] for w in sized if w in space}
    if len(sized_hits) == 1:
        return sized_hits.pop(), "sized"
    if len(sized_hits) > 1:
        return None, "ambiguous:%d" % len(sized_hits)
    return None, "miss"


# deliberately lower than analyze-catalog's 20b floor. that floor is a stand-in
# for "is this worth looking at", and here the model has already been scored by
# a third party, which answers the same question with evidence. 20b also does
# not describe this roster: it carries gemma-4-E2B at 5b and ling 3.0 tiny at
# 8b, and granite 4.2 8b -- AA intelligence 19.6 against the 30b's 23.7, at
# twice the decode speed -- was invisible to every discovery report we had
SIZE_MIN_B, SIZE_MAX_B = 3, 400
# the report is newest-first, so a cap drops the oldest. it says how many
SHOW = 20
PARAMS = re.compile(r"[-_/]?(\d+(?:\.\d+)?)\s*b\b", re.I)
GGUF_SUFFIX = re.compile(r"[-_]?GGUF$", re.I)
# a source key shorter than this matches half the hub by accident
MIN_KEY = 6


def roster_names(reg):
    """Every spelling of a model the registry already carries.

    Keyed on the model rather than on the source id: a source can name the same
    model twice (epoch carries both `gemma-4-26b-a4b` and its `-it` spelling),
    and asking "is this key claimed" then reports a carried model as missing.
    """
    out = set()
    for repo, m in reg.items():
        cands = [repo.split("/")[-1], (m.get("name") or {}).get("short") or ""]
        cands += [(q.get("repo") or "").split("/")[-1] for q in (m.get("quants") or [])]
        for c in cands:
            if not c:
                continue
            c = GGUF_SUFFIX.sub("", c)
            out.add(norm(c))
            for suffix in ("-it", "-instruct", "-bf16", "-chat", "-base"):
                if c.lower().endswith(suffix):
                    out.add(norm(c[: -len(suffix)]))
    return out


def hub_index():
    """{normalized model name: newest gguf repo the catalog captured for it}."""
    out = {}
    for name in ("hf-catalog", "hf-catalog-new"):
        d = load(name)
        rows = list(d.get("trending") or [])
        for repos in (d.get("authors") or {}).values():
            rows += repos
        for r in rows:
            k = norm(GGUF_SUFFIX.sub("", r["id"].split("/", 1)[-1]))
            prev = out.get(k)
            if not prev or (r.get("createdAt") or "") > (prev.get("createdAt") or ""):
                out[k] = r
    return out


def report_unclaimed(reg, spaces):
    """Scored somewhere, downloadable as gguf, and on no roster line."""
    roster, hub = roster_names(reg), hub_index()
    found = {}
    for source, space in spaces.items():
        for key, real in space.items():
            if len(key) < MIN_KEY or key in roster:
                continue
            r = hub.get(key)
            if r:
                found.setdefault(r["id"], {"row": r, "sources": set()})["sources"].add(source)
    rows = []
    for rid, v in found.items():
        sizes = [float(m.group(1)) for m in PARAMS.finditer(rid.split("/")[-1])]
        b = max(sizes) if sizes else None
        if b is not None and SIZE_MIN_B <= b <= SIZE_MAX_B:
            rows.append((v["row"].get("createdAt") or "", rid, b, sorted(v["sources"])))
    # newest first: an old generation left off the roster is a decision that was
    # already made, and a release from last week is the one nobody has seen
    rows.sort(reverse=True)
    print("\nunclaimed: %d model(s) a source scores, with a gguf, that the "
          "registry does not carry" % len(rows))
    for created, rid, b, sources in rows[:SHOW]:
        print("  %-11s %-48s %5gb  %s" % (created[:10], rid, b, ",".join(sources)))
    if len(rows) > SHOW:
        print("  ... and %d older, back to %s. a generation left off the roster is "
              "usually a decision\n  already made; the newest rows are the ones "
              "nobody has looked at" % (len(rows) - SHOW, rows[-1][0][:10]))
    return rows


def patch_ids(path, reg):
    """Insert or replace each model's `ids:` block, touching nothing else.

    This used to only ever REPLACE, and a model added without an `ids:` block
    was therefore matched, counted as filled and silently dropped: qwen3.8 flash
    next carried AA and lmarena matches for a full capture that way and reached
    MODELS.md unscored. The splice lives in registry_patch now, shared with
    resolve-runtime, and inserts after `quants:` when the block is absent.
    """
    blocks = {}
    for repo, m in reg.items():
        ids = m.get("ids")
        if not ids:
            continue
        # dumped as a pair, not a bare scalar: safe_dump of a scalar appends a
        # `...` document-end marker that breaks the file
        blocks[repo] = {"ids": ["    ids:"] + ["      " + yaml.safe_dump({k: v}).strip()
                                               for k, v in ids.items()]}
    return registry_patch.patch_blocks(path, blocks, after="quants")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--registry", default=os.path.join(HERE, "..", "registry", "models.yaml"))
    ap.add_argument("--data", default=DATA,
                    help="directory the source captures are read from")
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--unclaimed", action="store_true",
                    help="report models a source scores that the roster does not carry")
    ap.add_argument("--names", action="store_true",
                    help="print {normalized name: short} for every roster model, as json")
    args = ap.parse_args()

    doc = yaml.safe_load(open(args.registry))
    reg = doc.get("models") or {}
    if args.names:
        # research/analyze-catalog labels requants with this, so that a model
        # with no name.match is still recognised as one the roster carries
        out = {}
        for repo, m in reg.items():
            for n in roster_names({repo: m}):
                out.setdefault(n, (m.get("name") or {}).get("short") or repo)
        json.dump(out, sys.stdout, indent=1, sort_keys=True)
        print()
        return
    by_kind = key_spaces(args.data)
    if args.unclaimed:
        # every source at once here: the question is whether ANYBODY scores a
        # model with a gguf that the roster lacks, and a speech board answers it
        # for the speech half exactly as a leaderboard does for the text half
        report_unclaimed(reg, {s: sp for spaces in by_kind.values()
                               for s, sp in spaces.items()})
        return
    for kind, spaces in sorted(by_kind.items()):
        print("%s key spaces: %s"
              % (kind, ", ".join("%s %d" % (k, len(v)) for k, v in spaces.items())
                 or "none"))

    filled, kept, amb = 0, 0, 0
    for repo, m in reg.items():
        spaces = spaces_for(m, by_kind)
        if not spaces:
            continue
        # sources drop or keep trailing qualifiers inconsistently: AA writes
        # `gemma-4-31b` where the repo is `gemma-4-31B-it`, and nvidia's repo
        # carries a `-BF16` precision suffix no benchmark uses
        # the owner prefix is a third real spelling, not a fourth guess: several
        # boards slug a model as vendor-plus-name, and artificial analysis calls
        # fishaudio/s2-pro `fish-audio-s2-pro`, which no suffix of the basename
        # reaches. it is MORE specific than the basename, so it cannot widen a
        # match the other variants would not already have made
        raw = [repo.split("/")[-1], (m.get("name") or {}).get("short"),
               repo.replace("/", "-"), ""]
        variants = []
        for cand in raw:
            if not cand:
                continue
            variants.append(cand)
            # `-base` is deliberately NOT in this list, though the four others
            # are. `-it`, `-instruct`, `-chat` and `-bf16` are spellings of the
            # weights they name; a pretrain is the weights BEFORE the
            # post-training that made the other one, and this registry carries
            # both -- so stripping it asked for `Qwen3.5-4B` on behalf of
            # `Qwen/Qwen3.5-4B-Base` and matched artificial analysis' `qwen3-5-4b`
            # EXACTLY. the hub publishes 47 bases and 39 are a `-Base` pretrain:
            # the qualifier is load-bearing, and a source that names a pretrain
            # names it in full, which the unsuffixed variant already covers.
            for suffix in ("-it", "-instruct", "-bf16", "-chat"):
                if cand.lower().endswith(suffix):
                    variants.append(cand[: -len(suffix)])
        wants, sized = [], []
        for v in variants:
            n = norm(v)
            if n and n not in wants:
                wants.append(n)
            s = norm(SIZE.sub("", v))
            if s and s != n and s not in sized:
                sized.append(s)
        ids = m.setdefault("ids", {})
        marks = []
        for source, space in spaces.items():
            if ids.get(source):
                kept += 1
                marks.append("%s=kept" % source)
                continue
            found, how = candidates(space, wants, sized,
                                    exact_only=source in EXACT_ONLY)
            if found:
                ids[source] = found
                filled += 1
                marks.append("%s=%s" % (source, how))
            else:
                ids.setdefault(source, "")
                if how.startswith("ambiguous"):
                    amb += 1
                    marks.append("%s=%s" % (source, how))
        print("  %-46s %s" % (repo, " ".join(marks)))

    print("\nfilled %d, kept %d already set, %d ambiguous left empty"
          % (filled, kept, amb))
    if args.write:
        n = patch_ids(args.registry, reg)
        print("wrote %s: %d ids block(s) rewritten" % (args.registry, n))


if __name__ == "__main__":
    main()
