SCALED_FACETS = {k for _, yes, _, keys in QUANT_EVIDENCE if yes for k in keys}
FACET_EVIDENCE = {k: (name, why)
                  for name, _, why, keys in QUANT_EVIDENCE for k in keys}


def check_evidence(meta):
    """Every facet is classified, or the build stops and says which is not."""
    loose = sorted(k for k in meta if k not in FACET_EVIDENCE)
    if loose:
        raise SystemExit(
            "!!! %d facet(s) have no quantization-evidence classification:\n    %s\n"
            "    add each to QUANT_EVIDENCE in scripts/build-viewer -- to the "
            "`code` group if the\n    benchmark has the model write code or "
            "drive a tool loop through a software task,\n    and to the group "
            "that fits otherwise. a facet is never discounted by default."
            % (len(loose), "\n    ".join(loose)))
    gone = sorted(k for k in FACET_EVIDENCE if k not in meta)
    if gone:
        print("  note: %d classified facet(s) no longer in the data: %s"
              % (len(gone), ", ".join(gone)), file=sys.stderr)

# measured degradation curves live beside the collectors as SOURCE; see that
# file for why it is empty and what a usable entry looks like.
CURVES = os.path.join(ROOT, "research", "quant-curves.json")
# below this many measured curves, a median of them is not a median of
# anything. the fitted curve answers instead, and the page says so.
MIN_CURVES = 3

GITHUB = "https://github.com/khimaros/aimbot"
BRANCH = "master"
HF = "https://huggingface.co/"
GIB = 2 ** 30

# weights the ranking opens with, and the only place they are set. they lived in
# research/build-tables beside a second composite that scored the same models a
# second way and disagreed about first place; that one is retired and MODELS.md
# is generated from this page, so the reasoning moved here with them. the page
# lets a reader change every one, so this is a starting point rather than a
# claim.
#
# each weight is what its source measures that the others do not.
# research/analyze-correlations --redundancy is the input, and it is worth
# re-running after a data refresh, because these are a property of the current
# roster rather than constants:
#
#   source        r2 vs AA scicode+tbench    new info    n
#   epoch ECI     0.876                      12%         16
#   gbench        0.732                      27%         18
#   lmarena       0.472                      53%         16
#   swe-rebench   0.314                      69%         11
#   sentiment     0.093                      91%         29
#
# GBENCH was on 0.35, the largest single weight, and is the source that agrees
# with AA most after epoch. it keeps a premium over its 27% because HOW it
# measures is a real property -- played rather than graded, so there is no public
# problem set to train against -- but it can no longer outvote everything it
# agrees with. its r2 was 0.961 against the AA indices that have since been
# retired and is 0.730 against the two evals that replaced them, so this figure
# was set against a number that no longer holds and is worth re-deriving.
#
# lmarena and swe-rebench miss 9 and 13 of the roster, which is why they enter at
# 0.10 rather than higher: the composite renormalizes over present components, so
# a low weight bounds how far an absence can move a rank. they are carried at all
# because they are the two sources that disagree with AA the most, which is the
# whole reason to have a second source.
#
# sentiment came down from 0.15 to 0.05 and the 0.10 went to AA. that one is
# judgment against the table rather than from it: sentiment carries the most
# information nobody else has, and it is also the least trustworthy measurement
# here -- a blunt polarity lexicon over forum sentences, where "x is better than
# y" scores positive for both. independence is a reason to carry it, not a reason
# to let it move a rank by a sixth.
#
# the intelligence index is NOT a component. across the 168 AA models carrying
# all three, II ~ 27.3*scicode + 35.6*terminalbenchV21 - 5.2 at R^2 0.896, so
# adding it would count the same runs twice for a tenth of the variance. every
# other AA field is >=0.82 rank-correlated with the index, which is why
# artificial analysis is one axis of evidence here rather than fourteen.
# a key ending in `.*` is a wildcard over every facet under it, averaged. card
# claims and epoch runs are per benchmark, and a reader wants one knob for "how
# much do i trust what the vendor says", not eleven. the forums are a wildcard
# for a second reason: build-tables carries ONE `sentiment` component at 0.05,
# and splitting it across four per-forum facets while weighting only reddit made
# a community-only model's composite whichever forum happened to be in this
# table. bonsai 27b is talked about on three and reddit is its highest on the
# fewest mentions, so the one that counted was the flattering one.
# the speech keys are weighted here for the same reason the text ones are: a
# facet nothing weights produces no score, and a roster that ranks 70 models and
# shows a dash beside the other 19 reads as "unmeasured" when the measurement
# exists. they cost the text ranking nothing -- no text model carries one, and
# the composite's denominator is the weight it actually used.
# the two artificial analysis keys carried the coding and agentic INDICES until
# the site retired both. the facets are named for evals now, so these name evals
# -- scicode for writing code and terminal-bench 2.1 for driving a terminal --
# chosen over the alternatives on roster coverage: an axis the composite has to
# impute for most of the roster moves ranks on absence rather than on evidence.
# livecodebench scores 5 of the 46 models artificial analysis rates here and
# terminal-bench 4.0 scores 29 with 14 of them at exactly zero, so both are
# carried at no weight until the boards fill in.
# ...and the weights that decide it are `registry/dashboard.yaml`, beside the
# models they rank rather than in this file. what the composite MEANS is a
# judgement, and a judgement in code is one nobody reviews: the reader who
# wants to argue with the ranking should find it where the registry is.
#
# every block that file holds -- the hardware a reader is assumed to have, the
# quant ladder's ceiling and floor, which filters the page opens with, the
# column order -- travels through here into `docs/data.json` unchanged, and the
# page and `scripts/aimbot` both read it from there. see CONFIG_BLOCKS.
CONFIG = os.path.join(ROOT, "registry", "dashboard.yaml")
# what a config file has to carry for the page to boot. a missing block is a
# page that renders with an empty column order and no explanation, so it is an
# error here rather than a puzzle there
CONFIG_BLOCKS = ("weights", "presets", "hardware", "caps", "floors", "filters",
                 "columns", "speed", "runtimes")


def dashboard_config(path=CONFIG):
    """The dashboard's own defaults, checked hard enough to fail loudly."""
    cfg = load_yaml(path)
    missing = [b for b in CONFIG_BLOCKS if not cfg.get(b)]
    if missing:
        sys.exit("!!! %s: no %s" % (path, ", ".join(missing)))
    order = set((cfg["columns"].get("order") or []))
    unknown = sorted(set(cfg["columns"].get("hidden") or []) - order)
    if unknown:
        sys.exit("!!! %s: columns.hidden names %s, which columns.order does not"
                 % (path, ", ".join(unknown)))
    caps = {c["k"] for c in cfg["caps"]}
    floors = {f["k"] for f in cfg["floors"]}
    for field, have in (("cap", caps), ("floor", floors)):
        if cfg["hardware"].get(field) not in have:
            sys.exit("!!! %s: hardware.%s is %r, which is not one of %s"
                     % (path, field, cfg["hardware"].get(field),
                        ", ".join(sorted(have))))
    # a preset either starts from the weights above or names its own; one that
    # does neither weighs nothing and silently ranks every model the same.
    # a LIST rather than a mapping, because the order it is written in is the
    # order the page offers and the payload is written with sorted keys
    if not isinstance(cfg["presets"], list):
        sys.exit("!!! %s: presets must be a list, so their order survives" % path)
    for p in cfg["presets"]:
        if not p.get("k") or not p.get("title"):
            sys.exit("!!! %s: every preset needs a `k` and a `title`: %r" % (path, p))
        if not p.get("base") and p.get("weights") is None:
            sys.exit("!!! %s: preset %r sets no weights and does not say `base: true`"
                     % (path, p["k"]))
    return cfg

# facet groups in the order the weighting panel lists them, with what each one
# actually measures. a reader deciding what to trust needs this more than the
# numbers.
GROUPS = [
    ("artificial analysis", "one harness across every model, third party. every "
     "facet here is one benchmark: the coding and agentic indices that used to "
     "be the two axes were retired by the site, so scicode and terminal-bench "
     "2.1 carry the default weight instead. the intelligence index is a "
     "composite over these runs and would count them twice."),
    ("gbench", "models play generated games against each other, so there is no "
     "public problem set to train against and outcomes are decided by play."),
    ("gbench languages", "success rate per language, rolled up from the games "
     "gbench played in each. the only source here that says a model is better "
     "at rust than at clojure -- weight the one you write."),
    ("lmarena", "human preference, style controlled. the only source here not "
     "scored by a grader."),
    ("swe-rebench", "pull requests merged after the models shipped, so a score "
     "here cannot have been trained against."),
    ("epoch", "epoch's own runs on its own harness, plus leaderboards it mirrors."),
    ("card claims", "what the model says about itself. corrected by the median "
     "+0.9 overstatement analyze-self-report measured, and still the weakest "
     "evidence here."),
    ("community", "what forums say, per forum. quantitative: mentions damped by "
     "log, times how well those mentions were received."),
    # named after the SOURCE, the way the text groups above are. `speech` said
    # what the numbers were about and not where they came from, so a reader
    # looking for the artificial analysis result on a voice model found a group
    # called `speech` and had to hover a `[src]` to learn whose number it was.
    ("artificial analysis speech", "the same site's three speech boards: batch "
     "transcription, streaming transcription, and a synthesis elo. the two word "
     "error rates are stored as the accuracy they leave, so higher is better in "
     "this column like every other."),
    ("tts arena", "crowd-sourced blind A/B votes on synthesis, published with "
     "the vote count. the second opinion artificial analysis cannot give."),
    ("voice arena languages", "word error rate per language, over a corpus of "
     "real recordings graded clean to noisy. the languages disagree by twenty "
     "points, so they are carried one at a time."),
    ("artificial analysis image", "generation, rated by people picking between "
     "two pictures."),
    ("lmarena images", "the same question at the other arena, over six million "
     "votes. the two disagree -- artificial analysis puts z-image above krea 2 "
     "and this board puts it below -- which is the reason to carry both."),
]


def per_repo_templates(repos, probes, registry_thinking):
    """turns and thinking for EVERY repo we probed, not just the served one.

    The registry records one template per model -- the one a consumer actually
    serves -- because that is the fact a config needs. The page lets a reader
    pick a different repo, and the two disagree far too often to show the
    served repo's answers beside another repo's name: 11 of the 39 models with
    both carry a gguf template that accepts a developer message where the base
    repo rejects it.

    resolve-turns owns the derivation, so it is imported rather than restated.
    """
    rt = load_script("resolve_turns", os.path.join(HERE, "resolve-turns"))
    out = {}
    for repo in repos:
        probe = probes.get(repo)
        if not probe:
            continue
        block = {"turns": rt.turns_for(probe)}
        thinking = rt.thinking_for(probe, None, registry_thinking)
        if thinking:
            block["thinking"] = thinking
        out[repo] = block
    return out


def draft_of(block, model, sizes):
    """What one drafting method loads, or None where nothing was found.

    Whether the drafter costs extra memory is NOT a property of the drafting
    method, which is what this assumed at first and got wrong. It is a property
    of how the publisher shipped it, and the conventions sit side by side:

      qwen     the -MTP- build IS the plain weights plus the head, 0.42gib
               larger, and the fit reads from that build -- already paid for
      gemma    `draft-mtp` too, but the head is a separate `mtp-*.gguf`
               sidecar, 0.09 to 0.48gib, that has to be loaded alongside
      deepseek `dspark:Q8_0`, 10.15gib, beside the quants in the same repo
      glimmer  `dflash-kquant.gguf`, 1.52gib
      dflash2  a repo of its own, published by neither the vendor nor the
               quantizer: inco drafts for qwen3.8 27b out of three rungs of
               `incoai/Qwen3.8-27B-DFlash2-GGUF`

    The first four are discovered -- look in the model's own quant repos for a
    file named after the method, which NOT_A_QUANT already keeps out of the
    quant list. The fifth cannot be, because no amount of looking through this
    model's repos finds a file somebody else published, so the registry names
    the repo and which of its rungs.
    """
    kind = (block.get("type") or "").replace("draft-", "")
    if not kind:
        return None
    if block.get("repo"):
        have = sizes.get(block["repo"]) or {}
        # the sizer prefixes a rung whose filename carries the method BEFORE the
        # quant token, so unsloth's `dflash-kquant.gguf` keys as `dflash:...`
        # while inco's `Qwen3.8-27B-DFlash2-Q4_K_M.gguf` keys plain -- the `2`
        # ends the word and the marker does not match. Both spellings are real
        # and which one a repo uses is not something the registry should know.
        for key in ("%s:%s" % (kind, block.get("quant")), block.get("quant")):
            if have.get(key):
                return {"repo": block["repo"], "file": key, "bytes": have[key],
                        "gib": round(have[key] / GIB, 2)}
        return {"repo": block["repo"], "file": block.get("quant")}
    found = []
    for q in model.get("quants") or []:
        for key, size in (sizes.get(q["repo"]) or {}).items():
            if key.lower().startswith(kind):
                found.append((size, q["repo"], key))
    if not found:
        return None
    # a bare tag is the aggregate over every variant of the head; the concrete
    # file beside it is the one that gets loaded
    concrete = [f for f in found if ".gguf" in f[2] or ":" in f[2]]
    size, repo, key = min(concrete or found)
    return {"repo": repo, "file": key, "bytes": size, "gib": round(size / GIB, 2)}


def speculative(model, sizes):
    """The declared drafter, and any second method the model also has.

    The fit charges for the method the ENTRY serves and not for the
    alternatives, because only one of them is resident: qwen3.8 27b drafts with
    the head inside its own file and could instead load DFlash2 beside it, and
    charging both would price a configuration nobody runs.
    """
    spec = dict(model.get("speculative") or {})
    draft = draft_of(spec, model, sizes)
    if draft:
        spec["draft"] = draft
    alts = []
    for alt in spec.get("alternatives") or []:
        row = dict(alt)
        found = draft_of(alt, model, sizes)
        if found:
            row["draft"] = found
        alts.append(row)
    if alts:
        spec["alternatives"] = alts
    return spec


def load_script(name, path):
    """Import one of this repo's extensionless scripts as a module."""
    spec = importlib.util.spec_from_loader(
        name, importlib.machinery.SourceFileLoader(name, path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def retention_curve():
    """build-tables' quantization retention curve, shipped rather than restated.

    A benchmark measures the model at full precision; a local roster runs a
    quant of it. build-tables scales the three artificial analysis indices by
    the retention this curve predicts for the quant's bits per weight, and the
    page offers the same view -- from the same numbers, so the two cannot
    disagree about what `effective` means.
    """
    mod = load_script("build_tables", os.path.join(ROOT, "research", "build-tables"))
    all_curves = {k: [check_curve(k, c) for c in curves_of(v)]
                  for k, v in (load_json_at(CURVES).get("curves") or {}).items()}
    # only a ratio of benchmark scores can be a retention multiplier. a
    # perplexity or kl sweep says the quant moved the weights, not how much of
    # the score survived, and no published mapping turns one into the other --
    # so those ship for a reader to see and are never multiplied by anything.
    measured = of_kind(all_curves, "score")
    proxies = of_kind(all_curves, "proxy")
    median = median_curve(measured)
    return {
        # what a model with no measurement of its own gets, in order
        "fitted": {"points": mod.CURVE,
                   "source": "research/build-tables CURVE, fitted to unsloth's "
                             "aider polyglot sweep of deepseek v3.1",
                   "file": "research/build-tables"},
        "median": {"points": median, "of": len(measured),
                   "source": "the median of %d measured curves" % len(measured),
                   "file": "research/quant-curves.json"} if median else None,
        "measured": measured,
        "proxies": proxies,
        # an allowlist, not a blocklist: what the curve is evidence FOR, plus
        # the reason each family is in or out, so the page can say why a number
        # was left alone rather than just leaving it alone
        "scaled": sorted(SCALED_FACETS),
        "evidence": [{"name": n, "scaled": yes, "why": why, "facets": sorted(keys)}
                     for n, yes, why, keys in QUANT_EVIDENCE],
    }


def unshipped_rungs(models, sizes):
    """[(repo, quant, what the repo does have)] for a pin nobody published.

    A rung whose lookup misses reaches the page with an empty size rather than
    an error, so the registry can name a tier that does not exist and nothing
    says so. `unsloth/Qwen3.5-397B-A17B-GGUF` publishes 29 of them and none is
    `UD-Q2_K_XL`; the pin sat there until a note tried to reference its size.

    This is the mirror of the `unnamed` report beside it -- that one names a
    published file the ladder cannot offer, this one names an offered rung the
    publisher never shipped -- and it is the direction that costs a reader.
    """
    out = []
    for model in models.values():
        for q in (model.get("quants") or []) + (model.get("components") or []):
            have = sizes.get(q.get("repo")) or {}
            if not have:
                # a repo the size collector has never read is a different
                # problem, and reporting every rung of it as missing would bury
                # the one that is actually wrong
                continue
            if any(have.get(k) is not None for k in (q.get("file"), q.get("quant")) if k):
                continue
            out.append((q["repo"], q.get("quant") or q.get("file"), tuple(sorted(have))))
    return [(repo, tag, list(have)) for repo, tag, have in sorted(set(out))]


def load_json_at(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (IOError, ValueError):
        return {}


def curves_of(value):
    """A model's curves, whether the file gives one or a list of them.

    The file was keyed by model and held one curve each, which held while one
    sweep per model existed. Two people have measured qwen3.8 27b and three of
    qwen3.8 flash next's rungs, and a bare object is still accepted so a
    hand-edit that forgets the brackets reads as the one curve it looks like.
    """
    return value if isinstance(value, list) else [value]


def of_kind(all_curves, kind):
    """{model: [curve]} for the models that have one of this kind."""
    out = {k: [c for c in v if c["kind"] == kind] for k, v in all_curves.items()}
    return {k: v for k, v in out.items() if v}


def check_curve(repo, curve):
    """A curve has to be a curve, and a `score` one has to be a ratio.

    `proxy` curves carry perplexity or kl divergence, which are unbounded and
    usually fall as quality rises, so only the shape is checked. `score` curves
    are the ones the viewer multiplies by, so their range is enforced -- and so
    is naming the gguf repo they ran, because that is what stops a measurement
    of one quant family being charged to another's rung.
    """
    pts = curve.get("points") or []
    kind = curve.get("kind")
    if kind not in ("score", "proxy"):
        sys.exit("!!! %s: curve kind %r is not score or proxy" % (repo, kind))
    if len(pts) < 2:
        sys.exit("!!! %s: a curve needs at least two points" % repo)
    if [x for x, _ in pts] != sorted(x for x, _ in pts):
        sys.exit("!!! %s: points must ascend by bits per weight" % repo)
    if kind == "score":
        if not curve.get("quant_repo"):
            sys.exit("!!! %s: a score curve must name the `quant_repo` whose "
                     "files it ran" % repo)
        for (_, y) in pts:
            if not 0 < y <= 1:
                sys.exit("!!! %s: retention %r is not in (0, 1]" % (repo, y))
    return curve


def median_curve(measured):
    """The middle of the measured curves, sampled at the bpw they share.

    Averaging curves with different sample points would interpolate a shape
    nobody measured, so this reads each curve at a common grid and takes the
    median there -- and only once enough MODELS have one. Counting curves would
    let two sweeps of a single model stand in for a population, and the middle
    of those two is that model rather than a middle of anything. For the same
    reason a model contributes one curve however many it carries.
    """
    if len(measured) < MIN_CURVES:
        return None
    curves = [v[0] for v in measured.values()]
    grid = sorted({x for c in curves for x, _ in c["points"]})
    out = []
    for x in grid:
        ys = sorted(interp(c["points"], x) for c in curves)
        out.append([x, round(ys[len(ys) // 2], 4)])
    return out


def interp(points, x):
    """Retention at x, clamped to the ends rather than extrapolated."""
    if x <= points[0][0]:
        return points[0][1]
    for (x0, y0), (x1, y1) in zip(points, points[1:]):
        if x0 <= x <= x1:
            return y0 + (y1 - y0) * (x - x0) / (x1 - x0) if x1 > x0 else y0
    return points[-1][1]


def load_yaml(path):
    import yaml
    with open(path) as f:
        return yaml.safe_load(f) or {}


def load_json(name):
    path = os.path.join(DATA, name + ".json")
    try:
        with open(path) as f:
            return json.load(f)
    except (IOError, ValueError):
        return {}


def registry_lines(path):
    """Line number of each model key, so every row can link at its own entry."""
    lines = {}
    with open(path) as f:
        for n, line in enumerate(f, 1):
            m = re.match(r"^  ([\w.-]+/[\w.-]+):\s*$", line)
            if m:
                lines[m.group(1)] = n
    return lines


@functools.lru_cache(maxsize=1)
@functools.cache
def validator():
    """models-validate as a module, so its reduction is shipped not restated.

    The page marks exactly the rungs the punch list prints, so the two cannot
    come to different conclusions about which files a stock build opens.

    Cached because it is asked per RUNG, not per run: re-executing the module a
    few thousand times to answer a regex was most of this script's runtime.
    """
    return load_script("models_validate", os.path.join(HERE, "models-validate"))


def fork_type(tag, known):
    return validator().fork_type(tag, known)


def is_quant_name(tag):
    return validator().is_quant_name(tag)


# a filename with its quant token and extension taken off, which is what makes
# two files the same model at two sizes. `ggml-large-v3-turbo-q8_0.bin` and
# `ggml-large-v3-turbo.bin` share a stem; `ggml-medium.bin` does not.
QUANT_TOKEN = re.compile(r"[-_](?:UD-|AD-)?(?:IQ|Q|BF|F|MXFP|NVFP|TQ)\d[A-Za-z0-9_]*",
                         re.I)
# and the measured bit width, where a publisher writes it behind the type.
# byteshape does, on every file, and it is what tells two rungs of one nominal
# type apart -- so the size table keeps it and the STEM must not, or the five
# files of one model differ in the one field that decides they are one ladder
# and each rung reaches the page with nothing to switch to
BPW_ANNOT = re.compile(r"[-_]\d+(?:\.\d+)?bpw\b", re.I)


# a type the tensor reader's block-geometry table has no entry for, which it
# records under its raw id and counts at NO SIZE. that is the right thing to
# record and the wrong thing to average: a rung whose weights are all a fork's
# own type comes back at 0.017 bpw where its card says 2.13, and ik_llama's
# interleaved `_R4` rungs at 0.113. the element count stays -- it is measured --
# and the bits over it do not, because most of the bits were never counted.
UNSIZED_TYPE = re.compile(r"^type\d+$")
# how much of a rung may be unsized before its average stops meaning anything.
# not zero: laguna m.1's IQ1_S carries 0.13% of one fork type beside 97% IQ1_S
# and its 1.664 bpw is sound, where the rungs this drops are 97% or more
UNSIZED_MAX = 0.5


def sized(types):
    """Whether enough of a rung was counted for its bits per weight to mean one."""
    return sum(share for t, share in (types or {}).items()
               if UNSIZED_TYPE.match(t)) <= UNSIZED_MAX


def is_filename(name):
    return bool(re.search(r"\.(gguf|bin)$", name, re.I))


def file_stem(name):
    bare = BPW_ANNOT.sub("", re.sub(r"\.(gguf|bin)$", "", name, flags=re.I))
    return QUANT_TOKEN.sub("", bare).lower()


def quant_rows(model, sizes, known_quants=(), voices=None, unnamed=None,
               tensors=None, repo=None):
    """Each declared quant, with what it weighs and what that is per weight.

    A rung also carries whether a stock llama.cpp can load it. The ladder is
    built from what a repo publishes, and a publisher is free to publish rungs
    in types only their own fork has -- laguna m.1's ik_llama `_R4` and
    `IQ5_K` are 10 of its 28. Offering those as choices with a size beside them
    is the page answering "what else is there" with files that will not open.

    `unnamed` collects the files dropped for carrying no type name, so a ladder
    that quietly got shorter says so.
    """
    params = None
    out = []
    unnamed = [] if unnamed is None else unnamed
    # every file this model pins, under the tag the registry gives it. built
    # first because the ladder is per RUNG and the naming is per MODEL: the Q8_0
    # rung lists the unsuffixed file as an alternate, and without this it stayed
    # a filename there while reading `F16` one rung up
    pinned = {q["file"]: q["quant"] for q in (model.get("quants") or [])
              if q.get("file")}
    for q in model.get("quants") or []:
        repo_sizes = sizes.get(q["repo"]) or {}
        row = dict(q)
        # the note's references become figures HERE rather than being stored
        # rendered, so what the page prints is read from the capture on the
        # build that prints it. see research/notes.py
        if row.get("note"):
            row["note"] = notes.render_parts(row["note"], q["repo"],
                                             q.get("file") or q["quant"],
                                             note_data(), model=repo)
        # and the rung's own runtime block, whose note is about this file too
        if isinstance(row.get("runtime"), dict):
            row["runtime"] = rendered_notes(row["runtime"], q["repo"],
                                            q.get("file") or q["quant"])
        row["url"] = HF + q["repo"]
        # the size table is keyed by whatever the repo publishes: a quant tag
        # where the filenames carry one, the filename itself where they do not,
        # and BOTH where a file carries a tag the derivation could read. `file:`
        # says which this rung is, and the tag is the fallback
        b = repo_sizes.get(q.get("file")) or repo_sizes.get(q["quant"])
        if b:
            row["bytes"] = b
            row["gib"] = round(b / GIB, 2)
        # every other quant published in the same repo, so a reader who cannot
        # fit the pinned one can see what else is there -- but only the ones
        # that are the SAME MODEL. one repo can hold several: whisper.cpp
        # publishes 33 files over eight checkpoints, and offering
        # `ggml-medium.bin` as an alternate rung of large-v3-turbo is offering a
        # different model at a smaller size. where the rung names a file, the
        # alternates are the files that differ from it only by quant token --
        # and the derived tags, which name no file and so name no other model.
        alt = repo_sizes.items()
        drop = NOT_A_QUANT
        if q.get("file"):
            want = file_stem(q["file"])
            alt = [(k, v) for k, v in alt
                   if not is_filename(k) or file_stem(k) == want]
            # `.gguf` in NOT_A_QUANT is there to keep filename keys out of a tag
            # ladder, and the stem filter above has already done that job better:
            # what is left IS this model at another size. kokoro publishes five
            # espeak rungs and the blanket rule hid four of them.
            drop = SIDECAR_NAME
        row["available"] = sorted(
            ({"quant": k, "gib": round(v / GIB, 2)}
             for k, v in alt if not drop.search(k)),
            key=lambda x: x["gib"])
        # a ladder is a list of TYPES and the page labels each rung by name, so a
        # rung it cannot name is a rung a reader cannot pick. three things get
        # here that are not type names, and they want three different answers.
        named = []
        for a in row["available"]:
            fork = known_quants and fork_type(a["quant"], known_quants)
            if fork:
                a["fork_type"] = fork
            # one the registry already pins, which knows the tag for its file
            if a["quant"] in pinned:
                a["file"], a["quant"] = a["quant"], pinned[a["quant"]]
            elif not is_quant_name(a["quant"]):
                # a name carrying a quant token is shown under that token:
                # `ggml-large-v3-turbo-q5_0.bin` is the Q5_0 rung, and a ladder
                # reading half tags and half filenames is the mess this
                # replaced. the extension is NOT the test and used to be --
                # bartowski uploads bf16 as `Fara1.5-27B-bf16`, with no
                # extension at all, and it reached the page wearing the whole
                # stem. the gate is instead whether the name is ALREADY a type,
                # because `UD-Q4_K_XL` carries a token too and reading it would
                # throw the publisher's prefix away
                token = QUANT_TOKEN.search(a["quant"])
                if not token:
                    # nothing in the name says what it is. cstr's
                    # `diff-harness-ref` is a reference file rather than a rung;
                    # `indextts-gpt.gguf` is a real full-precision build whose
                    # publisher tagged nothing. neither can be offered as a
                    # choice, so both are dropped and counted
                    unnamed.append("%s:%s" % (q["repo"], a["quant"]))
                    continue
                a["file"], a["quant"] = a["quant"], token.group(0).strip("-_").upper()
            # what the file IS, where its tensor table has been read. the label
            # is the publisher's and says very little: `UD-Q4_K_XL` is nine ggml
            # types with Q5_K over 42% of the weights. keyed by the tag the
            # sizes collector used, which is the same grouping this ladder is
            t = (tensors or {}).get("%s:%s" % (q["repo"], a.get("file") or a["quant"]))
            if t:
                a["types"] = t["types"]
                if sized(t["types"]):
                    a["real_bpw"] = t["bpw"]
            named.append(a)
        row["available"] = named
        # the speakers this FILE ships, read out of its own header. per quant
        # rather than per model because two conversions of one checkpoint
        # answer differently: cstr's qwen3-tts carries nine names where ours
        # carries none, and a reader needs the list for the rung being served
        spk = ((voices or {}).get(
            "%s:%s" % (q["repo"], q.get("file") or q["quant"])) or {}).get("voices")
        if spk:
            row["voices"] = spk
        out.append(row)
    return out, params


def with_bpw(quants, params_b):
    """Bits per weight, which is the number that predicts quantization loss."""
    if not params_b:
        return quants
    for q in quants:
        if q.get("bytes"):
            q["bpw"] = round(q["bytes"] * 8 / (params_b * 1e9), 2)
        for a in q.get("available") or []:
            a["bpw"] = round(a["gib"] * GIB * 8 / (params_b * 1e9), 2)
    return quants


# which runtimes load a model, joined here because two of them are stated in
# other words: an architecture llama.cpp merged, and a crispasr backend. writing
# either into `engine:` as well would be a second copy that can disagree, so the
# registry states each fact once and this is where they become one list.
#
# vllm is a special case and is not a fact about the weights: it serves a text
# checkpoint's BASE repo, never a gguf, and nothing here tracks its support
# matrix. it is offered for text models because that is where the claim holds,
# and the page's snippet says which repo it would serve.
def engines_for(model):
    """Every runtime that can load this model, derived plus written."""
    out = set(model.get("engine") or [])
    if (model.get("runtime") or {}).get("arch"):
        out.add("llama.cpp")
    if model.get("crispasr") or any(q.get("crispasr")
                                    for q in (model.get("quants") or [])):
        out.add("crispasr")
    if model.get("kind", "text") == "text":
        out.add("vllm")
    return sorted(out)


# the registry names the backend; crispasr's own catalog says which files that
# backend was published against. both are needed to write a command: the repo
# this registry pins is not always one crispasr reads -- kokoro's gguf is a
# TTS.cpp conversion and crispasr converts the checkpoint itself -- and a
# command naming the wrong file is worse than one saying `auto`.
def crispasr_block(model, backends):
    """The registry's crispasr fact, plus the repos the catalog names for it."""
    block = dict(model.get("crispasr") or {})
    names = {block.get("backend")} | {(q.get("crispasr") or {}).get("backend")
                                      for q in (model.get("quants") or [])}
    repos = []
    for name in sorted(n for n in names if n):
        cat = backends.get(name) or {}
        for r in (cat.get("gguf") or []) + (cat.get("models") or []):
            if r not in repos:
                repos.append(r)
    if repos:
        block["repos"] = repos
    return block


def build_model(repo, model, ctx):
    facts = ctx["facts"].get(repo) or {}
    use = (ctx["usecase"].get("models") or {}).get(repo) or {}
    card = ctx["cards"].get(repo) or {}
    quants, _ = quant_rows(model, ctx["sizes"], ctx["known_quants"],
                           ctx["voices"], ctx.setdefault("unnamed", []),
                           ctx["tensors"], repo)
    quants = with_bpw(quants, facts.get("params_total_b"))
    name = model.get("name") or {}
    rec = {
        "repo": repo, "publisher": repo.split("/")[0],
        "short": name.get("short") or repo, "match": name.get("match"),
        "kind": model.get("kind", "text"),
        "url": HF + repo,
        "entry_url": "%s/blob/%s/registry/models.yaml#L%d"
                     % (GITHUB, BRANCH, ctx["lines"].get(repo, 1)),
        # parts, for the same reason the assessment ships them: this one is
        # rendered as a paragraph beside the verdict and its `{card}` knows the
        # url it resolved to. the notes in table CELLS stay flat strings
        "notes": (notes.render_parts(model.get("notes"), repo, None,
                                     note_data(), model=repo)
                  if model.get("notes") else None),
        "runtime": rendered_notes(model.get("runtime") or {}, repo),
        "engines": engines_for(model),
        "crispasr": crispasr_block(model, ctx["backends"]),
        "native_low_bpw": model.get("native_low_bpw"),
        # why this entry is keyed on a gguf repo: nobody published weights for
        # it in any other form. carried so the page and the checks read the
        # same assertion the registry makes
        "gguf_only": model.get("gguf_only"),
        "modalities": model.get("modalities") or {},
        "facts": facts, "quants": quants,
        "components": [rendered_notes(c, c.get("repo") or repo,
                                      c.get("file") or c.get("quant"))
                       for c in (model.get("components") or [])],
        "speculative": rendered_notes(speculative(model, ctx["sizes"]), repo),
        "sampling": rendered_notes(model.get("sampling") or {}, repo),
        "thinking": rendered_notes(model.get("thinking") or {}, repo),
        "turns": rendered_notes(model.get("turns") or {}, repo),
        "templates": per_repo_templates(
            [repo] + [q["repo"] for q in (model.get("quants") or [])],
            ctx["probes"], model.get("thinking")),
        "ids": model.get("ids") or {},
        "params": use.get("params") or {},
        "facets": use.get("facets") or {},
        "languages": use.get("languages") or [],
        "community": use.get("community") or {},
        "tasks": use.get("tasks") or {},
        "derived": use.get("derived") or {},
        "assessed": rendered_verdict(
            use.get("assessed") or {}, use.get("facets") or {},
            lambda r: ((ctx["usecase"].get("models") or {}).get(r) or {}).get("facets")),
        # `quant_repo` rides along because the two sampler sets are not
        # interchangeable: unsloth's page routinely documents different numbers
        # from the vendor's, and merging them loses which is which
        "card": {k: card.get(k) for k in
                 ("summary", "highlights", "claimed", "others", "samplers",
                  "quant_samplers", "quant_repo", "hub", "card_url") if card.get(k)},
    }
    return rec


def facet_meta(models):
    """One description of each facet, rather than one per model that carries it."""
    meta = {}
    for m in models:
        for key, f in m["facets"].items():
            meta.setdefault(key, {"label": f.get("label"), "group": f.get("group"),
                                  "unit": f.get("unit"),
                                  "vendor_reported": bool(f.get("vendor_reported"))})
            # the per-model copies only need what varies
            for drop in ("label", "group", "unit"):
                f.pop(drop, None)
    return meta


def provenance():
    """Which capture each number came from, by content rather than by date."""
    out = {}
    for name in sorted(os.listdir(DATA)):
        if not name.endswith(".json"):
            continue
        path = os.path.join(DATA, name)
        with open(path, "rb") as f:
            out["research/data/" + name] = hashlib.sha256(f.read()).hexdigest()[:12]
    for rel in ("registry/models.yaml", "registry/sampling.yaml",
                "registry/dashboard.yaml"):
        with open(os.path.join(ROOT, rel), "rb") as f:
            out[rel] = hashlib.sha256(f.read()).hexdigest()[:12]
    return out


def build():
    reg_path = os.path.join(ROOT, "registry", "models.yaml")
    support = load_json("llama-support")
    ctx = {"facts": load_json("model-facts"), "sizes": load_json("gguf-sizes"),
           "voices": load_json("gguf-voices"),
           "tensors": load_json("gguf-tensors"),
           "backends": (load_json("crispasr").get("backends") or {}),
           "probes": load_json("template-probes"),
           "usecase": load_json("usecase"), "cards": load_json("model-cards"),
           "known_quants": set(support.get("quants") or []),
           "lines": registry_lines(reg_path)}
    registry = load_yaml(reg_path).get("models") or {}
    sampling = load_yaml(os.path.join(ROOT, "registry", "sampling.yaml"))
    cfg = dashboard_config()
    models = [build_model(repo, m, ctx) for repo, m in sorted(registry.items())]
    # a ladder that got shorter says so. these are files a repo publishes that
    # name no type, so the page has no label to offer them under -- a reference
    # build for a diff harness, or an untagged full-precision upload
    unnamed = sorted(set(ctx.get("unnamed") or []))
    if unnamed:
        print("  note: %d published file(s) name no quant and are not offered as "
              "rungs:\n    %s" % (len(unnamed), "\n    ".join(unnamed)),
              file=sys.stderr)
    # and the same check the other way, which is the direction that costs a
    # reader: a rung the registry offers that the publisher never shipped
    for repo, tag, have in unshipped_rungs(registry, ctx["sizes"]):
        print("  note: %s pins %s, which that repo does not publish. it has: %s"
              % (repo, tag, ", ".join(have[:8])), file=sys.stderr)
    meta = facet_meta(models)
    check_evidence(meta)
    return {
        "repo_url": GITHUB, "branch": BRANCH,
        "sampling": {"profiles": sampling.get("profiles") or {},
                     "default": sampling.get("default"),
                     "fields": sampling.get("fields") or {}},
        "weights": cfg["weights"],
        # the rest of the dashboard's defaults, shipped whole. the page used to
        # hold these as `const DEFAULT_*` and there was no way for anything
        # else to read them
        "config": {k: cfg[k] for k in CONFIG_BLOCKS if k != "weights"},
        "groups": [{"name": n, "about": a} for n, a in GROUPS],
        "facet_meta": meta,
        # what each source MEASURES, shipped rather than restated in javascript:
        # resolve-ids uses it to decide which boards a model is offered, and the
        # page uses it to decide which factors are questions anybody asks of it.
        # two copies of that table would drift the day a board is added.
        "board_needs": load_script(
            "resolve_ids", os.path.join(HERE, "resolve-ids")).BOARD_NEEDS,
        "retention": retention_curve(),
        "milestones": milestones(),
        "provenance": provenance(),
        "models": models,
    }


def milestones():
    """Frontier reference points, from research/milestones -- joined, not restated.

    The comparison these exist for is on artificial analysis' index, which is
    NOT the page's quality column: that is a weighted mean of percentiles inside
    the open-weights cohort and has no frontier model in it by construction. So
    the milestone ships as a raw index for the `aa.intelligence` facet to be read
    against, and the collector is what refuses a milestone that is open weights.
    """
    out = subprocess.run([os.path.join(ROOT, "research", "milestones"), "--json"],
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if out.returncode:
        sys.exit("!!! research/milestones failed: %s" % out.stderr.strip())
    return json.loads(out.stdout or "{}")


def render(payload):
    """The page: roster.js inlined, then the half of the viewer that has a dom.

    The arithmetic is a MODULE rather than part of the page, because three
    things need it and only one is a browser -- the page, `scripts/aimbot` and
    `research/dashboard-table`. It is inlined rather than loaded with a
    `<script src>` so the site stays one file a reader can open off disk, which
    is the property that made the page runnable under node in the first place.

    Order matters and is asserted: every name the viewer half reads is a plain
    global out of the module, so the module has to come first.
    """
    with open(TEMPLATE) as f:
        html = f.read()
    with open(ROSTER) as f:
        roster = f.read()
    for want, where in (("__DATA_URL__", TEMPLATE), ("__ROSTER_JS__", TEMPLATE)):
        if want not in html:
            sys.exit("!!! %s has no %s placeholder" % (where, want))
    # the export tail is what makes it a module under node and is meaningless
    # in a browser, where `module` is undefined. it is cut rather than guarded
    # twice: a reader viewing source should not have to wonder
    roster = MODULE_TAIL.split(roster)[0].rstrip() + "\n"
    found = BROWSER_API.search(roster)
    if found:
        sys.exit("!!! %s reaches for %r; it has to run under node too"
                 % (ROSTER, found.group()))
    return (html.replace("__ROSTER_JS__", roster)
                .replace("__DATA_URL__", "data.json"))


def write(path, text, check):
    current = open(path).read() if os.path.exists(path) else None
    if check:
        if current != text:
            sys.exit("!!! %s is out of date, run: make site" % os.path.relpath(path, ROOT))
        return False
    if current == text:
        return False
    with open(path, "w") as f:
        f.write(text)
    return True


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--check", action="store_true",
                    help="exit 1 if the committed page is not what this would write")
    ap.add_argument("--out", default=OUT_DIR)
    args = ap.parse_args()

    payload = build()
    data = json.dumps(payload, indent=1, sort_keys=True) + "\n"
    page = render(payload)

    os.makedirs(args.out, exist_ok=True)
    changed = [write(os.path.join(args.out, "data.json"), data, args.check),
               write(os.path.join(args.out, "index.html"), page, args.check),
               # github pages runs jekyll over a branch folder unless told not
               # to, and jekyll drops files it does not recognise
               write(os.path.join(args.out, ".nojekyll"), "", args.check)]
    if args.check:
        print("docs/ is current (%d models)" % len(payload["models"]))
        return
    print("wrote %s: %d models, %d facets, %d bytes of data%s"
          % (os.path.relpath(args.out, ROOT), len(payload["models"]),
             sum(len(m["facets"]) for m in payload["models"]), len(data),
             "" if any(changed) else " (unchanged)"))


if __name__ == "__main__":
    main()
