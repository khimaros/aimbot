#!/usr/bin/env python3

"""Build the single-page registry viewer that github pages serves from docs/.

The page is static and fetches ONE file, docs/data.json, by relative path. The
raw captures are 19mb across twenty files and half of them are yaml, so joining
them in the browser would mean shipping a yaml parser and most of the corpus to
read one table. This does the join once, here.

    build-viewer            # write docs/data.json and docs/index.html
    build-viewer --check    # exit 1 if either is out of date

What it joins, all by the registry's own keys:

    registry/models.yaml            the facts and the four keys to address them
    registry/sampling.yaml          what a profile name means
    research/data/model-facts.json  arch, params, context, mtp (derived)
    research/data/gguf-sizes.json   what each quant actually weighs
    research/data/usecase.json      every measurement, per facet, with its ref
    research/data/model-cards.json  the vendor's own prose and hub metadata

Nothing is imputed. A model with no gbench entry has no gbench facet, and the
page renormalizes its ranking over the facets a model actually carries rather
than scoring an absence as a zero.

The run snippets are NOT built here. The page builds them, because the reader
picks the quant and the sampling profile they are built from and there are
twenty quants in some repos. What ships is the facts they are a function of.
Those snippets stay derived rather than policy either way: which model to run,
at what context, on which host, is the consumer's business and is deliberately
absent -- see the README's split.
"""

import argparse
import functools
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.join(HERE, "..")
DATA = os.path.join(ROOT, "research", "data")
TEMPLATE = os.path.join(HERE, "viewer.html")
# the roster's arithmetic, shared with scripts/aimbot and dashboard-table
ROSTER = os.path.join(HERE, "roster.js")
# where the module stops and its node-only export tail begins
MODULE_TAIL = re.compile(r"^if \(typeof module ", re.M)
# a browser api the module must not reach for, named by the CALL rather than by
# the object: the first version of this matched `document` followed by a dot and
# fired on a comment ending a sentence with the word.
BROWSER_API = re.compile(
    r"\b(?:document|localStorage)\s*\.\s*"
    r"(?:querySelector|querySelectorAll|getElementById|createElement|"
    r"addEventListener|body|title|getItem|setItem|removeItem)\b")
OUT_DIR = os.path.join(ROOT, "docs")

sys.path.insert(0, os.path.join(ROOT, "research"))
import notes  # noqa: E402  the reference vocabulary registry notes are written in


import verdicts  # noqa: E402  the reference vocabulary the assessed prose uses


@functools.lru_cache(maxsize=1)
def note_data():
    """The captures a note's references resolve against, read once."""
    return notes.load(DATA)


def rendered_notes(node, repo, quant=None):
    """Every `note:` under one block, with its references rendered.

    A note hangs off six different things -- the model, a quant, `runtime`,
    `sampling.<profile>`, `speculative`, `thinking` -- and rendering only the
    first two shipped `{card}` to the page verbatim on thirteen sampling notes.
    The subject follows the structure the same way research/prose.py walks it:
    a note under a quant means that file, and everything else means the model.
    """
    if isinstance(node, dict):
        out = {}
        for key, value in node.items():
            if key in ("note", "notes") and isinstance(value, str):
                # parts, so a `{gib}` in a quant's note can say which rung it
                # read and a `{card}` can say whose card, the same way the
                # assessment's figures do
                out[key] = notes.render_parts(value, repo, quant, note_data(),
                                              model=repo)
            else:
                out[key] = rendered_notes(value, repo, quant)
        return out
    if isinstance(node, list):
        return [rendered_notes(v, repo, quant) for v in node]
    return node


def prose_fields():
    """The assessed fields that are sentences, from the one enumeration of them."""
    import prose
    return prose.VERDICT_FIELDS


def rendered_verdict(block, facets, other=None):
    """One assessed block with its figures rendered out of the facets.

    The verdicts name their figures -- `{aa.speed}` rather than `aa.speed p77`
    -- so the number a reader sees comes off the capture on the build that
    prints it. Shipped raw the page would print the brace, which is how this
    was noticed. An unresolved reference is left in place by `verdicts.render`
    rather than dropped, so a facet that stops existing is visible rather than
    silently deleting the clause that rested on it.

    `other(repo)` reaches the model a comparison is against, for the half of
    "against 52.0" that used to be typed because a reference could only resolve
    within one model.

    The prose ships as PARTS rather than as a finished string -- words, and the
    references between them with the key each one resolved. A figure the page
    printed out of a capture should be able to say which capture, the way the
    table cell it came from does, and the renderer is the only thing that knows
    which reference produced which figure. Matching the rendered text afterwards
    would be a second implementation of the substitution, and it could not
    attribute a cross-model reference at all: those render bare on purpose.
    """
    out = {}
    for name, value in (block or {}).items():
        # `confidence` and `assessed_on` are values rather than sentences, and
        # a value split into parts is a value with a wrapper around it
        if name not in prose_fields():
            out[name] = value
        elif isinstance(value, str):
            out[name] = verdicts.render_parts(value, facets, other)
        elif isinstance(value, list):
            out[name] = [verdicts.render_parts(v, facets, other)
                         if isinstance(v, str) else v for v in value]
        else:
            out[name] = value
    return out

# files in a quant repo that are not a quant of the model. the multimodal
# projector and the mtp draft head ship beside the weights under their own
# names, and offering either as something to serve would be an error a size
# column makes look plausible -- `MTP` is 2.26gib of gemma 4 31b's repo.
# same exclusion build-tables applies, plus the projector: a drafter is a
# separate model that ships in the model's repo, and `dspark` is 10.5gib of
# deepseek v4 flash's -- offered as a quant it looks like the bargain of the
# roster and is not the model at all.
NOT_A_QUANT = re.compile(r"^(mmproj|mtp|dspark|dflash|eagle3|imatrix)|\.gguf$", re.I)
# the same list without the `.gguf` half, for the ladders that are keyed by
# filename on purpose
SIDECAR_NAME = re.compile(r"^(mmproj|mtp|dspark|dflash|eagle3|imatrix)", re.I)

# WHICH FACETS THE QUANTIZATION CURVE HAS EVIDENCE FOR.
#
# there is one curve, and it is a single sweep: unsloth ran DeepSeek v3.1 at
# eight quants on AIDER POLYGLOT and published the pass rates. that is evidence
# about one thing -- a model writing and editing code to make a test suite pass
# -- and this list says so instead of quietly generalising it to hallucination
# rates, chess puzzles and creative writing.
#
# the line drawn is SAME FAMILY: a benchmark where the model writes code or
# drives a tool loop to finish a software task. that is still a generalisation,
# across benchmarks rather than within one, but it is a smaller one than the
# generalisation this already makes across all 54 models. everything else keeps
# its published number, marked as un-discounted with the reason, on the same
# principle as never scoring a missing measurement as a zero: an unmeasured
# effect is not the same as no effect, and inventing the correction is worse
# than admitting it is unknown.
#
# a facet in NEITHER list is an error, not a default. that is the point: when
# epoch adds a benchmark, somebody has to decide which side it is on rather
# than have it silently join the discounted pile.
QUANT_EVIDENCE = [
    ("code", True,
     "the curve was fitted to a code-editing pass rate, so it is evidence "
     "about writing code and driving a tool loop through a software task",
     ["aa.scicode", "aa.livecodebench", "aa.terminalbench",
      "aa.terminalbench_v40", "aa.terminalbench_hard", "aa.itbench_sre",
      "gbench.agentic", "gbench.decision", "gbench.oneshot", "gbench.overall",
      "lang.clojure", "lang.cpp", "lang.csharp", "lang.go", "lang.java",
      "lang.javascript", "lang.kotlin", "lang.ocaml", "lang.python",
      "lang.rust", "lang.typescript",
      "swerebench.resolved",
      "epoch.aider_polyglot", "epoch.ale_bench", "epoch.algotune",
      "epoch.cursorbench", "epoch.deepswe", "epoch.frontiercode",
      "epoch.frontierswe", "epoch.gso", "epoch.scicode",
      "epoch.swe_bench_verified", "epoch.terminalbench", "epoch.webdev_arena",
      "card.deepswe", "card.livecodebench", "card.scicode",
      "card.swebench_pro", "card.swebench_verified", "card.terminalbench"]),

    ("recall", False,
     "knowledge recall and question answering. quantization is widely reported "
     "to cost recall differently from reasoning, and nothing here measures it",
     ["aa.critpt", "aa.gpqa", "aa.hle", "aa.lcr", "aa.non_hallucination",
      "aa.omniscience", "aa.omniscience_index",
      "epoch.critpt", "epoch.gpqa_diamond", "epoch.hle",
      "epoch.simpleqa_verified", "epoch.simplebench",
      "card.critpt", "card.gpqa", "card.hle", "card.mmlu", "card.mmlu_pro"]),

    ("reasoning", False,
     "maths, proof, puzzle solving and argument. scored on what the model "
     "concluded rather than on working code, and no sweep here has measured "
     "what a quant costs it",
     ["epoch.arc_agi", "epoch.arc_agi_2", "epoch.chess_puzzles",
