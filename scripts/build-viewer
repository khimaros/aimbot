      "epoch.frontiermath", "epoch.frontiermath_tier_4",
      "epoch.frontiermath_tiers_1_3_v2", "epoch.frontiermath_tier_4_v2",
      # the conceptual reasoning index's two halves. dtbench is multiple choice
