SCALED_FACETS = {k for _, yes, _, keys in QUANT_EVIDENCE if yes for k in keys}
FACET_EVIDENCE = {k: (name, why)
                  for name, _, why, keys in QUANT_EVIDENCE for k in keys}


def check_evidence(meta):
    """Every facet is classified, or the build stops and says which is not."""
    loose = sorted(k for k in meta if k not in FACET_EVIDENCE)
    if loose:
        raise SystemExit(
            "!!! %d facet(s) have no quantization-evidence classification:\n    %s\n"
            "    add each to QUANT_EVIDENCE in scripts/build-viewer -- to the "
            "`code` group if the\n    benchmark has the model write code or "
            "drive a tool loop through a software task,\n    and to the group "
            "that fits otherwise. a facet is never discounted by default."
            % (len(loose), "\n    ".join(loose)))
    gone = sorted(k for k in FACET_EVIDENCE if k not in meta)
    if gone:
        print("  note: %d classified facet(s) no longer in the data: %s"
              % (len(gone), ", ".join(gone)), file=sys.stderr)

# measured degradation curves live beside the collectors as SOURCE; see that
# file for why it is empty and what a usable entry looks like.
CURVES = os.path.join(ROOT, "research", "quant-curves.json")
# below this many measured curves, a median of them is not a median of
# anything. the fitted curve answers instead, and the page says so.
MIN_CURVES = 3

GITHUB = "https://github.com/khimaros/aimbot"
BRANCH = "master"
HF = "https://huggingface.co/"
GIB = 2 ** 30

# weights the ranking opens with. these are build-tables' composite weights,
# which were set by a redundancy analysis rather than by taste -- see its
# WEIGHTS comment. the page lets a reader change every one of them, so this is
# a starting point rather than a claim.
# a key ending in `.*` is a wildcard over every facet under it, averaged. card
# claims and epoch runs are per benchmark, and a reader wants one knob for "how
# much do i trust what the vendor says", not eleven.
# the speech keys are weighted here for the same reason the text ones are: a
# facet nothing weights produces no score, and a roster that ranks 70 models and
# shows a dash beside the other 19 reads as "unmeasured" when the measurement
# exists. they cost the text ranking nothing -- no text model carries one, and
# the composite's denominator is the weight it actually used.
DEFAULT_WEIGHTS = {
    "aa.coding": 0.30, "aa.agentic": 0.30, "gbench.agentic": 0.15,
    "lmarena.rating": 0.10, "swerebench.resolved": 0.10,
    "community.reddit-localllama": 0.05, "card.*": 0.05,
    "aa-stt.accuracy": 0.30, "aa-tts.elo": 0.30, "tts-arena.elo": 0.20,
    # the wildcard, not us english: weighting one language would rank a model on
    # the slice it happens to be tuned for
    "voicearena.*": 0.20,
    "aa-t2i.elo": 0.5, "lmarena-t2i.rating": 0.5,
}

# facet groups in the order the weighting panel lists them, with what each one
# actually measures. a reader deciding what to trust needs this more than the
# numbers.
GROUPS = [
