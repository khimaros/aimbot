     ["aa.analyst_agent", "aa.apex_agents", "aa.gdpval",
      "epoch.apex_agents", "epoch.blueprint_bench_2", "epoch.cl_bench",
      # earthborne rangers: repeated playthroughs of a campaign board game with
      # note-taking between them, asking whether a model improves with practice.
      # a playthrough is 2-4 hours of human time, so it fails by drifting over a
      # long horizon rather than by getting one answer wrong
      "epoch.ebr_bench",
      "epoch.cl_bench_life", "epoch.exploitbench", "epoch.gbaeval",
