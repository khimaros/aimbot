# copy to .env, which is gitignored. read by research/llm.py, which is the only
# thing here that talks to a model -- see CONTRIBUTING.md for what the two steps
# that use it may and may not do -- and by research/fetch-reddit, which needs an
# api client now that reddit serves a login page to everyone else.
#
# anything already exported wins over this file, so one run can be pointed
# somewhere else without editing it:
#
#     AIMBOT_LLM_MODEL=gpt-oss-120b:Q8_0 make llm

# an OpenAI-compatible base url. llama-server, anything speaking the same
# protocol behind a proxy, or a hosted api. defaults to localhost:8080/v1.
AIMBOT_LLM_URL=http://localhost:8080/v1

# the model to ask for. REQUIRED: with this unset every llm step skips itself
# and a sweep runs exactly as it did before. llama-swap routes on this name.
AIMBOT_LLM_MODEL=

# bearer token. llama-server ignores it; a hosted api does not. leave blank for
# a local endpoint rather than inventing a placeholder.
AIMBOT_LLM_KEY=

# a reddit app, from https://www.reddit.com/prefs/apps -- create one of type
# `script`; the id is the string under the app name and the secret is beside it.
# BOTH or NEITHER: with them unset fetch-reddit falls back to scraping old.reddit
# and reports the login wall it now gets, leaving the committed capture in place.
# nothing here reads anything a logged-out visitor could not, so the token asked
# for is app-only (client_credentials) and acts as no user.
AIMBOT_REDDIT_CLIENT_ID=
AIMBOT_REDDIT_SECRET=
